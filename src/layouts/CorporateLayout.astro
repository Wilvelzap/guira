---
/**
 * CorporateLayout.astro
 *
 * Layout sobrio para páginas institucionales de verificación corporativa
 * (expedientes de KYB). Deliberadamente NO reutiliza Layout.astro: esta
 * familia de páginas se sirve sin píxeles publicitarios, sin fuentes por CDN
 * y sin JavaScript de terceros, y todo su contenido debe existir en el HTML
 * servido aunque el JS esté bloqueado.
 *
 * Importa global.css (Tailwind) porque "The platform" reutiliza
 * FaqSection.astro, un componente construido con utilidades de Tailwind y
 * compartido con el resto del sitio. Antes esta página no lo cargaba.
 */
import '../styles/global.css';

interface Props {
  lang: 'en' | 'es';
  title: string;
  description: string;
  canonical: string;
  alternateEn: string;
  alternateEs: string;
  ogLocale?: string;
}

const {
  lang,
  title,
  description,
  canonical,
  alternateEn,
  alternateEs,
  ogLocale = lang === 'es' ? 'es_ES' : 'en_US',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />

    <link rel="icon" type="image/svg+xml" href="/guira-logo.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
  </head>

  <body class="gs-body">
    <slot />
  </body>
</html>

<style is:global>
  /* ─── Tokens ──────────────────────────────────────────────────
     Tomados literalmente de tailwind.config.mjs (colors.guira) para que
     esta ruta se sienta parte del mismo entorno de marca que el resto de
     guiracorp.com, aunque su registro visual sea más sobrio: sin
     gradientes, sin animaciones, sin fotografía (ver §7 del brief). */
  :root {
    --gs-accent: #0051ff; /* guira-teal */
    --gs-accent-2: #00d8ff; /* guira-cyan, solo sobre fondo oscuro */
    --gs-dark: #020617; /* guira-dark */
    --gs-ink: #0f172a;
    --gs-ink-soft: #475569;
    --gs-ink-faint: #64748b;
    --gs-rule: #e2e8f0;
    --gs-surface: #ffffff;
    --gs-surface-alt: #f8fafc;
    --gs-font: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI',
      Roboto, Helvetica, Arial, sans-serif;
    --gs-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas,
      monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  /* ─── Neutraliza .reveal de global.css ────────────────────────
     FaqSection.astro (usado en "The platform") trae clases .reveal /
     .reveal-delay-* que empiezan en opacity:0 y solo pasan a visibles
     cuando src/scripts/main.js les agrega .active vía IntersectionObserver.
     Ese script no se carga en esta página (el brief de esta ruta pide
     "sin movimiento, sin scroll reveals"), así que sin esta regla el
     contenido de FaqSection quedaría invisible para siempre. Se fuerza
     el estado final visible en vez de cargar el script de scroll. */
  .reveal,
  .reveal-left,
  .reveal-right,
  .reveal-up {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }

  .gs-body {
    margin: 0;
    background: var(--gs-surface);
    color: var(--gs-ink);
    font-family: var(--gs-font);
    font-size: 17px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .gs-body a {
    color: var(--gs-accent);
    text-underline-offset: 0.2em;
  }

  .gs-body a:focus-visible,
  .gs-body button:focus-visible,
  .gs-body input:focus-visible,
  .gs-body textarea:focus-visible {
    outline: 2px solid var(--gs-accent);
    outline-offset: 2px;
  }

  /* ─── Estructura ─────────────────────────────────────────────── */
  /*
   * Contenedor exterior de toda sección, según
   * ESPECIFICACION_LAYOUT_HORIZONTAL.md: max-w-7xl (80rem) + px-6,
   * idéntico al que usan Navbar, Footer y el resto de páginas del sitio.
   * Antes esta ruta usaba un --gs-measure propio de 46rem centrado con
   * mx-auto, lo que dejaba una columna angosta flotando en medio de la
   * pantalla en escritorio — inconsistente con el resto de Guira y el
   * motivo del ajuste. El ancho de lectura ya no se controla achicando
   * este contenedor, sino con .gs-prose / .gs-prose--wide por dentro.
   */
  .gs-shell {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /*
   * Nivel 2 (bloque interior) de la guía: reduce el ancho solo del
   * contenido, nunca del contenedor de sección. A propósito SIN
   * margin-left auto: el texto queda pegado al borde izquierdo del
   * .gs-shell, como el resto de bloques editoriales del sitio, en vez de
   * flotar centrado.
   *
   * .gs-prose y .gs-prose--wide comparten la misma medida (56rem / 896px).
   * Antes eran 44rem y 58rem: esa diferencia dejaba la mayoría de las
   * secciones de texto corrido usando solo ~55% del ancho de .gs-shell
   * (mucho vacío a la derecha en pantallas grandes) mientras las secciones
   * en <dl> (Core capabilities, Corporate information) quedaban sin
   * ninguna de las dos clases y ocupaban el shell completo (1232px), con
   * líneas de descripción de casi 120 caracteres. Unificar ambas clases en
   * un solo valor intermedio empareja el ritmo visual de toda la página y
   * evita esas líneas demasiado largas en las filas dt/dd.
   */
  .gs-prose,
  .gs-prose--wide {
    max-width: 56rem;
  }

  /* ─── Hero (EditorialHeader reutilizado) ─────────────────────
     Fondo guira-dark de extremo a extremo, como referencia visual
     pedida: kicker arriba a la izquierda, titular grande debajo,
     párrafo desplazado a la derecha. Usa el mismo .gs-shell que el
     resto de la página para que el borde izquierdo del titular
     coincida exactamente con el de las secciones de abajo. */
  .gs-hero {
    background: var(--gs-dark);
    padding: 4.5rem 0 4rem;
  }

  @media print {
    .gs-hero,
    .gs-hero h1,
    .gs-hero p,
    .gs-hero span {
      background: #fff !important;
      color: #000 !important;
    }

    .gs-hero {
      padding: 0 0 0.75rem;
    }
  }

  .gs-section {
    padding: 2.75rem 0;
    border-top: 1px solid var(--gs-rule);
  }

  .gs-section:first-of-type {
    border-top: 0;
  }

  .gs-section h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 1.15;
    color: var(--gs-ink);
  }

  .gs-section p {
    margin: 0 0 1.15rem;
    color: var(--gs-ink-soft);
  }

  .gs-section p:last-child {
    margin-bottom: 0;
  }

  /* ─── Secciones oscuras ──────────────────────────────────────
     Mismo ritmo claro/oscuro que el resto del sitio (ver
     guiraglobal.astro), sin gradiente ni textura: color plano
     guira-dark. */
  .gs-section--dark {
    background: var(--gs-dark);
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  .gs-section--dark h2 {
    color: #ffffff;
  }

  .gs-section--dark p {
    color: #cbd5e1;
  }

  /* ─── Bloque de verificación (secciones 9–13) ────────────────
     Un fondo levemente distinto separa visualmente los datos
     registrales del bloque de producto, como pide el brief §8,
     sin depender de una etiqueta de texto nueva: la sección
     oscura de Regulatory position ya marca el corte, y esta banda
     gris continúa el mismo bloque hasta el pie. */
  .gs-section--verification {
    background: var(--gs-surface-alt);
  }

  @media print {
    .gs-section--verification {
      background: #fff;
    }

    .gs-section--dark,
    .gs-section--dark h2,
    .gs-section--dark p {
      background: #fff !important;
      color: #000 !important;
    }
  }

  .gs-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--gs-ink);
    color: #fff;
    padding: 0.6rem 1rem;
    z-index: 10;
  }

  .gs-skip:focus {
    left: 0.5rem;
    top: 0.5rem;
  }

  /* ─── Cabecera del sitio (Navbar oscuro como la plataforma Guira) ─── */
  .gs-topbar {
    background: #0B1120;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .gs-topbar__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .gs-topbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .gs-topbar__brand:hover {
    color: var(--gs-accent-2);
  }

  .gs-topbar__brand img {
    height: 1.75rem;
    width: auto;
    object-fit: contain;
  }

  /* Botón de cambio de idioma ES / EN con estilo oscuro de cápsula */
  .gs-langswitch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.5rem;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .gs-langswitch:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .gs-langswitch__current {
    color: #00d8ff; /* guira-cyan */
    font-weight: 800;
  }

  .gs-langswitch__sep {
    color: rgba(255, 255, 255, 0.25);
    font-weight: 400;
  }

  .gs-langswitch a {
    color: #94a3b8; /* slate-400 */
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .gs-langswitch a:hover {
    color: #ffffff;
    text-decoration: none;
  }

  /* ─── Pie legal ──────────────────────────────────────────────── */
  .gs-footer {
    border-top: 1px solid var(--gs-rule);
    background: var(--gs-surface-alt);
    padding: 2.25rem 0 3rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--gs-ink-faint);
  }

  .gs-footer p {
    margin: 0 0 0.9rem;
  }

  .gs-footer__legal {
    font-weight: 700;
    color: var(--gs-ink);
  }

  .gs-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gs-footer__links li + li::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--gs-rule);
  }

  .gs-footer__updated {
    margin-top: 1.25rem !important;
    font-size: 0.75rem;
  }

  .gs-print-note {
    display: none;
  }

  /* ─── Impresión (§6.5) ───────────────────────────────────────── */
  @media print {
    :root {
      --gs-ink: #000;
      --gs-ink-soft: #000;
      --gs-ink-faint: #000;
      --gs-rule: #999;
      --gs-surface: #fff;
      --gs-surface-alt: #fff;
    }

    .gs-body {
      font-size: 10.5pt;
      line-height: 1.45;
      background: #fff;
      color: #000;
    }

    .gs-topbar,
    .gs-contact__form,
    .gs-skip {
      display: none !important;
    }

    .gs-shell,
    .gs-prose,
    .gs-prose--wide,
    .gs-topbar__inner {
      max-width: none;
      padding: 0;
    }

    .gs-section {
      padding: 0.7rem 0;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .gs-body a {
      color: #000;
      text-decoration: none;
    }

    table,
    dl,
    .gs-card,
    .gs-flow__diagram {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .gs-print-note {
      display: block;
      margin-top: 1rem;
      font-size: 8pt;
      color: #000;
    }
  }
</style>
