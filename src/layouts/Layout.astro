---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import PostHog from '../components/posthog.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  ogLocale?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  robots?: string;
  activeLink?: string;
  footerTheme?: 'dark' | 'light' | 'rich-dark';
  footerVariant?: 'default' | 'guiraglobal';
  hideFloatingWhatsapp?: boolean;
  floatingWhatsappHref?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  keywords,
  canonicalUrl,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  ogImage = "https://www.guiracorp.com/assets/images/og-image.jpg",
  ogLocale = "es_ES",
  twitterCard = "summary_large_image",
  twitterTitle = title,
  twitterDescription = description,
  twitterImage = ogImage,
  robots = "index, follow",
  activeLink,
  footerTheme,
  footerVariant = 'default',
  hideFloatingWhatsapp = false,
  floatingWhatsappHref,
  hideNav = false,
  hideFooter = false
} = Astro.props;

const siteOrigin = 'https://www.guiracorp.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');

const defaultWhatsappHref = rawPath.includes('cobrar')
  ? 'https://wa.me/59167015106?text=%5BW-COB5%5D%20Hola%2C%20quiero%20cobrar%20a%20mis%20clientes%20del%20exterior%20con%20Guira.'
  : 'https://wa.me/59167015106?text=%5BW-PAG1%5D%20Hola,%20quiero%20pagar%20a%20mis%20proveedores%20del%20exterior%20con%20Guira';

const activeFloatingWhatsappHref = floatingWhatsappHref || defaultWhatsappHref;
const computedCanonical = `${siteOrigin}${rawPath === '' ? '/' : `${rawPath}/`}`;
const canonicalBase = canonicalUrl || computedCanonical;
const finalCanonicalUrl = canonicalBase === siteOrigin || canonicalBase.endsWith('/')
  ? canonicalBase === siteOrigin ? `${siteOrigin}/` : canonicalBase
  : `${canonicalBase}/`;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robots} />
    <PostHog />

    <!-- Consent-based Analytics & Marketing Scripts -->
    <script is:inline>
      (function() {
        // Function to get cookie value
        function getCookie(name) {
          let matches = document.cookie.match(new RegExp(
            "(?:^|; )" + name.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g, '\\$1') + "=([^;]*)"
          ));
          return matches ? decodeURIComponent(matches[1]) : undefined;
        }

        // Timezone heuristic for EU/UK
        function isEUorUK() {
          try {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            if (tz) {
              const euTzPrefixes = [
                'Europe/', 'Atlantic/Reykjavik', 'Atlantic/Azores', 
                'Atlantic/Canary', 'Atlantic/Faroe', 'Atlantic/Madeira'
              ];
              return euTzPrefixes.some(prefix => tz.startsWith(prefix));
            }
          } catch (e) {}
          return false;
        }

        // Share the same regional decision with the cookie banner.
        window.isEUorUK = isEUorUK;

        window.loadNonEssentialTracking = function() {
          if (window.nonEssentialTrackingLoaded) return;
          window.nonEssentialTrackingLoaded = true;

          // Google Tag Manager
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer','GTM-KN47K3LJ');

          // Meta Pixel Code
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', '1012152791596331');
          fbq('track', 'PageView');
        };

        const consent = getCookie('cookie_consent');

        function scheduleTracking() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(window.loadNonEssentialTracking, { timeout: 2500 });
          } else {
            setTimeout(window.loadNonEssentialTracking, 1500);
          }
        }

        // Defer loading to prevent blocking the critical rendering path
        if (consent === 'accepted' || (!consent && !isEUorUK())) {
          if (document.readyState === 'complete') {
            scheduleTracking();
          } else {
            window.addEventListener('load', scheduleTracking, { once: true });
          }
        }
      })();
    </script>
    <noscript>
      <img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=1012152791596331&ev=PageView&noscript=1" />
    </noscript>
    <!-- End Consent-based Analytics & Marketing Scripts -->

    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- meta keywords retirada: Google la ignora desde 2009 y exponía la estrategia
         completa en el código fuente. La prop `keywords` se mantiene aceptada para no
         romper las páginas que aún la pasan, pero ya no se renderiza. -->
    <link rel="canonical" href={finalCanonicalUrl} />
    
    <link rel="icon" type="image/svg+xml" href="/guira-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" />
    </noscript>

    <!-- Open Graph Tags -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={finalCanonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={twitterImage} />

    <!-- Custom elements in head (e.g. schemas, page-specific preloads) -->
    <slot name="head" />
</head>

<body class="bg-white text-slate-900 font-sans antialiased overflow-x-hidden selection:bg-guira-teal selection:text-white flex flex-col min-h-screen">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KN47K3LJ" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    {!hideNav && <Navbar activeLink={activeLink} />}

    <slot />

    {!hideFooter && <Footer theme={footerTheme} variant={footerVariant} />}

    <CookieBanner />

    {!hideFloatingWhatsapp && (
      <a
        href={activeFloatingWhatsappHref}
        data-cta-location="sticky_mobile"
        target="_blank"
        rel="noopener noreferrer"
        class="fixed bottom-6 right-6 w-14 h-14 bg-emerald-500 text-white rounded-full flex items-center justify-center shadow-lg shadow-emerald-500/40 hover:scale-110 hover:bg-emerald-400 transition-all z-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2"
        aria-label="Chat en WhatsApp"
      >
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"></path>
        </svg>
      </a>
    )}

    <!-- Main Client Script -->
    <script src="../scripts/main.js"></script>
    <script is:inline>
      document.addEventListener('click', (event) => {
        const link = event.target.closest('a');
        if (!link) return;

        const href = link.getAttribute('href') || '';
        const location = link.closest('nav') ? 'navigation' : link.closest('footer') ? 'footer' : 'content';

        if (href.includes('app.guiracorp.com')) {
          window.posthog?.capture('platform_link_clicked', {
            link_location: location,
            registration_link: href.includes('/registro')
          });
        } else if (href === '/demo' || href.startsWith('/demo?') || href === '#solicitar-demo') {
          window.posthog?.capture('demo_cta_clicked', {
            link_location: location,
            destination_type: href.startsWith('#') ? 'embedded_form' : 'demo_page'
          });
        }
      });
    </script>
</body>
</html>
