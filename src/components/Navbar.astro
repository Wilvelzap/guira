<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    if (typeof (window as any).lucide !== "undefined") {
      (window as any).lucide.createIcons();
    }

    const container = document.getElementById("navbar-container");
    const desktopPanel = document.getElementById("desktop-mega-panel");
    const groupButtons = document.querySelectorAll(".nav-group-btn");
    const tabContents = document.querySelectorAll(".mega-tab-content");
    
    const mobileBtn = document.getElementById("mega-mobile-btn");
    const mobileMenu = document.getElementById("mega-mobile-menu");
    const mobileAccordions = document.querySelectorAll(".mobile-accordion-group");

    let currentOpenGroup: string | null = null;
    let isMegaOpen = false;
    let closeTimeout: number | null = null;
    let isMobileOpen = false;

    // -------------------------------------------------------------------------
    // Desktop Mega Menu Logic (GSAP Animated)
    // -------------------------------------------------------------------------
    const openMegaMenu = (group: string) => {
      if (!desktopPanel) return;

      if (closeTimeout) {
        window.clearTimeout(closeTimeout);
        closeTimeout = null;
      }

      // Si ya está abierto con otro grupo, transición de pestañas
      if (isMegaOpen && currentOpenGroup !== group) {
        currentOpenGroup = group;

        groupButtons.forEach((btn) => {
          const btnGroup = btn.getAttribute("data-group");
          const isActive = btnGroup === group;
          btn.setAttribute("aria-expanded", String(isActive));
          const chevron = btn.querySelector(".nav-chevron");
          if (chevron) {
            gsap.to(chevron, { rotate: isActive ? 180 : 0, duration: 0.25, ease: "power2.out" });
          }
        });

        tabContents.forEach((tab) => {
          if (tab.getAttribute("data-panel") === group) {
            tab.classList.remove("hidden");
            gsap.fromTo(
              tab,
              { opacity: 0, y: 8 },
              { opacity: 1, y: 0, duration: 0.24, ease: "power2.out" }
            );
          } else {
            tab.classList.add("hidden");
          }
        });

        return;
      }

      if (isMegaOpen && currentOpenGroup === group) {
        return;
      }

      // Apertura desde cerrado
      isMegaOpen = true;
      currentOpenGroup = group;

      groupButtons.forEach((btn) => {
        const btnGroup = btn.getAttribute("data-group");
        const isActive = btnGroup === group;
        btn.setAttribute("aria-expanded", String(isActive));
        const chevron = btn.querySelector(".nav-chevron");
        if (chevron) {
          gsap.to(chevron, { rotate: isActive ? 180 : 0, duration: 0.25, ease: "power2.out" });
        }
      });

      tabContents.forEach((tab) => {
        if (tab.getAttribute("data-panel") === group) {
          tab.classList.remove("hidden");
        } else {
          tab.classList.add("hidden");
        }
      });

      desktopPanel.classList.remove("hidden");

      gsap.killTweensOf(desktopPanel);
      gsap.fromTo(
        desktopPanel,
        { height: 0, opacity: 0, y: -6 },
        {
          height: "auto",
          opacity: 1,
          y: 0,
          duration: 0.3,
          ease: "power2.out",
          onComplete: () => {
            if (typeof (window as any).lucide !== "undefined") {
              (window as any).lucide.createIcons();
            }
          }
        }
      );
    };

    const closeMegaMenu = () => {
      if (!isMegaOpen || !desktopPanel) return;

      isMegaOpen = false;
      currentOpenGroup = null;

      groupButtons.forEach((btn) => {
        btn.setAttribute("aria-expanded", "false");
        const chevron = btn.querySelector(".nav-chevron");
        if (chevron) {
          gsap.to(chevron, { rotate: 0, duration: 0.2, ease: "power2.out" });
        }
      });

      gsap.killTweensOf(desktopPanel);
      gsap.to(desktopPanel, {
        height: 0,
        opacity: 0,
        y: -6,
        duration: 0.2,
        ease: "power2.in",
        onComplete: () => {
          desktopPanel.classList.add("hidden");
          tabContents.forEach((tab) => tab.classList.add("hidden"));
        }
      });
    };

    const scheduleClose = () => {
      if (closeTimeout) window.clearTimeout(closeTimeout);
      closeTimeout = window.setTimeout(() => {
        closeMegaMenu();
      }, 240);
    };

    // Eventos Desktop
    groupButtons.forEach((btn) => {
      const group = btn.getAttribute("data-group");
      if (!group) return;

      btn.addEventListener("mouseenter", () => {
        if (window.matchMedia("(min-width: 1024px)").matches) {
          openMegaMenu(group);
        }
      });

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        if (isMegaOpen && currentOpenGroup === group) {
          closeMegaMenu();
        } else {
          openMegaMenu(group);
        }
      });
    });

    container?.addEventListener("mouseenter", () => {
      if (closeTimeout) {
        window.clearTimeout(closeTimeout);
        closeTimeout = null;
      }
    });

    container?.addEventListener("mouseleave", () => {
      if (window.matchMedia("(min-width: 1024px)").matches) {
        scheduleClose();
      }
    });

    // Cerrar con Escape o clic fuera
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeMegaMenu();
        if (isMobileOpen) toggleMobileMenu();
      }
    });

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!container?.contains(target)) {
        closeMegaMenu();
      }
    });

    // -------------------------------------------------------------------------
    // Mobile Menu & Accordions (GSAP Animated)
    // -------------------------------------------------------------------------
    const toggleMobileMenu = () => {
      if (!mobileMenu) return;

      isMobileOpen = !isMobileOpen;
      mobileBtn?.setAttribute("aria-expanded", String(isMobileOpen));

      if (isMobileOpen) {
        closeMegaMenu();
        mobileMenu.classList.remove("hidden");
        gsap.killTweensOf(mobileMenu);
        gsap.fromTo(
          mobileMenu,
          { height: 0, opacity: 0 },
          {
            height: "auto",
            opacity: 1,
            duration: 0.28,
            ease: "power2.out",
            onComplete: () => {
              if (typeof (window as any).lucide !== "undefined") {
                (window as any).lucide.createIcons();
              }
            }
          }
        );
      } else {
        gsap.killTweensOf(mobileMenu);
        gsap.to(mobileMenu, {
          height: 0,
          opacity: 0,
          duration: 0.22,
          ease: "power2.in",
          onComplete: () => {
            mobileMenu.classList.add("hidden");
          }
        });
      }
    };

    mobileBtn?.addEventListener("click", toggleMobileMenu);

    // Mobile Accordion Groups
    mobileAccordions.forEach((group) => {
      const btn = group.querySelector(".mobile-accordion-btn");
      const content = group.querySelector(".mobile-accordion-content") as HTMLElement | null;
      const chevron = group.querySelector(".mobile-chevron");

      if (!btn || !content) return;

      btn.addEventListener("click", () => {
        const isExpanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!isExpanded));

        if (!isExpanded) {
          content.classList.remove("hidden");
          if (chevron) gsap.to(chevron, { rotate: 180, duration: 0.25, ease: "power2.out" });
          gsap.fromTo(
            content,
            { height: 0, opacity: 0 },
            { height: "auto", opacity: 1, duration: 0.24, ease: "power2.out" }
          );
        } else {
          if (chevron) gsap.to(chevron, { rotate: 0, duration: 0.2, ease: "power2.out" });
          gsap.to(content, {
            height: 0,
            opacity: 0,
            duration: 0.2,
            ease: "power2.in",
            onComplete: () => {
              content.classList.add("hidden");
            }
          });
        }
      });
    });

    // Cerrar menú móvil al hacer clic en cualquier enlace interno
    const mobileLinks = mobileMenu?.querySelectorAll("a");
    mobileLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        if (isMobileOpen) toggleMobileMenu();
      });
    });
  });
</script>
