---
import KineticButton from './KineticButton.astro';

interface Props {
  activeLink?: string;
}

const { activeLink } = Astro.props;
const pathname = Astro.url.pathname;

const isCurrent = (page: string) => {
  const cleanPath = pathname.replace(/^\/|\/$/g, '');
  if (page === 'index') {
    return cleanPath === '' || cleanPath === 'index.html';
  }
  return cleanPath === page || cleanPath === `${page}.html` || cleanPath.startsWith(`${page}/`);
};

const isSectionActive = (section: 'producto' | 'soluciones' | 'seguridad' | 'recursos') => {
  if (section === 'producto') {
    return isCurrent('producto') || isCurrent('como-funciona') || isCurrent('cuenta-en-dolares') || isCurrent('demo');
  }
  if (section === 'soluciones') {
    return isCurrent('soluciones') || isCurrent('pagos-proveedores-bolivia') || isCurrent('pagar-proveedores-exterior') || isCurrent('pagos-cobros-internacionales');
  }
  if (section === 'seguridad') {
    return isCurrent('seguridad') || isCurrent('sobre-guira') || isCurrent('guiraglobal') || isCurrent('terminos');
  }
  if (section === 'recursos') {
    return isCurrent('blog') || isCurrent('faq') || isCurrent('contacto') || isCurrent('privacidad') || isCurrent('cookies');
  }
  return false;
};
