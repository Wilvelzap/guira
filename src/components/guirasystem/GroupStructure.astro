---
/**
 * Dos entidades, dos perímetros legales. Cada tarjeta nombra su sujeto de
 * forma explícita: ninguna frase de esta sección puede quedar ambigua entre
 * Guira System LLC y GUIRAGLOBAL S.R.L.
 */
interface Props {
  id?: string;
  group: {
    title: string;
    entities: {
      name: string;
      jurisdiction: string;
      role: string;
      perimeter: string;
    }[];
  };
}

const { id, group } = Astro.props;
---

<section class="gs-section" id={id}>
  <div class="gs-shell">
    <h2>{group.title}</h2>
    <div class="gs-group">
      {group.entities.map((entity) => (
        <article class="gs-card">
          <h3>{entity.name}</h3>
          <p class="gs-card__jurisdiction">{entity.jurisdiction}</p>
          <p class="gs-card__role">{entity.role}</p>
          <p class="gs-card__perimeter">{entity.perimeter}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .gs-group {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 48rem) {
    .gs-group {
      grid-template-columns: 1fr 1fr;
    }
  }

  .gs-card {
    border: 1px solid var(--gs-rule);
    border-top: 3px solid var(--gs-accent);
    padding: 1.35rem;
    background: var(--gs-surface);
  }

  .gs-card h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--gs-ink);
  }

  .gs-card__jurisdiction {
    margin: 0.35rem 0 1rem;
    font-family: var(--gs-mono);
    font-size: 0.8125rem;
    color: var(--gs-ink-faint);
  }

  .gs-card__role {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    color: var(--gs-ink-soft);
  }

  .gs-card__perimeter {
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--gs-rule);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--gs-ink);
  }
</style>
