---
/**
 * Controles operativos. La revisión humana de cada instrucción se presenta
 * como atributo de control, no como limitación técnica. Parte del bloque
 * de verificación (banda gris), no de la sección oscura de Regulatory
 * position.
 */
interface Props {
  id?: string;
  compliance: {
    title: string;
    items: string[];
  };
}

const { id, compliance } = Astro.props;
---

<section class="gs-section gs-section--verification gs-compliance" id={id}>
  <div class="gs-shell">
    <h2>{compliance.title}</h2>
    <ul class="gs-compliance__list">
      {compliance.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .gs-compliance__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--gs-rule);
  }

  .gs-compliance__list li {
    position: relative;
    padding: 0.85rem 0 0.85rem 1.5rem;
    border-bottom: 1px solid var(--gs-rule);
    color: var(--gs-ink-soft);
  }

  .gs-compliance__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.45rem;
    width: 0.55rem;
    height: 2px;
    background: var(--gs-accent);
  }
</style>
