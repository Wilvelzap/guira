---
/**
 * Contacto. No hay alta libre: la plataforma opera con solicitud de
 * evaluacion. Sin campos de monto, volumen, moneda ni tipo de operacion.
 * El formulario envia por Web3Forms —el mismo servicio que ya usa /demo—
 * mediante POST nativo: funciona con JavaScript deshabilitado.
 *
 * Diseno editorial en fondo blanco con disposicion de 2 columnas (grid 12 cols):
 * - Columna izquierda (col 4): Titulo e informacion de contacto/entidad.
 * - Columna derecha (col 8): Formulario de solicitud de evaluacion.
 */
interface Props {
  id?: string;
  contact: {
    title: string;
    entityLine: string;
    emailLabel?: string;
    email: string | null;
    emailPending?: string | null;
    note: string;
    form: {
      subject: string;
      fields: {
        name: string;
        company: string;
        email: string;
        country: string;
        message: string;
      };
      submit: string;
      privacyNote: string;
      privacyLink: string;
      privacyHref: string;
    };
  };
}

const { id, contact } = Astro.props;
const f = contact.form;

const letters = (text: string) =>
  text.split('').map((ch, i) => ({ ch: ch === ' ' ? ' ' : ch, i }));
---

<section
  class="relative overflow-hidden bg-white border-t border-slate-200 py-12 md:py-16 text-slate-900"
  id={id}
>
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16 lg:gap-20 xl:gap-24 items-start">
      <!-- Columna izquierda: Titulo e informacion de contacto -->
      <div class="md:col-span-4 md:pr-4 lg:pr-8">
        <h2
          class="text-4xl font-extrabold uppercase tracking-tight leading-[1.08] text-slate-900 md:text-5xl lg:text-6xl"
        >
          {contact.title}
        </h2>

        <div class="mt-6 space-y-4">
          <p class="font-mono text-sm sm:text-base font-semibold text-slate-900 leading-snug">
            {contact.entityLine}
          </p>

          {contact.email ? (
            <p class="font-mono text-sm sm:text-base text-guira-teal">
              {contact.emailLabel && <span class="text-slate-500 font-normal">{contact.emailLabel} </span>}
              <a href={`mailto:${contact.email}`} class="hover:underline">{contact.email}</a>
            </p>
          ) : (
            contact.emailPending && (
              <p class="font-mono text-xs sm:text-sm text-slate-500 leading-relaxed">
                {contact.emailPending}
              </p>
            )
          )}

          <p class="text-sm sm:text-base font-medium leading-relaxed text-slate-600 pt-4 border-t border-slate-200">
            {contact.note}
          </p>
        </div>
      </div>

      <!-- Columna derecha: Formulario -->
      <div class="md:col-span-8">
        <div class="bg-white p-6 sm:p-8 lg:p-10 rounded-2xl border border-slate-200 shadow-sm gs-contact__form-card">
          <form
            id={`${id}-form`}
            class="gs-contact__form space-y-6 m-0"
            action="https://api.web3forms.com/submit"
            method="POST"
          >
            <input
              type="hidden"
              name="access_key"
              value="8707452b-a137-481b-ba1b-75d2b548b4eb"
            />
            <input type="hidden" name="subject" value={f.subject} />
            <input
              type="checkbox"
              name="botcheck"
              class="gs-contact__botcheck"
              style="display:none"
              tabindex="-1"
              autocomplete="off"
            />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="field-float">
                <input id={`${id}-name`} name="name" type="text" required autocomplete="name" placeholder=" " class="field-input" />
                <label for={`${id}-name`} class="field-label">{letters(f.fields.name).map(({ ch, i }) => (
                  <span class="letter" style={`--i:${i}`}>{ch}</span>
                ))}</label>
              </div>

              <div class="field-float">
                <input id={`${id}-company`} name="company" type="text" required autocomplete="organization" placeholder=" " class="field-input" />
                <label for={`${id}-company`} class="field-label">{letters(f.fields.company).map(({ ch, i }) => (
                  <span class="letter" style={`--i:${i}`}>{ch}</span>
                ))}</label>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="field-float">
                <input id={`${id}-email`} name="email" type="email" required autocomplete="email" placeholder=" " class="field-input" />
                <label for={`${id}-email`} class="field-label">{letters(f.fields.email).map(({ ch, i }) => (
                  <span class="letter" style={`--i:${i}`}>{ch}</span>
                ))}</label>
              </div>

              <div class="field-float">
                <input id={`${id}-country`} name="country" type="text" required autocomplete="country-name" placeholder=" " class="field-input" />
                <label for={`${id}-country`} class="field-label">{letters(f.fields.country).map(({ ch, i }) => (
                  <span class="letter" style={`--i:${i}`}>{ch}</span>
                ))}</label>
              </div>
            </div>

            <div class="field-float">
              <textarea id={`${id}-message`} name="message" rows="4" required placeholder=" " class="field-input resize-none"></textarea>
              <label for={`${id}-message`} class="field-label">{letters(f.fields.message).map(({ ch, i }) => (
                <span class="letter" style={`--i:${i}`}>{ch}</span>
              ))}</label>
            </div>

            <button type="submit" class="btn-29 btn-29-teal w-full py-4 text-base font-extrabold cursor-pointer">
              <span class="text-container">
                <span class="text btn-label">{f.submit}</span>
              </span>
            </button>

            <p class="text-xs text-slate-500 font-medium leading-relaxed">
              {f.privacyNote} <a href={f.privacyHref} class="font-bold hover:underline">{f.privacyLink}</a>.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('form[id$="-form"].gs-contact__form').forEach((form) => {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"] .btn-label');
      const submitBtn = form.querySelector('button[type="submit"]');
      if (!btn || !submitBtn) return;
      const originalText = btn.textContent;

      submitBtn.setAttribute('disabled', 'true');
      btn.textContent = 'Enviando…';

      fetch(form.action, {
        method: 'POST',
        body: new FormData(form as HTMLFormElement),
        headers: { Accept: 'application/json' },
      })
        .then((response) => response.json())
        .then((data) => {
          btn.textContent = data.success ? 'Mensaje enviado' : 'Error, intenta de nuevo';
          if (data.success) (form as HTMLFormElement).reset();
          setTimeout(() => {
            btn.textContent = originalText;
            submitBtn.removeAttribute('disabled');
          }, 4000);
        })
        .catch(() => {
          btn.textContent = 'Error de conexión';
          setTimeout(() => {
            btn.textContent = originalText;
            submitBtn.removeAttribute('disabled');
          }, 4000);
        });
    });
  });
</script>

<style>
  .field-float {
    position: relative;
  }

  .field-input {
    width: 100%;
    padding: 0.75rem 0.25rem 0.5rem;
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--gs-rule);
    outline: none;
    font-family: inherit;
    font-weight: 500;
    color: var(--gs-ink);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field-input:focus {
    outline: none;
    border-color: var(--gs-accent) !important;
    box-shadow: none !important;
  }

  .field-label {
    position: absolute;
    left: 0.25rem;
    top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--gs-ink-faint);
    pointer-events: none;
  }

  .field-label .letter {
    display: inline-block;
    transform-origin: left bottom;
    transition: transform 0.35s ease, color 0.35s ease;
    transition-delay: calc(var(--i, 0) * 22ms);
  }

  .field-input:focus + .field-label .letter,
  .field-input:not(:placeholder-shown) + .field-label .letter {
    transform: translateY(-1.15rem) scale(0.8);
    color: var(--gs-accent);
  }

  @media print {
    section {
      background: #fff !important;
      color: #000 !important;
      border-color: #cbd5e1 !important;
      padding: 1rem 0 !important;
    }
    .gs-contact__form-card {
      display: none !important;
    }
  }
</style>
