---
/**
 * Platform and data handling.
 * Diseno editorial en fondo blanco con disposicion de 2 columnas (grid 12 cols):
 * - Titulo a la izquierda (col 4) con la segunda linea en color plomo (slate-400).
 * - Lista de puntos a la derecha (col 8).
 */
interface Props {
  id?: string;
  dataHandling: {
    title: string;
    items: string[];
  };
}

const { id, dataHandling } = Astro.props;

const words = dataHandling.title.split(' ');
let titleFirst = words[0];
let titleRest = words.slice(1).join(' ');

if (words.length >= 4) {
  titleFirst = words.slice(0, 2).join(' ');
  titleRest = words.slice(2).join(' ');
}
---

<section
  class="relative overflow-hidden bg-white border-t border-slate-200 py-12 md:py-16 text-slate-900"
  id={id}
>
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16 lg:gap-20 xl:gap-24">
      <div class="md:col-span-4 md:pr-4 lg:pr-8">
        <h2
          class="text-4xl font-extrabold uppercase tracking-tight leading-[1.08] text-slate-900 md:text-5xl lg:text-6xl"
        >
          <span>{titleFirst}</span>
          {titleRest && <br />}
          <span class="text-slate-400">{titleRest}</span>
        </h2>
      </div>
      <div class="md:col-span-8">
        <ul class="border-y border-slate-200 divide-y divide-slate-200 list-none p-0 m-0">
          {dataHandling.items.map((item, index) => (
            <li class="py-4 sm:py-5 flex items-start gap-4 sm:gap-6">
              <span class="font-mono text-xs sm:text-sm font-bold text-slate-400 shrink-0 pt-0.5 select-none">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="text-sm sm:text-base font-medium leading-relaxed text-slate-700 m-0">
                {item}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  @media print {
    section {
      background: #fff !important;
      color: #000 !important;
      border-color: #cbd5e1 !important;
      padding: 1rem 0 !important;
    }
    h2,
    h2 span,
    p,
    span {
      color: #000 !important;
    }
    ul,
    li {
      border-color: #cbd5e1 !important;
    }
  }
</style>
