---
/**
 * Platform and data handling. Solo publica las líneas confirmadas por
 * Wilmar. Todo lo demás —hosting, cifrado en reposo, SLA, certificaciones—
 * queda fuera hasta confirmación exacta (brief §3.4 y §5.6): afirmar
 * SOC 2 / ISO 27001 / PCI DSS / uptime / "bank-grade" sin tenerlos es un
 * hallazgo terminal para un analista de compliance, no un adorno de copy.
 *
 * PENDIENTE (§5.6, §9.11): hosting provider y región, cifrado en reposo,
 * política de respaldo, separación de entornos, procedimiento de respuesta
 * a incidentes, período de retención contractual. Wilmar confirma cuáles
 * son exactas antes de agregarlas a dataHandling.items en en.json / es.json.
 *
 * Nota de implementación: este bloque va en el frontmatter (script, no
 * template) a propósito. Un comentario HTML `<!-- -->` dentro del template
 * se conserva tal cual en el HTML servido, así que listar aquí los términos
 * prohibidos (SOC 2, ISO 27001, PCI DSS, etc.) los publicaría igual que si
 * fueran texto visible, y haría fallar la propia búsqueda de la checklist
 * §10 que existe para detectarlos.
 */
interface Props {
  id?: string;
  dataHandling: {
    title: string;
    items: string[];
  };
}

const { id, dataHandling } = Astro.props;
---

<section class="gs-section" id={id}>
  <div class="gs-shell">
    <h2>{dataHandling.title}</h2>
    <ul class="gs-list">
      {dataHandling.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .gs-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gs-list li {
    position: relative;
    padding: 0.55rem 0 0.55rem 1.5rem;
    color: var(--gs-ink);
  }

  .gs-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 0.55rem;
    height: 2px;
    background: var(--gs-accent);
  }
</style>
