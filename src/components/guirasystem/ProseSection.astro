---
/**
 * Sección de texto corrido. El copy llega desde en.json / es.json:
 * los párrafos del núcleo canónico no se editan en el markup.
 */
interface Props {
  id?: string;
  title: string;
  paragraphs: string[];
}

const { id, title, paragraphs } = Astro.props;
---

<section class="gs-section" id={id}>
  <div class="gs-shell">
    <h2>{title}</h2>
    {paragraphs.map((text) => <p>{text}</p>)}
  </div>
</section>
