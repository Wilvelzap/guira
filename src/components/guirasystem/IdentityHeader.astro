---
interface Props {
  identity: {
    legalName: string;
    attributes: string[];
    tagline: string;
    buildStatement: string;
  };
}

const { identity } = Astro.props;
---

<section class="gs-identity">
  <div class="gs-shell">
    <h1>{identity.legalName}</h1>
    <p class="gs-identity__attrs">
      {identity.attributes.map((attr, i) => (
        <>
          {i > 0 && <span class="gs-identity__sep" aria-hidden="true"> · </span>}
          <span>{attr}</span>
        </>
      ))}
    </p>
    <p class="gs-identity__tagline">{identity.tagline}</p>
    <p class="gs-identity__build">{identity.buildStatement}</p>
  </div>
</section>

<style>
  .gs-identity {
    padding: 3.5rem 0 2.5rem;
  }

  .gs-identity h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--gs-ink);
  }

  .gs-identity__attrs {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--gs-ink-faint);
  }

  .gs-identity__sep {
    color: var(--gs-rule);
  }

  .gs-identity__tagline {
    margin: 1.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 3px solid var(--gs-accent);
    max-width: 36rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--gs-ink-soft);
  }

  .gs-identity__build {
    margin: 1rem 0 0;
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--gs-ink-faint);
  }

  @media print {
    .gs-identity {
      padding: 0 0 0.75rem;
    }
  }
</style>
