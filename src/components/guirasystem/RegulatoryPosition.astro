---
/**
 * Regulatory position.
 * Diseno editorial en fondo blanco con disposicion de 2 columnas (grid 12 cols):
 * - Titulo a la izquierda (col 4) con la segunda palabra en color plomo (slate-400).
 * - Parrafos de contenido a la derecha (col 8).
 * El parrafo de evaluacion sobre 31 CFR se renderiza en tipografia secundaria
 * inmediatamente debajo del primer parrafo (postura de no-MSB) segun §2 de la directriz v2.1.
 */
interface Props {
  id?: string;
  regulatoryPosition: {
    title: string;
    paragraphs: string[];
    assessment?: string;
  };
}

const { id, regulatoryPosition } = Astro.props;

const words = regulatoryPosition.title.split(' ');
const titleFirst = words[0];
const titleRest = words.slice(1).join(' ');
---

<section
  class="relative overflow-hidden bg-white border-t border-slate-200 py-12 md:py-16 text-slate-900"
  id={id}
>
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16 lg:gap-20 xl:gap-24">
      <div class="md:col-span-4 md:pr-4 lg:pr-8">
        <h2
          class="text-4xl font-extrabold uppercase tracking-tight leading-[1.08] text-slate-900 md:text-5xl lg:text-6xl"
        >
          <span>{titleFirst}</span>
          {titleRest && <br />}
          <span class="text-slate-400">{titleRest}</span>
        </h2>
      </div>
      <div class="md:col-span-8 space-y-6">
        {regulatoryPosition.paragraphs[0] && (
          <p class="text-base font-medium leading-relaxed text-slate-800 m-0">
            {regulatoryPosition.paragraphs[0]}
          </p>
        )}
        {regulatoryPosition.assessment && (
          <p class="text-sm font-normal text-slate-500 pl-4 border-l-2 border-cyan-500 my-4 leading-relaxed">
            {regulatoryPosition.assessment}
          </p>
        )}
        {regulatoryPosition.paragraphs.slice(1).map((text) => (
          <p class="text-base font-medium leading-relaxed text-slate-800 m-0">
            {text}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @media print {
    section {
      background: #fff !important;
      color: #000 !important;
      border-color: #cbd5e1 !important;
      padding: 1rem 0 !important;
    }
    h2,
    h2 span,
    p {
      color: #000 !important;
    }
  }
</style>
