<style>
  /* Minimalist 3D Book Page-Turning Styles */
  #kyb-book-pages-container {
    perspective: 1400px;
    transform-style: preserve-3d;
  }

  .kyb-book-leaf {
    transform-origin: left center;
    transition: transform 0.7s cubic-bezier(0.25, 1, 0.4, 1), opacity 0.45s ease-out, filter 0.45s ease-out, box-shadow 0.7s ease;
    backface-visibility: hidden;
    will-change: transform, opacity;
  }

  /* Active page on the right side of the book */
  .kyb-book-leaf.is-active {
    opacity: 1;
    transform: rotateY(0deg) translateZ(2px);
    z-index: 20;
    pointer-events: auto;
    filter: blur(0px);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
  }

  /* Next pages stacked under the active right page */
  .kyb-book-leaf.is-next {
    opacity: 0;
    transform: rotateY(0deg) translateZ(-6px) scale(0.98);
    z-index: 10;
    pointer-events: none;
    filter: blur(0.5px);
  }

  /* Turned page (leafed over the spine to the left) */
  .kyb-book-leaf.is-prev {
    opacity: 0;
    transform: rotateY(-115deg) translateZ(8px);
    z-index: 25;
    pointer-events: none;
    filter: blur(1px);
    box-shadow: -10px 8px 20px rgba(0, 0, 0, 0.12);
  }

  /* Laser scan beam animation */
  @keyframes scanSweep {
    0% {
      top: 0%;
      opacity: 0;
    }
    20% {
      opacity: 0.9;
    }
    80% {
      opacity: 0.9;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  .kyb-scan-beam.scanning {
    animation: scanSweep 0.85s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Initialize horizontal scroll pin
  function initSecurityHorizontalScroll() {
    const section = document.querySelector("#security-horizontal-section");
    const track = document.querySelector(".horizontal-track") as HTMLElement | null;
    const cards = gsap.utils.toArray<HTMLElement>(".horizontal-card");
    const dots = document.querySelectorAll(".progress-dot");
    const counter = document.getElementById("security-step-counter");

    if (!section || !track || cards.length === 0) return;

    let mm = gsap.matchMedia();

    mm.add("(min-width: 1024px)", () => {
      const totalSlides = cards.length;
      const getTargetX = () => -(totalSlides - 1) * window.innerWidth;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          pin: true,
          pinSpacing: true,
          scrub: 1,
          start: "top top",
          end: () => `+=${(totalSlides - 1) * window.innerHeight * 0.85}`,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            const p = self.progress;
            let activeIndex = 0;
            if (p < 0.28) {
              activeIndex = 0;
            } else if (p < 0.58) {
              activeIndex = 1;
            } else if (p < 0.88) {
              activeIndex = 2;
            } else {
              activeIndex = 3;
            }

            dots.forEach((dot, idx) => {
              if (idx === activeIndex) {
                dot.classList.remove("w-2", "bg-slate-300");
                dot.classList.add("w-8", "bg-guira-teal");
              } else {
                dot.classList.remove("w-8", "bg-guira-teal");
                dot.classList.add("w-2", "bg-slate-300");
              }
            });

            if (counter) {
              counter.textContent = `0${activeIndex + 1} / 0${totalSlides}`;
            }
          }
        }
      });

      tl.to(track, {
        x: getTargetX,
        duration: 1,
        ease: "none"
      });

      return () => {
        tl.kill();
        ScrollTrigger.getAll().forEach(t => {
          if (t.trigger === section) t.kill();
        });
      };
    });
  }

  // Initialize KYB 3D Open Book / Ledger Experience
  function initKybBookExperience() {
    const container = document.getElementById("kyb-book-experience");
    if (!container) return;

    const leaves = container.querySelectorAll<HTMLElement>(".kyb-book-leaf");
    const indexItems = container.querySelectorAll<HTMLElement>(".kyb-index-item");
    const tabBtns = container.querySelectorAll<HTMLElement>(".kyb-tab-btn");
    const pageIndicator = container.querySelector<HTMLElement>("#kyb-book-page-indicator");
    const scanBeam = container.querySelector<HTMLElement>(".kyb-scan-beam");
    const btnPrev = container.querySelector<HTMLElement>("#kyb-btn-prev");
    const btnNext = container.querySelector<HTMLElement>("#kyb-btn-next");

    if (leaves.length === 0) return;

    let currentDocIndex = 0;
    let autoInterval: any = null;
    let isHovered = false;

    function triggerScanBeam() {
      if (!scanBeam) return;
      scanBeam.classList.remove("scanning");
      void scanBeam.offsetWidth;
      scanBeam.classList.add("scanning");
    }

    function setDocIndex(index: number) {
      if (index < 0 || index >= leaves.length) return;
      currentDocIndex = index;

      // 1. Update 3D Book Leaves (Right Page)
      leaves.forEach((leaf, idx) => {
        leaf.classList.remove("is-active", "is-next", "is-prev");
        if (idx === currentDocIndex) {
          leaf.classList.add("is-active");
        } else if (idx > currentDocIndex) {
          leaf.classList.add("is-next");
        } else {
          leaf.classList.add("is-prev");
        }
      });

      // 2. Update Left Page Index Checklist
      indexItems.forEach((item, idx) => {
        const dot = item.querySelector(".item-dot");
        if (idx === currentDocIndex) {
          item.classList.add("is-active", "bg-slate-900", "text-white", "font-semibold");
          item.classList.remove("text-slate-600", "hover:bg-slate-100");
          if (dot) {
            dot.classList.remove("bg-slate-300");
            dot.classList.add("bg-guira-teal");
          }
        } else {
          item.classList.remove("is-active", "bg-slate-900", "text-white", "font-semibold");
          item.classList.add("text-slate-600", "hover:bg-slate-100");
          if (dot) {
            dot.classList.remove("bg-guira-teal");
            dot.classList.add("bg-slate-300");
          }
        }
      });

      // 3. Update Bottom Tabs
      tabBtns.forEach((btn, idx) => {
        if (idx === currentDocIndex) {
          btn.classList.remove("bg-slate-50", "text-slate-600", "border-slate-200");
          btn.classList.add("bg-slate-900", "text-white", "border-slate-900", "shadow-xs");
        } else {
          btn.classList.remove("bg-slate-900", "text-white", "border-slate-900", "shadow-xs");
          btn.classList.add("bg-slate-50", "text-slate-600", "border-slate-200");
        }
      });

      // 4. Update Page Indicator
      if (pageIndicator) {
        pageIndicator.textContent = `PAG. 0${currentDocIndex + 1} / 0${leaves.length}`;
      }

      triggerScanBeam();
    }

    // Attach click listeners to index checklist items
    indexItems.forEach((item) => {
      item.addEventListener("click", () => {
        const target = parseInt(item.getAttribute("data-index") || "0", 10);
        setDocIndex(target);
      });
    });

    // Attach click listeners to bottom tabs
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = parseInt(btn.getAttribute("data-target") || "0", 10);
        setDocIndex(target);
      });
    });

    // Prev / Next arrow buttons
    btnPrev?.addEventListener("click", () => {
      const prevIdx = (currentDocIndex - 1 + leaves.length) % leaves.length;
      setDocIndex(prevIdx);
    });

    btnNext?.addEventListener("click", () => {
      const nextIdx = (currentDocIndex + 1) % leaves.length;
      setDocIndex(nextIdx);
    });

    // Auto-advance loop every 4 seconds
    function startAutoLoop() {
      stopAutoLoop();
      autoInterval = setInterval(() => {
        if (!isHovered) {
          const nextIdx = (currentDocIndex + 1) % leaves.length;
          setDocIndex(nextIdx);
        }
      }, 4000);
    }

    function stopAutoLoop() {
      if (autoInterval) {
        clearInterval(autoInterval);
        autoInterval = null;
      }
    }

    container.addEventListener("mouseenter", () => {
      isHovered = true;
    });

    container.addEventListener("mouseleave", () => {
      isHovered = false;
    });

    // Initial setup
    setDocIndex(0);
    startAutoLoop();
  }

  // Initialize Item 02 Traceability Live Stepper Animation
  function initSecurityTraceabilityTimeline() {
    const container = document.getElementById("security-traceability-modal");
    if (!container) return;

    const progressBar = document.getElementById("sec-timeline-progress-bar");
    const pulseDot = document.getElementById("sec-timeline-pulse-dot");
    const statusBadge = document.getElementById("sec-op-status-badge");
    const steps = container.querySelectorAll<HTMLElement>(".sec-timeline-step");
    if (!steps.length || !progressBar) return;

    let currentStep = 1;
    let timer: any = null;

    const stepData = [
      {
        name: "Orden creada",
        badgeText: "Orden creada",
        badgeClass: "bg-amber-50 text-amber-700 border-amber-200",
        dotClass: "bg-amber-500",
      },
      {
        name: "Esperando depósito",
        badgeText: "Esperando depósito",
        badgeClass: "bg-amber-50 text-amber-700 border-amber-200",
        dotClass: "bg-amber-500",
      },
      {
        name: "Depósito validado",
        badgeText: "Depósito validado",
        badgeClass: "bg-cyan-50 text-cyan-700 border-cyan-200",
        dotClass: "bg-cyan-500",
      },
      {
        name: "Procesando",
        badgeText: "Procesando",
        badgeClass: "bg-blue-50 text-blue-700 border-blue-200",
        dotClass: "bg-blue-500",
      },
      {
        name: "Enviado",
        badgeText: "Enviado",
        badgeClass: "bg-indigo-50 text-indigo-700 border-indigo-200",
        dotClass: "bg-indigo-500",
      },
      {
        name: "Completado",
        badgeText: "Completado",
        badgeClass: "bg-emerald-50 text-emerald-700 border-emerald-200",
        dotClass: "bg-emerald-500",
      },
    ];

    function renderStep(targetStep: number) {
      currentStep = targetStep;
      const totalSteps = steps.length;
      const progressPercent = ((currentStep - 1) / (totalSteps - 1)) * 100;

      progressBar.style.height = progressPercent + "%";

      if (pulseDot) {
        pulseDot.style.opacity = "1";
        pulseDot.style.top = progressPercent + "%";
        setTimeout(() => {
          if (pulseDot) pulseDot.style.opacity = "0";
        }, 450);
      }

      steps.forEach((stepEl, idx) => {
        const stepNum = idx + 1;
        const iconEl = stepEl.querySelector(".sec-timeline-node-icon");
        const labelEl = stepEl.querySelector(".sec-timeline-label");
        const subEl = stepEl.querySelector(".sec-timeline-sub");

        if (stepNum < currentStep) {
          if (iconEl) {
            iconEl.className =
              "sec-timeline-node-icon w-7 h-7 rounded-full bg-emerald-50 border-2 border-emerald-500 text-emerald-600 flex items-center justify-center shrink-0 shadow-sm transition-all duration-500";
            iconEl.innerHTML =
              '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
          }
          if (labelEl)
            labelEl.className =
              "text-xs sm:text-sm font-bold text-emerald-700 sec-timeline-label transition-colors";
          if (subEl) {
            subEl.classList.add("hidden");
            subEl.innerHTML = "";
          }
        } else if (stepNum === currentStep) {
          if (iconEl) {
            if (stepNum === 6) {
              iconEl.className =
                "sec-timeline-node-icon w-7 h-7 rounded-full bg-guira-teal text-white font-black text-xs flex items-center justify-center shrink-0 shadow-[0_0_14px_rgba(0,81,255,0.6)] scale-110 transition-all duration-500";
              iconEl.innerHTML = "6";
            } else {
              iconEl.className =
                "sec-timeline-node-icon w-7 h-7 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-[0_0_12px_rgba(37,99,235,0.5)] scale-105 transition-all duration-500";
              iconEl.innerHTML = String(stepNum);
            }
          }
          if (labelEl) {
            if (stepNum === 6) {
              labelEl.className =
                "text-xs sm:text-sm font-extrabold text-guira-teal sec-timeline-label transition-colors";
            } else {
              labelEl.className =
                "text-xs sm:text-sm font-extrabold text-blue-600 sec-timeline-label transition-colors";
            }
          }
          if (subEl) {
            subEl.classList.remove("hidden");
            subEl.innerHTML =
              '<span class="w-1.5 h-1.5 rounded-full bg-blue-600 inline-block mr-1"></span> Paso ' +
              stepNum +
              " de 6 · estado actual";
          }
        } else {
          if (iconEl) {
            iconEl.className =
              "sec-timeline-node-icon w-7 h-7 rounded-full bg-slate-100 border border-slate-200 text-slate-400 font-semibold text-xs flex items-center justify-center shrink-0 transition-all duration-500";
            iconEl.innerHTML = String(stepNum);
          }
          if (labelEl)
            labelEl.className =
              "text-xs sm:text-sm font-medium text-slate-400 sec-timeline-label transition-colors";
          if (subEl) {
            subEl.classList.add("hidden");
            subEl.innerHTML = "";
          }
        }
      });

      const data = stepData[currentStep - 1];
      if (statusBadge && data) {
        statusBadge.className =
          "inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold border transition-all duration-300 " +
          data.badgeClass;
        statusBadge.innerHTML =
          '<span class="w-1.5 h-1.5 rounded-full mr-1.5 animate-pulse ' +
          data.dotClass +
          '"></span>' +
          data.badgeText;
      }
    }

    function advanceStep() {
      const next = currentStep >= 6 ? 1 : currentStep + 1;
      renderStep(next);
      const delay = next === 6 ? 3500 : 1600;
      timer = setTimeout(advanceStep, delay);
    }

    steps.forEach((sEl, idx) => {
      sEl.addEventListener("click", () => {
        clearTimeout(timer);
        renderStep(idx + 1);
        timer = setTimeout(advanceStep, 2600);
      });
    });

    renderStep(1);
    timer = setTimeout(advanceStep, 1600);
  }

  // Lifecycle listeners
  function initAll() {
    initSecurityHorizontalScroll();
    initKybBookExperience();
    initSecurityTraceabilityTimeline();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  document.addEventListener('astro:page-load', initAll);
</script>

