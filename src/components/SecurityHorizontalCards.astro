---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const cards = [
  {
    step: "01",
    eyebrow: "VERIFICACIÓN DE PERFIL Y KYB",
    title: "VALIDACIÓN EMPRESARIAL",
    description: "Revisión previa de personería jurídica, directores y actividad comercial para habilitar una operación internacional con pleno respaldo y alineada a políticas de prevención.",
    specs: [
      { label: "CATEGORÍA", value: "COMPLIANCE Y PREVENCIÓN CORPORATIVA" },
      { label: "VERIFICACIÓN", value: "PERSONERÍA JURÍDICA Y BENEFICIARIOS FINALES" },
      { label: "DOCUMENTACIÓN", value: "REGISTRO MERCANTIL Y PODERES LEGALES" },
      { label: "ALCANCE", value: "BOLIVIA (BO) Y ESTADOS UNIDOS (US)" },
      { label: "CRITERIO", value: "ELEGIBILIDAD POR PERFIL EMPRESARIAL" }
    ],
    ctaPrimary: "SOLICITAR DEMO",
    ctaPrimaryHref: "/demo/",
    ctaSecondary: "CONTACTAR",
    ctaSecondaryHref: "/contacto/",
    mockType: "kyb"
  },
  {
    step: "02",
    eyebrow: "MONITOREO Y CONCILIACIÓN OPERATIVA",
    title: "TRAZABILIDAD Y CONTROL",
    description: "Visibilidad integral sobre cada movimiento y flujo empresarial, con respaldo documental descargable y seguimiento de estado en tiempo real.",
    specs: [
      { label: "CATEGORÍA", value: "SEGUIMIENTO Y CONTROL TRANSACCIONAL" },
      { label: "TRAZABILIDAD", value: "TIMELINE EN VIVO POR OPERACIÓN" },
      { label: "RESPALDOS", value: "COMPROBANTES SWIFT, FEDWIRE Y FACTURAS" },
      { label: "AUDITORÍA", value: "HISTORIAL EXPORTABLE Y CONCILIABLE" },
      { label: "ALCANCE", value: "OPERACIONES TRANSFRONTERIZAS B2B" }
    ],
    ctaPrimary: "SOLICITAR DEMO",
    ctaPrimaryHref: "/demo/",
    ctaSecondary: "CONTACTAR",
    ctaSecondaryHref: "/contacto/",
    mockType: "trace"
  },
  {
    step: "03",
    eyebrow: "INFRAESTRUCTURA DE SEGURIDAD",
    title: "CONTROLES DE ACCESO",
    description: "Capas avanzadas de protección tecnológica, autenticación multifactor y roles diferenciados para resguardar la información sensible de cada empresa.",
    specs: [
      { label: "CATEGORÍA", value: "SEGURIDAD TECNOLÓGICA Y CIFRADO" },
      { label: "CIFRADO", value: "TLS 1.3 EN TRÁNSITO / AES-256 EN REPOSO" },
      { label: "AUTENTICACIÓN", value: "DOBLE FACTOR (2FA / TOTP) OBLIGATORIO" },
      { label: "JERARQUÍA", value: "ROLES SEGREGADOS (OPERADOR / FIRMANTE)" },
      { label: "PROTECCIÓN", value: "ENTORNO DE DATOS ESTRUCTURADO Y AISLADO" }
    ],
    ctaPrimary: "SOLICITAR DEMO",
    ctaPrimaryHref: "/demo/",
    ctaSecondary: "CONTACTAR",
    ctaSecondaryHref: "/contacto/",
    mockType: "access"
  },
  {
    step: "04",
    eyebrow: "CONECTIVIDAD FINANCIERA INSTITUCIONAL",
    title: "INFRAESTRUCTURA Y RIELES",
    description: "Software empresarial conectado a rieles bancarios globales y partners tecnológicos autorizados en EE.UU. para máxima solidez operativa.",
    specs: [
      { label: "CATEGORÍA", value: "INFRAESTRUCTURA B2B MULTI-RIEL" },
      { label: "PLATAFORMA", value: "GUIRA SYSTEM LLC (ESTADOS UNIDOS)" },
      { label: "CUSTODIA Y FONDOS", value: "PARTNER TECNOLÓGICO LICENCIADO EN EE.UU." },
      { label: "RIELES BANCARIOS", value: "FEDWIRE, ACH Y TRANSFERENCIAS SWIFT" },
      { label: "ASESORÍA LOCAL", value: "GUIRAGLOBAL SRL (BOLIVIA)" }
    ],
    ctaPrimary: "SOLICITAR DEMO",
    ctaPrimaryHref: "/demo/",
    ctaSecondary: "CONTACTAR",
    ctaSecondaryHref: "/contacto/",
    mockType: "infra"
  }
];
---

<section 
  id="security-horizontal-section" 
  class={`security-horizontal-pin relative w-full overflow-hidden bg-white text-slate-900 border-b border-slate-200 ${className}`}
>
  <!-- Top Sticky Progress Bar (Standard max-w-7xl Container) -->
  <div class="sticky top-0 z-30 w-full bg-white/95 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-guira-teal animate-pulse"></span>
        <span class="text-xs font-mono uppercase tracking-wider text-slate-700 font-bold">Pilares de Seguridad y Control Operativo</span>
      </div>

      <!-- Progress Indicator Dots & Counter -->
      <div class="flex items-center gap-2" id="security-progress-dots">
        {cards.map((_, i) => (
          <span 
            class={`progress-dot h-1.5 rounded-full transition-all duration-300 ${i === 0 ? "w-8 bg-guira-teal" : "w-2 bg-slate-300"}`}
            data-step={i}
          ></span>
        ))}
        <span class="ml-2 text-xs font-mono text-slate-600 font-bold" id="security-step-counter">01 / 04</span>
      </div>
    </div>
  </div>

  <!-- Horizontal Scroll Viewport Container -->
  <div class="horizontal-track flex flex-col lg:flex-row h-auto lg:h-[calc(100vh-55px)] w-full lg:w-[400vw] will-change-transform z-10 relative">
    {cards.map((card, index) => (
      <div 
        class="horizontal-card w-full lg:w-screen lg:min-w-[100vw] lg:max-w-[100vw] h-auto min-h-[90vh] lg:min-h-0 lg:h-full flex items-center justify-center shrink-0 relative box-border border-b lg:border-b-0 lg:border-r border-slate-200 bg-white py-12 lg:py-0"
        data-index={index}
      >
        <div class="max-w-7xl mx-auto px-6 w-full relative z-10">
          <div class="grid lg:grid-cols-12 gap-8 lg:gap-14 items-center">
            
            <!-- Formal Specification Column (Exact Style from Reference) -->
            <div class="lg:col-span-7 text-left space-y-4">
              
              <!-- Big Clean Header -->
              <div>
                <div class="text-xs md:text-sm font-mono font-bold tracking-widest text-slate-500 uppercase mb-1">
                  {card.eyebrow}
                </div>
                <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight leading-none uppercase">
                  {card.title}
                </h2>
              </div>

              <!-- Description -->
              <p class="text-sm md:text-base text-slate-600 leading-relaxed font-normal pt-1 pb-2">
                {card.description}
              </p>

              <!-- Formal Specification Table (Hairline horizontal dividers) -->
              <div class="border-t border-b border-slate-900/80 divide-y divide-slate-200">
                {card.specs.map((spec) => (
                  <div class="grid grid-cols-12 py-2.5 md:py-3 gap-2 items-center text-xs md:text-[13px]">
                    <div class="col-span-4 font-mono font-semibold text-slate-500 uppercase tracking-wider">
                      {spec.label}
                    </div>
                    <div class="col-span-8 font-bold text-slate-900 uppercase tracking-tight">
                      {spec.value}
                    </div>
                  </div>
                ))}
              </div>

              <!-- Action Buttons (Formal Dark Block Style) -->
              <div class="flex items-center gap-3 pt-3">
                <a
                  href={card.ctaPrimaryHref}
                  class="inline-flex items-center justify-center px-6 py-2.5 rounded-sm bg-slate-900 text-white hover:bg-slate-800 text-xs font-bold uppercase tracking-wider transition-colors shadow-sm"
                >
                  {card.ctaPrimary}
                </a>
                <a
                  href={card.ctaSecondaryHref}
                  class="inline-flex items-center justify-center px-6 py-2.5 rounded-sm border border-slate-300 hover:border-slate-400 bg-white text-slate-800 text-xs font-bold uppercase tracking-wider transition-colors"
                >
                  {card.ctaSecondary}
                </a>
              </div>

            </div>

          <!-- Visual / UI Mockup Column (Light Mode Enterprise Cards) -->
          <div class="lg:col-span-5 w-full flex items-center justify-center">
            
            {card.mockType === "kyb" && (
              <div class="kyb-book-wrapper w-full max-w-lg select-none relative" id="kyb-book-experience">
                
                <!-- Main Book / Hardcover Ledger Container -->
                <div class="relative w-full rounded-2xl bg-white border border-slate-300/90 shadow-2xl p-3 md:p-4 overflow-hidden">
                  
                  <!-- Top Minimalist Book Header Bar -->
                  <div class="flex items-center justify-between px-2 pb-2.5 mb-2.5 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-guira-teal animate-pulse"></span>
                      <span class="text-[10px] font-mono font-bold tracking-widest text-slate-800 uppercase">EXPEDIENTE KYB · GUIRA SYSTEM</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class="text-[10px] font-mono text-slate-500 font-bold" id="kyb-book-page-indicator">PAG. 01 / 05</span>
                      <div class="flex items-center gap-1 border border-slate-200 rounded p-0.5 bg-slate-50">
                        <button type="button" class="kyb-nav-prev w-5 h-5 rounded flex items-center justify-center text-slate-600 hover:text-slate-900 hover:bg-white transition-colors" title="Página anterior" id="kyb-btn-prev">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
                        </button>
                        <button type="button" class="kyb-nav-next w-5 h-5 rounded flex items-center justify-center text-slate-600 hover:text-slate-900 hover:bg-white transition-colors" title="Página siguiente" id="kyb-btn-next">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- Open Book Dual-Page Stage -->
                  <div class="grid grid-cols-12 gap-0 relative bg-slate-50/80 rounded-xl border border-slate-200/90 overflow-hidden min-h-[300px] md:min-h-[320px]">
                    
                    <!-- LEFT PAGE: Fixed Index & Compliance Checklist -->
                    <div class="col-span-5 p-3 md:p-3.5 bg-white border-r border-slate-200/80 flex flex-col justify-between relative shadow-[inset_-8px_0_12px_rgba(0,0,0,0.02)]">
                      <div>
                        <div class="text-[9px] font-mono font-bold uppercase tracking-wider text-slate-400 mb-0.5">ESTRUCTURA</div>
                        <div class="text-[11px] font-black text-slate-900 uppercase tracking-tight mb-2.5">REQUISITOS BOLIVIA</div>
                        
                        <!-- Checklist items connected with active index -->
                        <div class="space-y-1" id="kyb-index-list">
                          <div class="kyb-index-item is-active flex items-center justify-between p-1.5 rounded text-[10px] transition-all cursor-pointer bg-slate-900 text-white font-semibold" data-index="0">
                            <div class="flex items-center gap-1.5 truncate">
                              <span class="w-1.5 h-1.5 rounded-full bg-guira-teal item-dot"></span>
                              <span class="truncate">1. Matrícula SEPREC</span>
                            </div>
                            <span class="text-[8px] font-mono uppercase tracking-tighter opacity-80">01</span>
                          </div>
                          <div class="kyb-index-item flex items-center justify-between p-1.5 rounded text-[10px] transition-all cursor-pointer text-slate-600 hover:bg-slate-100" data-index="1">
                            <div class="flex items-center gap-1.5 truncate">
                              <span class="w-1.5 h-1.5 rounded-full bg-slate-300 item-dot"></span>
                              <span class="truncate">2. Cédula Identidad</span>
                            </div>
                            <span class="text-[8px] font-mono uppercase tracking-tighter text-slate-400">02</span>
                          </div>
                          <div class="kyb-index-item flex items-center justify-between p-1.5 rounded text-[10px] transition-all cursor-pointer text-slate-600 hover:bg-slate-100" data-index="2">
                            <div class="flex items-center gap-1.5 truncate">
                              <span class="w-1.5 h-1.5 rounded-full bg-slate-300 item-dot"></span>
                              <span class="truncate">3. Certificado NIT</span>
                            </div>
                            <span class="text-[8px] font-mono uppercase tracking-tighter text-slate-400">03</span>
                          </div>
                          <div class="kyb-index-item flex items-center justify-between p-1.5 rounded text-[10px] transition-all cursor-pointer text-slate-600 hover:bg-slate-100" data-index="3">
                            <div class="flex items-center gap-1.5 truncate">
                              <span class="w-1.5 h-1.5 rounded-full bg-slate-300 item-dot"></span>
                              <span class="truncate">4. Factura Luz/Agua</span>
                            </div>
                            <span class="text-[8px] font-mono uppercase tracking-tighter text-slate-400">04</span>
                          </div>
                          <div class="kyb-index-item flex items-center justify-between p-1.5 rounded text-[10px] transition-all cursor-pointer text-slate-600 hover:bg-slate-100" data-index="4">
                            <div class="flex items-center gap-1.5 truncate">
                              <span class="w-1.5 h-1.5 rounded-full bg-slate-300 item-dot"></span>
                              <span class="truncate">5. Respaldo Fondos</span>
                            </div>
                            <span class="text-[8px] font-mono uppercase tracking-tighter text-slate-400">05</span>
                          </div>
                        </div>
                      </div>

                      <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-[8px] font-mono text-slate-400 uppercase">COTEJO</span>
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 text-[8px] font-mono font-bold border border-emerald-200">
                          <span class="w-1 h-1 rounded-full bg-emerald-500"></span> AUDITABLE
                        </span>
                      </div>
                    </div>

                    <!-- CENTER SPINE / FOLD CREASE (Sombra realista de lomo central) -->
                    <div class="absolute left-[41.666667%] top-0 bottom-0 w-2 -ml-1 z-30 pointer-events-none bg-gradient-to-r from-black/10 via-black/5 to-transparent"></div>

                    <!-- Laser Scan Beam Effect -->
                    <div class="kyb-scan-beam absolute right-0 w-[58.333333%] h-0.5 bg-gradient-to-r from-cyan-400 via-guira-teal to-cyan-300 z-40 pointer-events-none opacity-0"></div>

                    <!-- RIGHT PAGE: Turning 3D Book Page Deck -->
                    <div class="col-span-7 p-2.5 md:p-3 bg-[#fafbfa] relative flex items-center justify-center [perspective:1400px]" id="kyb-book-pages-container">
                      
                      <!-- Page 1: Registro Comercial SEPREC -->
                      <div class="kyb-book-leaf is-active absolute inset-2 rounded-lg bg-white border border-slate-200/90 p-3 flex flex-col justify-between shadow-md" data-doc-index="0">
                        <div>
                          <div class="flex items-center justify-between border-b border-slate-200 pb-1.5 mb-2">
                            <div class="flex items-center gap-1.5">
                              <div class="w-5 h-5 rounded bg-blue-50 border border-blue-200 flex items-center justify-center text-guira-teal text-[10px]">
                                <i data-lucide="building-2" class="w-3 h-3"></i>
                              </div>
                              <div>
                                <div class="text-[10px] font-bold text-slate-900 leading-none">MATRÍCULA SEPREC</div>
                                <div class="text-[8px] font-mono text-slate-400">REGISTRO MERCANTIL</div>
                              </div>
                            </div>
                            <span class="text-[8px] font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded">VÁLIDO 2026</span>
                          </div>
                          <div class="space-y-1.5 text-[9px] text-slate-600">
                            <div class="flex justify-between py-0.5 border-b border-slate-100">
                              <span class="text-slate-400">Razón Social:</span>
                              <span class="font-bold text-slate-900">EMPRESA CORP S.R.L.</span>
                            </div>
                            <div class="flex justify-between py-0.5 border-b border-slate-100">
                              <span class="text-slate-400">Matrícula:</span>
                              <span class="font-mono font-bold text-slate-900">00482910-BOL</span>
                            </div>
                            <div class="flex justify-between py-0.5">
                              <span class="text-slate-400">Actividad:</span>
                              <span class="font-semibold text-slate-700">Comercio B2B y Servicios</span>
                            </div>
                          </div>
                        </div>
                        <div class="pt-1.5 border-t border-slate-100 flex items-center justify-between text-[8px] text-slate-400">
                          <span class="flex items-center gap-1 text-emerald-600 font-semibold"><i data-lucide="check-circle-2" class="w-2.5 h-2.5 text-emerald-500"></i> Personería Aprobada</span>
                          <span class="font-mono text-slate-500">HOJA 01</span>
                        </div>
                      </div>

                      <!-- Page 2: Carnet de Identidad -->
                      <div class="kyb-book-leaf is-next absolute inset-2 rounded-lg bg-white border border-slate-200/90 p-3 flex flex-col justify-between shadow-md" data-doc-index="1">
                        <div>
                          <div class="flex items-center justify-between border-b border-slate-200 pb-1.5 mb-2">
                            <div class="flex items-center gap-1.5">
                              <div class="w-5 h-5 rounded bg-blue-50 border border-blue-200 flex items-center justify-center text-guira-teal text-[10px]">
                                <i data-lucide="contact-2" class="w-3 h-3"></i>
                              </div>
                              <div>
                                <div class="text-[10px] font-bold text-slate-900 leading-none">CÉDULA DE IDENTIDAD</div>
                                <div class="text-[8px] font-mono text-slate-400">REPRESENTANTE LEGAL</div>
                              </div>
                            </div>
                            <span class="text-[8px] font-mono font-bold bg-blue-50 text-blue-700 border border-blue-200 px-1.5 py-0.5 rounded">BIOMETRÍA</span>
                          </div>
                          <div class="flex gap-2 items-center py-1">
                            <div class="w-9 h-11 rounded bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 shrink-0">
                              <i data-lucide="user" class="w-4 h-4"></i>
                            </div>
                            <div class="space-y-0.5 text-[9px] text-slate-600 flex-1">
                              <div class="font-bold text-slate-900">REPRESENTANTE LEGAL</div>
                              <div class="text-[8px] font-mono text-slate-500">C.I. 6839201 LP</div>
                              <div class="text-[8px] text-emerald-600 font-semibold flex items-center gap-0.5">
                                <i data-lucide="scan" class="w-2 h-2"></i> Facial aprobado
                              </div>
                            </div>
                          </div>
                        </div>
                        <div class="pt-1.5 border-t border-slate-100 flex items-center justify-between text-[8px] text-slate-400">
                          <span class="flex items-center gap-1 text-emerald-600 font-semibold"><i data-lucide="check-circle-2" class="w-2.5 h-2.5 text-emerald-500"></i> Poder Notariado</span>
                          <span class="font-mono text-slate-500">HOJA 02</span>
                        </div>
                      </div>

                      <!-- Page 3: Certificado NIT -->
                      <div class="kyb-book-leaf is-next absolute inset-2 rounded-lg bg-white border border-slate-200/90 p-3 flex flex-col justify-between shadow-md" data-doc-index="2">
                        <div>
                          <div class="flex items-center justify-between border-b border-slate-200 pb-1.5 mb-2">
                            <div class="flex items-center gap-1.5">
                              <div class="w-5 h-5 rounded bg-blue-50 border border-blue-200 flex items-center justify-center text-guira-teal text-[10px]">
                                <i data-lucide="file-check-2" class="w-3 h-3"></i>
                              </div>
                              <div>
                                <div class="text-[10px] font-bold text-slate-900 leading-none">CERTIFICADO DE NIT</div>
                                <div class="text-[8px] font-mono text-slate-400">PADRÓN TRIBUTARIO</div>
                              </div>
                            </div>
                            <span class="text-[8px] font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded">ACTIVO</span>
                          </div>
                          <div class="space-y-1.5 text-[9px] text-slate-600">
                            <div class="flex justify-between py-0.5 border-b border-slate-100">
                              <span class="text-slate-400">NIT No.:</span>
                              <span class="font-mono font-bold text-slate-900">309482019012</span>
                            </div>
                            <div class="flex justify-between py-0.5 border-b border-slate-100">
                              <span class="text-slate-400">Régimen:</span>
                              <span class="font-semibold text-slate-800">General - Graco</span>
                            </div>
                            <div class="flex justify-between py-0.5">
                              <span class="text-slate-400">Estado Fiscal:</span>
                              <span class="font-bold text-emerald-600">Habilitado</span>
                            </div>
                          </div>
                        </div>
                        <div class="pt-1.5 border-t border-slate-100 flex items-center justify-between text-[8px] text-slate-400">
                          <span class="flex items-center gap-1 text-emerald-600 font-semibold"><i data-lucide="check-circle-2" class="w-2.5 h-2.5 text-emerald-500"></i> QR Autenticado</span>
                          <span class="font-mono text-slate-500">HOJA 03</span>
                        </div>
                      </div>

                      <!-- Page 4: Factura de Luz o Agua -->
                      <div class="kyb-book-leaf is-next absolute inset-2 rounded-lg bg-white border border-slate-200/90 p-3 flex flex-col justify-between shadow-md" data-doc-index="3">
                        <div>
                          <div class="flex items-center justify-between border-b border-slate-200 pb-1.5 mb-2">
                            <div class="flex items-center gap-1.5">
                              <div class="w-5 h-5 rounded bg-blue-50 border border-blue-200 flex items-center justify-center text-guira-teal text-[10px]">
                                <i data-lucide="home" class="w-3 h-3"></i>
                              </div>
                              <div>
                                <div class="text-[10px] font-bold text-slate-900 leading-none">DOMICILIO FISCAL</div>
                                <div class="text-[8px] font-mono text-slate-400">FACTURA LUZ / AGUA</div>
                              </div>
                            </div>
                            <span class="text-[8px] font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded">UBICADO</span>
                          </div>
                          <div class="space-y-1.5 text-[9px] text-slate-600">
                            <div class="flex justify-between py-0.5 border-b border-slate-100">
                              <span class="text-slate-400">Suministro:</span>
                              <span class="font-mono font-bold text-slate-900">CRE / DELAPAZ</span>
                            </div>
                            <div class="flex justify-between py-0.5 border-b border-slate-100">
                              <span class="text-slate-400">Dirección:</span>
                              <span class="font-semibold text-slate-800">Av. San Martín, Edif. Platinum</span>
                            </div>
