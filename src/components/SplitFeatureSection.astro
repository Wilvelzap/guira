---
import KineticButton from './KineticButton.astro';

export interface FeatureActionCard {
  icon?: string;
  iconBgClass?: string;
  title: string;
  description: string;
  button?: {
    href: string;
    label: string;
    variant?: 'teal' | 'dark' | 'outline' | 'white';
    size?: 'sm' | 'md' | 'lg';
  };
}

export interface Props {
  /**
   * Preset visual: 'light' (fondo blanco con acentos teal) o 'dark' (fondo oscuro con acentos cian)
   * @default 'light'
   */
  theme?: 'light' | 'dark';
  /**
   * Texto kicker de la barra superior (ej. "Qué puedes hacer")
   */
  kicker?: string;
  /**
   * Texto o etiqueta mono a la derecha de la barra superior (ej. "FLUIDEZ OPERATIVA B2B")
   */
  topBadge?: string;
  /**
   * Titular principal de la columna izquierda
   */
  title?: string;
  /**
   * Bajada o párrafo descriptivo bajo el titular
   */
  description?: string;
  /**
   * Si muestra el sello circular giratorio de marca
   * @default true
   */
  showStamp?: boolean;
  /**
   * Texto circular del sello
   * @default 'GUIRA EMPRESAS · OPERACIÓN EN DÓLARES ·'
   */
  stampText?: string;
  /**
   * Icono Lucide en el centro del sello
   * @default 'shield-check'
   */
  stampIcon?: string;
  /**
   * Texto de insignia en el centro del sello
   * @default 'B2B'
   */
  stampBadge?: string;
  /**
   * Lista de tarjetas de acción para la columna derecha
   */
  features?: FeatureActionCard[];
  /**
   * Clase personalizada de fondo para la sección (ej. "bg-slate-900", "bg-guira-navy")
   */
  bgClass?: string;
  /**
   * Clase personalizada de bordes (ej. "border-b border-slate-200")
   */
  borderClass?: string;
  /**
   * Clases CSS adicionales para la sección
   */
  class?: string;
  /**
   * ID de anclaje de la sección
   */
  id?: string;
  /**
   * Si incluye data-stack-section para StackedSections (por defecto true)
   */
  dataStackSection?: boolean;
  /**
   * Si muestra resplandor ambiental sutil de fondo (por defecto true)
   */
  showGlows?: boolean;
}

const {
  theme = 'light',
  kicker = 'Qué puedes hacer',
  topBadge = 'FLUIDEZ OPERATIVA B2B',
  title = '',
  description = '',
  showStamp = true,
  stampText = 'GUIRA EMPRESAS · OPERACIÓN EN DÓLARES ·',
  stampIcon = 'shield-check',
  stampBadge = 'B2B',
  features = [],
  bgClass,
  borderClass,
  class: className = '',
  id,
  dataStackSection = true,
  showGlows = true,
} = Astro.props;

const isDark = theme === 'dark';

// Configuración de estilos según el tema
const sectionBg = bgClass ?? (isDark ? 'bg-guira-dark text-white' : 'bg-white text-slate-900');
const sectionBorder = borderClass ?? (isDark ? 'border-b border-slate-800' : 'border-b border-slate-200');
const kickerColor = isDark ? 'text-guira-cyan' : 'text-guira-teal';
const topBarBorder = isDark ? 'border-slate-800' : 'border-slate-200';
const titleColor = isDark ? 'text-white' : 'text-slate-900';
const descColor = isDark ? 'text-slate-400' : 'text-slate-600';
const rightDividerColor = isDark ? 'divide-slate-800' : 'divide-slate-200';
const cardTitleColor = isDark ? 'text-white group-hover:text-guira-cyan' : 'text-slate-900 group-hover:text-guira-teal';
const cardDescColor = isDark ? 'text-slate-400' : 'text-slate-600';
const stampTextColor = isDark ? 'fill-slate-400' : 'fill-slate-500';
const stampIconColor = isDark ? 'text-guira-cyan' : 'text-guira-teal';
const stampBadgeColor = isDark ? 'text-white' : 'text-slate-900';

// ID único para el path SVG del sello circular
const stampPathId = `splitStampPath-${Math.random().toString(36).substring(2, 9)}`;

// Helper para clases de icono por defecto si no se especifican
function getDefaultIconBgClass(idx: number, dark: boolean): string {
  if (dark) {
    return 'bg-slate-900 border border-slate-700 text-guira-cyan shadow-cyan-500/5 group-hover:border-guira-cyan';
  }
  return idx % 2 === 0
    ? 'bg-teal-50 border border-teal-200 text-guira-teal shadow-teal-500/5 group-hover:border-guira-teal'
    : 'bg-blue-50 border border-blue-200 text-guira-teal shadow-blue-500/5 group-hover:border-guira-teal';
}
---

<section
  id={id}
  data-stack-section={dataStackSection ? '' : undefined}
  class={`py-20 lg:py-28 ${sectionBg} ${sectionBorder} relative overflow-hidden ${className}`}
>
  {showGlows && (
    <div
      class={`pointer-events-none absolute right-0 bottom-0 w-[500px] h-[500px] ${isDark ? 'bg-guira-cyan/10' : 'bg-guira-teal/5'} rounded-full blur-3xl`}
      aria-hidden="true"
    />
  )}

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <!-- Barra superior con kicker y línea separadora -->
    {(kicker || topBadge) && (
      <div class="reveal mb-12 lg:mb-16">
        <div class={`flex items-center justify-between pb-4 border-b ${topBarBorder}`}>
          {kicker && (
            <p class={`section-kicker ${kickerColor} text-xs sm:text-sm font-bold tracking-widest uppercase m-0`}>
              {kicker}
            </p>
          )}
          {topBadge && (
            <span class="font-mono text-xs text-slate-400 tracking-wider hidden sm:inline-block">
              {topBadge}
            </span>
          )}
        </div>
      </div>
    )}

    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Columna Izquierda: Título, Sello Circular y Descripción -->
      <div class="lg:col-span-5 reveal">
        {showStamp && (
          <div class="relative w-28 h-28 sm:w-36 sm:h-36 shrink-0 mb-8 select-none">
            <svg
              class="w-full h-full animate-[spin_30s_linear_infinite]"
              viewBox="0 0 160 160"
              aria-hidden="true"
            >
              <path
                id={stampPathId}
                d="M 80, 80 m -56, 0 a 56,56 0 1,1 112,0 a 56,56 0 1,1 -112,0"
                fill="none"
              />
              <text
                class={`text-[10px] uppercase tracking-[0.22em] font-extrabold ${stampTextColor}`}
              >
                <textPath href={`#${stampPathId}`} startOffset="0%">
                  {stampText}
                </textPath>
              </text>
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
              {stampIcon && (
                <i
                  data-lucide={stampIcon}
                  class={`w-6 h-6 sm:w-7 sm:h-7 ${stampIconColor} mb-0.5`}
                />
              )}
              {stampBadge && (
                <span class={`font-mono font-black text-[10px] tracking-widest ${stampBadgeColor} uppercase`}>
                  {stampBadge}
                </span>
              )}
            </div>
          </div>
        )}

        {title && (
          <h2 class={`text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight ${titleColor} leading-[1.1]`}>
            {title}
          </h2>
        )}

        {description && (
          <p class={`mt-6 ${descColor} text-base sm:text-lg font-medium leading-relaxed max-w-lg`}>
            {description}
          </p>
        )}

        <slot name="left" />
      </div>

      <!-- Columna Derecha: Tarjetas de Acción con Iconos y Botones -->
      <div class={`lg:col-span-7 reveal reveal-delay-1 flex flex-col ${rightDividerColor} divide-y`}>
        {features.length > 0 ? (
          features.map((feature, idx) => {
            const iconBg = feature.iconBgClass || getDefaultIconBgClass(idx, isDark);
            const isFirst = idx === 0;
            const paddingClass = isFirst ? 'pb-10 sm:pb-12' : 'pt-10 sm:pt-12';

            return (
              <div class={`flex flex-col sm:flex-row gap-6 sm:gap-8 items-start ${paddingClass} group`}>
                {feature.icon && (
                  <div
                    class={`w-16 h-16 sm:w-20 sm:h-20 rounded-2xl flex items-center justify-center shrink-0 shadow-lg group-hover:scale-105 transition-all duration-300 ${iconBg}`}
                  >
                    <i data-lucide={feature.icon} class="w-8 h-8 sm:w-9 sm:h-9" />
                  </div>
                )}
                <div class="flex-1">
                  <h3 class={`text-base sm:text-lg font-extrabold uppercase tracking-wider ${cardTitleColor} mb-3 transition-colors`}>
                    {feature.title}
                  </h3>
                  <p class={`text-sm sm:text-base font-medium ${cardDescColor} leading-relaxed mb-6`}>
                    {feature.description}
                  </p>
                  {feature.button && (
                    <KineticButton
                      href={feature.button.href}
                      variant={feature.button.variant || (idx === 0 ? 'teal' : 'dark')}
                      size={feature.button.size || 'md'}
                      label={feature.button.label}
                    />
                  )}
                </div>
              </div>
            );
          })
        ) : (
          <slot />
        )}
      </div>
    </div>
  </div>
</section>
