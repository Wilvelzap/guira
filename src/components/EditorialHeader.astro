---
export interface Props {
  /** Texto del kicker o categoría superior (ej: "Cómo empezar") */
  kicker?: string;
  /** Primera línea monumental del título (alto contraste, ej: "El proceso,") */
  line1?: string;
  /** Segunda línea monumental del título (tono atenuado, ej: "paso a paso.") */
  line2?: string;
  /** Opcional: Título en una sola línea si no se divide en dos */
  title?: string;
  /** Párrafo descriptivo asimétrico */
  description?: string;
  /** Nivel del tag HTML de encabezado: 'h1' | 'h2' | 'h3'. Default: 'h2' */
  as?: 'h1' | 'h2' | 'h3';
  /** Tema de color: 'light' (fondo blanco) o 'dark' (fondo oscuro). Default: 'light' */
  theme?: 'light' | 'dark';
  /** Si debe incluir la clase `reveal` para animación de scroll. Default: true */
  reveal?: boolean;
  /** Clases CSS adicionales para el contenedor */
  class?: string;
  /** Margen inferior. Default: 'mb-16 sm:mb-20 md:mb-24' */
  marginBottom?: string;
}

const {
  kicker,
  line1,
  line2,
  title,
  description,
  as: Tag = 'h2',
  theme = 'light',
  reveal = true,
  class: className = '',
  marginBottom = 'mb-16 sm:mb-20 md:mb-24',
  ...rest
} = Astro.props;

const isDark = theme === 'dark';
---

<div
  class:list={[
    marginBottom,
    reveal && 'reveal',
    className,
  ]}
  {...rest}
>
  {kicker && (
    <div class="mb-4 sm:mb-6">
      <span
        class:list={[
          "inline-flex items-center gap-2 text-xs sm:text-sm font-bold tracking-widest uppercase select-none",
          isDark ? "text-guira-cyan" : "text-guira-teal"
        ]}
      >
        <span
          class:list={[
            "w-1.5 h-1.5 rounded-full",
            isDark ? "bg-guira-cyan" : "bg-guira-teal"
          ]}
        ></span>
        {kicker}
      </span>
    </div>
  )}

  <Tag
    class="text-4xl sm:text-6xl md:text-7xl lg:text-[76px] xl:text-[88px] font-black uppercase tracking-tight leading-[0.95] text-left select-none"
  >
    {line1 && (
      <span class:list={[isDark ? "text-white" : "text-slate-900", "block"]}>
        {line1}
      </span>
    )}
    {line2 && (
      <span class:list={[isDark ? "text-slate-500" : "text-slate-400", "block"]}>
        {line2}
      </span>
    )}
    {!line1 && !line2 && title && (
      <span class:list={[isDark ? "text-white" : "text-slate-900", "block"]}>
        {title}
      </span>
    )}
  </Tag>

  {(description || Astro.slots.has('default')) && (
    <div class="mt-8 sm:mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
      <div class="hidden md:block md:col-span-5 lg:col-span-6">
        <!-- Espacio de balance editorial -->
      </div>
      <div class="md:col-span-7 lg:col-span-6">
        {description && (
          <p
            class:list={[
              "text-base sm:text-lg md:text-xl font-medium leading-relaxed max-w-xl md:ml-auto text-left",
              isDark ? "text-slate-300" : "text-slate-600"
            ]}
          >
            {description}
          </p>
        )}
        <slot />
      </div>
    </div>
  )}
</div>
