---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`security-hero-container relative w-full max-w-[580px] lg:max-w-[680px] aspect-square mx-auto flex items-center justify-center select-none ${className}`}>
  <!-- Decorative Ambient Glow in Background -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-80 h-80 md:w-[480px] md:h-[480px] rounded-full bg-gradient-to-tr from-sky-400/15 via-blue-500/10 to-teal-400/15 blur-3xl transform scale-125"></div>
  </div>

  <!-- Dynamic Cipher Matrix Canvas (Seamless, large-scale, high-res) -->
  <canvas 
    id="security-cipher-canvas" 
    class="absolute inset-0 w-full h-full pointer-events-none z-0"
    width="1000" 
    height="1000"
    aria-hidden="true"
  ></canvas>

  <!-- Concentric Static Tech Rings -->
  <div class="absolute w-[560px] h-[560px] rounded-full border border-dashed border-slate-300/35 pointer-events-none animate-[spin_80s_linear_infinite]"></div>
  <div class="absolute w-[440px] h-[440px] rounded-full border border-slate-200/60 pointer-events-none"></div>
  <div class="absolute w-[280px] h-[280px] rounded-full border border-sky-300/40 pointer-events-none"></div>

  <!-- Expanding Pulse Wave Rings (Radar Ripples) -->
  <div class="pulse-ring ring-1 pointer-events-none"></div>
  <div class="pulse-ring ring-2 pointer-events-none"></div>
  <div class="pulse-ring ring-3 pointer-events-none"></div>
  <div class="pulse-ring ring-4 pointer-events-none"></div>

  <!-- Central Glowing Padlock Unit -->
  <div class="relative z-10 flex flex-col items-center justify-center pointer-events-none">
    <!-- Glow under lock -->
    <div class="absolute -inset-8 bg-gradient-to-r from-sky-400/35 via-blue-500/30 to-teal-400/35 rounded-full blur-2xl animate-pulse"></div>
    
    <!-- Central Padlock SVG Icon (Clean Line Art Glow) -->
    <div class="relative flex items-center justify-center transition-transform duration-700 hover:scale-105">
      <svg 
        class="w-20 h-20 md:w-24 md:h-24 lg:w-28 lg:h-28 drop-shadow-[0_4px_22px_rgba(0,81,255,0.5)]" 
        viewBox="0 0 24 24" 
        fill="none" 
        stroke="url(#hero-lock-gradient)" 
        stroke-width="1.5" 
        stroke-linecap="round" 
        stroke-linejoin="round"
      >
        <defs>
          <linearGradient id="hero-lock-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00d8ff" />
            <stop offset="50%" stop-color="#0051ff" />
            <stop offset="100%" stop-color="#0284c7" />
          </linearGradient>
        </defs>
        <!-- Shackle -->
        <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="url(#hero-lock-gradient)"></path>
        <!-- Body -->
        <rect x="3" y="11" width="18" height="11" rx="3" stroke="url(#hero-lock-gradient)"></rect>
        <!-- Keyhole -->
        <circle cx="12" cy="15.8" r="1.3" fill="#0051ff" stroke="none"></circle>
        <path d="M12 17.1V18.8" stroke="#0051ff" stroke-width="1.6"></path>
      </svg>

      <!-- Keyhole Ping Beacon Light -->
      <span class="absolute top-[65%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping opacity-80"></span>
    </div>
  </div>
</div>

<style>
  /* Concentric Expanding Pulse Rings */
  .pulse-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    border: 1.5px solid rgba(0, 150, 255, 0.45);
    background: radial-gradient(circle, rgba(0, 216, 255, 0.05) 0%, rgba(0, 81, 255, 0.02) 60%, transparent 100%);
    box-shadow: 0 0 20px rgba(0, 180, 255, 0.18);
    opacity: 0;
    pointer-events: none;
    animation: ripple-pulse 4.5s cubic-bezier(0.2, 0.8, 0.4, 1) infinite;
  }

  .ring-1 {
    animation-delay: 0s;
  }

  .ring-2 {
    animation-delay: 1.125s;
  }

  .ring-3 {
    animation-delay: 2.25s;
  }

  .ring-4 {
    animation-delay: 3.375s;
  }

  @keyframes ripple-pulse {
    0% {
      width: 90px;
      height: 90px;
      opacity: 0.9;
      border-color: rgba(0, 216, 255, 0.7);
    }
    50% {
      opacity: 0.45;
      border-color: rgba(0, 81, 255, 0.35);
    }
    100% {
      width: 660px;
      height: 660px;
      opacity: 0;
      border-color: rgba(0, 81, 255, 0);
    }
  }
</style>

<script>
  function initSecurityCipherCanvas() {
    const canvas = document.getElementById('security-cipher-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Density and character sets matching cryptographic payload from reference
    const charPool = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz#@$%&*^~_-+={}|[]:;<>?/";
    
    // Matrix dimensions (higher resolution grid)
    const cols = 48;
    const rows = 40;
    
    // Generate initial grid of characters
    const grid: { char: string; isHighlight: boolean; opacity: number }[][] = [];
    
    for (let r = 0; r < rows; r++) {
      grid[r] = [];
      for (let c = 0; c < cols; c++) {
        grid[r][c] = {
          char: charPool[Math.floor(Math.random() * charPool.length)],
          isHighlight: Math.random() < 0.08,
          opacity: 0.2 + Math.random() * 0.45
        };
      }
    }

    let animationFrameId: number;
    let tick = 0;

    function render() {
      if (!ctx || !canvas) return;
      const width = canvas.width;
      const height = canvas.height;

      ctx.clearRect(0, 0, width, height);

      const cellW = width / cols;
      const cellH = height / rows;
      const centerX = width / 2;
      const centerY = height / 2;
      const maxDist = width * 0.485;

      ctx.font = '600 13px "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      // Periodically mutate characters to create continuous active decryption effect
      tick++;
      if (tick % 3 === 0) {
        for (let i = 0; i < 24; i++) {
          const rr = Math.floor(Math.random() * rows);
          const cc = Math.floor(Math.random() * cols);
          grid[rr][cc].char = charPool[Math.floor(Math.random() * charPool.length)];
          grid[rr][cc].isHighlight = Math.random() < 0.07;
        }
      }

      // Draw each character with radial distance attenuation (radial mask)
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = c * cellW + cellW / 2;
          const y = r * cellH + cellH / 2;

          const dx = x - centerX;
          const dy = y - centerY;
          const dist = Math.sqrt(dx * dx + dy * dy);

          // Calculate radial falloff so it fades nicely towards the edge like the reference image
          if (dist > maxDist) continue;
          
          const falloff = 1 - Math.pow(dist / maxDist, 1.6);
          if (falloff <= 0) continue;

          const cell = grid[r][c];

          // Center zone around lock: slightly lighter opacity so lock stands out
          const centerZone = dist < 90 ? 0.35 : 1.0;
          const finalAlpha = cell.opacity * falloff * centerZone;

          if (cell.isHighlight) {
            // Glowing cyan/blue characters
            ctx.fillStyle = `rgba(0, 110, 255, ${Math.min(finalAlpha * 1.8, 0.95)})`;
            ctx.fillText(cell.char, x, y);
          } else {
            // Subtle dark slate characters for light mode
            ctx.fillStyle = `rgba(30, 41, 59, ${finalAlpha * 0.65})`;
            ctx.fillText(cell.char, x, y);
          }
        }
      }

      animationFrameId = requestAnimationFrame(render);
    }

    render();

    // Cleanup on navigation
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrameId);
    }, { once: true });
  }

  // Run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSecurityCipherCanvas);
  } else {
    initSecurityCipherCanvas();
  }

  // Support Astro page transitions
  document.addEventListener('astro:page-load', initSecurityCipherCanvas);
</script>