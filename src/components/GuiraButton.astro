---
import KineticButton from './KineticButton.astro';

interface Props {
  href: string;
  label: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  variant?: 'light' | 'dark' | 'teal';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  href,
  label,
  target,
  rel,
  ariaLabel = label,
  variant = 'teal',
  size = 'lg',
  class: className = ''
} = Astro.props;
---

<KineticButton
  href={href}
  label={label}
  target={target}
  rel={rel}
  ariaLabel={ariaLabel}
  variant={variant}
  size={size}
  class={className}
/>
