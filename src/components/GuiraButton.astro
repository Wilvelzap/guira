---
import KineticButton from './KineticButton.astro';

interface Props {
  href: string;
  label: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  ctaLocation?: 'hero' | 'problem' | 'benefits' | 'how_it_works' | 'documentation' | 'trust' | 'faq' | 'final_cta' | 'sticky_mobile' | 'footer';
  variant?: 'light' | 'dark' | 'teal';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  href,
  label,
  target,
  rel,
  ariaLabel = label,
  ctaLocation,
  variant = 'teal',
  size = 'lg',
  class: className = ''
} = Astro.props;
---

<KineticButton
  href={href}
  label={label}
  target={target}
  rel={rel}
  ariaLabel={ariaLabel}
  data-cta-location={ctaLocation}
  variant={variant}
  size={size}
  class={className}
/>
