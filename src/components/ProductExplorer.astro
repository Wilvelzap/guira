  .product-showcase__intro h2 { margin:0; font-size:clamp(1.75rem, 2.5vw, 2.6rem); font-weight:800; line-height:1.1; letter-spacing:-.04em; color:#0f172a; }
  .product-showcase__intro p { margin:1.25rem 0 0; color:#475569; font-size:1rem; font-weight:500; line-height:1.65; }
  .product-showcase__card { padding:clamp(1.5rem, 2.6vw, 2.5rem); border:1px solid rgba(15,23,42,.08); border-radius:1.75rem; background:linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%); color:#0f172a; text-align:left; cursor:pointer; overflow:hidden; box-shadow:0 1px 2px rgba(15,23,42,.04), 0 20px 40px -30px rgba(15,23,42,.22); transition:border-color .2s ease, box-shadow .3s ease, transform .3s ease; }
  .product-showcase__card:hover, .product-showcase__card:focus-visible { border-color:rgba(0,81,255,.35); box-shadow:0 1px 2px rgba(15,23,42,.04), 0 24px 48px -26px rgba(0,81,255,.32); outline:none; transform:translateY(-3px); }
  .product-showcase__card[aria-pressed="true"] { border-color:rgba(0,81,255,.45); box-shadow:0 0 0 3px rgba(0,81,255,.16), 0 28px 56px -30px rgba(0,81,255,.4); transform:translateY(-3px); }
  .product-showcase__icon-panel { position:relative; display:flex; align-items:center; justify-content:center; width:100%; height:14rem; margin-bottom:1.5rem; border-radius:1.25rem; overflow:hidden; background:linear-gradient(150deg, #0b1120 0%, #101c34 55%, #0b1120 100%); transition:height .35s ease, margin .35s ease; }
  .product-showcase__icon-panel::before { content:""; position:absolute; top:50%; left:50%; width:11rem; height:11rem; border-radius:999px; background:radial-gradient(circle, rgba(0,216,255,.4), rgba(0,81,255,.12) 55%, transparent 72%); filter:blur(18px); transform:translate(-50%,-50%) scale(1); transition:transform .35s ease; }
  .product-showcase__icon-panel::after { content:""; position:absolute; inset:0; opacity:.5; background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,.16) 1px, transparent 0); background-size:14px 14px; }
  .product-showcase__card[aria-pressed="true"] .product-showcase__icon-panel { height:4rem; margin-bottom:1rem; }
  .product-showcase__card[aria-pressed="true"] .product-showcase__icon-panel::before { transform:translate(-50%,-50%) scale(.4); }
  .product-showcase__icon-badge { position:relative; z-index:1; display:flex; align-items:center; justify-content:center; width:5.5rem; height:5.5rem; border-radius:999px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.16); backdrop-filter:blur(6px); transition:width .35s ease, height .35s ease; }
  .product-showcase__card[aria-pressed="true"] .product-showcase__icon-badge { width:2.75rem; height:2.75rem; }
  .product-showcase__icon { width:2.75rem; height:2.75rem; stroke-width:1.5; color:#00d8ff; transition:width .3s ease, height .3s ease; }
  .product-showcase__card[aria-pressed="true"] .product-showcase__icon { width:1.5rem; height:1.5rem; }
  .product-showcase__card h3 { margin:0; font-size:1.4rem; font-weight:800; line-height:1.25; }
  .product-showcase__card p { max-height:0; margin:0; opacity:0; overflow:hidden; color:#475569; font-size:.94rem; font-weight:500; line-height:1.65; transition:max-height .35s ease, opacity .25s ease, margin .35s ease; }
  .product-showcase__card[aria-pressed="true"] p { max-height:11rem; margin:.85rem 0 1.25rem; opacity:1; }
  .product-showcase__card ul { margin:.85rem 0 1.5rem; padding:1.1rem 0 0; border-top:1px solid #e7ecf3; list-style:none; color:#334155; font-size:.83rem; font-weight:700; line-height:1.8; }
  .product-showcase__card li + li { margin-top:.45rem; }
  .product-showcase__card li::before { content:"✓"; margin-right:.65rem; color:#0051ff; }
  .product-showcase__toggle { display:flex; align-items:center; justify-content:center; width:2.4rem; height:2.4rem; margin-top:auto; border:1px solid #dbe3ed; border-radius:999px; background:#fff; transition:border-color .2s ease, background .2s ease, box-shadow .2s ease; }
  .product-showcase__card:hover .product-showcase__toggle,
  .product-showcase__card[aria-pressed="true"] .product-showcase__toggle { border-color:#0051ff; background:linear-gradient(135deg, #0051ff, #00d8ff); box-shadow:0 8px 20px -8px rgba(0,81,255,.55); }
  .product-showcase__toggle-icon { width:1.1rem; height:1.1rem; color:#0051ff; stroke-width:2; transition:transform .3s ease, color .2s ease; }
  .product-showcase__card:hover .product-showcase__toggle-icon,
  .product-showcase__card[aria-pressed="true"] .product-showcase__toggle-icon { color:#fff; }
  .product-showcase__card[aria-pressed="true"] .product-showcase__toggle-icon { transform:rotate(45deg); }
  .product-showcase__detail { padding:0; overflow:hidden; border:0; border-radius:1.5rem; background:#e2e8f0; box-shadow:0 28px 80px -48px rgba(15,23,42,.55); }
  .product-showcase__detail:hover, .product-showcase__detail:focus-visible { background:#e2e8f0; }
  .product-showcase__detail img { width:100%; height:100%; object-fit:cover; }
  .product-showcase__hint { margin:1.2rem 0 0; color:#64748b; font-size:.875rem; font-weight:600; text-align:center; }
  .product-showcase__mobile { display:none; }
  .product-showcase__mobile-intro { padding:0 .25rem 1.5rem; }
  .product-showcase__mobile-intro h2 { margin:0; font-size:1.75rem; font-weight:800; line-height:1.15; letter-spacing:-.03em; color:#0f172a; }
  .product-showcase__mobile-intro p { margin:.85rem 0 0; color:#475569; font-size:.95rem; font-weight:500; line-height:1.6; }
  .product-showcase__mobile-list { display:flex; flex-direction:column; gap:1rem; }
  .product-showcase__mobile-item { display:block; width:100%; padding:1.25rem; border:1px solid rgba(15,23,42,.1); border-radius:1.25rem; background:#fff; text-align:left; cursor:pointer; box-shadow:0 1px 2px rgba(15,23,42,.04); }
  .product-showcase__mobile-item[aria-expanded="true"] { border-color:rgba(0,81,255,.35); box-shadow:0 8px 24px -16px rgba(0,81,255,.35); }
  .product-showcase__mobile-item-header { display:flex; align-items:center; gap:.85rem; }
  .product-showcase__mobile-icon-badge { display:flex; align-items:center; justify-content:center; width:2.75rem; height:2.75rem; flex-shrink:0; border-radius:.85rem; background:#0b1120; }
  .product-showcase__mobile-icon-badge .product-showcase__mobile-icon { width:1.35rem; height:1.35rem; color:#00d8ff; stroke-width:1.75; }
  .product-showcase__mobile-item-header h3 { flex:1; margin:0; font-size:1.05rem; font-weight:800; color:#0f172a; line-height:1.3; }
  .product-showcase__mobile-toggle { display:flex; align-items:center; justify-content:center; width:1.9rem; height:1.9rem; flex-shrink:0; border-radius:999px; border:1px solid #dbe3ed; transition:transform .25s ease, border-color .2s ease, background .2s ease; }
  .product-showcase__mobile-toggle .product-showcase__mobile-toggle-icon { width:.9rem; height:.9rem; color:#0051ff; stroke-width:2; }
  .product-showcase__mobile-item[aria-expanded="true"] .product-showcase__mobile-toggle { transform:rotate(45deg); border-color:#0051ff; background:linear-gradient(135deg, #0051ff, #00d8ff); }
  .product-showcase__mobile-item[aria-expanded="true"] .product-showcase__mobile-toggle .product-showcase__mobile-toggle-icon { color:#fff; }
  .product-showcase__mobile-item-body { max-height:0; overflow:hidden; transition:max-height .3s ease; }
  .product-showcase__mobile-item[aria-expanded="true"] .product-showcase__mobile-item-body { max-height:20rem; }
  .product-showcase__mobile-item-body p { margin:.9rem 0 0; color:#475569; font-size:.9rem; font-weight:500; line-height:1.6; }
  .product-showcase__mobile-item-body ul { margin:.75rem 0 0; padding:.75rem 0 0; border-top:1px solid #e7ecf3; list-style:none; color:#334155; font-size:.82rem; font-weight:700; line-height:1.7; }
  .product-showcase__mobile-item-body li + li { margin-top:.4rem; }
  .product-showcase__mobile-item-body li::before { content:"✓"; margin-right:.6rem; color:#0051ff; }
  @media (max-width:767px) { .product-showcase { padding:0 1rem; } .product-showcase__desktop { display:none; } .product-showcase__mobile { display:block; } }
</style>

<script>
  import { gsap } from "gsap";
  const showcase = document.querySelector("[data-product-showcase]");
  if (showcase) {
    const items = [
      { id:"usd", icon:"wallet", eyebrow:"Cuenta operativa en USD", title:"Infraestructura operativa en USD", text:"Centraliza la recepci&oacute;n de pagos desde USA al integrarte con estructuras de pago reguladas, facilitando la visibilidad de tu flujo operativo internacional de inicio a fin.", points:["Datos de recepci&oacute;n en USD", "Recepci&oacute;n de pagos desde USA"], detail:{ type:"image", src:"/assets/images/blog/dashboard-cobros-internacionales-trazabilidad.webp", alt:"Panel de cobros internacionales" } },
      { id:"payments", icon:"arrow-left-right", eyebrow:"Pagos internacionales", title:"Pagos empresariales", text:"Ejecuta pagos ACH y Wire a proveedores y partners clave en Estados Unidos con total visibilidad, orden y trazabilidad operativa.", points:["Pagos ACH y Wire transfer", "Mayor orden y trazabilidad"], detail:{ type:"image", src:"/assets/images/plataforma-dashboard-monitor.webp", alt:"Panel de pagos empresariales" } },
      { id:"routing", icon:"route", eyebrow:"Flexibilidad operativa", title:"Flexibilidad de salida", text:"Instruye transferencias seg&uacute;n la estructura aprobada hacia cuentas locales o canales digitales mediante una interfaz orientada al control documental.", points:["Opciones de enrutamiento operativo", "Soporte documental trazable por transacci&oacute;n"], detail:{ type:"image", src:"/assets/images/blog/transferencia-internacional-documentos-usd.webp", alt:"Documentos de transferencia internacional" } }
    ];
    const mobileList = showcase.querySelector("[data-product-mobile-list]");
    if (mobileList) {
      items.forEach((item) => {
        const entry = document.createElement("button"); entry.type = "button"; entry.className = "product-showcase__mobile-item"; entry.dataset.itemId = item.id; entry.setAttribute("aria-expanded", "false");
        entry.innerHTML = `<div class="product-showcase__mobile-item-header"><span class="product-showcase__mobile-icon-badge"><i data-lucide="${item.icon}" class="product-showcase__mobile-icon" aria-hidden="true"></i></span><h3>${item.title}</h3><span class="product-showcase__mobile-toggle" aria-hidden="true"><i data-lucide="plus" class="product-showcase__mobile-toggle-icon"></i></span></div><div class="product-showcase__mobile-item-body"><p>${item.text}</p><ul>${item.points.map((point) => `<li>${point}</li>`).join("")}</ul></div>`;
        entry.addEventListener("click", () => { const expanded = entry.getAttribute("aria-expanded") === "true"; entry.setAttribute("aria-expanded", String(!expanded)); });
        mobileList.append(entry);
      });
    }
    if (window.matchMedia("(min-width:768px)").matches) {
    const viewport = showcase.querySelector("[data-product-viewport]"); const track = showcase.querySelector("[data-product-track]"); const previous = showcase.querySelector("[data-product-prev]"); const next = showcase.querySelector("[data-product-next]"); const counter = showcase.querySelector("[data-product-counter]");
    const cards = new Map([["intro", track.querySelector("[data-key='intro']")]]); const scenes = Array.from({ length:Math.ceil(items.length / 2) }, (_, index) => items.slice(index * 2, index * 2 + 2)); let sceneIndex = 0; let activeId = null; let visibleKeys = []; let locked = false;
    items.forEach((item) => {
      const main = document.createElement("button"); main.type = "button"; main.className = "product-showcase__card"; main.dataset.key = `${item.id}:main`; main.dataset.itemId = item.id;
      main.innerHTML = `<div class="product-showcase__icon-panel"><span class="product-showcase__icon-badge"><i data-lucide="${item.icon}" class="product-showcase__icon" aria-hidden="true"></i></span></div><h3>${item.title}</h3><p>${item.text}</p><ul>${item.points.map((point) => `<li>${point}</li>`).join("")}</ul><span class="product-showcase__toggle" aria-hidden="true"><i data-lucide="plus" class="product-showcase__toggle-icon"></i></span>`; track.append(main); cards.set(main.dataset.key, main);
      const detail = document.createElement("button"); detail.type = "button"; detail.className = "product-showcase__card product-showcase__detail"; detail.dataset.key = `${item.id}:detail`; detail.dataset.itemId = item.id;
      detail.innerHTML = item.detail.type === "image" ? `<img src="${item.detail.src}" alt="${item.detail.alt}" loading="lazy">` : ""; track.append(detail); cards.set(detail.dataset.key, detail);
    });
    const sceneKeys = () => { const pageItems = scenes[sceneIndex]; if (!activeId) return ["intro", ...pageItems.map((item) => `${item.id}:main`)]; return pageItems.flatMap((item) => item.id === activeId ? [`${item.id}:main`, `${item.id}:detail`] : [`${item.id}:main`]); };
    const render = (immediate = false, direction = "state") => {
      const nextKeys = sceneKeys(); const viewportWidth = viewport.clientWidth; const gap = 0; const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const weights = nextKeys.map((key) => key === "intro" || key.endsWith(":detail") ? 1.65 : 1); const availableWidth = viewportWidth - Math.max(0, nextKeys.length - 1) * gap; const weightTotal = weights.reduce((total, weight) => total + weight, 0); const layout = new Map(); let cursor = 0;
      nextKeys.forEach((key, index) => { const width = availableWidth * (weights[index] / weightTotal); layout.set(key, { x:cursor, width }); cursor += width + gap; });
      const trackLeft = track.getBoundingClientRect().left; const sourcePositions = new Map(items.map((item) => [item.id, cards.get(`${item.id}:main`).getBoundingClientRect().left - trackLeft]));
      cards.forEach((card, key) => { const slot = layout.get(key); const wasVisible = visibleKeys.includes(key); const visible = Boolean(slot); const entering = visible && !wasVisible; const currentWidth = card.getBoundingClientRect().width; const width = visible ? slot.width : currentWidth; let targetX = visible ? slot.x : viewportWidth + gap; let targetOpacity = 1; const closingDetail = !visible && wasVisible && key.endsWith(":detail") && direction === "state"; if (!visible && wasVisible) { if (closingDetail) { const mainSlot = layout.get(`${card.dataset.itemId}:main`); targetX = mainSlot ? mainSlot.x : -width - gap; targetOpacity = 0; } else { targetX = direction === "next" ? -width - gap : direction === "previous" ? viewportWidth + gap : -width - gap; } } if (entering && key.endsWith(":detail") && !immediate) { const sourceX = sourcePositions.get(card.dataset.itemId); if (Number.isFinite(sourceX)) gsap.set(card, { x:sourceX, opacity:1 }); } card.style.width = `${width}px`; card.style.zIndex = entering || !visible ? "1" : "3"; card.style.pointerEvents = visible ? "auto" : "none"; card.tabIndex = visible ? 0 : -1; card.setAttribute("aria-hidden", String(!visible)); card.setAttribute("aria-pressed", String(Boolean(activeId) && card.dataset.itemId === activeId && !key.endsWith(":detail"))); gsap.to(card, { x:targetX, opacity:targetOpacity, duration:immediate || reducedMotion ? 0 : .72, ease:"power3.inOut", overwrite:"auto" }); });
      visibleKeys = nextKeys; counter.textContent = `Escena ${sceneIndex + 1} de ${scenes.length}`; previous.disabled = sceneIndex === 0; next.disabled = sceneIndex === scenes.length - 1; if (immediate || reducedMotion) locked = false;
    };
    const update = (direction = "state") => { if (locked) return; locked = true; render(false, direction); gsap.delayedCall(.74, () => { locked = false; }); };
    track.addEventListener("click", (event) => { const card = event.target.closest("button[data-item-id]"); if (!card || locked) return; const id = card.dataset.itemId; activeId = activeId === id ? null : id; update(); });
    next.addEventListener("click", () => { if (locked || sceneIndex === scenes.length - 1) return; sceneIndex += 1; activeId = null; update("next"); });
    previous.addEventListener("click", () => { if (locked || sceneIndex === 0) return; sceneIndex -= 1; activeId = null; update("previous"); });
    window.addEventListener("resize", () => render(true), { passive:true }); render(true);
    }
  }
</script>
