---
import Layout from "../layouts/Layout.astro";
import StackedSections from "../components/StackedSections.astro";
import KineticButton from "../components/KineticButton.astro";
---

<Layout
  title="Guiraglobal SRL | Asesoría Comercial de Guira en Bolivia"
  description="Guiraglobal SRL brinda asesoría comercial y acompañamiento operativo a empresas bolivianas que usan la plataforma tecnológica Guira."
  keywords="Guiraglobal SRL, Guira Bolivia, asesoría comercial pagos internacionales, pagos a proveedores desde Bolivia, asesoría Guira Bolivia, plataforma tecnológica B2B Bolivia"
  canonicalUrl="https://www.guiracorp.com/guiraglobal"
  footerTheme="light"
  footerVariant="guiraglobal"
  hideFloatingWhatsapp={true}
>
  <Fragment slot="head">
    <!-- Schema: Organization + LocalBusiness -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Guiraglobal SRL",
        "legalName": "Guiraglobal SRL",
        "description": "Guiraglobal SRL brinda asesoría comercial y acompañamiento operativo a empresas bolivianas para pagos internacionales y gestión operativa.",
        "url": "https://www.guiracorp.com/guiraglobal",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Calle 8 de Calacoto #8330",
          "addressLocality": "La Paz",
          "addressRegion": "La Paz",
          "addressCountry": "BO"
        },
        "areaServed": {
          "@type": "Country",
          "name": "Bolivia"
        },
        "parentOrganization": {
          "@type": "Organization",
          "name": "Guira System LLC",
          "url": "https://www.guiracorp.com"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+59167015106",
          "contactType": "sales",
          "areaServed": "BO",
          "availableLanguage": "Spanish"
        }
      }
    </script>

    <!-- Schema: BreadcrumbList -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "https://www.guiracorp.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Guiraglobal SRL",
            "item": "https://www.guiracorp.com/guiraglobal"
          }
        ]
      }
    </script>
  </Fragment>

  <StackedSections>
    <!-- Header Section -->
    <header
      data-stack-section
      class="pt-32 pb-24 bg-white border-b border-slate-200 relative overflow-hidden"
    >
      <div
        class="absolute top-0 right-0 w-96 h-96 bg-guira-teal opacity-5 blur-[100px] rounded-full pointer-events-none"
      >
      </div>
      <div class="max-w-7xl mx-auto px-6 relative z-10 reveal">
        <div class="grid gap-6 md:grid-cols-12 md:gap-10">
          <div class="md:col-span-9">
            <h1
              class="text-4xl sm:text-5xl md:text-6xl font-extrabold uppercase tracking-tight leading-[1.1] text-slate-900"
            >
              Guiraglobal SRL
            </h1>
            <p
              class="mt-7 max-w-2xl text-lg md:text-xl text-slate-600 font-medium leading-relaxed"
            >
              Somos el equipo de asesoría comercial y acompañamiento operativo
              en Bolivia para empresas que usan la plataforma tecnológica Guira.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main data-stack-section class="bg-white">
      <!-- Quiénes Somos -->
      <section
        class="reveal relative overflow-hidden bg-guira-dark py-12 md:py-16 text-white"
      >
        <div class="max-w-7xl mx-auto px-6">
          <div class="grid gap-10 md:grid-cols-12 md:gap-12">
            <h2
              class="text-4xl font-extrabold uppercase tracking-tight leading-[1.08] text-white md:col-span-4 md:text-6xl"
            >
              Quiénes<br />Somos
            </h2>
            <div class="border-y border-white/15 py-7 md:col-span-8 md:py-10">
              <div
                class="space-y-5 text-base font-medium leading-relaxed text-slate-300 md:text-lg"
              >
                <p>
                  Guiraglobal SRL es una empresa boliviana constituida
                  legalmente que brinda <strong>asesoría comercial</strong> y <strong
                    >acompañamiento operativo</strong
                  > a empresas bolivianas que usan la plataforma tecnológica Guira.
                </p>
                <p>
                  Trabajamos como puente entre las empresas de LATAM y la
                  infraestructura tecnológica de Guira System LLC, facilitando
                  el onboarding, la operación y el seguimiento de los
                  servicios de pagos internacionales.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Información Legal -->
      <section
        class="reveal relative overflow-hidden bg-guira-dark border-t border-white/10 py-12 md:py-16 text-white"
      >
        <div class="max-w-7xl mx-auto px-6">
          <div class="grid gap-10 md:grid-cols-12 md:gap-12">
            <h2
              class="text-4xl font-extrabold uppercase tracking-tight leading-[1.08] text-white md:col-span-4 md:text-6xl"
            >
              Información<br />Legal
            </h2>
            <dl class="border-y border-white/15 md:col-span-8">
              <div
                class="grid gap-2 border-b border-white/15 py-6 sm:grid-cols-2 sm:gap-16 lg:gap-24"
              >
                <dt class="text-sm font-medium text-slate-400">
                  Nombre legal
                </dt>
                <dd class="text-base font-medium text-slate-200">
                  Guiraglobal SRL
                </dd>
              </div>
              <div
                class="grid gap-2 border-b border-white/15 py-6 sm:grid-cols-2 sm:gap-16 lg:gap-24"
              >
                <dt class="text-sm font-medium text-slate-400">Dirección</dt>
                <dd
                  class="text-base font-medium leading-relaxed text-slate-200"
                >
                  Calle 8 de Calacoto #8330, La Paz, Bolivia
                </dd>
              </div>
              <div
                class="grid gap-2 border-b border-white/15 py-6 sm:grid-cols-2 sm:gap-16 lg:gap-24"
              >
                <dt class="text-sm font-medium text-slate-400">Actividad</dt>
                <dd
                  class="text-base font-medium leading-relaxed text-slate-200"
                >
                  Asesoría comercial y acompañamiento operativo en servicios
                  tecnológicos B2B
                </dd>
              </div>
              <div class="grid gap-2 py-6 sm:grid-cols-2 sm:gap-16 lg:gap-24">
                <dt class="text-sm font-medium text-slate-400">Contacto</dt>
                <dd>
                  <a
                    href="tel:+59167015106"
                    class="text-base font-semibold text-white hover:text-guira-cyan hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-guira-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-guira-dark rounded-sm"
                    >+591 67015106</a
                  >
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <!-- Servicios -->
      <section
        class="reveal relative overflow-hidden border-y border-slate-200 bg-white py-16 md:py-20 text-slate-900"
      >
        <div
          class="pointer-events-none absolute -right-24 top-1/2 h-96 w-96 -translate-y-1/2 rounded-full bg-guira-teal/5 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="pointer-events-none absolute -left-24 top-1/4 h-80 w-80 rounded-full bg-blue-500/5 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative z-10 max-w-7xl mx-auto px-6">
          <div
            class="mb-12 grid items-end gap-8 lg:mb-16 lg:grid-cols-12 lg:gap-12"
          >
            <div class="lg:col-span-8">
              <h2
                class="text-3xl font-extrabold uppercase tracking-tight text-slate-900 leading-[1.08] sm:text-4xl md:text-5xl"
              >
                Nuestros Servicios
              </h2>
            </div>
          </div>
          <div class="border-t border-slate-200">
            <div
              class="grid grid-cols-1 divide-y divide-slate-200 md:grid-cols-2 md:divide-x md:divide-y-0 lg:grid-cols-4"
            >
              <div class="group py-8 md:py-10 md:pr-8 lg:pr-10">
                <div
                  class="w-12 h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center mb-4 shadow-sm"
                >
                  <i data-lucide="users" class="w-6 h-6 text-slate-700"></i>
                </div>
                <h3
                  class="text-base sm:text-lg font-extrabold uppercase tracking-wider text-slate-900 mb-3 sm:mb-4 group-hover:text-guira-teal transition-colors"
                >
                  Asesoría Comercial
                </h3>
                <p
                  class="text-sm sm:text-base font-medium text-slate-600 leading-relaxed"
                >
                  Orientación a empresas bolivianas sobre el uso de la
                  plataforma Guira para sus operaciones internacionales.
                </p>
              </div>
              <div class="group py-8 md:px-8 md:py-10 lg:px-10">
                <div
                  class="w-12 h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center mb-4 shadow-sm"
                >
                  <i data-lucide="headset" class="w-6 h-6 text-slate-700"></i>
                </div>
                <h3
                  class="text-base sm:text-lg font-extrabold uppercase tracking-wider text-slate-900 mb-3 sm:mb-4 group-hover:text-guira-teal transition-colors"
                >
                  Acompañamiento Operativo
                </h3>
                <p
                  class="text-sm sm:text-base font-medium text-slate-600 leading-relaxed"
                >
                  Soporte en el proceso de onboarding, validación empresarial
                  y operación continua.
                </p>
              </div>
              <div class="group py-8 md:py-10 md:pr-8 lg:px-10">
                <div
                  class="w-12 h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center mb-4 shadow-sm"
                >
                  <i data-lucide="file-text" class="w-6 h-6 text-slate-700"
                  ></i>
                </div>
                <h3
                  class="text-base sm:text-lg font-extrabold uppercase tracking-wider text-slate-900 mb-3 sm:mb-4 group-hover:text-guira-teal transition-colors"
                >
                  Gestión Documental
                </h3>
                <p
                  class="text-sm sm:text-base font-medium text-slate-600 leading-relaxed"
                >
                  Asistencia en la preparación y presentación de documentación
                  requerida para cada operación.
                </p>
              </div>
              <div class="group py-8 md:px-8 md:py-10 lg:pl-10 lg:pr-0">
                <div
                  class="w-12 h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center mb-4 shadow-sm"
                >
                  <i
                    data-lucide="message-circle"
                    class="w-6 h-6 text-slate-700"></i>
                </div>
                <h3
                  class="text-base sm:text-lg font-extrabold uppercase tracking-wider text-slate-900 mb-3 sm:mb-4 group-hover:text-guira-teal transition-colors"
                >
                  Atención Local
                </h3>
                <p
                  class="text-sm sm:text-base font-medium text-slate-600 leading-relaxed"
                >
                  Canal de comunicación directo en zona horaria boliviana para
                  consultas y seguimiento.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Contacto -->
      <section class="reveal bg-slate-900 py-16 md:py-20">
        <div class="max-w-7xl mx-auto px-6">
          <div class="max-w-3xl">
            <h2 class="h2-cta text-white mb-6">Contacto</h2>
            <p class="text-slate-300 font-medium leading-relaxed mb-8 text-base md:text-lg">
              Si eres una empresa boliviana interesada en los servicios de
              Guira, nuestro equipo puede orientarte sobre el proceso,
              requisitos y casos de uso aplicables.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <KineticButton
                href="https://wa.me/59167015106"
                variant="teal"
                size="lg"
                label="Escribir por WhatsApp"
                class="w-full sm:w-auto"
              />
              <KineticButton
                href="/demo/"
                variant="teal"
                size="lg"
                label="Solicitar Asesoría"
                class="w-full sm:w-auto"
              />
              <KineticButton
                href="/contacto/"
                variant="light"
                size="lg"
                label="Contactar"
                class="w-full sm:w-auto"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Relación con Guira System LLC -->
      <section class="reveal bg-white py-14 md:py-16 border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="text-xl font-extrabold text-slate-900 mb-4">
            Relación con Guira System LLC
          </h2>
          <div
            class="space-y-3 text-xs md:text-sm text-slate-600 font-medium leading-relaxed"
          >
            <p>
              Guiraglobal SRL brinda <strong
                >asesoría comercial y acompañamiento operativo</strong
              > en Bolivia para empresas que usan la plataforma Guira. Guira System
              LLC es la empresa matriz constituida en Delaware, Estados Unidos, que
              desarrolla y opera la plataforma tecnológica.
            </p>
            <p>
              Guiraglobal SRL <strong
                >no presta servicios financieros regulados</strong
              >. Su función es de asesoría, acompañamiento y gestión comercial
              de la relación entre las empresas bolivianas y la plataforma
              tecnológica.
            </p>
            <p>
              Los servicios financieros, rieles de pago, cuentas de recepción y
              procesamiento transaccional son provistos exclusivamente por
              terceros o partners aplicables bajo sus propias autorizaciones
              regulatorias.
            </p>
          </div>
        </div>
      </section>
    </main>
  </StackedSections>
</Layout>
