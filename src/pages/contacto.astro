---
import Layout from "../layouts/Layout.astro";
import StackedSections from "../components/StackedSections.astro";

const letters = (text: string) =>
    text.split("").map((ch, i) => ({ ch: ch === " " ? " " : ch, i }));
---

<Layout
    title="Contacto y Asesoría B2B | Guira Empresas"
    description="Habla con el equipo de Guira Empresas sobre recibir pagos en USD, pagar proveedores internacionales ACH/Wire o habilitar tu operación B2B desde LATAM. Asesores en Bolivia y EE.UU."
    keywords="contacto guira, hablar con asesores guira, acompañamiento corporativo guira, asesoría B2B pagos internacionales, oficinas guira bolivia"
    canonicalUrl="https://www.guiracorp.com/contacto"
    footerTheme="light"
    copyright="Acompañamiento Corporativo. © 2026 Guira System LLC. Representado en Bolivia por Guiraglobal SRL. Todos los derechos reservados."
>
    <Fragment slot="head">
        <!-- Schema: ContactPage + BreadcrumbList -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "ContactPage",
                "name": "Contacto y Asesoría B2B | Guira Empresas",
                "description": "Habla con el equipo de Guira para recibir pagos en USD o pagar proveedores internacionales desde LATAM.",
                "url": "https://www.guiracorp.com/contacto",
                "breadcrumb": {
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                        {
                            "@type": "ListItem",
                            "position": 1,
                            "name": "Inicio",
                            "item": "https://www.guiracorp.com/"
                        },
                        {
                            "@type": "ListItem",
                            "position": 2,
                            "name": "Contacto",
                            "item": "https://www.guiracorp.com/contacto"
                        }
                    ]
                },
                "mainEntity": {
                    "@type": "Organization",
                    "name": "Guira System LLC",
                    "url": "https://www.guiracorp.com",
                    "telephone": "+13057681048",
                    "email": "administracion@guiracorp.com",
                    "address": {
                        "@type": "PostalAddress",
                        "streetAddress": "1201 North Market Street #111",
                        "addressLocality": "Wilmington",
                        "addressRegion": "Delaware",
                        "postalCode": "19801",
                        "addressCountry": "US"
                    }
                }
            }
        </script>
    </Fragment>

    <StackedSections>
        <!-- Content -->
        <main data-stack-section class="pt-32 pb-24 flex-1 text-left">
            <div class="max-w-5xl mx-auto px-6">
                <h1 class="text-4xl font-extrabold text-slate-900 mb-4">
                    Contacto: Recibe Pagos en USD o Paga Proveedores
                    Internacionales desde LATAM
                </h1>
                <p class="text-slate-600 font-medium mb-8 text-lg">
                    Cuéntanos tu caso de uso y revisaremos si Guira puede ayudar
                    a tu empresa a recibir pagos en USD, instruir pagos
                    empresariales B2B vía ACH o Wire, y operar
                    internacionalmente con más claridad y trazabilidad.
                </p>
            </div>
            <div
                class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-14"
            >
                <div
                    class="md:col-span-2 reveal-left space-y-8 mt-4 pb-8 border-b border-slate-200 md:pb-0 md:border-b-0 md:border-r md:pr-7"
                >
                    <div class="p-6 space-y-6">
                        <div class="flex gap-4">
                            <i
                                data-lucide="mail"
                                class="w-6 h-6 text-guira-teal"></i>
                            <div>
                                <div class="font-bold text-slate-900">
                                    Email comercial
                                </div>
                                <a
                                    href="mailto:administracion@guiracorp.com"
                                    class="text-sm text-slate-500 hover:text-guira-teal transition-colors font-medium"
                                    >administracion@guiracorp.com</a
                                >
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <i
                                data-lucide="life-buoy"
                                class="w-6 h-6 text-guira-teal"></i>
                            <div>
                                <div class="font-bold text-slate-900">
                                    Asesoría de onboarding
                                </div>
                                <a
                                    href="mailto:soporte@guiracorp.com"
                                    class="text-sm text-slate-500 hover:text-guira-teal transition-colors font-medium"
                                    >soporte@guiracorp.com</a
                                >
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <i
                                data-lucide="file-check-2"
                                class="w-6 h-6 text-guira-teal"></i>
                            <div>
                                <div class="font-bold text-slate-900">
                                    Consulta sobre elegibilidad
                                </div>
                                <p
                                    class="text-sm text-slate-500 font-medium pt-1"
                                >
                                    Revisaremos la estructura de tu caso de uso
                                    B2B.
                                </p>
                            </div>
                        </div>

                        <hr class="border-slate-100" />

                        <div class="flex gap-4">
                            <i
                                data-lucide="map-pin"
                                class="w-6 h-6 text-guira-teal"></i>
                            <div>
                                <div class="font-bold text-slate-900">
                                    Estados Unidos
                                </div>
                                <p
                                    class="text-sm text-slate-500 font-medium pt-1"
                                >
                                    1201 North Market Street #111, Wilmington,
                                    19801, Delaware
                                </p>
                                <a
                                    href="tel:+13057681048"
                                    class="text-sm text-slate-500 hover:text-guira-teal transition-colors font-medium block mt-1"
                                    >+1 305 768 1048</a
                                >
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <i
                                data-lucide="map-pin"
                                class="w-6 h-6 text-guira-teal"></i>
                            <div>
                                <div class="font-bold text-slate-900">
                                    Asesores Guira Bolivia
                                </div>
                                <p
                                    class="text-sm text-slate-500 font-medium pt-1"
                                >
                                    Calle 8 de Calacoto #8330, La Paz, Bolivia
                                </p>
                                <a
                                    href="https://wa.me/59175245845"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-sm text-emerald-600 hover:text-emerald-500 transition-colors font-medium flex items-center gap-1.5 mt-1"
                                >
                                    <svg
                                        class="w-4 h-4"
                                        fill="currentColor"
                                        viewBox="0 0 24 24"
                                        xmlns="http://www.w3.org/2000/svg"
                                        ><path
                                            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
                                        ></path></svg
                                    >
                                    WhatsApp: +591-75245845
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <div class="md:col-span-3 bg-white p-8 shadow-sm reveal-right">
                    <h2 class="text-2xl font-bold text-slate-900 mb-6">
                        Déjanos tu mensaje
                    </h2>
                    <form
                        id="contact-form"
                        action="https://api.web3forms.com/submit"
                        method="POST"
                        class="space-y-5"
                    >
                        <input
                            type="hidden"
                            name="access_key"
                            value="8707452b-a137-481b-ba1b-75d2b548b4eb"
                        />
                        <input
                            type="hidden"
                            name="subject"
                            value="Nuevo mensaje de contacto - Guira Empresas"
                        />

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div class="field-float">
                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    required
                                    placeholder=" "
                                    class="field-input"
                                />
                                <label for="name" class="field-label"
                                    >{
                                        letters("Nombre").map(({ ch, i }) => (
                                            <span
                                                class="letter"
                                                style={`--i:${i}`}
                                            >
                                                {ch}
                                            </span>
                                        ))
                                    }</label
                                >
                            </div>
                            <div class="field-float">
                                <input
                                    type="text"
                                    id="company"
                                    name="company"
                                    required
                                    placeholder=" "
                                    class="field-input"
                                />
                                <label for="company" class="field-label"
                                    >{
                                        letters("Empresa").map(({ ch, i }) => (
                                            <span
                                                class="letter"
                                                style={`--i:${i}`}
                                            >
                                                {ch}
                                            </span>
                                        ))
                                    }</label
                                >
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div class="field-float">
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    required
                                    placeholder=" "
                                    class="field-input"
                                />
                                <label for="email" class="field-label"
                                    >{
                                        letters("Email Corporativo").map(
                                            ({ ch, i }) => (
                                                <span
                                                    class="letter"
                                                    style={`--i:${i}`}
                                                >
                                                    {ch}
                                                </span>
                                            ),
                                        )
                                    }</label
                                >
                            </div>
                            <div class="field-float">
                                <input
                                    type="text"
                                    id="country"
                                    name="country"
                                    required
                                    placeholder=" "
                                    class="field-input"
                                />
                                <label for="country" class="field-label"
                                    >{
                                        letters("País").map(({ ch, i }) => (
                                            <span
                                                class="letter"
                                                style={`--i:${i}`}
                                            >
                                                {ch}
                                            </span>
                                        ))
                                    }</label
                                >
                            </div>
                        </div>

                        <div
                            class="field-float accordion-field"
                            id="topic-accordion"
                        >
                            <button
                                type="button"
                                class="field-input field-select accordion-trigger"
                                aria-expanded="false"
                            >
                                <span class="accordion-value"></span>
                                <i
                                    data-lucide="chevron-down"
                                    class="accordion-chevron w-4 h-4"></i>
                            </button>
                            <label for="topic-accordion" class="field-label"
                                >{
                                    letters("Tipo de Operación").map(
                                        ({ ch, i }) => (
                                            <span
                                                class="letter"
                                                style={`--i:${i}`}
                                            >
                                                {ch}
                                            </span>
                                        ),
                                    )
                                }</label
                            >
                            <div class="accordion-panel">
                                <div class="accordion-panel-inner">
                                    <label class="accordion-option"
                                        ><input
                                            type="radio"
                                            name="topic"
                                            value="cobros"
                                            required
                                        /><span
                                            >Recibir pagos internacionales en
                                            USD</span
                                        ></label
                                    >
                                    <label class="accordion-option"
                                        ><input
                                            type="radio"
                                            name="topic"
                                            value="pagos"
                                            required
                                        /><span
                                            >Pagar a proveedores externos</span
                                        ></label
                                    >
                                    <label class="accordion-option"
                                        ><input
                                            type="radio"
                                            name="topic"
                                            value="ambos"
                                            required
                                        /><span>Cobros y pagos unificados</span
                                        ></label
                                    >
                                    <label class="accordion-option"
                                        ><input
                                            type="radio"
                                            name="topic"
                                            value="otro"
                                            required
                                        /><span
                                            >Otras consultas empresariales</span
                                        ></label
                                    >
                                </div>
                            </div>
                        </div>

                        <div class="field-float">
                            <textarea
                                id="message"
                                name="message"
                                rows="4"
                                required
                                placeholder=" "
                                class="field-input resize-none"></textarea>
                            <label for="message" class="field-label"
                                >{
                                    letters("Mensaje").map(({ ch, i }) => (
                                        <span class="letter" style={`--i:${i}`}>
                                            {ch}
                                        </span>
                                    ))
                                }</label
                            >
                        </div>

                        <div class="pt-2 pb-4">
                            <label
                                class="flex items-start gap-3 cursor-pointer group"
                            >
                                <div
                                    class="relative flex items-center justify-center mt-0.5"
                                >
                                    <input
                                        type="checkbox"
                                        required
                                        class="peer appearance-none w-5 h-5 border-2 border-slate-300 rounded cursor-pointer checked:bg-guira-teal checked:border-guira-teal transition-colors"
                                    />
                                    <i
                                        data-lucide="check"
                                        class="absolute w-3 h-3 text-white opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity"
                                    ></i>
                                </div>
                                <span
                                    class="text-xs text-slate-500 font-medium leading-relaxed group-hover:text-slate-700 transition-colors"
                                    >He leído y acepto la <a
                                        href="/privacidad/"
                                        class="text-guira-teal font-bold hover:underline"
                                        >Política de Privacidad</a
                                    > de Guira. Autorizo que Guira se comunique conmigo
                                    por correo electrónico, teléfono o WhatsApp para
                                    dar seguimiento a mi consulta.</span
                                >
                            </label>
                        </div>

                        <button
                            type="submit"
                            class="btn-29 btn-29-teal w-full py-4 text-base font-extrabold"
                        >
                            <span class="text-container">
                                <span class="text btn-label">Enviar consulta</span>
                            </span>
                        </button>
                    </form>
                </div>
            </div>
        </main>

        <script>
            document
                .getElementById("contact-form")
                .addEventListener("submit", function (e) {
                    e.preventDefault();
                    const form = this;
                    const btn = form.querySelector('button[type="submit"]');
                    const originalHTML = btn.innerHTML;

                    // Comprobar si se ha configurado Formspree u otro servicio
                    const action = form.getAttribute("action");
                    if (
                        !action ||
                        action === "#" ||
                        action === "" ||
                        action.includes("4bcb5f9d527045acbf8594b2b665542c")
                    ) {
                        // Comportamiento de demostración por defecto con aviso instructivo
                        btn.innerHTML =
                            '<i data-lucide="loader-2" class="w-5 h-5 animate-spin mx-auto"></i>';
                        btn.classList.add("is-filled");
                        if (typeof lucide !== "undefined") lucide.createIcons();

                        setTimeout(() => {
                            btn.innerHTML =
                                '<i data-lucide="check" class="w-5 h-5 mx-auto"></i> ¡Simulado con éxito! (Reemplaza el ID de Formspree en el HTML)';
                            btn.classList.add("is-filled", "is-success");

                            if (typeof lucide !== "undefined")
                                lucide.createIcons();

                            setTimeout(() => {
                                btn.innerHTML = originalHTML;
                                btn.classList.remove("is-filled", "is-success");
                                form.reset();
                            }, 4000);
                        }, 1000);
                        return;
                    }

                    // Envío real por AJAX
                    btn.disabled = true;
                    btn.innerHTML =
                        '<i data-lucide="loader-2" class="w-5 h-5 animate-spin mx-auto"></i> Enviando...';
                    btn.classList.add("is-filled");
                    if (typeof lucide !== "undefined") lucide.createIcons();

                    fetch(action, {
                        method: "POST",
                        body: new FormData(form),
                        headers: {
                            Accept: "application/json",
                        },
                    })
                        .then((response) => response.json())
                        .then((data) => {
                            if (data.success) {
                                const topic =
                                    form.querySelector('[name="topic"]')
                                        ?.value || "not_selected";
                                window.posthog?.capture(
                                    "contact_form_submitted",
                                    {
                                        topic,
                                        form_path: window.location.pathname,
                                    },
                                );
                                btn.innerHTML =
                                    '<i data-lucide="check" class="w-5 h-5 mx-auto"></i> ¡Mensaje enviado con éxito!';
                                btn.classList.add("is-success");
                                if (typeof lucide !== "undefined")
                                    lucide.createIcons();
                                form.reset();
                            } else {
                                window.posthog?.capture("contact_form_failed", {
                                    failure_type: "api_response",
                                    form_path: window.location.pathname,
                                });
                                btn.innerHTML =
                                    "Error: " +
                                    (data.message ||
                                        "Verifica tu clave de formulario.");
                                btn.classList.add("is-error");
                            }
                            setTimeout(() => {
                                btn.innerHTML = originalHTML;
                                btn.classList.remove(
                                    "is-filled",
                                    "is-success",
                                    "is-error",
                                );
                                btn.disabled = false;
                            }, 4000);
                        })
                        .catch((error) => {
                            window.posthog?.capture("contact_form_failed", {
                                failure_type: "network_error",
                                form_path: window.location.pathname,
                            });
                            window.posthog?.captureException(error);
                            btn.innerHTML = "Error de conexión.";
                            btn.classList.add("is-error");
                            setTimeout(() => {
                                btn.innerHTML = originalHTML;
                                btn.classList.remove("is-filled", "is-error");
                                btn.disabled = false;
                            }, 4000);
                        });
                });

            const topicAccordion = document.getElementById("topic-accordion");
            const topicTrigger =
                topicAccordion.querySelector(".accordion-trigger");
            const topicValue = topicAccordion.querySelector(".accordion-value");
            const topicOptions = topicAccordion.querySelectorAll(
                '.accordion-option input[type="radio"]',
            );

            topicTrigger.addEventListener("click", () => {
                const isOpen =
                    topicTrigger.getAttribute("aria-expanded") === "true";
                topicTrigger.setAttribute("aria-expanded", String(!isOpen));
            });

            topicOptions.forEach((input) => {
                input.addEventListener("change", () => {
                    topicValue.textContent = input
                        .closest(".accordion-option")
                        .querySelector("span").textContent;
                    topicAccordion.classList.add("has-value");
                    topicTrigger.setAttribute("aria-expanded", "false");
                });
            });

            document.addEventListener("click", (e) => {
                if (!topicAccordion.contains(e.target)) {
                    topicTrigger.setAttribute("aria-expanded", "false");
                }
            });
        </script>

        <style>
            .field-float {
                position: relative;
            }

            .field-input {
                width: 100%;
                padding: 0.75rem 0.25rem 0.5rem;
                background: transparent;
                border: none;
                border-bottom: 1.5px solid rgb(203 213 225);
                outline: none;
                font-weight: 500;
                color: rgb(15 23 42);
                transition:
                    border-color 0.2s ease,
                    box-shadow 0.2s ease;
            }

            .field-input:focus {
                outline: none;
                border-color: var(--guira-teal, #0051ff) !important;
                box-shadow: none !important;
            }

            .field-select {
                appearance: none;
                cursor: pointer;
            }

            textarea.field-input {
                resize: none;
            }

            .field-label {
                position: absolute;
                left: 0.25rem;
                top: 0.75rem;
                font-size: 0.9375rem;
                font-weight: 500;
                color: rgb(148 163 184);
                pointer-events: none;
            }

            .field-label .letter {
                display: inline-block;
                transform-origin: left bottom;
                transition:
                    transform 0.35s ease,
                    color 0.35s ease;
                transition-delay: calc(var(--i, 0) * 22ms);
            }

            .field-input:focus + .field-label .letter,
            .field-input:not(:placeholder-shown) + .field-label .letter,
            select.field-input:valid + .field-label .letter {
                transform: translateY(-1.15rem) scale(0.8);
                color: var(--guira-teal, #0051ff);
            }

            .accordion-field {
                margin-bottom: 0.5rem;
            }

            button.accordion-trigger {
                font: inherit;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
                text-align: left;
                cursor: pointer;
                color: rgb(15 23 42);
            }

            .accordion-value {
                display: block;
                min-height: 1.2em;
            }

            .accordion-chevron {
                flex-shrink: 0;
                color: rgb(148 163 184);
                transition: transform 0.25s ease;
            }

            .accordion-trigger[aria-expanded="true"] .accordion-chevron {
                transform: rotate(180deg);
            }

            .accordion-panel {
                display: grid;
                grid-template-rows: 0fr;
                transition: grid-template-rows 0.3s ease;
            }

            .accordion-trigger[aria-expanded="true"]
                + .field-label
                + .accordion-panel {
                grid-template-rows: 1fr;
            }

            .accordion-panel-inner {
                overflow: hidden;
            }

            .accordion-option {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                padding: 0.65rem 0.25rem;
                font-size: 0.9375rem;
                font-weight: 500;
                color: rgb(51 65 85);
                cursor: pointer;
                border-top: 1px solid rgb(241 245 249);
                transition:
                    color 0.2s ease,
                    padding-left 0.2s ease;
            }

            .accordion-option:first-child {
                border-top: none;
            }

            .accordion-option:hover {
                color: var(--guira-teal, #0051ff);
                padding-left: 0.5rem;
            }

            .accordion-option input {
                accent-color: var(--guira-teal, #0051ff);
            }

            .accordion-field.has-value .field-label .letter,
            .accordion-trigger:focus + .field-label .letter,
            .accordion-trigger[aria-expanded="true"] + .field-label .letter {
                transform: translateY(-1.15rem) scale(0.8);
                color: var(--guira-teal, #0051ff);
            }

            .guira-submit-btn {
                position: relative;
                background-color: transparent;
                color: rgb(15 23 42);
                transition:
                    background-color 0.4s ease,
                    color 0.4s ease,
                    box-shadow 0.4s ease;
            }

            .guira-submit-btn:hover,
            .guira-submit-btn:focus-visible,
            .guira-submit-btn.is-filled {
                background-color: rgb(15 23 42);
                color: #fff;
