<Layout
    title="Plataforma para pagos internacionales empresariales | Guira"
    description="Centraliza la gestión de operaciones internacionales: cobros, pagos, documentación, seguimiento y trazabilidad para equipos financieros y administrativos."
    keywords="plataforma de pagos internacionales para empresas, pagos empresariales internacionales, gestión de operaciones internacionales, fintech B2B Latinoamérica, software para pagos internacionales, gestión documental internacional"
    canonicalUrl="https://www.guiracorp.com/producto"
    activeLink="producto"
    footerTheme="light"
>
    <Fragment slot="head">
        <!-- Schema: Service -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "Service",
                "serviceType": "Technology Platform for International Payments",
                "provider": {
                    "@type": "SoftwareApplication",
                    "name": "Guira Empresas",
                    "url": "https://www.guiracorp.com"
                },
                "name": "Plataforma Operativa Multi-moneda para Empresas",
                "description": "Permite recibir pagos en múltiples monedas desde el exterior y realizar pagos a proveedores internacionales de manera ágil y documentada."
            }
        </script>

        <!-- Schema: BreadcrumbList -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Inicio",
                        "item": "https://www.guiracorp.com/"
                    },
                    {
                        "@type": "ListItem",
                        "position": 2,
                        "name": "Producto",
                        "item": "https://www.guiracorp.com/producto"
                    }
                ]
            }
        </script>
    </Fragment>

    <StackedSections>
        <!-- 1. Hero Principal -->
        <header
            data-stack-section
            class="pt-24 sm:pt-28 md:pt-36 pb-14 sm:pb-16 md:pb-20 relative z-10 overflow-hidden bg-white border-b border-slate-200"
        >
            <div class="hero-operation-surface hero-operation-surface--light"></div>
            <div class="hero-operation-network hero-operation-network--light" aria-hidden="true">
                <div class="hero-operation-network__halo"></div>
                <svg class="hero-operation-network__desktop" viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice" fill="none">
                    <path class="hero-operation-network__route" d="M650 616C770 525 806 315 972 286C1110 262 1122 122 1374 78"></path>
                    <path class="hero-operation-network__route" d="M745 702C836 556 1055 598 1137 427C1195 306 1316 319 1440 242"></path>
                    <path class="hero-operation-network__route hero-operation-network__route--faint" d="M835 720C916 619 1004 623 1091 580C1208 523 1280 592 1416 555"></path>
                    <path class="hero-operation-network__signal" d="M650 616C770 525 806 315 972 286C1110 262 1122 122 1374 78"></path>
                    <path class="hero-operation-network__signal hero-operation-network__signal--delayed" d="M745 702C836 556 1055 598 1137 427C1195 306 1316 319 1440 242"></path>
                    <g class="hero-operation-network__capsule">
                        <rect x="-28" y="-13" width="56" height="26" rx="13"></rect>
                        <text x="0" y="4" text-anchor="middle">US$</text>
                        <animateMotion dur="13s" begin="-2s" repeatCount="indefinite" path="M650 616C770 525 806 315 972 286C1110 262 1122 122 1374 78"></animateMotion>
                    </g>
                    <g class="hero-operation-network__capsule hero-operation-network__capsule--secondary">
                        <rect x="-28" y="-13" width="56" height="26" rx="13"></rect>
                        <text x="0" y="4" text-anchor="middle">€</text>
                        <animateMotion dur="16s" begin="-9s" repeatCount="indefinite" path="M745 702C836 556 1055 598 1137 427C1195 306 1316 319 1440 242"></animateMotion>
                    </g>
                    <g class="hero-operation-network__nodes">
                        <circle cx="972" cy="286" r="4"></circle>
                        <circle cx="1137" cy="427" r="4"></circle>
                        <circle cx="1201" cy="161" r="3"></circle>
                        <circle cx="1351" cy="132" r="3"></circle>
                        <circle cx="1091" cy="580" r="3"></circle>
                    </g>
                </svg>
                <svg class="hero-operation-network__mobile" viewBox="0 0 390 844" preserveAspectRatio="none" fill="none">
                    <path class="hero-operation-network__route" d="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"></path>
                    <path class="hero-operation-network__route hero-operation-network__route--faint" d="M390 786C351 649 422 590 380 443C360 374 416 316 390 213"></path>
                    <path class="hero-operation-network__signal" d="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"></path>
                    <g class="hero-operation-network__capsule">
                        <rect x="-28" y="-13" width="56" height="26" rx="13"></rect>
                        <text x="0" y="4" text-anchor="middle">US$</text>
                        <animateMotion dur="14s" begin="-4s" repeatCount="indefinite" path="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"></animateMotion>
                    </g>
                    <g class="hero-operation-network__nodes">
                        <circle cx="367" cy="500" r="3"></circle>
                        <circle cx="390" cy="277" r="3"></circle>
                    </g>
                </svg>
            </div>
            <div
                class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10 grid lg:grid-cols-2 gap-10 lg:gap-12 items-center"
            >
                <div class="text-left reveal-up">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-slate-200 shadow-xs text-xs font-bold text-slate-600 mb-5 sm:mb-6 cursor-default"
                    >
                        <span
                            class="w-2 h-2 rounded-full bg-guira-teal animate-pulse"
                        ></span>
                        Infraestructura B2B para LATAM
                    </div>
                    <h1
                        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 mb-5 sm:mb-6 leading-[1.15] sm:leading-[1.1] tracking-tight break-words"
                    >
                        Plataforma para gestionar operaciones <span class="text-guira-teal">internacionales</span> empresariales
                    </h1>
                    <p
                        class="text-base sm:text-lg text-slate-600 font-medium max-w-xl mb-7 sm:mb-8 leading-relaxed"
                    >
                        Guira ayuda a centralizar información, documentación,
                        historial y seguimiento de cobros y pagos
                        internacionales para que finanzas, administración y
                        contabilidad trabajen con mayor visibilidad.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-3.5 sm:gap-4">
                        <GuiraButton
                            href="/demo/"
                            variant="dark"
                            size="lg"
                            label="Solicitar demo"
                            class="w-full sm:w-auto text-center justify-center"
                        />
                        <GuiraButton
                            href="/blog/aspectos-elegir-plataforma-pagos-internacionales-empresas/"
                            variant="light"
                            size="lg"
                            label="Qué evaluar antes de elegir"
                            class="w-full sm:w-auto text-center justify-center"
                        />
                    </div>

                    <div
                        class="mt-8 sm:mt-10 grid grid-cols-1 xs:grid-cols-3 sm:grid-cols-3 gap-3 xs:gap-4 sm:gap-6 lg:gap-8 border-t border-slate-200 pt-6 reveal-up delay-100"
                    >
                        <div class="group cursor-default">
                            <p
                                class="text-slate-900 font-bold group-hover:text-guira-teal transition-colors text-sm sm:text-base"
                            >
                                Visibilidad
                            </p>
                            <p class="text-xs text-slate-500 font-medium mt-0.5 sm:mt-1">
                                Estado de cada operación
                            </p>
                        </div>
                        <div
                            class="group cursor-default pt-2 xs:pt-0 border-t xs:border-t-0 xs:border-l border-slate-200 xs:pl-4 sm:pl-6 lg:pl-8"
                        >
                            <p
                                class="text-slate-900 font-bold group-hover:text-guira-teal transition-colors text-sm sm:text-base"
                            >
                                Documentos
                            </p>
                            <p class="text-xs text-slate-500 font-medium mt-0.5 sm:mt-1">
                                Facturas y respaldos
                            </p>
                        </div>
                        <div
                            class="group cursor-default pt-2 xs:pt-0 border-t xs:border-t-0 xs:border-l border-slate-200 xs:pl-4 sm:pl-6 lg:pl-8"
                        >
                            <p
                                class="text-slate-900 font-bold group-hover:text-guira-teal transition-colors text-sm sm:text-base"
                            >
                                Coordinación
                            </p>
                            <p class="text-xs text-slate-500 font-medium mt-0.5 sm:mt-1">
                                Equipos alineados
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Mockup de Smartphone con Flujo Animado -->
                <div
                    class="relative lg:ml-auto w-full max-w-lg mt-8 sm:mt-10 lg:mt-0 flex justify-center lg:justify-end reveal-up delay-200"
                >
                    <PhoneFlowMockup />
                </div>
            </div>
        </header>

        <!-- Social Proof Marquee (Blanco/Gris estilo Corporativo) -->
        <div
            data-stack-section
            class="w-full bg-white border-b border-slate-200 py-4 sm:py-6 overflow-hidden relative z-10"
        >
            <!-- masks para desvanecer bordes en modo claro -->
            <div
                class="absolute inset-y-0 left-0 w-12 sm:w-24 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"
            >
            </div>
            <div
                class="absolute inset-y-0 right-0 w-12 sm:w-24 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"
            >
            </div>

            <div class="flex marquee-container w-[200%] animate-marquee">
                <!-- Bloque 1 -->
                <div
                    class="flex items-center justify-around w-1/2 min-w-full sm:min-w-0 gap-6 sm:gap-10"
                >
                    <div
                        class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-bold opacity-70 grayscale hover:grayscale-0 hover:opacity-100 hover:text-slate-900 transition-all shrink-0"
                    >
                        <i data-lucide="globe" class="w-5 h-5 sm:w-6 sm:h-6"></i> Rieles de Pago Global
                    </div>
                    <div
                        class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-bold opacity-70 grayscale hover:grayscale-0 hover:opacity-100 hover:text-slate-900 transition-all shrink-0"
                    >
                        <i data-lucide="network" class="w-5 h-5 sm:w-6 sm:h-6"></i> Redes ACH/Wire
                    </div>
                    <div
                        class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-bold opacity-70 grayscale hover:grayscale-0 hover:opacity-100 hover:text-slate-900 transition-all shrink-0"
                    >
                        <i data-lucide="file-check-2" class="w-5 h-5 sm:w-6 sm:h-6"></i> Transacciones Auditables
                    </div>
                    <div
                        class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-bold opacity-70 grayscale hover:grayscale-0 hover:opacity-100 hover:text-slate-900 transition-all shrink-0"
                    >
                        <i data-lucide="shield-check" class="w-5 h-5 sm:w-6 sm:h-6"></i> Validación B2B Estricta
                    </div>
                </div>
                <!-- Bloque 2 (Duplicado para infinito) -->
                <div
                    class="flex items-center justify-around w-1/2 min-w-full sm:min-w-0 gap-6 sm:gap-10"
                >
                    <div
                        class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-bold opacity-70 grayscale hover:grayscale-0 hover:opacity-100 hover:text-slate-900 transition-all shrink-0"
                    >
                        <i data-lucide="globe" class="w-5 h-5 sm:w-6 sm:h-6"></i> Rieles de Pago Global
                    </div>
                    <div
                        class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-bold opacity-70 grayscale hover:grayscale-0 hover:opacity-100 hover:text-slate-900 transition-all shrink-0"
                    >
                        <i data-lucide="network" class="w-5 h-5 sm:w-6 sm:h-6"></i> Redes ACH/Wire
                    </div>
                    <div
                        class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-bold opacity-70 grayscale hover:grayscale-0 hover:opacity-100 hover:text-slate-900 transition-all shrink-0"
                    >
                        <i data-lucide="file-check-2" class="w-5 h-5 sm:w-6 sm:h-6"></i> Transacciones Auditables
                    </div>
                    <div
                        class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-bold opacity-70 grayscale hover:grayscale-0 hover:opacity-100 hover:text-slate-900 transition-all shrink-0"
                    >
                        <i data-lucide="shield-check" class="w-5 h-5 sm:w-6 sm:h-6"></i> Validación B2B Estricta
                    </div>
                </div>
            </div>
        </div>

        <!-- Cambio de enfoque -->
        <section
            data-stack-section
            class="bg-slate-50 border-b border-slate-200 relative z-10"
        >
            <div class="grid md:grid-cols-2 items-stretch w-full">
                <div
                    class="flex flex-col justify-center py-14 sm:py-18 md:py-24 px-5 sm:px-6 md:pl-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] md:pr-12 reveal-up"
                >
                    <p class="section-kicker text-guira-teal mb-3">
                        De transferir a gestionar
                    </p>
                    <h2
                        class="h2-panel text-slate-900 mb-4 sm:mb-5 text-2xl sm:text-3xl md:text-4xl"
                    >
                        Los pagos internacionales ya no terminan en la
                        transferencia
                    </h2>
                    <p class="body-copy text-slate-600 text-base sm:text-lg mb-6 sm:mb-8 leading-relaxed">
                        A medida que crecen los clientes, proveedores y socios
                        en el exterior, las empresas necesitan administrar
                        documentación, estados, aprobaciones y trazabilidad
                        desde un mismo entorno.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-3.5 sm:gap-4">
                        <GuiraButton
                            href="/blog/de-transferir-dinero-a-gestionar-operaciones-pagos-internacionales-empresas/"
                            variant="dark"
                            size="md"
                            label="Leer evolución de pagos"
                            class="w-full sm:w-auto text-center justify-center"
                        />
                        <GuiraButton
                            href="/blog/plataformas-operaciones-internacionales-elegir-mejor-opcion/"
                            variant="light"
                            size="md"
                            label="Comparar tipos de plataformas"
                            class="w-full sm:w-auto text-center justify-center"
                        />
                    </div>
                </div>

                <div
                    class="bg-guira-navy flex flex-col justify-center py-14 sm:py-18 md:py-24 px-5 sm:px-6 md:pl-12 md:pr-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] reveal-up"
                >
                    <div class="pb-6 sm:pb-8 border-b border-white/10">
                        <h3 class="text-lg sm:text-xl font-extrabold uppercase tracking-wider text-rose-400 mb-4 sm:mb-6">
                            Antes
                        </h3>
                        <ul class="space-y-3.5 sm:space-y-4">
                            <li class="flex gap-3 text-slate-300 font-medium text-sm sm:text-base leading-relaxed">
                                <i
                                    data-lucide="x"
                                    class="w-5 h-5 text-rose-400 shrink-0 mt-0.5"
                                ></i>
                                <span>El foco estaba en ejecutar una transferencia.</span>
                            </li>
                            <li class="flex gap-3 text-slate-300 font-medium text-sm sm:text-base leading-relaxed">
                                <i
                                    data-lucide="x"
                                    class="w-5 h-5 text-rose-400 shrink-0 mt-0.5"
                                ></i>
                                <span>El seguimiento dependía de correos y consultas manuales.</span>
                            </li>
                            <li class="flex gap-3 text-slate-300 font-medium text-sm sm:text-base leading-relaxed">
                                <i
                                    data-lucide="x"
                                    class="w-5 h-5 text-rose-400 shrink-0 mt-0.5"
                                ></i>
                                <span>La documentación quedaba distribuida entre carpetas y equipos.</span>
                            </li>
                        </ul>
                    </div>

                    <div class="pt-6 sm:pt-8">
                        <h3
