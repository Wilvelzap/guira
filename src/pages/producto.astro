    /* Scroll Reveal Animation Classes */
    .reveal-up {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
    }
    .reveal-up.active {
        opacity: 1;
        transform: translateY(0);
    }
    .delay-100 {
        transition-delay: 100ms;
    }
    .delay-200 {
        transition-delay: 200ms;
    }
    .delay-300 {
        transition-delay: 300ms;
    }

