const productoFaq = [
    {
        question: "¿Es Guira un banco tradicional?",
        answer: "Guira no es un banco ni un custodio directo. Es una infraestructura tecnológica que centraliza las instrucciones de pago B2B e integraciones formales para empresas de LATAM, apoyándose en partners financieros debidamente autorizados según la estructura acordada."
    },
    {
        question: "¿Qué documentos se necesitan para recibir USD o pagar a proveedores?",
        answer: "Durante el onboarding, validamos la constitución legal de tu empresa y el perfil de negocio. Para las operaciones en vivo (cobros o pagos), requieres adjuntar tu factura comercial (invoice) o contrato asociado para sustentar la trazabilidad B2B de los fondos ante los partners financieros."
    },
    {
        question: "¿Pueden empresas bolivianas usar Guira para pagar a proveedores en el exterior?",
        answer: "Sí. A través del equipo asesor con presencia en Bolivia, las empresas bolivianas pueden acceder a la plataforma Guira (que opera en EE.UU.) para instruir pagos ACH o Wire a sus proveedores internacionales. Los asesores en Bolivia acompañan todo el proceso: onboarding (KYB), operación y seguimiento. <a href=\"/pagos-proveedores-bolivia/\" class=\"text-guira-cyan hover:underline font-bold\">Ver solución específica para Bolivia →</a>"
    },
    {
        question: "¿Cuánto demoran los pagos hacia terceros en Estados Unidos (ACH/Wire)?",
        answer: "Al contar con un soporte documental previo, las instrucciones de pago a través de la red ACH o las ejecuciones en formato Wire se cursan de acuerdo a los tiempos bancarios habituales de Estados Unidos (usualmente el mismo día o al día siguiente hábil), minimizando así interrupciones injustificadas."
    }
];

