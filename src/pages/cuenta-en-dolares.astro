                  <span class="account-hero-desc">
                    <span class="account-hero-desc__title">Depósito cuenta operativa</span>
                    <span class="account-hero-desc__sub">Transferencia entrante</span>
                  </span>
                </div>
                <div class="account-hero-row flex items-center justify-between gap-4 px-6 py-5" aria-hidden="true">
