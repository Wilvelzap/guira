---
import Layout from "../layouts/Layout.astro";
import StackedSections from "../components/StackedSections.astro";
import KineticButton from "../components/KineticButton.astro";
import FaqSection from "../components/FaqSection.astro";
import EditorialGridSection from "../components/EditorialGridSection.astro";
import SplitFeatureSection from "../components/SplitFeatureSection.astro";

const queResuelveItems = [
  {
    title: "El cobro tarda",
    description:
      "Tu cliente dice que ya pagó, tu banco no lo ve y el equipo de finanzas queda a ciegas durante días.",
  },
  {
    title: "Papeles dispersos",
    description:
      "Factura, orden de compra, instrucción de pago y comprobante viven en cuatro lugares distintos.",
  },
  {
    title: "Cobros y pagos aislados",
    description:
      "Lo que entra por un canal no sirve para pagar por el otro, y cada operación empieza de cero.",
  },
];

const comoFuncionaItems = [
  {
    step: "01 · Paso inicial",
    title: "Validación de la empresa",
    description:
      "Presentas la documentación de constitución, los representantes autorizados y una descripción de la actividad. Es el proceso conocido como KYB.",
  },
  {
    step: "02 · Habilitación",
    title: "Apertura de la cuenta",
    description:
      "Tu empresa queda habilitada para recibir cobros en dólares e instruir pagos al exterior desde un mismo lugar. Cada empresa opera su propia cuenta, sin mezclarse con la de otras.",
  },
  {
    step: "03 · Operación",
    title: "Control y respaldo",
    description:
      "Cada cobro y cada pago quedan con su documentación asociada y su estado visible, listos para conciliación contable y auditoría financiera.",
  },
];

const segmentosItems = [
  {
    step: "01 · Servicios",
    title: "Exportadoras de servicios",
    description:
      "Agencias, estudios de software y consultoras que facturan a clientes en el exterior.",
  },
  {
    step: "02 · Comercio",
    title: "Importadoras",
    description:
      "Empresas que compran mercadería fuera del país y necesitan pagar a plazo fijo.",
  },
  {
    step: "03 · Corporativo",
    title: "Corporativos regionales",
    description:
      "Grupos con operación en varios países que necesitan una sola vista de sus movimientos.",
  },
  {
    step: "04 · Cooperación",
    title: "ONGs y cooperación",
    description:
      "Organizaciones que reciben desembolsos del exterior y deben rendir cuentas por cada uno.",
  },
];

const paraQueSirveFeatures = [
  {
    icon: "arrow-down-left",
    iconBgClass:
      "bg-teal-50 border border-teal-200 text-guira-teal shadow-lg shadow-teal-500/5 group-hover:scale-105 group-hover:border-guira-teal transition-all duration-300",
    title: "Cobrar a clientes del exterior",
    description:
      "Recibe pagos de clientes en Estados Unidos, Europa y la región sin intermediarios innecesarios y con visibilidad completa de cada acreditación.",
    button: {
      href: "/pagos-cobros-internacionales/",
      label: "Cómo cobrar del exterior",
      variant: "teal" as const,
    },
  },
  {
    icon: "arrow-up-right",
    iconBgClass:
      "bg-blue-50 border border-blue-200 text-guira-teal shadow-lg shadow-blue-500/5 group-hover:scale-105 group-hover:border-guira-teal transition-all duration-300",
    title: "Pagar a proveedores internacionales",
    description:
      "Instruye pagos a proveedores en el exterior con los datos del beneficiario, la factura comercial asociada y el seguimiento de cada operación.",
    button: {
      href: "/pagos-proveedores-bolivia/",
      label: "Pagos a proveedores",
      variant: "dark" as const,
    },
  },
];

const cuentaEnDolaresFaq = [
  {
    question: "¿Qué es exactamente una cuenta en dólares para empresas?",
    answer:
      "Es una cuenta operativa en dólares desde la que tu empresa cobra a clientes del exterior, instruye pagos a proveedores internacionales y consulta el estado de cada operación. Guira es la plataforma tecnológica que la ordena. La infraestructura financiera la provee un partner tecnológico licenciado en Estados Unidos.",
  },
  {
    question:
      "¿Puede una empresa boliviana operar una cuenta en dólares con el exterior?",
    answer:
      "Sí, siempre que complete la validación empresarial. Se revisa la documentación de constitución, los representantes autorizados y la actividad económica. La disponibilidad depende del perfil de la empresa, la jurisdicción y el caso de uso.",
  },
  {
    question: "¿Qué documentación necesita mi empresa?",
    answer:
      'En general se pide documentación de constitución de la empresa, identificación de los representantes autorizados, descripción de la actividad y respaldo comercial de las operaciones, como facturas o contratos. Puedes ver el detalle en <a href="/como-funciona/" class="text-guira-cyan font-bold hover:underline">cómo funciona</a>.',
  },
  {
    question: "¿Guira es un banco?",
    answer:
      "No. Guira es una plataforma tecnológica creada y operada por Guira System LLC, en Delaware, Estados Unidos. No es banco, entidad financiera ni casa de cambio. En Bolivia, Guiraglobal SRL es el equipo de asesoría comercial que acompaña a las empresas en el uso de la plataforma.",
  },
  {
    question: "¿Cuánto tarda la habilitación?",
    answer:
      "Depende de qué tan completa esté la documentación al momento de presentarla. El equipo asesor en Bolivia revisa contigo la carpeta antes de enviarla, que es lo que más acorta el proceso.",
  },
];
---

<Layout
  title="Cuenta en dólares para empresas en Bolivia | Guira"
  description="Opera una cuenta en dólares para tu empresa en Bolivia. Cobra a clientes del exterior, paga a tus proveedores y deja respaldo documental de cada operación."
  canonicalUrl="https://www.guiracorp.com/cuenta-en-dolares/"
  activeLink="cuenta-en-dolares"
  footerTheme="dark"
>
  <Fragment slot="head">
    <!-- Schema: Service + FAQPage -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Service",
            "name": "Cuenta operativa en dólares para empresas",
            "url": "https://www.guiracorp.com/cuenta-en-dolares/",
            "description": "Cuenta operativa en dólares para empresas en Bolivia, para cobrar a clientes del exterior, pagar a proveedores internacionales y conservar el respaldo documental de cada operación.",
            "provider": {
              "@type": "Organization",
              "name": "Guira System LLC",
              "url": "https://www.guiracorp.com"
            },
            "areaServed": {
              "@type": "Country",
              "name": "Bolivia"
            },
            "serviceType": "Cuenta operativa en dólares para empresas"
          },
          {
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "¿Qué es una cuenta en dólares para empresas?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Es una cuenta operativa en dólares desde la que tu empresa cobra a clientes del exterior, instruye pagos a proveedores internacionales y consulta el estado de cada operación. Guira es la plataforma tecnológica que la ordena. La infraestructura financiera la provee un partner tecnológico licenciado en Estados Unidos."
                }
              },
              {
                "@type": "Question",
                "name": "¿Puede una empresa boliviana abrir una cuenta en dólares para operar con el exterior?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Sí, siempre que complete la validación empresarial. Se revisa la documentación de constitución, los representantes autorizados y la actividad económica. La disponibilidad depende del perfil de la empresa, la jurisdicción y el caso de uso."
                }
              },
              {
                "@type": "Question",
                "name": "¿Qué documentación necesita mi empresa?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "En general se pide documentación de constitución de la empresa, identificación de los representantes autorizados, descripción de la actividad y respaldo comercial de las operaciones, como facturas o contratos."
                }
              },
              {
                "@type": "Question",
                "name": "¿Guira es un banco?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. Guira es una plataforma tecnológica creada y operada por Guira System LLC en Delaware, Estados Unidos. No es banco, entidad financiera ni casa de cambio. En Bolivia, Guiraglobal SRL es el equipo de asesoría comercial que acompaña a las empresas en el uso de la plataforma."
                }
              }
            ]
          }
        ]
      }
    </script>

    <!-- Schema: BreadcrumbList -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "https://www.guiracorp.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Soluciones",
            "item": "https://www.guiracorp.com/soluciones/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Cuenta en dólares para empresas",
            "item": "https://www.guiracorp.com/cuenta-en-dolares/"
          }
        ]
      }
    </script>
  </Fragment>

  <StackedSections>
    <!-- HERO -->
    <header
      data-stack-section
      class="relative pt-36 pb-24 overflow-hidden bg-guira-dark border-b border-white/5"
    >
      <div class="hero-operation-surface"></div>
      <div class="hero-operation-network" aria-hidden="true">
