            d="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"></path>
          <g class="hero-operation-network__capsule">
            <rect x="-28" y="-13" width="56" height="26" rx="13"></rect>
            <text x="0" y="4" text-anchor="middle">US$</text>
            <animateMotion
              dur="14s"
              begin="-4s"
              repeatCount="indefinite"
              path="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"
            ></animateMotion>
          </g>
          <g class="hero-operation-network__nodes">
            <circle cx="367" cy="500" r="3"></circle>
            <circle cx="390" cy="277" r="3"></circle>
            <circle cx="380" cy="443" r="2.5"></circle>
          </g>
        </svg>
      </div>

      <div
        class="max-w-7xl mx-auto px-4 relative z-10 grid lg:grid-cols-[1.15fr_0.85fr] gap-16 items-center"
      >
        <div class="text-left reveal">
          <div
            class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-xs font-bold text-guira-cyan bg-guira-teal/10 border border-guira-teal/25 mb-8"
          >
            <span class="signal-dot w-2 h-2 rounded-full bg-guira-cyan"></span>
            Para empresas en Bolivia · Guira opera desde EE.UU.
          </div>

          <h1
            class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-[1.1]"
          >
            <span class="text-white">Cuenta en dólares</span><br />
            <span class="text-guira-cyan">para empresas</span>
            <span class="text-white"> en Bolivia</span>
          </h1>

          <p
            class="text-base md:text-lg text-slate-400 mb-10 max-w-xl font-medium leading-relaxed"
          >
            Una sola cuenta operativa en dólares para cobrar a tus clientes del
            exterior, pagar a tus proveedores internacionales y seguir el estado
            de cada operación. Sin abrir un trámite bancario distinto cada vez.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-12">
            <KineticButton
              href="/demo/"
              variant="teal"
              size="lg"
              label="Hablar con un asesor"
              class="w-full sm:w-auto"
            />
            <KineticButton
              href="/como-funciona/"
              variant="dark"
              size="lg"
              label="Ver cómo funciona"
              class="w-full sm:w-auto"
            />
          </div>

          <div class="flex flex-wrap items-center gap-x-10 gap-y-6 max-w-lg">
            <div class="pr-10 border-r border-white/20">
              <p class="text-xs font-bold text-slate-400 section-kicker mb-2">
                Cobra
              </p>
              <p class="text-lg font-extrabold text-white">
                Clientes del exterior
              </p>
            </div>
            <div class="pr-10 border-r border-white/20">
              <p class="text-xs font-bold text-slate-400 section-kicker mb-2">
                Paga
              </p>
              <p class="text-lg font-extrabold text-white">
                Proveedores internacionales
              </p>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-400 section-kicker mb-2">
                Documenta
              </p>
              <p class="text-lg font-extrabold text-guira-cyan">
                Respaldo por operación
              </p>
            </div>
          </div>
        </div>

        <!-- Mockup -->
        <div
          class="relative mx-auto w-full max-w-xl reveal reveal-delay-2 account-hero-tilt-wrap"
        >
          <div class="account-hero-table account-hero-tilt overflow-hidden">
            <div
              class="flex items-center justify-between px-6 py-5 border-b border-slate-100"
            >
              <p class="text-sm font-extrabold text-slate-900">
                Operaciones recientes
              </p>
              <span
