    <!-- QUÉ RESUELVE -->
    <EditorialGridSection
      theme="light"
      kicker="El problema real"
      title="Operar en dólares desde Bolivia no debería depender de un trámite distinto cada vez."
      items={queResuelveItems}
    />

    <!-- CÓMO FUNCIONA -->
    <EditorialGridSection
      theme="dark"
      kicker="Cómo se abre"
      title="Tres pasos, y tu empresa opera en dólares desde Bolivia."
      items={comoFuncionaItems}
    />

    <!-- PARA QUÉ SIRVE -->
    <SplitFeatureSection
      theme="light"
      kicker="Qué puedes hacer"
      topBadge="FLUIDEZ OPERATIVA B2B"
      title="Una cuenta, las dos puntas de tu operación internacional"
      description="Centraliza los cobros de tus clientes del exterior y las instrucciones de pago a tus proveedores en una sola cuenta operativa en dólares."
      features={paraQueSirveFeatures}
    />

    <!-- PARA QUIÉN -->
    <EditorialGridSection
      theme="dark"
      kicker="Para quién es"
      title="Empresas formales con operación internacional recurrente."
      items={segmentosItems}
      columns={4}
    >
      <Fragment slot="header-right">
        <div
          class="flex items-center gap-2 text-2xl sm:text-3xl font-black italic tracking-tighter text-white"
        >
          <span>Segmentos</span>
          <span
            class="text-xs not-italic font-bold tracking-widest uppercase bg-guira-cyan text-guira-navy px-2.5 py-1 rounded font-sans"
            >B2B LATAM</span
          >
        </div>
        <div
          class="mt-4 lg:mt-0 text-sm font-semibold text-slate-400 text-left lg:text-right"
        >
          Casos de uso empresarial
        </div>
      </Fragment>
    </EditorialGridSection>

    <!-- FAQ -->
    <FaqSection
      kicker="Preguntas frecuentes"
      topBadge="RESOLUCIÓN DE DUDAS"
      title="Lo que más nos preguntan"
      description="Todo lo que tu equipo financiero y contable necesita saber antes de habilitar la cuenta operativa en dólares con Guira."
      items={cuentaEnDolaresFaq}
    />

    <!-- CTA -->
    <section
      data-stack-section
      class="py-24 bg-guira-dark relative overflow-hidden"
