                    <span class="account-hero-desc__sub">Cuenta operativa en dólares</span>
                  </span>
                </div>
                <div class="account-hero-row flex items-center justify-between gap-4 px-6 py-5">
                  <span class="account-hero-id">#58cd103a</span>
                  <span class="account-hero-status account-hero-status--ok">Completado</span>
                  <span class="account-hero-desc">
