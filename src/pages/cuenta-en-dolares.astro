                    <span class="account-hero-desc__sub">Cuenta operativa en dólares</span>
                  </span>
                </div>
                <div class="account-hero-row flex items-center justify-between gap-4 px-6 py-5">
                  <span class="account-hero-id">#6ef73d2c</span>
                  <span class="account-hero-status account-hero-status--ok">Completado</span>
                  <span class="account-hero-desc">
                    <span class="account-hero-desc__title">Factura comercial adjunta</span>
                    <span class="account-hero-desc__sub">Documentación de respaldo</span>
                  </span>
                </div>
                <!-- Duplicado para el loop continuo del carrusel -->
                <div class="account-hero-row flex items-center justify-between gap-4 px-6 py-5" aria-hidden="true">
                  <span class="account-hero-id">#7a2f91c4</span>
                  <span class="account-hero-status account-hero-status--ok">Completado</span>
                  <span class="account-hero-desc">
                    <span class="account-hero-desc__title">Cobro cliente EE.UU.</span>
                    <span class="account-hero-desc__sub">Cuenta operativa en dólares</span>
                  </span>
                </div>
                <div class="account-hero-row flex items-center justify-between gap-4 px-6 py-5" aria-hidden="true">
