---
import Layout from "../layouts/Layout.astro";
import KineticButton from "../components/KineticButton.astro";
import SecurityHeroAnimation from "../components/SecurityHeroAnimation.astro";
import SecurityHorizontalCards from "../components/SecurityHorizontalCards.astro";
---

<Layout
    title="Compliance y Seguridad Operativa para Pagos B2B Internacionales | Guira Empresas"
    description="Conoce cómo Guira ayuda a empresas de LATAM a operar con validación empresarial, trazabilidad, controles de acceso e infraestructura conectada a partners aplicables."
    keywords="seguridad para pagos empresariales, plataforma tecnológica segura para empresas, trazabilidad operativa, validación empresarial, compliance para empresas, operación internacional segura, controles para pagos internacionales"
    canonicalUrl="https://www.guiracorp.com/seguridad"
    footerTheme="light"
    copyright="Compliance y Legal. © 2026 Guira System LLC. Representado en Bolivia por Guiraglobal SRL. Todos los derechos reservados."
>
    <Fragment slot="head">
        <!-- Schema: BreadcrumbList -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Inicio",
                        "item": "https://www.guiracorp.com/"
                    },
                    {
                        "@type": "ListItem",
                        "position": 2,
                        "name": "Seguridad y Compliance",
                        "item": "https://www.guiracorp.com/seguridad"
                    }
                ]
            }
        </script>
    </Fragment>

    <!-- Hero -->
    <header
        class="pt-28 md:pt-32 pb-16 md:pb-20 relative z-10 bg-white border-b border-slate-200 overflow-hidden"
    >
        <div
            class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-8 lg:gap-0 items-center relative"
        >
            <div class="lg:col-span-6 text-left reveal-up relative z-20">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-slate-200 shadow-sm text-xs font-bold text-slate-600 mb-6 cursor-default"
                >
                    <span
                        class="w-2 h-2 rounded-full bg-guira-teal animate-pulse"
                    ></span>
                    Seguridad y compliance
                </div>
                <h1
                    class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-6 leading-[1.1] tracking-tight"
                >
                    Seguridad y <span class="text-guira-teal">confianza</span> para la operación internacional de tu
                    empresa
                </h1>
                <p
                    class="text-base md:text-lg text-slate-600 font-medium max-w-xl leading-relaxed"
                >
                    Guira combina validación empresarial, trazabilidad operativa
                    y controles tecnológicos para ofrecer una experiencia más
                    segura, clara y confiable a empresas de LATAM.
                </p>
            </div>

            <!-- Animación de Candado + Código Cifrado + Pulso de Radar (Expandido) -->
            <div
                class="lg:col-span-6 relative w-full flex items-center justify-center lg:justify-center reveal-up delay-100 z-10 -my-6 lg:-my-14 lg:-ml-8 xl:-ml-12"
            >
                <SecurityHeroAnimation />
            </div>
        </div>
    </header>

    <!-- Recorrido Horizontal de Pilares de Seguridad (GSAP ScrollTrigger) -->
    <SecurityHorizontalCards />

    <!-- Disclaimer Legal -->
    <section class="py-12 bg-white border-b border-slate-200 relative z-10">
        <div class="max-w-7xl mx-auto px-6">
            <div class="bg-slate-50 p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm">
                <div class="flex gap-3.5">
                    <i
                        data-lucide="info"
                        class="w-5 h-5 text-slate-400 shrink-0 mt-0.5"></i>
                    <p
                        class="text-slate-500 text-xs md:text-sm leading-relaxed font-medium"
                    >
                        Guira es una plataforma tecnológica B2B. No somos banco,
                        entidad financiera, casa de cambio ni custodio directo
                        de fondos. Los servicios financieros, rieles de pago,
                        cuentas de recepción, custodia, movimiento de fondos o
                        procesamiento transaccional, cuando correspondan, son
                        provistos exclusivamente por terceros o partners
                        aplicables bajo sus propias autorizaciones, términos,
                        límites, jurisdicciones y criterios de aprobación. La
                        disponibilidad del servicio depende del perfil de la
                        empresa, documentación presentada, jurisdicción, caso de
                        uso y revisión correspondiente.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Cierre -->
    <section
        class="py-20 bg-guira-navy text-center relative overflow-hidden z-20"
    >
        <div class="max-w-3xl mx-auto px-6 relative z-10 reveal-up">
            <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-white mb-4">
                Conoce cómo opera Guira para empresas de LATAM
            </h2>
            <p class="text-slate-400 font-medium leading-relaxed mb-8 max-w-2xl mx-auto">
                Solicita una demo para revisar el proceso, los criterios de
                validación y cómo Guira puede ayudarte a operar con más
                trazabilidad y control.
            </p>
            <div
                class="flex flex-col sm:flex-row items-center justify-center gap-4"
            >
                <KineticButton
                    href="/demo/"
                    variant="teal"
                    size="lg"
                    label="Solicitar demo"
                    class="w-full sm:w-auto"
                />
                <KineticButton
                    href="/contacto/"
                    variant="dark"
                    size="lg"
                    label="Hablar con ventas"
                    class="w-full sm:w-auto"
                />
            </div>
            <div class="mt-10">
                <a
                    href="/faq/"
                    class="font-bold text-slate-400 hover:text-guira-teal transition-colors text-sm"
                    >¿Tienes dudas adicionales? Consulta las FAQ &rarr;</a
                >
            </div>
        </div>
    </section>
</Layout>
