---
import Layout from "../layouts/Layout.astro";
import StackedSections from "../components/StackedSections.astro";
import ProductExplorer from "../components/ProductExplorer.astro";
import Flag from "../components/Flag.astro";
---

<Layout
    title="Plataforma Operativa Multi-moneda para Empresas de LATAM | Guira Empresas"
    description="Guira Empresas es la plataforma B2B para que agencias, exportadoras e importadoras de LATAM operen internacionalmente en dólares, euros, pesos mexicanos, pesos colombianos o reales: recepción de pagos, trazabilidad operativa y pagos a proveedores desde una sola interfaz."
    keywords="plataforma de pagos internacional, cuenta multi-moneda para empresas, cuenta en USD para empresas, recibir pagos en USD, recibir pagos desde Estados Unidos, pagos empresariales internacionales, plataforma tecnológica para empresas en LATAM, pagos a proveedores Bolivia, empresa boliviana pagar proveedor extranjero, pagar proveedores internacionales desde Bolivia, cuenta en USD para empresas bolivianas, pagos en euros para empresas, pagos a México desde Bolivia, pagos a Colombia desde Bolivia, pagos a Brasil desde Bolivia"
    canonicalUrl="https://www.guiracorp.com/"
    activeLink="index"
    footerTheme="rich-dark"
>
    <Fragment slot="head">
        <!-- Schema: Organization + WebSite -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "Organization",
                "name": "Guira System LLC",
                "alternateName": "Guira Empresas",
                "url": "https://www.guiracorp.com",
                "description": "Plataforma tecnológica operativa B2B con sede en EE.UU. para pagos empresariales internacionales multi-moneda (USD, EUR, MXN, COP, BRL). Centraliza la recepción de pagos, visibilidad operativa y pagos a proveedores mediante ACH o Wire para empresas de LATAM.",
                "logo": "https://www.guiracorp.com/guira-logo.svg",
                "image": "https://www.guiracorp.com/assets/images/og-image.jpg",
                "telephone": "+13057681048",
                "email": "administracion@guiracorp.com",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "1201 North Market Street #111",
                    "addressLocality": "Wilmington",
                    "addressRegion": "Delaware",
                    "postalCode": "19801",
                    "addressCountry": "US"
                },
                "areaServed": [
                    { "@type": "Place", "name": "América Latina" },
                    { "@type": "Country", "name": "Bolivia" },
                    { "@type": "Country", "name": "Colombia" },
                    { "@type": "Country", "name": "Perú" },
                    { "@type": "Country", "name": "México" }
                ],
                "contactPoint": [
                    {
                        "@type": "ContactPoint",
                        "telephone": "+13057681048",
                        "contactType": "sales",
                        "areaServed": "LATAM",
                        "availableLanguage": "Spanish"
                    },
                    {
                        "@type": "ContactPoint",
                        "telephone": "+59175245845",
                        "contactType": "customer support",
                        "areaServed": "BO",
                        "availableLanguage": "Spanish"
                    }
                ],
                "hasOfferCatalog": {
                    "@type": "OfferCatalog",
                    "name": "Servicios Financieros Empresariales",
                    "itemListElement": [
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Cuenta Operativa Multi-moneda para Empresas",
                                "description": "Recibe pagos en dólares, euros, pesos mexicanos, pesos colombianos o reales desde el exterior con datos de recepción en tu nombre corporativo."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Pagos empresariales ACH y Wire",
                                "description": "Instruye pagos a proveedores internacionales mediante ACH o Wire con trazabilidad completa."
                            }
                        }
                    ]
                },
                "sameAs": []
            }
        </script>
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "name": "Guira Empresas",
                "url": "https://www.guiracorp.com"
            }
        </script>
        <link
            rel="preload"
            as="image"
            href="/assets/images/hero-ejecutivo.webp"
            type="image/webp"
        />
    </Fragment>

    <StackedSections>
        <!-- Hero -->
        <header
            data-stack-section
            class="relative pt-20 md:pt-24 pb-24 overflow-hidden border-b border-slate-200"
        >
            <div class="absolute inset-0">
                <picture class="w-full h-full block">
                    <source
                        srcset="/assets/images/hero-ejecutivo.webp"
                        type="image/webp"
                        fetchpriority="high"
                    />
                    <img
                        src="/assets/images/hero-ejecutivo.jpg"
                        alt=""
                        class="w-full h-full object-cover object-center"
                        aria-hidden="true"
                        fetchpriority="high"
                    />
                </picture>
                <div
                    class="absolute inset-0 bg-gradient-to-r from-white via-white/96 to-white/55"
                >
                </div>
            </div>

            <div
                class="max-w-7xl mx-auto px-6 relative z-10 grid xl:grid-cols-[1.1fr_0.9fr] gap-14 items-center"
            >
                <div class="text-left">
                    <div class="reveal">
                        <span
                            class="fintech-badge inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold text-guira-teal mb-8"
                        >
                            <span
                                class="w-1.5 h-1.5 rounded-full bg-guira-teal"
                            ></span>
                            Plataforma tecnológica para empresas de LATAM · Presencia
                            en Bolivia
                        </span>
                    </div>

                    <h1
                        class="reveal reveal-delay-1 text-3xl md:text-4xl font-extrabold tracking-tight mb-6 leading-[1.2] text-slate-900 max-w-3xl"
                    >
                        Plataforma operativa para pagos empresariales
                        internacionales
                    </h1>

                    <p
                        class="reveal reveal-delay-2 text-base md:text-lg text-slate-500 mb-10 max-w-xl font-medium leading-relaxed"
                    >
                        Centraliza la recepción, visibilidad y las
                        instrucciones de pago de tu empresa con respaldo
                        documental y partners internacionales calificados.
                    </p>

                    <div
                        class="reveal reveal-delay-3 flex flex-col sm:flex-row items-center sm:items-stretch gap-4 mb-12"
                    >
                        <a
                            href="https://app.guiracorp.com"
                            class="w-full sm:w-auto px-8 py-4 bg-slate-900 text-white rounded-xl font-bold text-lg hover:bg-slate-800 transition-all shadow-xl shadow-slate-900/20 hover:-translate-y-1 flex items-center justify-center gap-2"
                        >
                            Comenzar Onboarding Empresarial
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </a>
                        <a
                            href="/demo"
                            class="w-full sm:w-auto px-8 py-4 bg-white text-slate-700 border border-slate-200 rounded-xl font-bold text-lg hover:bg-slate-50 transition-all shadow-sm hover:-translate-y-1"
                        >
                            Hablar con Ventas
                        </a>
                    </div>

                    <div
                        class="reveal reveal-delay-4 flex flex-wrap items-center gap-x-10 gap-y-6 max-w-xl"
                    >
                        <div class="pr-10 border-r border-slate-200">
                            <p
                                class="text-xs font-bold text-slate-400 section-kicker mb-2"
                            >
                                Onboarding
                            </p>
                            <p class="text-lg font-extrabold text-slate-900">
                                Empresarial
                            </p>
                        </div>
                        <div class="pr-10 border-r border-slate-200">
                            <p
                                class="text-xs font-bold text-slate-400 section-kicker mb-2"
                            >
                                Canales
                            </p>
                            <p class="text-lg font-extrabold text-slate-900">
                                ACH / Wire
                            </p>
                        </div>
                        <div>
                            <p
                                class="text-xs font-bold text-slate-400 section-kicker mb-2"
                            >
                                Control
                            </p>
                            <p class="text-lg font-extrabold text-slate-900">
                                Trazabilidad
                            </p>
                        </div>
                    </div>
                </div>

                <div
                    class="hidden xl:block relative h-[420px] reveal reveal-delay-4"
                >
                    <img
                        src="/assets/images/tablet_sin_fondo.png"
                        alt="Panel de operaciones de Guira Empresas en tablet"
                        class="absolute inset-0 w-full h-full object-contain object-center"
                    />
                    <img
                        src="/assets/images/telefono_guira_sin_fondo.png"
                        alt="Panel de operaciones de Guira Empresas en el celular"
                        class="absolute bottom-0 -right-10 h-[92%] w-auto drop-shadow-2xl rotate-6"
                    />
                </div>
            </div>
        </header>

        <!-- Cotizador -->
        <section
            data-stack-section
            class="py-24 bg-white border-b border-slate-200 relative overflow-hidden hidden"
        >
            <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,81,255,0.06),transparent_32%)]"
            >
            </div>
            <div class="max-w-4xl mx-auto px-6 relative z-10">
                <div class="text-center mb-14 reveal">
                    <p class="section-kicker text-guira-teal mb-4">
                        Simulador de operación
                    </p>
                    <h2
                        class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-4"
                    >
                        Ve cuánto llega, en la moneda que elijas.
                    </h2>
                    <p
                        class="text-slate-500 text-lg font-medium max-w-2xl mx-auto"
                    >
                        Simula el destino de tu saldo en dólares: tu cuenta
                        Guira, tu wallet propia en stablecoins o tu banco en
                        bolivianos.
                    </p>
                </div>

                <div
                    class="premium-card rounded-3xl p-6 md:p-10 reveal-up"
                    data-quote-widget
                >
                    <p class="section-kicker text-slate-400 mb-3">
                        Envías desde tu cuenta Guira
                    </p>
                    <div
                        class="flex items-center justify-between gap-3 bg-slate-50 border border-slate-200 rounded-2xl p-5 mb-8"
                    >
                        <input
                            type="text"
                            inputmode="decimal"
                            value="100.00"
                            aria-label="Monto a enviar en dólares"
                            class="w-full bg-transparent text-2xl md:text-3xl font-extrabold text-slate-900 focus:outline-none"
                            data-quote-input
                        />
                        <span
                            class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-3 py-2 font-bold text-sm text-slate-700 shrink-0"
                        >
                            <Flag code="us" /> USD
                        </span>
                    </div>

                    <p class="section-kicker text-slate-400 mb-3">
                        Elige el destino
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
                        <button
                            type="button"
                            class="quote-destination-btn active"
                            data-quote-destination
                            data-rate="1"
                            data-currency="USD"
                            data-note="Sin conversión de moneda. El saldo se mantiene en tu cuenta Guira."
                        >
                            <i data-lucide="landmark" class="w-5 h-5"></i>
                            <span>
                                <span class="quote-destination-btn__title"
                                    >Cuenta Guira</span
                                >
                                <span class="quote-destination-btn__meta"
                                    >Saldo en USD</span
                                >
                            </span>
                        </button>
                        <button
                            type="button"
                            class="quote-destination-btn"
                            data-quote-destination
                            data-rate="1"
                            data-currency="USDC/USDT"
                            data-note="Envío a tu wallet externa y propia, en Binance u otro exchange de tu preferencia."
                        >
                            <i data-lucide="coins" class="w-5 h-5"></i>
                            <span>
                                <span class="quote-destination-btn__title"
                                    >Wallet propia</span
                                >
                                <span class="quote-destination-btn__meta"
                                    >Stablecoins</span
                                >
                            </span>
                        </button>
                        <button
                            type="button"
                            class="quote-destination-btn"
                            data-quote-destination
                            data-rate="11.40"
                            data-currency="BOB"
                            data-note="Conversión a tu cuenta bancaria local en bolivianos."
                        >
                            <i data-lucide="banknote" class="w-5 h-5"></i>
                            <span>
                                <span class="quote-destination-btn__title"
                                    >Cuenta BOB</span
                                >
                                <span class="quote-destination-btn__meta"
                                    >Banco local</span
                                >
                            </span>
                        </button>
                    </div>

                    <div class="bg-slate-900 rounded-2xl p-6 md:p-8">
                        <p class="section-kicker text-slate-400 mb-3">
                            Recibes
                        </p>
                        <div
                            class="flex items-baseline justify-between flex-wrap gap-2"
                        >
                            <span
                                class="text-3xl md:text-4xl font-extrabold text-white"
                                data-quote-output>100.00</span
                            >
                            <span
                                class="text-sm font-bold text-guira-cyan"
                                data-quote-currency-label
                                >USD · Cuenta Guira</span
                            >
                        </div>
                        <p
                            class="text-xs text-slate-400 font-medium mt-3"
                            data-quote-note
                        >
                            Sin conversión de moneda. El saldo se mantiene en tu
                            cuenta Guira.
                        </p>
                    </div>

                    <p
                        class="text-[11px] text-slate-400 font-medium mt-5 text-center"
                    >
                        * Simulación referencial. El tipo de cambio y las
                        condiciones finales se confirman en cada operación según
                        la estructura habilitada.
                    </p>
                </div>
            </div>
        </section>

        <!-- Bloque Presencia e Infraestructura -->
        <section
            data-stack-section
            class="py-12 bg-guira-navy border-b border-slate-800"
        >
            <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-8">
                <div class="flex items-center gap-4 reveal">
                    <div
                        class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center text-slate-300 border border-slate-700"
                    >
                        <i data-lucide="building-2" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3
                            class="font-bold text-white text-sm uppercase tracking-wider"
                        >
                            Estructura Corporativa
                        </h3>
                        <p class="text-slate-400 text-sm font-medium">
                            Empresa matriz operativa en Delaware, EE.UU.
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-4 reveal reveal-delay-1">
                    <div
                        class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center text-slate-300 border border-slate-700"
                    >
                        <i data-lucide="map-pin" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3
                            class="font-bold text-white text-sm uppercase tracking-wider"
                        >
                            Asesores en Bolivia
                        </h3>
                        <p class="text-slate-400 text-sm font-medium">
                            Equipo asesor local para empresas que quieren usar
                            Guira.
                        </p>
                        <a
                            href="/pagos-proveedores-bolivia"
                            class="text-guira-teal text-xs font-bold hover:underline mt-1 inline-block"
                            >Ver solución para Bolivia →</a
                        >
                    </div>
                </div>
                <div class="flex items-center gap-4 reveal reveal-delay-2">
                    <div
                        class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center text-slate-300 border border-slate-700"
                    >
                        <i data-lucide="users" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3
                            class="font-bold text-white text-sm uppercase tracking-wider"
                        >
                            Acompañamiento B2B
                        </h3>
                        <p class="text-slate-400 text-sm font-medium">
                            Equipo humano consultivo y permanente.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Franja Confianza -->
        <section
            data-stack-section
            class="py-10 border-b border-slate-200 bg-white relative overflow-hidden"
        >
            <div class="max-w-7xl mx-auto px-6">
                <p
                    class="text-center text-xs font-bold tracking-widest text-slate-400 uppercase mb-8"
                >
                    Infraestructura desarrollada para escalar tu operación
                    internacional
                </p>
                <div class="relative overflow-hidden">
                    <div
                        class="absolute inset-y-0 left-0 w-20 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"
                    >
                    </div>
                    <div
                        class="absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"
                    >
                    </div>
                    <div class="marquee-track">
                        <div class="marquee-chip">
                            <i
                                data-lucide="check-circle"
                                class="w-4 h-4 text-guira-teal"></i>
                            Validación empresarial según perfil
                        </div>
                        <div class="marquee-chip">
                            <i
                                data-lucide="file-check-2"
                                class="w-4 h-4 text-guira-teal"></i> Soporte documental
                            y trazabilidad
                        </div>
                        <div class="marquee-chip">
                            <i
                                data-lucide="arrow-right-left"
                                class="w-4 h-4 text-guira-teal"></i>
                            Operación entre rieles habilitados
                        </div>
                        <div class="marquee-chip">
                            <i
                                data-lucide="building-2"
                                class="w-4 h-4 text-guira-teal"></i>
                            Experiencia diseñada para empresas
                        </div>
                        <div class="marquee-chip">
                            <i
                                data-lucide="check-circle"
                                class="w-4 h-4 text-guira-teal"></i>
                            Validación empresarial según perfil
                        </div>
                        <div class="marquee-chip">
                            <i
                                data-lucide="file-check-2"
                                class="w-4 h-4 text-guira-teal"></i> Soporte documental
                            y trazabilidad
                        </div>
                        <div class="marquee-chip">
                            <i
                                data-lucide="arrow-right-left"
                                class="w-4 h-4 text-guira-teal"></i>
                            Operación entre rieles habilitados
                        </div>
                        <div class="marquee-chip">
                            <i
                                data-lucide="building-2"
                                class="w-4 h-4 text-guira-teal"></i>
                            Experiencia diseñada para empresas
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Banner Visual LATAM -->
        <section
            data-stack-section
            class="relative h-72 md:h-96 overflow-hidden"
        >
            <video
                class="w-full h-full object-cover object-center"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label="Infraestructura operativa para empresas de LATAM"
                data-restart-on-view
            >
                <source
                    src="https://res.cloudinary.com/dbrkedvyp/video/upload/v1784908883/BusquedaGuira_ew64og.webm"
                    type="video/webm"
                />
            </video>
        </section>

        <!-- Problema / Solución -->
        <section
            data-stack-section
            class="relative flex min-h-[100dvh] flex-col overflow-hidden bg-guira-navy"
        >
            <div class="grid shrink-0 md:grid-cols-2">
                <!-- Encabezado: Operación tradicional -->
                <div
                    class="relative overflow-hidden bg-guira-navy px-6 pb-8 pt-14 sm:px-10 md:px-16 lg:px-[clamp(4rem,8vw,10rem)]"
                >
                    <div
                        class="absolute inset-0 opacity-40 [background-image:radial-gradient(circle_at_1px_1px,rgba(148,163,184,0.18)_1px,transparent_0)] [background-size:24px_24px]"
                        aria-hidden="true"
                    >
                    </div>
                    <div
                        class="relative z-10 mx-auto max-w-xl pair-reveal-left"
                        data-replay-reveal
                    >
                        <p class="section-kicker text-slate-500">
                            Operación tradicional
                        </p>
                        <h2
                            class="mt-5 max-w-lg text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl lg:text-5xl"
                        >
                            Desafíos de la operación tradicional
                        </h2>
                        <p
                            class="mt-5 max-w-md text-base font-medium leading-relaxed text-slate-400 sm:text-lg"
                        >
                            Abrir una cuenta bancaria internacional requiere
                            presencia física, tiempo y altos costos.
                        </p>
                    </div>
                </div>

                <!-- Encabezado: Guira Empresas -->
                <div
                    class="relative overflow-hidden bg-guira-petrol px-6 pb-8 pt-14 sm:px-10 md:px-16 lg:px-[clamp(4rem,8vw,10rem)]"
                >
                    <div
                        class="absolute -right-32 -top-24 h-[430px] w-[430px] rounded-full bg-guira-teal/20 blur-[110px]"
                        aria-hidden="true"
                    >
                    </div>
                    <div
                        class="relative z-10 mx-auto max-w-xl pair-reveal-right"
                        data-replay-reveal
                    >
                        <p class="section-kicker text-guira-cyan">
                            La alternativa Guira
                        </p>
                        <h2
                            class="mt-5 max-w-lg text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl lg:text-5xl"
                        >
                            Guira Empresas
                        </h2>
                        <p
                            class="mt-5 max-w-md text-base font-medium leading-relaxed text-slate-300 sm:text-lg"
                        >
                            Una plataforma operativa multi-moneda para cobrar, pagar
                            y tener control de cada operación.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Pares problema → solución -->
            <div class="relative flex flex-1 flex-col border-t border-white/5">
                <div
                    class="grid flex-1 grid-cols-1 border-b border-white/5 md:grid-cols-2"
                >
                    <div
                        class="pair-reveal-left flex h-full items-center gap-5 bg-guira-navy px-6 py-8 sm:px-10 md:px-16 lg:px-[clamp(4rem,8vw,10rem)]"
                        data-replay-reveal
                    >
                        <span
                            class="font-mono text-xs tracking-wider text-slate-600"
                            >01</span
                        >
                        <span
                            class="h-px flex-1 max-w-6 bg-slate-700/60"
                            aria-hidden="true"
                        ></span>
                        <span
                            class="text-sm font-medium leading-relaxed text-slate-300 sm:text-base"
                            >Dificultad para recibir pagos en USD desde LATAM
                            de forma fluida.</span
                        >
                    </div>
                    <div
                        class="pair-reveal-right flex h-full items-center gap-5 bg-guira-petrol px-6 py-8 sm:px-10 md:px-16 lg:px-[clamp(4rem,8vw,10rem)]"
                        data-replay-reveal
                    >
                        <span
                            class="font-mono text-xs tracking-wider text-guira-cyan/70"
                            >01</span
                        >
                        <span
                            class="h-px flex-1 max-w-6 bg-guira-cyan/30"
                            aria-hidden="true"
                        ></span>
                        <span
                            class="text-sm font-medium leading-relaxed text-slate-200 sm:text-base"
                            >Estructura habilitada mediante partners para la
                            recepción de fondos.</span
                        >
                    </div>
                </div>

                <div
                    class="reveal-delay-1 grid flex-1 grid-cols-1 border-b border-white/5 md:grid-cols-2"
                >
