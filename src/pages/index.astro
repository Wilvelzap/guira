---
import Layout from "../layouts/Layout.astro";
import StackedSections from "../components/StackedSections.astro";
import ProductExplorer from "../components/ProductExplorer.astro";
import Flag from "../components/Flag.astro";
import KineticButton from "../components/KineticButton.astro";
import FaqSection from "../components/FaqSection.astro";

const homeFaq = [
    {
        question: "¿A quién está dirigida la plataforma?",
        answer: "Exclusivamente a empresas, importadores, exportadores y entidades corporativas debidamente registradas que requieran herramientas formales para operar pagos y cobros B2B internacionales.",
    },
    {
        question:
            "¿La cuenta internacional se registra a nombre de mi empresa?",
        answer: "Así es, dispones de una cuenta operativa empresarial donde la razón social de tu empresa figura como titular o beneficiaria para recibir cobros y emitir pagos a proveedores.",
    },
    {
        question: "¿Guira es una entidad bancaria tradicional?",
        answer: "No. Guira es una plataforma tecnológica creada y operada por Guira System LLC en Delaware, EE. UU. Todos los servicios financieros aplicables y la custodia de fondos son provistos por partners tecnológicos e instituciones reguladas en Estados Unidos.",
    },
];

const coverageCol1 = [
    {
        name: "Bolivia",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/bo.svg",
    },
    {
        name: "Estados Unidos",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/us.svg",
    },
    {
        name: "Perú",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/pe.svg",
    },
    {
        name: "Colombia",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/co.svg",
    },
    {
        name: "China",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/cn.svg",
    },
    {
        name: "Chile",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/cl.svg",
    },
    {
        name: "España",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/es.svg",
    },
    {
        name: "Reino Unido",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/gb.svg",
    },
];

const coverageCol2 = [
    {
        name: "Brasil",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/br.svg",
    },
    {
        name: "México",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/mx.svg",
    },
    {
        name: "Argentina",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/ar.svg",
    },
    {
        name: "Canadá",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/ca.svg",
    },
    {
        name: "Unión Europea",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/european_union.svg",
    },
    {
        name: "Panamá",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/pa.svg",
    },
    {
        name: "Alemania",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/de.svg",
    },
    {
        name: "Japón",
        flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/jp.svg",
