---

<Layout
    title="Paga a proveedores y cobra en dólares desde Bolivia | Guira"
    description="Paga a tus proveedores en el exterior y cobra a tus clientes del exterior desde una cuenta operativa en dólares. Con respaldo documental en cada operación."
    canonicalUrl="https://www.guiracorp.com/"
    activeLink="index"
    footerTheme="rich-dark"
>
    <Fragment slot="head">
        <!-- Schema: Organization + WebSite -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "Organization",
                "name": "Guira System LLC",
                "alternateName": "Guira Empresas",
                "url": "https://www.guiracorp.com",
                "description": "Plataforma tecnológica operativa B2B con sede en EE.UU. para pagos empresariales internacionales multi-moneda (USD, EUR, MXN, COP, BRL). Centraliza la recepción de pagos, visibilidad operativa y pagos a proveedores mediante ACH o Wire para empresas de LATAM.",
                "logo": "https://www.guiracorp.com/guira-logo.svg",
                "image": "https://www.guiracorp.com/assets/images/og-image.jpg",
                "telephone": "+13057681048",
                "email": "administracion@guiracorp.com",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "1201 North Market Street #111",
                    "addressLocality": "Wilmington",
                    "addressRegion": "Delaware",
                    "postalCode": "19801",
                    "addressCountry": "US"
                },
                "areaServed": [
                    { "@type": "Place", "name": "América Latina" },
                    { "@type": "Country", "name": "Bolivia" },
                    { "@type": "Country", "name": "Colombia" },
                    { "@type": "Country", "name": "Perú" },
                    { "@type": "Country", "name": "México" }
                ],
                "contactPoint": [
                    {
                        "@type": "ContactPoint",
                        "telephone": "+13057681048",
                        "contactType": "sales",
                        "areaServed": "LATAM",
                        "availableLanguage": "Spanish"
                    },
                    {
                        "@type": "ContactPoint",
                        "telephone": "+59167015106",
                        "contactType": "customer support",
                        "areaServed": "BO",
                        "availableLanguage": "Spanish"
                    }
                ],
                "hasOfferCatalog": {
                    "@type": "OfferCatalog",
                    "name": "Servicios Financieros Empresariales",
                    "itemListElement": [
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Cuenta Operativa Multi-moneda para Empresas",
                                "description": "Recibe pagos en dólares, euros, pesos mexicanos, pesos colombianos o reales desde el exterior con datos de recepción en tu nombre corporativo."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Pagos empresariales ACH y Wire",
                                "description": "Instruye pagos a proveedores internacionales mediante ACH o Wire con trazabilidad completa."
                            }
                        }
                    ]
                },
                "sameAs": []
            }
        </script>
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "name": "Guira Empresas",
                "url": "https://www.guiracorp.com"
            }
        </script>
        <link
            rel="preload"
            as="image"
            href="/assets/images/hero-ejecutivo.webp"
            type="image/webp"
        />
    </Fragment>

    <!-- Hero -->
    <header
        data-stack-section
        class="relative min-h-screen overflow-hidden border-b border-slate-200 flex flex-col justify-center"
    >
        <div class="hero-operation-surface"></div>
        <div class="hero-operation-network" aria-hidden="true">
            <div class="hero-operation-network__halo"></div>
            <svg
                class="hero-operation-network__desktop"
                viewBox="0 0 1440 720"
                preserveAspectRatio="xMidYMid slice"
                fill="none"
            >
                <path
                    class="hero-operation-network__route"
                    d="M650 616C770 525 806 315 972 286C1110 262 1122 122 1374 78"
                ></path>
                <path
                    class="hero-operation-network__route"
                    d="M745 702C836 556 1055 598 1137 427C1195 306 1316 319 1440 242"
                ></path>
                <path
                    class="hero-operation-network__route"
                    d="M708 644C827 566 897 425 1045 462C1164 492 1235 420 1440 374"
                ></path>
                <path
                    class="hero-operation-network__route hero-operation-network__route--faint"
                    d="M851 681C915 544 898 403 1038 351C1181 297 1201 161 1351 132"
                ></path>
                <path
                    class="hero-operation-network__route hero-operation-network__route--faint"
                    d="M835 720C916 619 1004 623 1091 580C1208 523 1280 592 1416 555"
                ></path>
                <path
                    class="hero-operation-network__signal"
                    d="M650 616C770 525 806 315 972 286C1110 262 1122 122 1374 78"
                ></path>
                <path
                    class="hero-operation-network__signal hero-operation-network__signal--delayed"
                    d="M745 702C836 556 1055 598 1137 427C1195 306 1316 319 1440 242"
                ></path>
                <path
                    class="hero-operation-network__sweep"
                    d="M708 644C827 566 897 425 1045 462C1164 492 1235 420 1440 374"
                ></path>
                <g class="hero-operation-network__capsule">
                    <rect x="-28" y="-13" width="56" height="26" rx="13"></rect>
                    <text x="0" y="4" text-anchor="middle">US$</text>
                    <animateMotion
                        dur="13s"
                        begin="-2s"
                        repeatCount="indefinite"
                        path="M650 616C770 525 806 315 972 286C1110 262 1122 122 1374 78"
                    ></animateMotion>
                </g>
                <g
                    class="hero-operation-network__capsule hero-operation-network__capsule--secondary"
                >
                    <rect x="-28" y="-13" width="56" height="26" rx="13"></rect>
                    <text x="0" y="4" text-anchor="middle">€</text>
                    <animateMotion
                        dur="16s"
                        begin="-9s"
                        repeatCount="indefinite"
                        path="M745 702C836 556 1055 598 1137 427C1195 306 1316 319 1440 242"
                    ></animateMotion>
                </g>
                <g class="hero-operation-network__nodes">
                    <circle cx="972" cy="286" r="4"></circle>
                    <circle cx="1137" cy="427" r="4"></circle>
                    <circle cx="1201" cy="161" r="3"></circle>
                    <circle cx="1351" cy="132" r="3"></circle>
                    <circle cx="1045" cy="462" r="3"></circle>
                    <circle cx="1091" cy="580" r="3"></circle>
                </g>
            </svg>
            <svg
                class="hero-operation-network__mobile"
                viewBox="0 0 390 844"
                preserveAspectRatio="none"
                fill="none"
            >
                <path
                    class="hero-operation-network__route"
                    d="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"
                ></path>
                <path
                    class="hero-operation-network__route hero-operation-network__route--faint"
                    d="M390 786C351 649 422 590 380 443C360 374 416 316 390 213"
                ></path>
                <path
                    class="hero-operation-network__signal"
                    d="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"
                ></path>
                <g class="hero-operation-network__capsule">
                    <rect x="-28" y="-13" width="56" height="26" rx="13"></rect>
                    <text x="0" y="4" text-anchor="middle">US$</text>
                    <animateMotion
                        dur="14s"
                        begin="-4s"
                        repeatCount="indefinite"
                        path="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"
                    ></animateMotion>
                </g>
                <g class="hero-operation-network__nodes">
                    <circle cx="367" cy="500" r="3"></circle>
                    <circle cx="390" cy="277" r="3"></circle>
                    <circle cx="380" cy="443" r="2.5"></circle>
                </g>
            </svg>
        </div>

        <div
            class="max-w-7xl mx-auto px-6 relative z-10 grid xl:grid-cols-[1.1fr_0.9fr] gap-14 items-center"
        >
            <div class="text-left">
                <div class="reveal">
                    <span
                        class="fintech-badge inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold text-guira-teal mb-8"
                    >
                        <span class="w-1.5 h-1.5 rounded-full bg-guira-teal"
                        ></span>
                        Plataforma tecnológica para empresas de LATAM · Presencia
                        en Bolivia
                    </span>
                </div>

                <h1
                    class="reveal reveal-delay-1 text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-[1.1] text-white max-w-3xl"
                >
                    Paga a tus proveedores y cobra en dólares desde Bolivia
                </h1>

                <p
                    class="reveal reveal-delay-2 text-base md:text-lg text-slate-300 mb-10 max-w-xl font-medium leading-relaxed"
                >
                    Centraliza la recepción, visibilidad y las instrucciones de
                    pago de tu empresa con respaldo documental y partners
                    internacionales calificados.
                </p>

                <div
                    class="reveal reveal-delay-3 flex flex-col sm:flex-row items-center sm:items-stretch gap-4 mb-12"
                >
                    <KineticButton
                        href="https://app.guiracorp.com"
                        variant="light"
                        size="lg"
                        label="Comenzar Onboarding Empresarial"
                        class="w-full sm:w-auto"
                    />
                    <KineticButton
                        href="/demo/"
                        variant="dark"
                        size="lg"
                        label="Hablar con Ventas"
                        class="w-full sm:w-auto"
                    />
                </div>

                <div
                    class="reveal reveal-delay-4 flex flex-wrap items-center gap-x-10 gap-y-6 max-w-xl"
                >
                    <div class="pr-10 border-r border-white/20">
                        <p
                            class="text-xs font-bold text-slate-400 section-kicker mb-2"
                        >
                            Onboarding
                        </p>
                        <p class="text-lg font-extrabold text-white">
                            Empresarial
                        </p>
                    </div>
                    <div class="pr-10 border-r border-white/20">
                        <p
                            class="text-xs font-bold text-slate-400 section-kicker mb-2"
                        >
                            Canales
                        </p>
                        <p class="text-lg font-extrabold text-white">
                            ACH / Wire
                        </p>
                    </div>
                    <div>
                        <p
                            class="text-xs font-bold text-slate-400 section-kicker mb-2"
                        >
                            Control
                        </p>
                        <p class="text-lg font-extrabold text-white">
                            Trazabilidad
                        </p>
                    </div>
                </div>
            </div>

            <div
                class="hidden xl:block relative h-[420px] reveal reveal-delay-4"
            >
                <img
                    src="/assets/images/tablet_sin_fondo.png"
                    alt="Panel de operaciones de Guira Empresas en tablet"
                    class="absolute inset-0 w-full h-full object-contain object-center animate-float-tablet"
                />
                <img
                    src="/assets/images/telefono_guira_sin_fondo.png"
                    alt="Panel de operaciones de Guira Empresas en el celular"
                    class="absolute bottom-0 -right-10 h-[92%] w-auto drop-shadow-2xl rotate-6 animate-float-phone"
                />
            </div>
        </div>
    </header>

    <!-- Cotizador -->
    <section
        data-stack-section
        class="py-24 bg-white border-b border-slate-200 relative overflow-hidden hidden"
    >
        <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,81,255,0.06),transparent_32%)]"
        >
        </div>
        <div class="max-w-4xl mx-auto px-6 relative z-10">
            <div class="text-center mb-14 reveal">
                <p class="section-kicker text-guira-teal mb-4">
                    Simulador de operación
                </p>
                <h2
                    class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.65rem] font-extrabold uppercase tracking-tight leading-[1.08] text-slate-900 mb-4"
                >
                    Ve cuánto llega, en la moneda que elijas.
                </h2>
                <p class="text-slate-500 text-lg font-medium max-w-2xl mx-auto">
                    Simula el destino de tu saldo en dólares: tu cuenta
                    operativa en dólares o tu banco local en bolivianos.
                </p>
            </div>

            <div
                class="premium-card rounded-3xl p-6 md:p-10 reveal-up"
                data-quote-widget
            >
                <p class="section-kicker text-slate-400 mb-3">
                    Envías desde tu cuenta operativa en dólares
                </p>
                <div
                    class="flex items-center justify-between gap-3 bg-slate-50 border border-slate-200 rounded-2xl p-5 mb-8"
                >
                    <input
                        type="text"
                        inputmode="decimal"
                        value="100.00"
                        aria-label="Monto a enviar en dólares"
                        class="w-full bg-transparent text-2xl md:text-3xl font-extrabold text-slate-900 focus:outline-none"
                        data-quote-input
                    />
                    <span
                        class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-3 py-2 font-bold text-sm text-slate-700 shrink-0"
                    >
                        <Flag code="us" /> USD
                    </span>
                </div>

                <p class="section-kicker text-slate-400 mb-3">
                    Elige el destino
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                    <button
                        type="button"
                        class="quote-destination-btn active"
                        data-quote-destination
                        data-rate="1"
                        data-currency="USD"
                        data-note="Sin conversión de moneda. El saldo se mantiene en tu cuenta operativa en dólares."
                    >
                        <i data-lucide="landmark" class="w-5 h-5"></i>
                        <span>
                            <span class="quote-destination-btn__title"
                                >Cuenta en dólares</span
                            >
                            <span class="quote-destination-btn__meta"
                                >Saldo en USD</span
                            >
                        </span>
                    </button>
                    <button
                        type="button"
                        class="quote-destination-btn"
                        data-quote-destination
                        data-rate="11.40"
                        data-currency="BOB"
                        data-note="Conversión a tu cuenta bancaria local en bolivianos."
                    >
                        <i data-lucide="banknote" class="w-5 h-5"></i>
                        <span>
                            <span class="quote-destination-btn__title"
                                >Cuenta BOB</span
                            >
                            <span class="quote-destination-btn__meta"
                                >Banco local</span
                            >
                        </span>
                    </button>
                </div>

                <div class="bg-slate-900 rounded-2xl p-6 md:p-8">
                    <p class="section-kicker text-slate-400 mb-3">Recibes</p>
                    <div
                        class="flex items-baseline justify-between flex-wrap gap-2"
                    >
                        <span
                            class="text-3xl md:text-4xl font-extrabold text-white"
                            data-quote-output>100.00</span
                        >
                        <span
                            class="text-sm font-bold text-guira-cyan"
                            data-quote-currency-label>USD · Cuenta Guira</span
                        >
                    </div>
                    <p
                        class="text-xs text-slate-400 font-medium mt-3"
                        data-quote-note
                    >
                        Sin conversión de moneda. El saldo se mantiene en tu
                        cuenta Guira.
                    </p>
                </div>

                <p
                    class="text-[11px] text-slate-400 font-medium mt-5 text-center"
                >
                    * Simulación referencial. El tipo de cambio y las
                    condiciones finales se confirman en cada operación según la
                    estructura habilitada.
                </p>
            </div>
        </div>
    </section>

    <!-- Bloque Presencia e Infraestructura -->
    <section
        data-stack-section
        class="py-12 bg-guira-navy border-b border-slate-800"
    >
        <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-8">
            <div class="flex items-center gap-4 reveal">
                <div
                    class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center text-slate-300 border border-slate-700"
                >
                    <i data-lucide="building-2" class="w-6 h-6"></i>
                </div>
                <div>
                    <h3
                        class="font-extrabold text-white text-sm uppercase tracking-wider"
                    >
                        Estructura Corporativa
                    </h3>
                    <p class="text-slate-400 text-sm font-medium">
                        Empresa matriz operativa en Delaware, EE.UU.
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-4 reveal reveal-delay-1">
                <div
                    class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center text-slate-300 border border-slate-700"
                >
                    <i data-lucide="map-pin" class="w-6 h-6"></i>
                </div>
                <div>
                    <h3
                        class="font-extrabold text-white text-sm uppercase tracking-wider"
                    >
                        Asesores en Bolivia
                    </h3>
                    <p class="text-slate-400 text-sm font-medium">
                        Equipo asesor local para empresas que quieren usar
                        Guira.
                    </p>
                    <a
                        href="/pagos-proveedores-bolivia/"
                        class="text-guira-teal text-xs font-bold hover:underline mt-1 inline-block"
                        >Ver solución para Bolivia →</a
                    >
                </div>
            </div>
            <div class="flex items-center gap-4 reveal reveal-delay-2">
                <div
                    class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center text-slate-300 border border-slate-700"
                >
                    <i data-lucide="users" class="w-6 h-6"></i>
                </div>
                <div>
                    <h3
                        class="font-extrabold text-white text-sm uppercase tracking-wider"
                    >
                        Acompañamiento B2B
                    </h3>
                    <p class="text-slate-400 text-sm font-medium">
                        Equipo humano consultivo y permanente.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Franja Confianza -->
    <section
        data-stack-section
        class="py-12 border-b border-slate-200 bg-white relative overflow-hidden"
    >
        <div class="max-w-7xl mx-auto px-6 relative">
            <p
                class="text-center text-xs font-bold tracking-widest text-slate-400 uppercase mb-8"
            >
                Infraestructura desarrollada para escalar tu operación
                internacional
            </p>
            <div class="relative overflow-hidden">
                <div
                    class="absolute inset-y-0 left-0 w-20 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"
                >
                </div>
                <div
                    class="absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"
                >
                </div>
                <div class="marquee-track">
                    <div class="marquee-logo">
                        <i
                            data-lucide="check-circle"
                            class="w-5 h-5 text-guira-teal"></i>
                        Validación empresarial según perfil
                    </div>
                    <div class="marquee-logo">
                        <i
                            data-lucide="file-check-2"
                            class="w-5 h-5 text-guira-teal"></i> Soporte documental
                        y trazabilidad
                    </div>
                    <div class="marquee-logo">
                        <i
                            data-lucide="arrow-right-left"
                            class="w-5 h-5 text-guira-teal"></i>
                        Operación entre rieles habilitados
                    </div>
                    <div class="marquee-logo">
                        <i
                            data-lucide="building-2"
                            class="w-5 h-5 text-guira-teal"></i>
                        Experiencia diseñada para empresas
                    </div>
                    <div class="marquee-logo">
                        <i
                            data-lucide="check-circle"
                            class="w-5 h-5 text-guira-teal"></i>
                        Validación empresarial según perfil
                    </div>
                    <div class="marquee-logo">
                        <i
                            data-lucide="file-check-2"
                            class="w-5 h-5 text-guira-teal"></i> Soporte documental
                        y trazabilidad
                    </div>
                    <div class="marquee-logo">
                        <i
                            data-lucide="arrow-right-left"
                            class="w-5 h-5 text-guira-teal"></i>
                        Operación entre rieles habilitados
                    </div>
                    <div class="marquee-logo">
                        <i
                            data-lucide="building-2"
                            class="w-5 h-5 text-guira-teal"></i>
                        Experiencia diseñada para empresas
