            "Registra avances, comprobantes e historial para responder al proveedor y cerrar la operación con control.",
    },
];

const problemaColumna = {
    theme: "light" as const,
    kicker: "El desafío boliviano",
    title: "¿Por qué es difícil pagar a proveedores?",
    description:
        "Los mayores problemas suelen aparecer antes y después del envío de fondos: datos incorrectos, documentos dispersos y poca visibilidad.",
    listTitle: "Problemas habituales",
    items: [
        {
            icon: "x",
            iconColor: "text-rose-500",
            title: "Datos del beneficiario incompletos",
            description:
                "Nombre legal, cuenta, SWIFT, ABA o dirección bancaria mal cargados pueden generar observaciones y retrasos.",
        },
        {
            icon: "x",
            iconColor: "text-rose-500",
            title: "Documentación distribuida",
            description:
                "Facturas, contratos, órdenes de compra y comprobantes quedan repartidos entre correos y carpetas.",
        },
        {
            icon: "x",
            iconColor: "text-rose-500",
            title: "Seguimiento poco claro",
            description:
                "Compras, administración, finanzas y contabilidad no siempre ven la misma etapa de la operación.",
        },
        {
            icon: "x",
            iconColor: "text-rose-500",
            title: "Carga administrativa creciente",
            description:
                "A mayor volumen de pagos, más difícil resulta mantener historial y control por proveedor.",
        },
    ],
};

const solucionColumna = {
    theme: "dark" as const,
    kicker: "La solución estructurada",
    title: "Guira + Asesores en Bolivia",
    description:
        "Centralizamos datos, documentos y trazabilidad por operación con acompañamiento comercial local.",
    listTitle: "Cómo lo resuelve Guira",
    items: [
        {
            icon: "check",
            iconColor: "text-guira-cyan",
            title: "Revisión previa de la operación",
            description:
                "Nuestro equipo te orienta sobre los datos y documentos que normalmente se requieren antes de iniciar.",
        },
        {
            icon: "check",
            iconColor: "text-guira-cyan",
            title: "Datos y documentos en un solo flujo",
            description:
                "Asocia beneficiario, datos bancarios, factura, contrato y monto a cada pago internacional.",
        },
        {
            icon: "check",
            iconColor: "text-guira-cyan",
            title: "Seguimiento por estado",
            description:
                "Consulta avances, observaciones y registros asociados para responder a proveedores y equipos internos.",
        },
        {
            icon: "check",
            iconColor: "text-guira-cyan",
            title: "Trazabilidad para control interno",
            description:
                "Mantén historial documental estructurado para conciliaciones, auditorías y consultas posteriores.",
        },
    ],
};

const restriccionesColumna = {
  theme: "light" as const,
  kicker: "Alcance",
  title: "Lo que no aplica",
  description:
    "Guira opera exclusivamente en el ámbito corporativo B2B con respaldo comercial.",
  listTitle: "Casos no admitidos",
  items: [
    {
      icon: "user",
      iconColor: "text-rose-500",
      title: "Personas naturales",
      description: "Uso individual o consumo personal.",
    },
    {
      icon: "file-x",
      iconColor: "text-rose-500",
      title: "Sin soporte documental",
      description: "Operaciones sin invoice o contrato de respaldo.",
    },
    {
      icon: "alert-triangle",
      iconColor: "text-rose-500",
      title: "Actividades restringidas",
      description:
        "Alto riesgo o fuera de los rieles habilitados por los partners financieros.",
    },
  ],
};

const elegibilidadColumna = {
  theme: "dark" as const,
  kicker: "Requisitos",
  title: "¿Qué tipo de empresa boliviana puede acceder?",
  description:
    "Nuestros asesores evalúan tu perfil y te orientan sobre la elegibilidad.",
  listTitle: "Perfiles que pueden aplicar",
  items: [
    {
      icon: "package",
      iconColor: "text-guira-cyan",
      title: "Importadoras bolivianas",
      description:
        "Que pagan a proveedores en EE.UU., Europa o Latinoamérica.",
    },
    {
      icon: "briefcase",
      iconColor: "text-guira-cyan",
      title: "Empresas de servicios",
      description:
        "Con contratos activos con proveedores extranjeros.",
    },
    {
      icon: "globe",
      iconColor: "text-guira-cyan",
      title: "Corporativos y ONGs bolivianas",
      description:
        "Con operación regional o proyectos internacionales.",
    },
    {
      icon: "file-text",
      iconColor: "text-guira-cyan",
      title: "NIT activo + respaldo",
      description:
        "Invoice o contrato por cada operación de pago.",
    },
  ],
};

const proveedoresFaq = [
    {
        question:
            "¿Qué información necesito antes de pagar a un proveedor en el exterior?",
        answer: "Conviene verificar nombre legal del proveedor, país, dirección registrada, contacto, banco receptor, número de cuenta, código SWIFT, ABA Routing Number o IBAN cuando aplique, además de moneda, monto y referencia comercial.",
    },
    {
        question:
            "¿Qué documentos respaldan un pago internacional a proveedores?",
        answer: "La factura comercial suele ser el documento principal. Según la operación, también pueden requerirse contratos, órdenes de compra, propuestas aceptadas, instrucciones bancarias y documentos propios de importación.",
    },
    {
        question: "¿Qué datos se revisan para enviar un Wire a Estados Unidos?",
        answer: "Normalmente se revisa nombre legal del beneficiario, banco receptor, número de cuenta, código SWIFT, dirección del beneficiario y dirección del banco. La información debe coincidir con la factura, contrato y documentos asociados.",
    },
    {
        question: "¿Cómo mejora la trazabilidad de un pago internacional?",
        answer: "La trazabilidad permite registrar solicitud, documentación, estado de revisión, aprobaciones, avances y comprobantes de cada operación. Así compras, administración, finanzas y contabilidad trabajan con la misma información.",
    },
    {
        question: "¿Qué plataforma puede ayudar a gestionar estos procesos?",
        answer: "Guira es la plataforma donde una empresa boliviana paga a sus proveedores, cobra de sus clientes y opera cuentas en la moneda que necesite en el exterior (dólares, euros, pesos mexicanos, pesos colombianos o reales) con la trazabilidad documental que su contador y su auditor necesitan en cada operación. Permite centralizar documentación, consultar información relevante de cada operación y mantener mayor visibilidad sobre los procesos asociados.",
    },
];
---

<Layout
    title="Pagos internacionales a proveedores desde Bolivia | Guira"
    description="Conoce cómo pagar a proveedores internacionales desde Bolivia con documentación organizada, datos bancarios correctos y trazabilidad por operación."
    keywords="pagos internacionales a proveedores, pagar proveedores internacionales Bolivia, cómo pagar a un proveedor en el exterior desde Bolivia, transferencia internacional a proveedores, documentación para pagos internacionales, Wire Transfer proveedores, trazabilidad de pagos internacionales"
    canonicalUrl="https://www.guiracorp.com/pagos-proveedores-bolivia"
    footerTheme="dark"
>
    <Fragment slot="head">
        <!-- Schema: ProfessionalService + FAQPage -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "ProfessionalService",
                        "name": "Asesoría para usar Guira Empresas desde Bolivia",
                        "url": "https://www.guiracorp.com/pagos-proveedores-bolivia",
                        "description": "Equipo asesor en Bolivia que acompaña a empresas bolivianas para organizar documentación, evaluar el proceso y acceder a Guira Empresas (plataforma de pagos B2B internacionales con sede en EE.UU.) para pagar a sus proveedores en el exterior.",
                        "provider": {
                            "@type": "Organization",
                            "name": "Guira System LLC",
                            "url": "https://www.guiracorp.com"
                        },
                        "areaServed": {
                            "@type": "Country",
                            "name": "Bolivia"
                        },
                        "serviceType": "Asesoría para pagos empresariales internacionales B2B"
                    },
                    {
                        "@type": "FAQPage",
                        "mainEntity": [
                            {
                                "@type": "Question",
                                "name": "¿Qué información necesito antes de pagar a un proveedor en el exterior?",
                                "acceptedAnswer": {
                                    "@type": "Answer",
                                    "text": "Conviene verificar nombre legal del proveedor, país, dirección registrada, contacto, banco receptor, número de cuenta, código SWIFT, ABA Routing Number o IBAN cuando aplique, además de moneda, monto y referencia comercial."
                                }
                            },
                            {
                                "@type": "Question",
                                "name": "¿Qué documentos respaldan un pago internacional a proveedores?",
                                "acceptedAnswer": {
                                    "@type": "Answer",
                                    "text": "La factura comercial suele ser el documento principal. Según la operación, también pueden requerirse contratos, órdenes de compra, propuestas aceptadas, instrucciones bancarias y documentos propios de importación."
                                }
                            }
                        ]
                    }
                ]
            }
        </script>

        <!-- Schema: BreadcrumbList -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Inicio",
                        "item": "https://www.guiracorp.com/"
                    },
                    {
                        "@type": "ListItem",
                        "position": 2,
                        "name": "Soluciones",
                        "item": "https://www.guiracorp.com/soluciones"
                    },
                    {
                        "@type": "ListItem",
                        "position": 3,
                        "name": "Pagos a Proveedores desde Bolivia",
                        "item": "https://www.guiracorp.com/pagos-proveedores-bolivia"
                    }
                ]
            }
        </script>
    </Fragment>

    <StackedSections>
        <!-- HERO — Two-column con mockup de pago flotante -->
        <header
            data-stack-section
            class="relative pt-36 pb-24 overflow-hidden bg-guira-dark border-b border-white/5"
        >
            <div class="hero-operation-surface"></div>
            <div class="hero-operation-network" aria-hidden="true">
                <div class="hero-operation-network__halo"></div>
                <svg
                    class="hero-operation-network__desktop"
                    viewBox="0 0 1440 720"
                    preserveAspectRatio="xMidYMid slice"
                    fill="none"
                >
                    <path
                        class="hero-operation-network__route"
                        d="M650 616C770 525 806 315 972 286C1110 262 1122 122 1374 78"
                    ></path>
                    <path
                        class="hero-operation-network__route"
                        d="M745 702C836 556 1055 598 1137 427C1195 306 1316 319 1440 242"
                    ></path>
                    <path
                        class="hero-operation-network__route"
                        d="M708 644C827 566 897 425 1045 462C1164 492 1235 420 1440 374"
                    ></path>
                    <path
