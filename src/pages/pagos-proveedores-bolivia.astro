---
import Layout from "../layouts/Layout.astro";
import StackedSections from "../components/StackedSections.astro";
import KineticButton from "../components/KineticButton.astro";
import FaqSection from "../components/FaqSection.astro";
import EditorialGridSection from "../components/EditorialGridSection.astro";
import DualSplitSection from "../components/DualSplitSection.astro";

const verificacionItems = [
    {
        icon: "building-2",
        step: "01 · Beneficiario",
        title: "Datos del beneficiario",
        description:
            "Nombre legal, país, dirección registrada, persona de contacto y correo de referencia.",
    },
    {
        icon: "landmark",
        step: "02 · Bancarios",
        title: "Datos bancarios",
        description:
            "Banco receptor, número de cuenta, código SWIFT, ABA Routing Number o IBAN cuando aplique.",
    },
    {
        icon: "badge-dollar-sign",
        step: "03 · Moneda",
        title: "Moneda y monto",
        description:
            "Definir moneda desde el inicio ayuda a evitar ajustes posteriores y facilita la conciliación.",
