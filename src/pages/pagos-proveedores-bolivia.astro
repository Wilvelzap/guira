                        d="M851 681C915 544 898 403 1038 351C1181 297 1201 161 1351 132"
                    ></path>
                    <path
                        class="hero-operation-network__route hero-operation-network__route--faint"
                        d="M835 720C916 619 1004 623 1091 580C1208 523 1280 592 1416 555"
                    ></path>
                    <path
                        class="hero-operation-network__signal"
                        d="M650 616C770 525 806 315 972 286C1110 262 1122 122 1374 78"
                    ></path>
                    <path
                        class="hero-operation-network__signal hero-operation-network__signal--delayed"
                        d="M745 702C836 556 1055 598 1137 427C1195 306 1316 319 1440 242"
                    ></path>
                    <path
                        class="hero-operation-network__sweep"
                        d="M708 644C827 566 897 425 1045 462C1164 492 1235 420 1440 374"
                    ></path>
                    <g class="hero-operation-network__capsule">
                        <rect x="-28" y="-13" width="56" height="26" rx="13"
                        ></rect>
                        <text x="0" y="4" text-anchor="middle">US$</text>
                        <animateMotion
                            dur="13s"
                            begin="-2s"
                            repeatCount="indefinite"
                            path="M650 616C770 525 806 315 972 286C1110 262 1122 122 1374 78"
                        ></animateMotion>
                    </g>
                    <g
                        class="hero-operation-network__capsule hero-operation-network__capsule--secondary"
                    >
                        <rect x="-28" y="-13" width="56" height="26" rx="13"
                        ></rect>
                        <text x="0" y="4" text-anchor="middle">€</text>
                        <animateMotion
                            dur="16s"
                            begin="-9s"
                            repeatCount="indefinite"
                            path="M745 702C836 556 1055 598 1137 427C1195 306 1316 319 1440 242"
                        ></animateMotion>
                    </g>
                    <g class="hero-operation-network__nodes">
                        <circle cx="972" cy="286" r="4"></circle>
                        <circle cx="1137" cy="427" r="4"></circle>
                        <circle cx="1201" cy="161" r="3"></circle>
                        <circle cx="1351" cy="132" r="3"></circle>
                        <circle cx="1045" cy="462" r="3"></circle>
                        <circle cx="1091" cy="580" r="3"></circle>
                    </g>
                </svg>
                <svg
                    class="hero-operation-network__mobile"
                    viewBox="0 0 390 844"
                    preserveAspectRatio="none"
                    fill="none"
                >
                    <path
                        class="hero-operation-network__route"
                        d="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"
                    ></path>
                    <path
                        class="hero-operation-network__route hero-operation-network__route--faint"
                        d="M390 786C351 649 422 590 380 443C360 374 416 316 390 213"
                    ></path>
                    <path
                        class="hero-operation-network__signal"
                        d="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"
                    ></path>
                    <g class="hero-operation-network__capsule">
                        <rect x="-28" y="-13" width="56" height="26" rx="13"
                        ></rect>
                        <text x="0" y="4" text-anchor="middle">US$</text>
                        <animateMotion
                            dur="14s"
                            begin="-4s"
                            repeatCount="indefinite"
                            path="M342 844C329 693 405 651 367 500C343 407 411 352 390 277"
                        ></animateMotion>
                    </g>
                    <g class="hero-operation-network__nodes">
                        <circle cx="367" cy="500" r="3"></circle>
                        <circle cx="390" cy="277" r="3"></circle>
                        <circle cx="380" cy="443" r="2.5"></circle>
                    </g>
                </svg>
            </div>

            <div
                class="max-w-7xl mx-auto px-6 relative z-10 grid lg:grid-cols-[1.15fr_0.85fr] gap-16 items-center"
            >
                <!-- Left: Texto -->
                <div class="text-left reveal">
                    <!-- Badge -->
                    <div
                        class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-xs font-bold text-guira-cyan bg-guira-teal/10 border border-guira-teal/25 mb-8"
                    >
                        <span
                            class="signal-dot w-2 h-2 rounded-full bg-guira-cyan"
                        ></span>
                        Asesores especializados en Bolivia · Guira opera en EE.UU.
                    </div>

                    <h1
                        class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-[1.1]"
                    >
                        <span class="text-white">Paga a tus proveedores</span
                        ><br />
                        <span class="text-guira-cyan">internacionales</span>
                        <span class="text-white"> desde Bolivia</span>
                    </h1>

                    <p
                        class="text-base md:text-lg text-slate-400 mb-10 max-w-xl font-medium leading-relaxed"
                    >
                        Organiza datos del beneficiario, factura comercial,
                        documentación de respaldo y seguimiento de cada
                        operación. Nuestro equipo asesor en Bolivia te acompaña
                        para operar con <strong class="text-white">Guira</strong
                        >, plataforma B2B en EE.UU.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4 mb-12">
                        <KineticButton
                            href="/demo/"
                            variant="teal"
                            size="lg"
                            label="Revisar mi pago con un asesor"
                            class="w-full sm:w-auto"
                        />
                        <KineticButton
                            href="/blog/como-pagar-proveedor-exterior-desde-bolivia/"
                            variant="dark"
                            size="lg"
                            label="Leer guía completa"
                            class="w-full sm:w-auto"
                        />
                    </div>

                    <!-- Mini stats row -->
                    <div class="grid grid-cols-3 gap-4 max-w-lg">
                        <div class="fintech-badge rounded-2xl p-4 text-center">
                            <div
                                class="text-xl font-extrabold text-white mb-0.5"
                            >
                                Datos
                            </div>
                            <div
                                class="text-[11px] text-slate-400 font-semibold"
                            >
                                Proveedor y banco
                            </div>
                        </div>
                        <div class="fintech-badge rounded-2xl p-4 text-center">
                            <div
                                class="text-xl font-extrabold text-white mb-0.5"
                            >
                                Invoice
                            </div>
                            <div
                                class="text-[11px] text-slate-400 font-semibold"
                            >
                                Respaldo comercial
                            </div>
                        </div>
                        <div class="fintech-badge rounded-2xl p-4 text-center">
                            <div
                                class="text-xl font-extrabold text-guira-cyan mb-0.5"
                            >
                                Estado
                            </div>
                            <div
                                class="text-[11px] text-slate-400 font-semibold"
                            >
                                Seguimiento por pago
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Mockup visual de pago -->
                <div
                    class="relative mx-auto w-full max-w-sm reveal reveal-delay-2 account-hero-tilt-wrap"
                >
                    <div class="mockup-tilt-group">
                        <!-- Card flotante superior izquierda -->
                        <div class="absolute -top-8 -left-8 z-20">
                            <div
                                class="mockup-float-badge rounded-2xl p-4 w-52 animate-float-soft shadow-2xl"
                            >
                                <div
                                    class="flex items-center justify-between mb-2"
                                >
                                    <span class="section-kicker text-slate-400"
                                        >Asesor Bolivia</span
                                    >
                                    <span
                                        class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-500"
                                    >
                                        <span
                                            class="w-1.5 h-1.5 rounded-full bg-emerald-500"
                                        ></span> Online
                                    </span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div
                                        class="w-8 h-8 rounded-full bg-guira-teal/20 flex items-center justify-center text-guira-cyan text-xs font-bold"
                                    >
                                        JP
                                    </div>
                                    <div>
                                        <div
                                            class="text-xs font-bold text-white"
                                        >
                                            Juan Pablo M.
                                        </div>
                                        <div class="text-[10px] text-slate-400">
