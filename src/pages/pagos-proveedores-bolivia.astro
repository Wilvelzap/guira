        <script>
            const balanceEl = document.querySelector("[data-balance-amount]");

            if (balanceEl) {
                const formatAmount = (value) =>
                    `$${Math.round(value).toLocaleString("en-US")}`;

                const values = [42800, 47250, 39600, 44100];
                let current = values[0];
                let step = 0;

                const animateTo = (target, duration = 1400) => {
                    const start = current;
                    const startTime = performance.now();

                    const tick = (now) => {
                        const progress = Math.min(
                            (now - startTime) / duration,
                            1,
                        );
                        const eased = 1 - Math.pow(1 - progress, 3);
                        const value = start + (target - start) * eased;
                        balanceEl.textContent = formatAmount(value);

                        if (progress < 1) {
                            requestAnimationFrame(tick);
                        } else {
                            current = target;
                        }
                    };

                    requestAnimationFrame(tick);
                };

                if (
                    !window.matchMedia("(prefers-reduced-motion: reduce)")
                        .matches
                ) {
                    setInterval(() => {
                        step = (step + 1) % values.length;
                        animateTo(values[step]);
                    }, 2600);
                }
            }
