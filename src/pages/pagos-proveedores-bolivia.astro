    {
        icon: "file-check-2",
        step: "04 · Respaldo",
        title: "Respaldo comercial",
        description:
            "Factura, contrato, orden de compra o documentos de importación según el tipo de operación.",
    },
];

const verificacionBotones = [
    {
        href: "/blog/como-enviar-wire-proveedor-eeuu-desde-bolivia/",
        label: "Ver información para Wire a EE.UU.",
        variant: "teal" as const,
    },
    {
        href: "/blog/trazabilidad-pagos-internacionales-proveedores-bolivia/",
        label: "Mejorar trazabilidad",
        variant: "dark" as const,
    },
];

const comoFuncionaItems = [
    {
        icon: "building-2",
        step: "01 · Proveedor",
        title: "Verifica al proveedor",
        description:
            "Confirma nombre legal, país, dirección, contacto y consistencia con la documentación comercial.",
    },
    {
        icon: "file-check-2",
        step: "02 · Respaldo",
        title: "Reúne el respaldo",
        description:
            "Centraliza factura, contrato, orden de compra, instrucciones bancarias y documentos de importación si aplica.",
    },
    {
        icon: "send",
        step: "03 · Instrucción",
        title: "Instruye el pago",
        description:
            "Define moneda, monto, ruta bancaria y método disponible para la operación, como Wire o ACH cuando corresponda.",
    },
    {
        icon: "check-circle-2",
        step: "04 · Trazabilidad",
        title: "Da seguimiento y concilia",
