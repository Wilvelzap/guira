---
import Layout from "../layouts/Layout.astro";
import Flag from "../components/Flag.astro";
import DemoForm from "../components/DemoForm.astro";
import StackedSections from "../components/StackedSections.astro";
import FaqSection from "../components/FaqSection.astro";
import EditorialGridSection from "../components/EditorialGridSection.astro";
import EditorialHeader from "../components/EditorialHeader.astro";
import GuiraButton from "../components/GuiraButton.astro";

const opcionesCobroItems = [
  {
    icon: "landmark",
    title: "Wire Transfer",
    description:
      "Suele usarse para montos relevantes, contratos empresariales y operaciones donde es importante identificar claramente origen, beneficiario y referencia.",
    link: {
      href: "/blog/wire-vs-ach-diferencias-empresas-bolivianas/",
      text: "Ver diferencias con ACH",
    },
  },
  {
    icon: "repeat-2",
    title: "ACH",
    description:
      "Puede servir para pagos recurrentes o administrativos originados dentro de Estados Unidos cuando la empresa cuenta con una estructura habilitada para recibirlos.",
    link: {
      href: "/blog/como-cobrar-clientes-estados-unidos-desde-bolivia/",
      text: "Leer opciones de cobro",
    },
  },
  {
    icon: "layout-dashboard",
    title: "Plataforma especializada",
    description:
      "Ayuda a centralizar información, documentos, seguimiento y validaciones asociadas a cada operación internacional.",
    link: {
      href: "/blog/desafios-recibir-pagos-internacionales-bolivia/",
      text: "Conocer desafíos frecuentes",
    },
  },
];

const comoGuiraOrdenaItems = [
  {
    icon: "file-text",
    step: "01 · Preparación",
    title: "Prepara la operación",
    description:
      "Organiza factura, contrato, datos del pagador y referencia para que el cobro llegue identificado desde el inicio.",
  },
  {
    icon: "route",
    step: "02 · Recepción",
    title: "Recibe por la ruta adecuada",
    description:
      "Evalúa si la operación conviene por Wire, ACH o una estructura especializada según monto, frecuencia y requisitos.",
  },
  {
    icon: "shield-check",
    step: "03 · Respaldo",
    title: "Centraliza el respaldo",
    description:
      "Mantén comprobantes, conciliación, estado e historial de la operación disponibles para tu equipo.",
  },
];

const comoGuiraOrdenaBotones = [
  {
    href: "#solicitar-demo",
    label: "Solicitar demostración",
    variant: "teal" as const,
  },
  {
    href: "https://wa.me/59167015106?text=%5BW-COB2%5D%20Hola,%20mi%20cliente%20de%20Estados%20Unidos%20quiere%20pagarme%20y%20necesito%20orientaci%C3%B3n",
    label: "Hablar por WhatsApp",
    variant: "dark" as const,
  },
];

const cobrosFaq = [
  {
    question:
      "¿Cuál es la mejor forma de cobrar clientes de Estados Unidos desde Bolivia?",
    answer:
      "Depende del monto, frecuencia, tipo de cliente y documentación requerida. Wire suele usarse en pagos corporativos internacionales, ACH puede servir si existe una estructura habilitada en Estados Unidos y una plataforma especializada ayuda a ordenar seguimiento y respaldo.",
  },
  {
    question:
      "¿ACH sirve para recibir pagos directamente en una cuenta boliviana?",
    answer:
      "ACH es una red de pagos de Estados Unidos. Para una empresa boliviana puede ser útil cuando cuenta con una cuenta, partner o plataforma que pueda recibir fondos por esa vía dentro de EE. UU. No funciona como una transferencia internacional directa a Bolivia.",
  },
  {
    question: "¿Qué información suele pedir mi cliente para realizar el pago?",
    answer:
      "Normalmente solicita nombre legal de la empresa, dirección fiscal, datos de la cuenta o ruta receptora, referencia de factura o contrato, información bancaria necesaria y documentación de respaldo cuando corresponda.",
  },
  {
    question: "¿Qué documentos debo conservar por cada cobro internacional?",
    answer:
      "Como mínimo conviene conservar factura, contrato u orden de servicio, instrucciones de pago, comprobante del pagador, confirmación de recepción y registro interno de conciliación. Cada operación puede requerir documentos adicionales.",
  },
  {
    question: "¿Cómo ayuda Guira en la gestión de cobros internacionales?",
    answer:
      "Guira centraliza información, documentación, estado e historial de las operaciones internacionales para que el equipo administrativo y financiero tenga mayor visibilidad y control operativo.",
  },
];
---

<Layout
  title="Cómo cobrar a clientes del exterior desde Bolivia | Guira"
  description="Cobra a tus clientes de Estados Unidos, Europa y la región en dólares desde Bolivia, en una cuenta operativa propia y con respaldo documental en cada cobro."
  canonicalUrl="https://www.guiracorp.com/pagos-cobros-internacionales"
  activeLink="pagos-cobros-internacionales"
  footerTheme="dark"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href="/assets/images/plataforma-dashboard-macbook.webp"
      type="image/webp"
    />
    <link
      rel="preload"
      as="image"
      href="/assets/images/soluciones-corporativo.webp"
      type="image/webp"
    />
    <style is:inline>
      html {
        scroll-behavior: smooth;
      }
      /* Ocultar el widget global de WhatsApp (inyectado por main.js); en esta página usamos el botón personalizado más grande */
      body > a.bg-emerald-500[href*="wa.me"]:not(.p-6) {
        display: none !important;
      }
    </style>
  </Fragment>

  <!-- HERO -->
  <header
    data-stack-section
    class="relative pt-28 md:pt-36 lg:pt-40 pb-20 md:pb-28 lg:pb-36 min-h-[calc(100vh-80px)] flex items-center overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(0,81,255,0.15),transparent_50%),radial-gradient(circle_at_70%_80%,rgba(0,216,255,0.1),transparent_40%)]"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10 w-full">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <div class="lg:col-span-6 text-left">
          <p class="section-kicker text-guira-cyan mb-3">
            Para empresas importadoras y exportadoras de Bolivia
          </p>
          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6 leading-[1.1] text-white"
          >
            Cobra a tus clientes <span class="text-guira-cyan"
              >del exterior</span
            > desde Bolivia
          </h1>
          <p
            class="text-base md:text-lg text-slate-400 mb-10 max-w-xl font-medium leading-relaxed"
          >
            Todo desde una misma cuenta en dólares, sin depender de trámites
            bancarios distintos para cada operación.
          </p>
          <div class="flex flex-col sm:flex-row items-center gap-4">
            <GuiraButton
              href="https://wa.me/59167015106?text=%5BW-COB1%5D%20Hola,%20quiero%20recibir%20pagos%20internacionales%20en%20mi%20empresa%20con%20Guira"
              target="_blank"
              rel="noopener noreferrer"
              label="Hablar con un especialista"
              variant="teal"
            />
            <GuiraButton
              href="#solicitar-demo"
              label="Solicitar demostración"
              variant="dark"
            />
          </div>
          <p class="text-slate-400 text-sm mt-4 font-medium">
            Te orientamos según tu tipo de cliente, monto y documentación
            disponible.
          </p>
        </div>

        <!-- GLOBO TERRÁQUEO WIREFRAME: HEMISFERIO SUPERIOR EN 3D REAL CON ROTACIÓN ESFÉRICA -->
        <div
          class="lg:col-span-6 relative flex items-center justify-center py-4 globe-3d-perspective-wrapper"
        >
          <!-- Ambient Glow Backdrop -->
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_50%_65%,rgba(56,189,248,0.24),rgba(0,81,255,0.08)_50%,transparent_75%)] blur-3xl pointer-events-none"
          >
          </div>

          <div
            class="relative w-full max-w-[620px] aspect-[16/9] flex items-center justify-center select-none overflow-visible globe-3d-stage"
            id="semicircle-hero-container"
          >
            <!-- 1. Canvas 3D de Alta Resolución para Malla Esférica en Rotación Real -->
            <canvas
              id="globe-3d-mesh-canvas"
              width="1200"
              height="680"
              class="absolute inset-0 w-full h-full pointer-events-none z-0 select-none"
            ></canvas>

            <!-- 2. Capa de Discos de Banderas en Órbita 3D Continua -->
            <div
              id="orbit-flags-track"
              class="absolute inset-0 z-10 pointer-events-none"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- FLUJO: RECIBE Y ENVÍA -->
  <!-- FLUJO: RECIBE Y ENVÍA -->
  <section
    data-stack-section
    class="relative py-20 bg-guira-navy text-white overflow-hidden"
  >
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <EditorialHeader
        theme="dark"
        kicker="Todo en una sola plataforma"
        line1="Recibe y envía pagos"
        line2="internacionales sin salir de Guira"
        description="Cobra desde Estados Unidos y paga a tus proveedores en el exterior desde un mismo lugar, con trazabilidad y control por operación."
        marginBottom="mb-12 sm:mb-16"
      />

      <div class="hub-flow-wrapper" id="network-flow-container">
        <div class="hub-flow-scroll">
          <div class="hub-flow">
            <div class="hub-flow-canvas">
              <!-- SVG Network & Connector Lines -->
              <svg
                class="hub-flow-svg"
                viewBox="0 0 960 420"
                preserveAspectRatio="xMidYMid meet"
                aria-hidden="true"
                id="network-svg"
              >
                <defs>
                  <!-- Glow Filter for active beam (userSpaceOnUse to guarantee 100% rendering on horizontal lines) -->
                  <filter
                    id="laser-glow"
                    filterUnits="userSpaceOnUse"
                    x="0"
                    y="0"
                    width="960"
                    height="420"
                  >
                    <feGaussianBlur stdDeviation="3.5" result="coloredBlur"
                    ></feGaussianBlur>
                    <feMerge>
                      <feMergeNode in="coloredBlur"></feMergeNode>
                      <feMergeNode in="SourceGraphic"></feMergeNode>
                    </feMerge>
                  </filter>
                </defs>

                <!-- Base Static Lines (Tree convergence to Guira & divergence from Guira) -->
                <g
                  class="network-base-paths"
                  stroke="#334155"
                  stroke-width="1.8"
                  fill="none"
                >
                  <!-- ENTRADAS HACIA GUIRA (CONVERGENCIA IZQUIERDA) -->
                  <!-- 1. USD -> Guira (Dotted Cyan accent style like ref) -->
                  <path
                    id="path-in-usd"
                    d="M 150,55 H 270 C 330,55 350,210 423,210"
                    stroke="#00D8FF"
                    stroke-dasharray="4 4"
                    opacity="0.65"></path>
                  <!-- 2. EUR -> Guira -->
                  <path
                    id="path-in-eur"
                    d="M 220,130 H 290 C 340,130 360,210 423,210"></path>
                  <!-- 3. BRL -> Guira (Straight stem with L command) -->
                  <path id="path-in-brl" d="M 290,210 L 423,210"></path>
                  <!-- 4. MXN -> Guira (Dotted Emerald accent style like ref) -->
                  <path
                    id="path-in-mxn"
                    d="M 180,290 H 280 C 335,290 355,210 423,210"
                    stroke="#10B981"
                    stroke-dasharray="4 4"
                    opacity="0.65"></path>
                  <!-- 5. COP -> Guira -->
                  <path
                    id="path-in-cop"
                    d="M 240,365 H 290 C 340,365 360,210 423,210"></path>

                  <!-- SALIDAS DESDE GUIRA (BIFURCACIÓN DERECHA) -->
                  <!-- 6. Guira -> USDC -->
                  <path
                    id="path-out-usdc"
                    d="M 537,210 C 600,210 620,55 680,55 H 810"></path>
                  <!-- 7. Guira -> USDT (Dotted Emerald accent style like ref) -->
                  <path
                    id="path-out-usdt"
                    d="M 537,210 C 600,210 620,130 670,130 H 740"
                    stroke="#10B981"
                    stroke-dasharray="4 4"
                    opacity="0.65"></path>
                  <!-- 8. Guira -> EUR (Straight stem with L command) -->
                  <path id="path-out-eur" d="M 537,210 L 670,210"></path>
                  <!-- 9. Guira -> BOB -->
                  <path
                    id="path-out-bob"
                    d="M 537,210 C 605,210 625,290 680,290 H 780"></path>
                  <!-- 10. Guira -> USD (Dotted Cyan accent style like ref) -->
                  <path
                    id="path-out-usd"
                    d="M 537,210 C 600,210 620,365 670,365 H 720"
                    stroke="#00D8FF"
                    stroke-dasharray="4 4"
                    opacity="0.65"></path>
                </g>

                <!-- Anchor Connector Squares/Dots (from reference image) -->
                <g class="network-anchors" fill="#64748b">
                  <!-- Left anchors -->
                  <rect x="147" y="52" width="6" height="6" rx="1.5"></rect>
                  <rect x="217" y="127" width="6" height="6" rx="1.5"></rect>
                  <rect x="287" y="207" width="6" height="6" rx="1.5"></rect>
                  <rect x="177" y="287" width="6" height="6" rx="1.5"></rect>
                  <rect x="237" y="362" width="6" height="6" rx="1.5"></rect>

                  <!-- Hub inlet & outlet anchors -->
                  <rect
                    x="420"
                    y="207"
                    width="6"
                    height="6"
                    rx="1.5"
                    fill="#00D8FF"></rect>
                  <rect
                    x="534"
                    y="207"
                    width="6"
                    height="6"
                    rx="1.5"
                    fill="#00D8FF"></rect>

                  <!-- Right anchors -->
                  <rect x="807" y="52" width="6" height="6" rx="1.5"></rect>
                  <rect x="737" y="127" width="6" height="6" rx="1.5"></rect>
                  <rect x="667" y="207" width="6" height="6" rx="1.5"></rect>
                  <rect x="777" y="287" width="6" height="6" rx="1.5"></rect>
                  <rect x="717" y="362" width="6" height="6" rx="1.5"></rect>
                </g>

                <!-- Animated Active Line & Traveling Particle Layer -->
                <g id="active-laser-layer">
                  <path
                    id="laser-trail"
                    fill="none"
                    stroke="#00D8FF"
                    stroke-width="2.8"
                    stroke-linecap="round"
                    filter="url(#laser-glow)"
                    opacity="0"></path>
                  <circle
                    id="laser-particle"
                    r="4.5"
                    fill="#ffffff"
                    stroke="#00D8FF"
                    stroke-width="2"
                    filter="url(#laser-glow)"
                    opacity="0"></circle>
                </g>
              </svg>

              <!-- Network Cards / Clean Single Currency Boxes -->
              <!-- LEFT: ORIGENES / ENTRADAS -->
              <div
                class="network-node"
                id="node-orig-usd"
                data-node="orig-usd"
                style="left: 11.46%; top: 13.10%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">USD</span>
                </div>
              </div>

              <div
                class="network-node"
                id="node-orig-eur"
                data-node="orig-eur"
                style="left: 18.75%; top: 30.95%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">EUR</span>
                </div>
              </div>

              <div
                class="network-node"
                id="node-orig-brl"
                data-node="orig-brl"
                style="left: 26.04%; top: 50.00%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">BRL</span>
                </div>
              </div>

              <div
                class="network-node"
                id="node-orig-mxn"
                data-node="orig-mxn"
                style="left: 14.58%; top: 69.05%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">MXN</span>
                </div>
              </div>

              <div
                class="network-node"
                id="node-orig-cop"
                data-node="orig-cop"
                style="left: 20.83%; top: 86.90%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">COP</span>
                </div>
              </div>

              <!-- CENTER: GUIRA HUB -->
              <div
                class="network-node network-hub"
                id="node-guira"
                data-node="guira"
                style="left: 50%; top: 50%;"
              >
                <div class="network-hub-inner">
                  <div class="network-hub-logo-box">
                    <img
                      src="/guira-logo.svg"
                      alt="Guira"
                      class="w-5 h-5 object-contain"
                    />
                  </div>
                  <span class="network-hub-title">Guira</span>
                </div>
                <div class="network-hub-ripple"></div>
              </div>

              <!-- RIGHT: DESTINOS / SALIDAS -->
              <div
                class="network-node"
                id="node-dest-usdc"
                data-node="dest-usdc"
                style="left: 88.54%; top: 13.10%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">USDC</span>
                </div>
              </div>

              <div
                class="network-node"
                id="node-dest-usdt"
                data-node="dest-usdt"
                style="left: 81.25%; top: 30.95%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">USDT</span>
                </div>
              </div>

              <div
                class="network-node"
                id="node-dest-eur"
                data-node="dest-eur"
                style="left: 73.96%; top: 50.00%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">EUR</span>
                </div>
              </div>

              <div
                class="network-node"
                id="node-dest-bob"
                data-node="dest-bob"
                style="left: 85.42%; top: 69.05%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">BOB</span>
                </div>
              </div>

              <div
                class="network-node"
                id="node-dest-usd"
                data-node="dest-usd"
                style="left: 79.17%; top: 86.90%;"
              >
                <div class="network-node-inner">
                  <span class="network-symbol">USD</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-10 flex justify-center">
        <GuiraButton
          href="https://wa.me/59167015106?text=%5BW-COB3%5D%20Hola,%20quiero%20ordenar%20la%20recepci%C3%B3n%20de%20pagos%20internacionales%20de%20mi%20empresa"
          target="_blank"
          rel="noopener noreferrer"
          label="Quiero conocer todo el flujo"
          variant="teal"
        />
      </div>
    </div>
  </section>

  <!-- ESTADÍSTICAS RÁPIDAS -->
  <section
    data-stack-section
    class="py-10 lg:py-12 bg-slate-900 border-b border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-6">
      <div
        class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-slate-800 text-center"
      >
        <div
          class="py-4 md:py-2 px-4 sm:px-6 border-r border-slate-800 md:border-r-0"
        >
          <p
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-1.5"
          >
            USD
          </p>
          <p class="text-guira-cyan text-xs sm:text-sm font-semibold">
            Cobros desde EE. UU.
          </p>
        </div>
        <div class="py-4 md:py-2 px-4 sm:px-6">
          <p
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-1.5"
          >
            Wire
          </p>
          <p class="text-guira-cyan text-xs sm:text-sm font-semibold">
            Pagos corporativos
          </p>
        </div>
        <div
          class="py-4 md:py-2 px-4 sm:px-6 border-r border-slate-800 md:border-r-0"
        >
          <p
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-1.5"
          >
            ACH
          </p>
          <p class="text-guira-cyan text-xs sm:text-sm font-semibold">
            Según estructura
          </p>
        </div>
        <div class="py-4 md:py-2 px-4 sm:px-6">
          <p
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-1.5"
          >
            1 lugar
          </p>
          <p class="text-guira-cyan text-xs sm:text-sm font-semibold">
            Documentos y estado
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEMA -->
  <section data-stack-section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.65rem] font-extrabold uppercase tracking-tight leading-[1.08] mb-6 text-slate-900"
        >
          Recibir el pago es solo una parte del proceso
        </h2>
        <p
          class="text-slate-600 text-lg font-medium leading-relaxed max-w-3xl mx-auto"
        >
          Cuando cobras a clientes del exterior, tu empresa también debe
          identificar el origen del fondo, relacionarlo con la factura y
          conservar respaldo para controles internos.
        </p>
      </div>

      <div class="border-y border-slate-200 divide-y divide-slate-200 mb-10">
        <div
          class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-200"
        >
          <div class="py-8 md:py-10 md:pr-8 lg:pr-10">
            <span
              class="font-mono text-xs font-bold text-rose-500 tracking-widest uppercase mb-2 block"
            >
              01 · Identificación
            </span>
            <h3
              class="text-base sm:text-lg font-extrabold uppercase tracking-wider text-rose-600 mb-2"
            >
              No sabes qué cliente pagó
            </h3>
            <p
              class="text-sm sm:text-base font-medium text-slate-600 leading-relaxed"
            >
              La referencia bancaria llega incompleta o con datos del
              intermediario.
            </p>
          </div>
          <div class="py-8 md:py-10 md:pl-8 lg:pl-10">
            <span
              class="font-mono text-xs font-bold text-rose-500 tracking-widest uppercase mb-2 block"
            >
              02 · Documentación
            </span>
            <h3
              class="text-base sm:text-lg font-extrabold uppercase tracking-wider text-rose-600 mb-2"
            >
              La documentación queda dispersa
            </h3>
            <p
              class="text-sm sm:text-base font-medium text-slate-600 leading-relaxed"
            >
              Entre correos, carpetas y mensajes de distintas áreas sin un
              repositorio central.
            </p>
          </div>
        </div>
        <div
          class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-200"
        >
          <div class="py-8 md:py-10 md:pr-8 lg:pr-10">
            <span
              class="font-mono text-xs font-bold text-rose-500 tracking-widest uppercase mb-2 block"
            >
              03 · Visibilidad
            </span>
            <h3
              class="text-base sm:text-lg font-extrabold uppercase tracking-wider text-rose-600 mb-2"
            >
              El seguimiento depende de mensajes
