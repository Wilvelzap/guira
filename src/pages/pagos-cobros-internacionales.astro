  <script is:inline>
    function initNetworkFlow() {
      var container = document.getElementById("network-flow-container");
      if (!container) return;

      var trail = document.getElementById("laser-trail");
      var particle = document.getElementById("laser-particle");

      var ROUTES = [
        {
          name: "Cobro USD → Cuenta Guira → Salida USDC",
          color: "#00D8FF",
          glow: "rgba(0, 216, 255, 0.55)",
          steps: [
