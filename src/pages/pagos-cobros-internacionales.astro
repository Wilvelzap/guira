            { type: "path", id: "path-in-usd", duration: 800 },
            { type: "node", id: "node-guira", duration: 600 },
            { type: "path", id: "path-out-usdc", duration: 800 },
            { type: "node", id: "node-dest-usdc", duration: 1200 },
          ],
        },
        {
          name: "Cobro EUR → Cuenta Guira → Liquidación BOB",
          color: "#F59E0B",
          glow: "rgba(245, 158, 11, 0.55)",
          steps: [
            { type: "node", id: "node-orig-eur", duration: 450 },
            { type: "path", id: "path-in-eur", duration: 750 },
            { type: "node", id: "node-guira", duration: 600 },
            { type: "path", id: "path-out-bob", duration: 750 },
            { type: "node", id: "node-dest-bob", duration: 1200 },
          ],
        },
        {
          name: "Cobro BRL → Cuenta Guira → Pago EUR Europa",
          color: "#10B981",
          glow: "rgba(16, 185, 129, 0.55)",
          steps: [
            { type: "node", id: "node-orig-brl", duration: 450 },
            { type: "path", id: "path-in-brl", duration: 700 },
            { type: "node", id: "node-guira", duration: 600 },
            { type: "path", id: "path-out-eur", duration: 700 },
            { type: "node", id: "node-dest-eur", duration: 1200 },
          ],
        },
        {
          name: "Cobro MXN → Cuenta Guira → Pago USD Exterior",
          color: "#A855F7",
          glow: "rgba(168, 85, 247, 0.55)",
          steps: [
            { type: "node", id: "node-orig-mxn", duration: 450 },
            { type: "path", id: "path-in-mxn", duration: 750 },
            { type: "node", id: "node-guira", duration: 600 },
            { type: "path", id: "path-out-usd", duration: 750 },
            { type: "node", id: "node-dest-usd", duration: 1200 },
          ],
        },
        {
          name: "Cobro COP → Cuenta Guira → Salida USDT",
          color: "#06B6D4",
          glow: "rgba(6, 182, 212, 0.55)",
          steps: [
            { type: "node", id: "node-orig-cop", duration: 450 },
            { type: "path", id: "path-in-cop", duration: 800 },
            { type: "node", id: "node-guira", duration: 600 },
            { type: "path", id: "path-out-usdt", duration: 750 },
            { type: "node", id: "node-dest-usdt", duration: 1200 },
          ],
        },
      ];

      var currentRouteIdx = 0;
      var cancelCurrentAnimation = null;
      var loopTimer = null;

      function clearActiveStates() {
        var nodes = document.querySelectorAll(".network-node");
        for (var i = 0; i < nodes.length; i++) {
          nodes[i].classList.remove("is-active", "is-hub-active");
          nodes[i].style.removeProperty("--active-color");
          nodes[i].style.removeProperty("--active-glow");
        }
        if (trail) {
          trail.setAttribute("opacity", "0");
          trail.setAttribute("d", "");
        }
        if (particle) {
          particle.setAttribute("opacity", "0");
        }
      }

      function highlightNode(nodeId, color, glow) {
        var node = document.getElementById(nodeId);
        if (!node) return;
        node.classList.add("is-active");
        if (nodeId === "node-guira") {
          node.classList.add("is-hub-active");
        }
        node.style.setProperty("--active-color", color);
        node.style.setProperty("--active-glow", glow);
      }

      function animatePath(pathId, reverse, duration, color, onComplete) {
        var pathEl = document.getElementById(pathId);
        if (!pathEl || !trail || !particle) {
          onComplete();
          return function () {};
        }

        var totalLen = pathEl.getTotalLength();
        var pathD = pathEl.getAttribute("d") || "";
        trail.setAttribute("d", pathD);
        trail.setAttribute("stroke", color);
        particle.setAttribute("stroke", color);
        particle.setAttribute("fill", "#ffffff");
        trail.style.strokeDasharray = totalLen + " " + totalLen;
        trail.style.strokeDashoffset = totalLen;

        var startPt = pathEl.getPointAtLength(0);
        particle.setAttribute("cx", startPt.x);
        particle.setAttribute("cy", startPt.y);

        var startTime = performance.now();
        var reqId = null;
        var cancelled = false;

        trail.setAttribute("opacity", "1");
        particle.setAttribute("opacity", "1");

        // Fase 1: avance completo de la línea hasta llegar al destino (60% del tiempo)
        // Fase 2: una vez en el destino, la cola se recoge desde el inicio hacia el final (40% del tiempo)
        var totalDuration = duration * 1.3;

        function tick(now) {
          if (cancelled) return;
          var elapsed = now - startTime;
          var rawProgress = Math.min(elapsed / totalDuration, 1);

          if (rawProgress <= 0.6) {
            // FASE 1: DIBUJADO COMPLETO DE IDA HASTA EL DESTINO
            var p1 = rawProgress / 0.6;
            // easeOutCubic para una llegada suave
            var easeP1 = 1 - Math.pow(1 - p1, 3);
            var dist1 = easeP1 * totalLen;
            var point1 = pathEl.getPointAtLength(dist1);

            particle.setAttribute("cx", point1.x);
            particle.setAttribute("cy", point1.y);
            particle.setAttribute("opacity", "1");

            trail.style.strokeDashoffset = (1 - easeP1) * totalLen;
          } else {
            // FASE 2: RECOGIDO DESDE EL INICIO HACIA EL DESTINO
            var p2 = (rawProgress - 0.6) / 0.4;
            // easeInQuad para el desvanecimiento y recogido
            var easeP2 = p2 * p2;

            var endPoint = pathEl.getPointAtLength(totalLen);
            particle.setAttribute("cx", endPoint.x);
            particle.setAttribute("cy", endPoint.y);
            particle.setAttribute("opacity", String(Math.max(0, 1 - p2 * 1.5)));

            trail.style.strokeDashoffset = -easeP2 * totalLen;
          }

          if (rawProgress < 1) {
            reqId = requestAnimationFrame(tick);
          } else {
            trail.setAttribute("opacity", "0");
            particle.setAttribute("opacity", "0");
            trail.style.strokeDashoffset = "0";
            onComplete();
          }
        }

        reqId = requestAnimationFrame(tick);

        return function () {
          cancelled = true;
          if (reqId) cancelAnimationFrame(reqId);
        };
      }

      function playRoute(routeIdx) {
        if (cancelCurrentAnimation) {
          cancelCurrentAnimation();
          cancelCurrentAnimation = null;
        }
        clearTimeout(loopTimer);
        clearActiveStates();

        currentRouteIdx = routeIdx % ROUTES.length;
        var route = ROUTES[currentRouteIdx];

        var stepIndex = 0;
        var stepTimeout = null;

        function executeNextStep() {
          if (stepIndex >= route.steps.length) {
            loopTimer = setTimeout(function () {
              playRoute((currentRouteIdx + 1) % ROUTES.length);
            }, 1400);
            return;
          }

          var step = route.steps[stepIndex];
          stepIndex++;

          if (step.type === "node") {
            highlightNode(step.id, route.color, route.glow);
            stepTimeout = setTimeout(executeNextStep, step.duration);
            cancelCurrentAnimation = function () {
              clearTimeout(stepTimeout);
            };
          } else if (step.type === "path") {
            var cancelPath = animatePath(
              step.id,
              !!step.reverse,
              step.duration,
              route.color,
              function () {
                executeNextStep();
              },
            );
            cancelCurrentAnimation = cancelPath;
          }
        }

        executeNextStep();
      }

      var nodeToRouteMap = {
        "node-orig-usd": 0,
        "node-orig-eur": 1,
        "node-orig-brl": 2,
        "node-orig-mxn": 3,
        "node-orig-cop": 4,
        "node-guira": 0,
        "node-dest-usdc": 0,
        "node-dest-bob": 1,
        "node-dest-usdt": 2,
        "node-dest-usd": 3,
        "node-dest-eur": 4,
      };

      var allNodes = document.querySelectorAll(".network-node");
      for (var n = 0; n < allNodes.length; n++) {
        allNodes[n].addEventListener("click", function () {
          var rIdx = nodeToRouteMap[this.id];
          if (rIdx !== undefined) {
            playRoute(rIdx);
          }
        });
      }

      playRoute(0);
    }

    function initTraceabilityTimeline() {
      var container = document.getElementById("traceability-modal-demo");
      if (!container) return;

      var progressBar = document.getElementById("timeline-progress-bar");
      var pulseDot = document.getElementById("timeline-pulse-dot");
      var statusBadge = document.getElementById("op-status-badge");
      var steps = container.querySelectorAll(".timeline-step");
      if (!steps.length || !progressBar) return;

      var currentStep = 1;
      var timer = null;

      var stepData = [
        {
          name: "Orden creada",
          badgeText: "Orden creada",
          badgeClass: "bg-amber-50 text-amber-700 border-amber-200",
          dotClass: "bg-amber-500",
        },
        {
          name: "Esperando depósito",
          badgeText: "Esperando depósito",
          badgeClass: "bg-amber-50 text-amber-700 border-amber-200",
          dotClass: "bg-amber-500",
        },
        {
          name: "Depósito validado",
          badgeText: "Depósito validado",
          badgeClass: "bg-cyan-50 text-cyan-700 border-cyan-200",
          dotClass: "bg-cyan-500",
        },
        {
          name: "Procesando",
          badgeText: "Procesando",
          badgeClass: "bg-blue-50 text-blue-700 border-blue-200",
          dotClass: "bg-blue-500",
        },
        {
          name: "Enviado",
          badgeText: "Enviado",
          badgeClass: "bg-indigo-50 text-indigo-700 border-indigo-200",
          dotClass: "bg-indigo-500",
        },
        {
          name: "Completado",
          badgeText: "Completado",
          badgeClass: "bg-emerald-50 text-emerald-700 border-emerald-200",
          dotClass: "bg-emerald-500",
        },
      ];

      function renderStep(targetStep) {
        currentStep = targetStep;
        var totalSteps = steps.length;
        var progressPercent = ((currentStep - 1) / (totalSteps - 1)) * 100;

        progressBar.style.height = progressPercent + "%";

        if (pulseDot) {
          pulseDot.style.opacity = "1";
          pulseDot.style.top = progressPercent + "%";
          setTimeout(function () {
            if (pulseDot) pulseDot.style.opacity = "0";
          }, 450);
        }

        steps.forEach(function (stepEl, idx) {
          var stepNum = idx + 1;
          var iconEl = stepEl.querySelector(".timeline-node-icon");
          var labelEl = stepEl.querySelector(".timeline-label");
          var subEl = stepEl.querySelector(".timeline-sub");

          if (stepNum < currentStep) {
            if (iconEl) {
              iconEl.className =
                "timeline-node-icon w-8 h-8 rounded-full bg-emerald-50 border-2 border-emerald-500 text-emerald-600 flex items-center justify-center shrink-0 shadow-sm transition-all duration-500";
              iconEl.innerHTML =
                '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
            }
            if (labelEl)
              labelEl.className =
                "text-sm sm:text-base font-bold text-emerald-700 timeline-label transition-colors";
            if (subEl) {
              subEl.classList.add("hidden");
              subEl.innerHTML = "";
            }
          } else if (stepNum === currentStep) {
            if (iconEl) {
              if (stepNum === 6) {
                iconEl.className =
                  "timeline-node-icon w-8 h-8 rounded-full bg-guira-teal text-white font-black text-sm flex items-center justify-center shrink-0 shadow-[0_0_16px_rgba(0,81,255,0.6)] scale-110 transition-all duration-500";
                iconEl.innerHTML = "6";
              } else {
                iconEl.className =
                  "timeline-node-icon w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-[0_0_14px_rgba(37,99,235,0.5)] scale-105 transition-all duration-500";
                iconEl.innerHTML = String(stepNum);
              }
            }
            if (labelEl) {
              if (stepNum === 6) {
                labelEl.className =
                  "text-sm sm:text-base font-extrabold text-guira-teal timeline-label transition-colors";
              } else {
                labelEl.className =
                  "text-sm sm:text-base font-extrabold text-blue-600 timeline-label transition-colors";
              }
            }
            if (subEl) {
              subEl.classList.remove("hidden");
              subEl.innerHTML =
                '<span class="w-1.5 h-1.5 rounded-full bg-blue-600 inline-block mr-1"></span> Paso ' +
                stepNum +
                " de 6 · estado actual";
            }
          } else {
            if (iconEl) {
              iconEl.className =
                "timeline-node-icon w-8 h-8 rounded-full bg-slate-100 border border-slate-200 text-slate-400 font-semibold text-xs flex items-center justify-center shrink-0 transition-all duration-500";
              iconEl.innerHTML = String(stepNum);
            }
            if (labelEl)
              labelEl.className =
                "text-sm sm:text-base font-medium text-slate-400 timeline-label transition-colors";
            if (subEl) {
              subEl.classList.add("hidden");
              subEl.innerHTML = "";
            }
          }
        });

        var data = stepData[currentStep - 1];
        if (statusBadge && data) {
          statusBadge.className =
            "inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border transition-all duration-300 " +
            data.badgeClass;
          statusBadge.innerHTML =
            '<span class="w-2 h-2 rounded-full mr-1.5 animate-pulse ' +
            data.dotClass +
            '"></span>' +
            data.badgeText;
        }
      }

      function advanceStep() {
        var next = currentStep >= 6 ? 1 : currentStep + 1;
        renderStep(next);
        var delay = next === 6 ? 3500 : 1600;
        timer = setTimeout(advanceStep, delay);
      }

      steps.forEach(function (sEl, idx) {
        sEl.style.cursor = "pointer";
        sEl.addEventListener("click", function () {
          clearTimeout(timer);
          renderStep(idx + 1);
          timer = setTimeout(advanceStep, 2600);
        });
      });

      renderStep(1);
      timer = setTimeout(advanceStep, 1600);
    }

    function initSemicircleHero() {
      var container = document.getElementById("semicircle-hero-container");
      var canvas = document.getElementById("globe-3d-mesh-canvas");
      var flagsTrack = document.getElementById("orbit-flags-track");
      if (!container || !canvas || !flagsTrack) return;

      var ctx = canvas.getContext("2d");
      if (!ctx) return;

      // Lista exacta de países de "Alcance regional de Guira" en index.astro
      var COUNTRIES = [
        {
          name: "Bolivia",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/bo.svg",
        },
        {
          name: "Estados Unidos",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/us.svg",
        },
        {
          name: "Perú",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/pe.svg",
        },
        {
          name: "Colombia",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/co.svg",
        },
        {
          name: "China",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/cn.svg",
        },
        {
          name: "Chile",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/cl.svg",
        },
        {
          name: "España",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/es.svg",
        },
        {
          name: "Reino Unido",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/gb.svg",
        },
        {
          name: "Brasil",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/br.svg",
        },
        {
          name: "México",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/mx.svg",
        },
        {
          name: "Argentina",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/ar.svg",
        },
        {
          name: "Canadá",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/ca.svg",
        },
        {
          name: "Unión Europea",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/european_union.svg",
        },
        {
          name: "Alemania",
          flag: "https://cdn.jsdelivr.net/gh/hatscripts/circle-flags/flags/de.svg",
        },
      ];

      flagsTrack.innerHTML = "";
      var flagElements = [];

      COUNTRIES.forEach(function (c) {
        var el = document.createElement("div");
        el.className = "flag-disc-wrapper";
        el.title = c.name;
        el.innerHTML =
          '<div class="flag-disc-inner">' +
          '<img src="' +
          c.flag +
          '" alt="' +
          c.name +
          '" class="w-full h-full object-cover rounded-full select-none" loading="lazy" />' +
          "</div>";
        flagsTrack.appendChild(el);
        flagElements.push(el);
      });

      var N = COUNTRIES.length;
      var flagAngleOffset = 0;
      var flagSpeed = 0.0022;

      var globeRotY = 0;
      var globeSpeed = 0.0016;

      // Parámetros de proyección 3D del Canvas
      var W = canvas.width; // 1200
      var H = canvas.height; // 680
      var cx = W / 2; // 600
      var cy = H - 60; // 620 (Línea de horizonte en la base)
      var R = 490; // Radio en espacio canvas 1200x680
      var pitch = 22 * (Math.PI / 180); // Inclinación hacia la cámara (eje X)
      var cosP = Math.cos(pitch);
      var sinP = Math.sin(pitch);

      // Proyección 3D trigonométrica esférica (lat, lon) -> (x, y, z)
      function project3D(latRad, lonRad) {
        var cosLat = Math.cos(latRad);
        var sinLat = Math.sin(latRad);
        var cosLon = Math.cos(lonRad);
        var sinLon = Math.sin(lonRad);

        // Coordenadas en esfera unitaria
        var x0 = cosLat * sinLon;
        var y0 = sinLat;
        var z0 = cosLat * cosLon;

        // Rotación de inclinación sobre el eje X
        var y1 = y0 * cosP - z0 * sinP;
        var z1 = y0 * sinP + z0 * cosP;
        var x1 = x0;

        return {
          x: cx + x1 * R,
          y: cy - y1 * R,
          z: z1,
        };
      }

      function draw3DGlobe() {
        ctx.clearRect(0, 0, W, H);

        // 1. Sombreado esférico volumétrico natural
        var sphereGrad = ctx.createRadialGradient(
          cx,
          cy - R * 0.45,
          R * 0.08,
          cx,
          cy,
          R,
        );
        sphereGrad.addColorStop(0, "rgba(56, 189, 248, 0.22)");
        sphereGrad.addColorStop(0.55, "rgba(0, 81, 255, 0.09)");
        sphereGrad.addColorStop(1, "rgba(2, 132, 199, 0.01)");

        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, R, Math.PI, 0, false);
        ctx.fillStyle = sphereGrad;
        ctx.fill();
        ctx.restore();

        // 2. Paralelos de Latitud 3D (Ecuador 0°, 18°, 36°, 54°, 72°)
        var parallels = [0, 18, 36, 54, 72];
        parallels.forEach(function (latDeg) {
          var latRad = latDeg * (Math.PI / 180);
          ctx.beginPath();
          var steps = 60;
          for (var s = 0; s <= steps; s++) {
            var lonRad = (s / steps) * Math.PI * 2;
            var pt = project3D(latRad, lonRad);
            if (s === 0) ctx.moveTo(pt.x, pt.y);
            else ctx.lineTo(pt.x, pt.y);
          }
          if (latDeg === 0) {
            ctx.lineWidth = 3.2;
            ctx.strokeStyle = "rgba(56, 189, 248, 0.7)";
          } else {
            ctx.lineWidth = 1.8;
            ctx.strokeStyle = "rgba(186, 230, 253, 0.4)";
          }
          ctx.stroke();
        });

        // 3. Meridianos de Longitud 3D en Rotación Continua (12 meridianos)
        var meridiansCount = 12;
        for (var m = 0; m < meridiansCount; m++) {
          var lonRad = globeRotY + (m / meridiansCount) * Math.PI * 2;
          ctx.beginPath();
          var latSteps = 40;
          var avgZ = 0;
          for (var ls = 0; ls <= latSteps; ls++) {
            // Curvan desde el polo norte hasta ligeramente por debajo del ecuador (-12°)
            var latRad = (1 - ls / latSteps) * (Math.PI / 2 + 0.2) - 0.2;
            var pt = project3D(latRad, lonRad);
            if (ls === 0) ctx.moveTo(pt.x, pt.y);
            else ctx.lineTo(pt.x, pt.y);
            avgZ += pt.z;
          }
          avgZ /= latSteps + 1;

          // Iluminación dependiente de la profundidad Z
          var zNorm = Math.max(0, Math.min(1, (avgZ + 1) / 2));
          var alpha = 0.12 + 0.55 * Math.pow(zNorm, 1.3);
          var lineW = 1.2 + 1.6 * zNorm;

          ctx.lineWidth = lineW;
          ctx.strokeStyle = "rgba(186, 230, 253, " + alpha.toFixed(2) + ")";
          ctx.stroke();
        }

        // 4. Borde suave del Arco Superior (sin línea recta horizontal inferior)
        ctx.beginPath();
        ctx.arc(cx, cy, R, Math.PI, 0, false);
        ctx.lineWidth = 3.4;
        ctx.strokeStyle = "rgba(56, 189, 248, 0.65)";
        ctx.stroke();
      }

      function tick() {
        globeRotY += globeSpeed;
        flagAngleOffset += flagSpeed;

        draw3DGlobe();

        // Posicionar las banderas en órbita 3D sobre la cúpula
        var flagRx = 250;
        var flagRy = 215;
        var flagCx = 300;
        var flagCy = 310;

        COUNTRIES.forEach(function (c, i) {
          var rawTheta = flagAngleOffset + (i / N) * Math.PI * 2;
          var theta = rawTheta % (Math.PI * 2);
          if (theta < 0) theta += Math.PI * 2;

          var el = flagElements[i];
          var isVisible = theta >= 0.02 && theta <= Math.PI - 0.02;

          if (isVisible) {
            var sinT = Math.sin(theta);
            var cosT = Math.cos(theta);

            var x = flagCx - flagRx * cosT;
            var y = flagCy - flagRy * sinT;

            var elevation = sinT;
            var size = 36 + 32 * elevation;
            var opacity = Math.pow(elevation, 0.4);

            var pctX = (x / 600) * 100;
            var pctY = (y / 340) * 100;
            var zDepth = 18 + 36 * elevation;

            el.style.display = "flex";
            el.style.left = pctX + "%";
            el.style.top = pctY + "%";
            el.style.width = size.toFixed(1) + "px";
            el.style.height = size.toFixed(1) + "px";
            el.style.transform =
              "translate(-50%, -50%) translateZ(" + zDepth.toFixed(1) + "px)";
            el.style.opacity = opacity.toFixed(3);
            el.style.zIndex = String(Math.round(elevation * 100));
          } else {
            el.style.display = "none";
          }
        });

        requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);
    }

    function initPageScripts() {
      initSemicircleHero();
      initNetworkFlow();
      initTraceabilityTimeline();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPageScripts);
    } else {
      initPageScripts();
    }
    document.addEventListener("astro:page-load", initPageScripts);
  </script>
</Layout>
