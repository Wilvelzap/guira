---
import Layout from "../layouts/Layout.astro";
import Flag from "../components/Flag.astro";
import DemoForm from "../components/DemoForm.astro";
import StackedSections from "../components/StackedSections.astro";
import FaqSection from "../components/FaqSection.astro";
import EditorialGridSection from "../components/EditorialGridSection.astro";
import GuiraButton from "../components/GuiraButton.astro";

const opcionesCobroItems = [
  {
    icon: "landmark",
    title: "Wire Transfer",
    description:
      "Suele usarse para montos relevantes, contratos empresariales y operaciones donde es importante identificar claramente origen, beneficiario y referencia.",
    link: {
      href: "/blog/wire-vs-ach-diferencias-empresas-bolivianas/",
      text: "Ver diferencias con ACH",
    },
  },
  {
    icon: "repeat-2",
    title: "ACH",
    description:
      "Puede servir para pagos recurrentes o administrativos originados dentro de Estados Unidos cuando la empresa cuenta con una estructura habilitada para recibirlos.",
    link: {
      href: "/blog/como-cobrar-clientes-estados-unidos-desde-bolivia/",
      text: "Leer opciones de cobro",
    },
  },
  {
    icon: "layout-dashboard",
    title: "Plataforma especializada",
    description:
      "Ayuda a centralizar información, documentos, seguimiento y validaciones asociadas a cada operación internacional.",
    link: {
      href: "/blog/desafios-recibir-pagos-internacionales-bolivia/",
      text: "Conocer desafíos frecuentes",
    },
  },
];

const comoGuiraOrdenaItems = [
  {
    icon: "file-text",
    step: "01 · Preparación",
    title: "Prepara la operación",
    description:
      "Organiza factura, contrato, datos del pagador y referencia para que el cobro llegue identificado desde el inicio.",
  },
  {
    icon: "route",
    step: "02 · Recepción",
    title: "Recibe por la ruta adecuada",
    description:
      "Evalúa si la operación conviene por Wire, ACH o una estructura especializada según monto, frecuencia y requisitos.",
  },
  {
    icon: "shield-check",
    step: "03 · Respaldo",
    title: "Centraliza el respaldo",
    description:
      "Mantén comprobantes, conciliación, estado e historial de la operación disponibles para tu equipo.",
  },
];

const comoGuiraOrdenaBotones = [
  {
    href: "#solicitar-demo",
    label: "Solicitar demostración",
    variant: "teal" as const,
  },
  {
    href: "https://wa.me/59167015106?text=Hola,%20mi%20cliente%20de%20Estados%20Unidos%20quiere%20pagarme%20y%20necesito%20orientaci%C3%B3n",
    label: "Hablar por WhatsApp",
    variant: "dark" as const,
  },
];

const cobrosFaq = [
  {
    question: "¿Cuál es la mejor forma de cobrar clientes de Estados Unidos desde Bolivia?",
    answer: "Depende del monto, frecuencia, tipo de cliente y documentación requerida. Wire suele usarse en pagos corporativos internacionales, ACH puede servir si existe una estructura habilitada en Estados Unidos y una plataforma especializada ayuda a ordenar seguimiento y respaldo."
  },
  {
    question: "¿ACH sirve para recibir pagos directamente en una cuenta boliviana?",
    answer: "ACH es una red de pagos de Estados Unidos. Para una empresa boliviana puede ser útil cuando cuenta con una cuenta, partner o plataforma que pueda recibir fondos por esa vía dentro de EE. UU. No funciona como una transferencia internacional directa a Bolivia."
  },
  {
    question: "¿Qué información suele pedir mi cliente para realizar el pago?",
    answer: "Normalmente solicita nombre legal de la empresa, dirección fiscal, datos de la cuenta o ruta receptora, referencia de factura o contrato, información bancaria necesaria y documentación de respaldo cuando corresponda."
  },
  {
    question: "¿Qué documentos debo conservar por cada cobro internacional?",
    answer: "Como mínimo conviene conservar factura, contrato u orden de servicio, instrucciones de pago, comprobante del pagador, confirmación de recepción y registro interno de conciliación. Cada operación puede requerir documentos adicionales."
  },
  {
    question: "¿Cómo ayuda Guira en la gestión de cobros internacionales?",
    answer: "Guira centraliza información, documentación, estado e historial de las operaciones internacionales para que el equipo administrativo y financiero tenga mayor visibilidad y control operativo."
  }
];
---

<Layout
  title="Cómo cobrar a clientes del exterior desde Bolivia | Guira"
  description="Cobra a tus clientes de Estados Unidos, Europa y la región en dólares desde Bolivia, en una cuenta operativa propia y con respaldo documental en cada cobro."
  canonicalUrl="https://www.guiracorp.com/pagos-cobros-internacionales"
  activeLink="pagos-cobros-internacionales"
  footerTheme="dark"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href="/assets/images/plataforma-dashboard-macbook.webp"
      type="image/webp"
    />
    <link
      rel="preload"
      as="image"
      href="/assets/images/soluciones-corporativo.webp"
      type="image/webp"
    />
    <style is:inline>
      html {
        scroll-behavior: smooth;
      }
      /* Ocultar el widget global de WhatsApp (inyectado por main.js); en esta página usamos el botón personalizado más grande */
      body > a.bg-emerald-500[href*="wa.me"]:not(.p-6) {
        display: none !important;
      }
    </style>
  </Fragment>

  <StackedSections>
    <!-- HERO -->
    <header
      data-stack-section
      class="relative pt-20 pb-16 overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900"
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(0,81,255,0.15),transparent_50%),radial-gradient(circle_at_70%_80%,rgba(0,216,255,0.1),transparent_40%)]"
      >
      </div>

      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="text-left">
            <p class="section-kicker text-guira-cyan mb-3">
              Para empresas importadoras y exportadoras de Bolivia
            </p>
            <h1
              class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-[1.1] text-white"
            >
              Cobra a tus clientes <span class="text-guira-cyan">del exterior</span> desde Bolivia
            </h1>
            <p
              class="text-base md:text-lg text-slate-400 mb-10 max-w-xl font-medium leading-relaxed"
            >
              Todo desde una misma cuenta en dólares, sin depender de trámites
              bancarios distintos para cada operación.
            </p>
            <div class="flex flex-col sm:flex-row items-center gap-4">
              <GuiraButton
                href="https://wa.me/59167015106?text=Hola,%20quiero%20recibir%20pagos%20USD%20desde%20Estados%20Unidos%20con%20Guira"
                target="_blank"
                rel="noopener noreferrer"
                label="Hablar con un especialista"
                variant="teal"
              />
              <GuiraButton
                href="#solicitar-demo"
                label="Solicitar demostración"
                variant="dark"
              />
            </div>
            <p class="text-slate-400 text-sm mt-4 font-medium">
              Te orientamos según tu tipo de cliente, monto y documentación
              disponible.
            </p>
          </div>

          <!-- Mockup de la plataforma -->
          <div class="relative">
            <div
              class="absolute inset-0 bg-gradient-to-r from-guira-teal/20 to-guira-cyan/20 blur-3xl rounded-full"
            >
            </div>
            <img
              src="/assets/images/plataforma-dashboard-macbook.webp"
              alt="Plataforma Guira - Dashboard con saldo, operaciones y trazabilidad"
              class="relative rounded-2xl shadow-2xl border border-slate-700 w-full"
            />
            <a
              href="https://app.guiracorp.com"
              target="_blank"
              rel="noopener noreferrer"
              class="absolute -bottom-4 -right-4 bg-guira-teal text-white px-4 py-2 rounded-xl font-bold text-sm animate-bounce hover:bg-guira-teal/80 transition-all"
            >
              Plataforma en vivo
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- FLUJO: RECIBE Y ENVÍA -->
    <section
      data-stack-section
      class="relative py-24 bg-slate-950 text-white overflow-hidden"
    >
      <div class="absolute inset-0">
        <picture class="w-full h-full block">
          <source
            srcset="/assets/images/soluciones-corporativo.webp"
            type="image/webp"
          />
          <img
            src="/assets/images/soluciones-corporativo.jpg"
            alt=""
            class="flow-bg-image w-full h-full object-cover object-center"
            aria-hidden="true"
            loading="lazy"
          />
        </picture>
        <div
          class="absolute inset-0 bg-gradient-to-b from-slate-950/96 via-slate-950/92 to-slate-950"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/88 to-slate-950/94"
        >
        </div>
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(0,81,255,0.16),transparent_45%),radial-gradient(circle_at_82%_78%,rgba(0,216,255,0.14),transparent_42%)]"
      >
      </div>
      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="text-center mb-14">
          <p class="section-kicker text-guira-cyan mb-3">
            Todo en una sola plataforma
          </p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.65rem] font-extrabold uppercase tracking-tight leading-[1.08] mb-6">
            Recibe y envía pagos internacionales sin salir de Guira
          </h2>
          <p class="text-slate-300 text-lg max-w-2xl mx-auto font-medium leading-relaxed">
            Cobra desde Estados Unidos y paga a tus proveedores en el exterior
            desde un mismo lugar, eligiendo el destino y la moneda que más te
            convenga.
          </p>
        </div>

        <div
          class="international-visual mb-10"
          aria-label="Vista gráfica de capacidades internacionales con Guira"
        >
          <div class="console-topbar">
            <div class="flex items-center gap-3">
              <span class="console-dot"></span>
              <div>
                <p class="console-kicker">Mapa de posibilidades</p>
                <p class="console-title">
                  Lo que puedes habilitar para cobrar, mantener y pagar
                </p>
              </div>
            </div>
            <div class="console-meta">
              <span>USD</span>
              <span>EUR / IBAN</span>
              <span>BOB local</span>
              <span>ACH / Wire</span>
            </div>
          </div>

          <div class="hub-flow">
            <div class="hub-flow-labels">
              <span class="hub-flow-label">Origen</span>
              <span class="hub-flow-label hub-flow-label-right">Destino</span>
            </div>

            <div class="hub-flow-canvas">
              <svg
                class="hub-flow-svg"
                viewBox="0 0 600 340"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <defs>
                  <linearGradient
                    id="hubFlowLine"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="0%"
                  >
                    <stop offset="0%" stop-color="#00D8FF" stop-opacity="0.7"
                    ></stop>
                    <stop
                      offset="100%"
                      stop-color="#0051FF"
                      stop-opacity="0.18"></stop>
                  </linearGradient>
                </defs>

                <path
                  class="hub-flow-path"
                  d="M60,170 C140,150 220,190 300,170"
                ></path>
                <path
                  class="hub-flow-pulse"
                  style="animation-delay:0s"
                  d="M60,170 C140,150 220,190 300,170"></path>

                <path
                  class="hub-flow-path"
                  d="M300,170 C420,170 420,34 540,34"
                ></path>
                <path
                  class="hub-flow-pulse"
                  style="animation-delay:.3s"
                  d="M300,170 C420,170 420,34 540,34"></path>

                <path
                  class="hub-flow-path"
                  d="M300,170 C420,170 420,102 540,102"
                ></path>
                <path
                  class="hub-flow-pulse"
                  style="animation-delay:.6s"
                  d="M300,170 C420,170 420,102 540,102"></path>

                <path
                  class="hub-flow-path"
                  d="M300,170 C420,170 420,170 540,170"
                ></path>
                <path
                  class="hub-flow-pulse"
                  style="animation-delay:.9s"
                  d="M300,170 C420,170 420,170 540,170"></path>

                <path
                  class="hub-flow-path"
                  d="M300,170 C420,170 420,238 540,238"
                ></path>
                <path
                  class="hub-flow-pulse"
                  style="animation-delay:1.2s"
                  d="M300,170 C420,170 420,238 540,238"></path>

                <path
                  class="hub-flow-path"
                  d="M300,170 C420,170 420,306 540,306"
                ></path>
                <path
                  class="hub-flow-pulse"
                  style="animation-delay:1.5s"
                  d="M300,170 C420,170 420,306 540,306"></path>
              </svg>

              <div class="hub-flow-node" style="--x:10%;--y:50%;">
                <span class="hub-sphere"><Flag code="bo" size="lg" /></span>
                <p class="hub-node-label">Bolivia</p>
              </div>

              <div
                class="hub-flow-node hub-flow-center"
                style="--x:50%;--y:50%;"
              >
                <span class="hub-sphere hub-sphere-brand">
                  <img
                    src="/guira-logo.svg"
                    alt=""
                    class="w-7 h-7"
                    aria-hidden="true"
                  />
                </span>
                <p class="hub-node-label">Guira</p>
              </div>

              <div class="hub-flow-node" style="--x:90%;--y:10%;">
                <span class="hub-sphere"><Flag code="us" /></span>
                <p class="hub-node-label">USD</p>
              </div>
              <div class="hub-flow-node" style="--x:90%;--y:30%;">
                <span class="hub-sphere"><Flag code="br" /></span>
                <p class="hub-node-label">BRL</p>
              </div>
              <div class="hub-flow-node" style="--x:90%;--y:50%;">
                <span class="hub-sphere"><Flag code="mx" /></span>
                <p class="hub-node-label">MXN</p>
              </div>
              <div class="hub-flow-node" style="--x:90%;--y:70%;">
                <span class="hub-sphere"><Flag code="co" /></span>
                <p class="hub-node-label">COP</p>
              </div>
              <div class="hub-flow-node" style="--x:90%;--y:90%;">
                <span class="hub-sphere"><Flag code="eu" /></span>
                <p class="hub-node-label">EUR</p>
              </div>
            </div>
          </div>

          <div class="ux-outcomes" aria-label="Beneficios operativos visibles">
            <div class="ux-outcome">
              <div class="ux-icon">
                <i data-lucide="eye" class="w-4 h-4"></i>
              </div>
              <div>
                <p>Rutas claras antes de operar</p>
                <span
                  >El equipo entiende qué puede recibir, mantener o enviar.</span
                >
              </div>
            </div>
            <div class="ux-outcome">
              <div class="ux-icon">
                <i data-lucide="mouse-pointer-click" class="w-4 h-4"></i>
              </div>
              <div>
                <p>Salidas según el caso</p>
                <span
                  >Bolivia en bolivianos, proveedor internacional o cuenta de
                  destino definida por tu empresa.</span
                >
              </div>
            </div>
            <div class="ux-outcome">
              <div class="ux-icon">
                <i data-lucide="file-check-2" class="w-4 h-4"></i>
              </div>
              <div>
                <p>Respaldo operativo</p>
                <span>Validación y documentación acompañan cada flujo.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="grid lg:grid-cols-2 gap-8">
          <!-- RECIBE -->
          <div
            class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur"
          >
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-guira-teal flex items-center justify-center shrink-0"
              >
                <i data-lucide="arrow-down-to-line" class="w-6 h-6 text-white"
                ></i>
              </div>
              <div>
                <p class="section-kicker text-guira-cyan">
                  Recibe
                </p>
                <h3 class="text-lg sm:text-xl font-extrabold uppercase tracking-wider text-white">
                  A tu cuenta americana ACH
                </h3>
              </div>
            </div>
            <p class="text-slate-300 font-medium mb-6">
              Tus clientes de Estados Unidos te pagan a una cuenta ACH a nombre
              de tu empresa. Desde ahí, tú decides a dónde va tu dinero:
            </p>
            <div class="space-y-3">
              <div
                class="flex items-center gap-4 bg-white/5 border border-white/10 rounded-2xl p-4 hover:border-guira-teal/50 transition-colors"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-guira-teal/20 flex items-center justify-center shrink-0"
                >
                  <i
                    data-lucide="layout-dashboard"
                    class="w-5 h-5 text-guira-cyan"></i>
                </div>
                <div>
                  <p class="font-bold text-white text-sm">
                    Tu cuenta operativa Guira
                  </p>
                  <p class="text-slate-400 text-xs font-medium">
                    Mantén el saldo listo para pagar proveedores u operar cuando
                    quieras.
                  </p>
                </div>
              </div>
              <div
                class="flex items-center gap-4 bg-white/5 border border-white/10 rounded-2xl p-4 hover:border-guira-teal/50 transition-colors"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-guira-teal/20 flex items-center justify-center shrink-0"
                >
                  <i data-lucide="coins" class="w-5 h-5 text-guira-cyan"></i>
                </div>
                <div>
                  <p class="font-bold text-white text-sm">
                    El destino que tu empresa defina
                  </p>
                  <p class="text-slate-400 text-xs font-medium">
                    Envía tus fondos a la cuenta de destino que tu empresa
                    determine, según tu operación.
                  </p>
                </div>
              </div>
              <div
                class="flex items-center gap-4 bg-white/5 border border-white/10 rounded-2xl p-4 hover:border-guira-teal/50 transition-colors"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-guira-teal/20 flex items-center justify-center shrink-0"
                >
                  <i data-lucide="landmark" class="w-5 h-5 text-guira-cyan"></i>
                </div>
                <div>
                  <p class="font-bold text-white text-sm">
                    Tu cuenta boliviana en Bolivianos
                  </p>
                  <p class="text-slate-400 text-xs font-medium">
                    Convierte y recibe directamente en BOB en tu banco local.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- ENVÍA -->
          <div
            class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur"
          >
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-guira-cyan flex items-center justify-center shrink-0"
              >
                <i data-lucide="arrow-up-right" class="w-6 h-6 text-slate-900"
                ></i>
              </div>
              <div>
                <p class="section-kicker text-guira-cyan">
                  Envía
                </p>
                <h3 class="text-lg sm:text-xl font-extrabold uppercase tracking-wider text-white">
                  A proveedores en el exterior
                </h3>
              </div>
            </div>
            <p class="text-slate-300 font-medium mb-6">
              Paga a proveedores y socios en los principales corredores
              internacionales:
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
              <div class="country-option">
                <Flag code="us" />
                <p class="font-bold text-sm">Estados Unidos</p>
              </div>
              <div class="country-option">
                <Flag code="eu" />
                <p class="font-bold text-sm">Europa</p>
              </div>
              <div class="country-option">
                <Flag code="br" />
                <p class="font-bold text-sm">Brasil</p>
              </div>
              <div class="country-option">
                <Flag code="co" />
                <p class="font-bold text-sm">Colombia</p>
              </div>
              <div class="country-option">
                <Flag code="mx" />
                <p class="font-bold text-sm">México</p>
              </div>
            </div>
            <div
              class="flex items-center gap-3 bg-guira-teal/10 border border-guira-teal/30 rounded-2xl p-4"
            >
              <i data-lucide="banknote" class="w-5 h-5 text-guira-cyan shrink-0"
              ></i>
              <p class="font-bold text-white text-sm">
                Paga el envío en bolivianos.
              </p>
            </div>
          </div>
        </div>

        <div class="text-center mt-12 flex justify-center">
          <GuiraButton
            href="https://wa.me/59167015106?text=Hola,%20quiero%20conocer%20c%C3%B3mo%20recibir%20y%20enviar%20pagos%20internacionales%20con%20Guira"
            target="_blank"
            rel="noopener noreferrer"
            label="Quiero conocer todo el flujo"
            variant="teal"
          />
        </div>
      </div>
    </section>

    <!-- ESTADÍSTICAS RÁPIDAS -->
    <section data-stack-section class="py-12 bg-guira-teal">
      <div class="max-w-6xl mx-auto px-6">
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center text-white"
        >
          <div>
            <p class="text-3xl md:text-4xl font-extrabold mb-1">USD</p>
            <p class="text-guira-cyan text-sm font-medium">
              Cobros desde EE. UU.
            </p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-extrabold mb-1">Wire</p>
            <p class="text-guira-cyan text-sm font-medium">
              Pagos corporativos
            </p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-extrabold mb-1">ACH</p>
            <p class="text-guira-cyan text-sm font-medium">Según estructura</p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-extrabold mb-1">1 lugar</p>
            <p class="text-guira-cyan text-sm font-medium">
              Documentos y estado
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEMA -->
    <section data-stack-section class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.65rem] font-extrabold uppercase tracking-tight leading-[1.08] mb-6 text-slate-900">
            Recibir el pago es solo una parte del proceso
          </h2>
          <p class="text-slate-600 text-lg font-medium leading-relaxed max-w-3xl mx-auto">
            Cuando cobras a clientes del exterior, tu empresa también debe
            identificar el origen del fondo, relacionarlo con la factura y
            conservar respaldo para controles internos.
          </p>
        </div>

        <div class="border-y border-slate-200 divide-y divide-slate-200 mb-10">
