---
import Layout from '../layouts/Layout.astro';
import DemoForm from '../components/DemoForm.astro';
---

<Layout
  title="Paga a tus proveedores en el exterior desde una sola cuenta operativa | Guira"
  description="Paga a proveedores en Estados Unidos, Brasil, México, Colombia y Europa desde una sola cuenta operativa. En la moneda que tu proveedor necesita recibir, con respaldo documental en cada operación."
  canonicalUrl="https://www.guiracorp.com/pagar-proveedores-exterior"
  robots="noindex, nofollow"
  hideNav={true}
  hideFooter={true}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/images/plataforma-dashboard-macbook.webp" type="image/webp" />
    <link rel="preload" as="image" href="/assets/images/logo-horizontal-color-blanco.png" type="image/png" />
    <style is:inline>
      html { scroll-behavior: smooth; }
      /* Ocultar el widget global de WhatsApp inyectado por main.js; esta página usa su propio botón flotante */
      body > a.bg-emerald-500[href*="wa.me"]:not(.p-6) {
        display: none !important;
      }
    </style>
  </Fragment>

  <!-- HERO -->
  <header class="relative pt-8 pb-20 md:pb-24 overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(0,81,255,0.18),transparent_50%),radial-gradient(circle_at_78%_75%,rgba(0,216,255,0.12),transparent_42%)]"></div>
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 64px 64px;"></div>
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-guira-cyan/10 blur-3xl"></div>

    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <!-- ENCABEZADO: solo logo, sin enlace, sin navegación -->
      <div class="mb-10 md:mb-14">
        <img src="/assets/images/logo-horizontal-color-blanco.png" alt="Guira" class="h-8 md:h-9 object-contain" />
      </div>

      <div class="max-w-3xl mb-10 reveal-left">
        <p class="inline-flex items-center gap-2 text-sm font-semibold text-guira-cyan mb-5">
          <i data-lucide="building-2" class="w-4 h-4"></i>
          Para empresas importadoras de Bolivia
        </p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.05] text-white">
          Paga a tus proveedores en el exterior
        </h1>
      </div>

      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 text-left reveal-left">
          <p class="text-lg md:text-xl text-slate-300 mb-7 max-w-xl font-medium leading-relaxed">
            Desde una sola cuenta operativa, en la moneda que tu proveedor necesita recibir. Con respaldo documental en cada operación.
          </p>

          <p class="inline-flex flex-wrap items-center gap-3 px-5 py-3 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm text-slate-200 text-sm md:text-base font-bold tracking-wide mb-9">
            <i data-lucide="route" class="w-4 h-4 text-guira-cyan shrink-0"></i>
            Estados Unidos · Brasil · México · Colombia · Europa
          </p>

          <div class="flex flex-col items-start gap-3">
            <a href="https://wa.me/59175245845?text=Hola,%20quiero%20pagar%20a%20mis%20proveedores%20del%20exterior%20con%20Guira"
              target="_blank" rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex px-8 py-4 bg-guira-teal text-white rounded-xl font-bold text-lg hover:bg-guira-teal/80 transition-all shadow-xl shadow-guira-teal/30 hover:-translate-y-1 items-center justify-center gap-2">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              Quiero pagar a mi proveedor
            </a>
            <p class="text-slate-400 text-sm font-medium text-left">Escríbenos y revisamos tu operación. Sin compromiso.</p>
          </div>
        </div>

        <div class="lg:col-span-5 relative reveal-right">
          <div class="absolute inset-0 bg-gradient-to-r from-guira-teal/20 to-guira-cyan/20 blur-3xl rounded-full"></div>
          <img src="/assets/images/plataforma-dashboard-macbook.webp"
            alt="Plataforma Guira, panel de operaciones y trazabilidad"
            class="relative rounded-2xl shadow-2xl border border-slate-700 w-full">
        </div>
      </div>
    </div>
  </header>

  <!-- SECCION 2: LOS CORREDORES -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-12 reveal">
        <h2 class="text-2xl md:text-4xl font-extrabold mb-5 text-slate-900">
          Un solo lugar para pagar a tus proveedores
        </h2>
        <p class="text-slate-600 text-lg font-medium">
          Elige el destino y la moneda según lo que tu proveedor necesite recibir.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <article class="bg-white border border-slate-200 rounded-2xl p-7 shadow-sm h-full flex flex-col reveal reveal-delay-1 hover:-translate-y-1 hover:shadow-lg transition-all">
          <h3 class="font-extrabold text-slate-900 text-xl mb-2">Estados Unidos</h3>
          <p class="text-slate-600 font-medium leading-relaxed">Pagos en dólares a proveedores y socios comerciales en EE.UU.</p>
        </article>

        <article class="bg-white border border-slate-200 rounded-2xl p-7 shadow-sm h-full flex flex-col reveal reveal-delay-2 hover:-translate-y-1 hover:shadow-lg transition-all">
          <h3 class="font-extrabold text-slate-900 text-xl mb-2">Brasil</h3>
          <p class="text-slate-600 font-medium leading-relaxed">Pagos en reales a proveedores brasileños.</p>
        </article>

        <article class="bg-white border border-slate-200 rounded-2xl p-7 shadow-sm h-full flex flex-col reveal reveal-delay-3 hover:-translate-y-1 hover:shadow-lg transition-all">
          <h3 class="font-extrabold text-slate-900 text-xl mb-2">México</h3>
          <p class="text-slate-600 font-medium leading-relaxed">Pagos en pesos mexicanos a proveedores en México.</p>
        </article>

        <article class="bg-white border border-slate-200 rounded-2xl p-7 shadow-sm h-full flex flex-col reveal reveal-delay-4 hover:-translate-y-1 hover:shadow-lg transition-all">
          <h3 class="font-extrabold text-slate-900 text-xl mb-2">Colombia</h3>
          <p class="text-slate-600 font-medium leading-relaxed">Pagos en pesos colombianos a proveedores colombianos.</p>
        </article>

        <article class="bg-white border border-slate-200 rounded-2xl p-7 shadow-sm h-full flex flex-col reveal hover:-translate-y-1 hover:shadow-lg transition-all">
          <h3 class="font-extrabold text-slate-900 text-xl mb-2">Europa</h3>
          <p class="text-slate-600 font-medium leading-relaxed">Pagos en euros a proveedores de la zona europea.</p>
        </article>

        <article class="bg-gradient-to-br from-guira-teal to-slate-900 rounded-2xl p-7 shadow-sm h-full flex flex-col text-white reveal hover:-translate-y-1 transition-transform">
          <div class="w-11 h-11 rounded-xl bg-white/15 flex items-center justify-center mb-5">
            <i data-lucide="repeat-2" class="w-6 h-6 text-white"></i>
          </div>
          <h3 class="font-extrabold text-xl mb-2">Operaciones recurrentes</h3>
          <p class="text-white/90 font-medium leading-relaxed">Repite los pagos que ya haces a tus proveedores habituales sin volver a empezar el proceso desde cero.</p>
        </article>
      </div>

      <p class="text-center text-slate-900 text-lg font-bold reveal">
        Fondeas tu cuenta operativa y el pago sale en la moneda que tu proveedor necesita.
      </p>
    </div>
  </section>

  <!-- SECCION 3: EL PROBLEMA -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12 reveal">
        <h2 class="text-2xl md:text-4xl font-extrabold mb-5 text-slate-900">
          Pagar afuera no debería frenar tu operación
        </h2>
        <p class="text-slate-600 text-lg font-medium max-w-3xl mx-auto">
          Cuando el pago se demora, no se demora un trámite. Se demora tu mercadería, tu producción y tu compromiso con el cliente.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <div class="flex gap-4 bg-slate-50 border-l-4 border-guira-teal p-6 rounded-r-xl reveal reveal-delay-1">
          <i data-lucide="lock" class="w-5 h-5 text-guira-teal shrink-0 mt-1"></i>
          <p class="text-slate-700 font-medium leading-relaxed">
            <strong class="text-slate-900">El proveedor no libera el pedido</strong> hasta confirmar que el pago salió, y esa confirmación depende de un proceso que no controlas.
          </p>
        </div>
        <div class="flex gap-4 bg-slate-50 border-l-4 border-guira-teal p-6 rounded-r-xl reveal reveal-delay-2">
          <i data-lucide="file-question" class="w-5 h-5 text-guira-teal shrink-0 mt-1"></i>
          <p class="text-slate-700 font-medium leading-relaxed">
            <strong class="text-slate-900">Cada operación pide algo distinto</strong> y el requisito aparece recién cuando el trámite ya empezó.
          </p>
        </div>
        <div class="flex gap-4 bg-slate-50 border-l-4 border-guira-teal p-6 rounded-r-xl reveal reveal-delay-3">
          <i data-lucide="help-circle" class="w-5 h-5 text-guira-teal shrink-0 mt-1"></i>
          <p class="text-slate-700 font-medium leading-relaxed">
            <strong class="text-slate-900">No sabes en qué estado está el pago</strong> hasta que alguien responde un correo o un mensaje.
          </p>
        </div>
        <div class="flex gap-4 bg-slate-50 border-l-4 border-guira-teal p-6 rounded-r-xl reveal reveal-delay-4">
          <i data-lucide="file-x" class="w-5 h-5 text-guira-teal shrink-0 mt-1"></i>
          <p class="text-slate-700 font-medium leading-relaxed">
            <strong class="text-slate-900">El comprobante no alcanza para conciliar</strong> porque llega sin la referencia que conecta el pago con la factura.
          </p>
        </div>
      </div>

      <div class="text-center">
        <a href="https://wa.me/59175245845?text=Hola,%20necesito%20pagar%20a%20un%20proveedor%20del%20exterior%20y%20quiero%20orientaci%C3%B3n"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-slate-900 text-white rounded-xl font-bold text-lg hover:bg-slate-800 transition-all">
          Quiero resolver esto
          <i data-lucide="arrow-right" class="w-5 h-5"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- SECCION 4: COMO FUNCIONA -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mx-auto text-center mb-12 reveal">
        <h2 class="text-2xl md:text-4xl font-extrabold mb-5 text-slate-900">
          Cómo se ordena un pago con Guira
        </h2>
        <p class="text-slate-600 text-lg font-medium">
          Tres pasos, con un especialista revisando la operación contigo antes de ejecutarla.
        </p>
      </div>

      <div class="relative mb-14">
        <div class="hidden md:block absolute top-8 left-[16.6%] right-[16.6%] h-px bg-gradient-to-r from-transparent via-guira-teal/40 to-transparent"></div>
        <div class="grid md:grid-cols-3 gap-10">
          <div class="text-center reveal reveal-delay-1">
            <div class="relative z-10 w-16 h-16 rounded-full bg-guira-teal flex items-center justify-center mx-auto mb-6 shadow-lg shadow-guira-teal/30">
              <span class="text-2xl font-bold text-white">1</span>
            </div>
            <h3 class="font-bold text-slate-900 mb-3 text-xl">Preparamos la operación</h3>
            <p class="text-slate-600 font-medium max-w-xs mx-auto">Revisamos factura, datos del proveedor y destino para que el pago salga completo desde el primer intento.</p>
          </div>
          <div class="text-center reveal reveal-delay-2">
            <div class="relative z-10 w-16 h-16 rounded-full bg-guira-teal flex items-center justify-center mx-auto mb-6 shadow-lg shadow-guira-teal/30">
              <span class="text-2xl font-bold text-white">2</span>
            </div>
            <h3 class="font-bold text-slate-900 mb-3 text-xl">Ejecutamos por el corredor adecuado</h3>
            <p class="text-slate-600 font-medium max-w-xs mx-auto">Definimos la ruta según el país del proveedor, el monto y la moneda que necesita recibir.</p>
          </div>
          <div class="text-center reveal reveal-delay-3">
            <div class="relative z-10 w-16 h-16 rounded-full bg-guira-teal flex items-center justify-center mx-auto mb-6 shadow-lg shadow-guira-teal/30">
              <span class="text-2xl font-bold text-white">3</span>
            </div>
            <h3 class="font-bold text-slate-900 mb-3 text-xl">Entregamos el respaldo</h3>
            <p class="text-slate-600 font-medium max-w-xs mx-auto">Comprobante, referencia y conciliación disponibles para tu equipo administrativo.</p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="https://wa.me/59175245845?text=Hola,%20quiero%20empezar%20a%20pagar%20a%20mis%20proveedores%20del%20exterior%20con%20Guira"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-10 py-5 bg-guira-teal text-white rounded-xl font-bold text-lg hover:bg-guira-teal/80 transition-all shadow-xl hover:-translate-y-1">
          Empezar mi primera operación
          <i data-lucide="arrow-right" class="w-5 h-5"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- SECCION 5: RESPALDO POR OPERACION -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 reveal-left">
          <div class="record-panel">
            <div class="record-topbar">
              <span class="record-dot"></span>
              <div>
                <p class="record-kicker">Operación</p>
                <p class="record-title">Pago a proveedor</p>
              </div>
              <span class="record-status">Completada</span>
            </div>
            <div class="record-rows">
              <div class="record-row">
                <span>Comprobante</span>
                <i data-lucide="check-circle-2" class="w-4 h-4"></i>
              </div>
              <div class="record-row">
                <span>Referencia de factura</span>
                <i data-lucide="check-circle-2" class="w-4 h-4"></i>
              </div>
              <div class="record-row">
                <span>Estado de la operación</span>
                <i data-lucide="check-circle-2" class="w-4 h-4"></i>
              </div>
              <div class="record-row">
                <span>Historial</span>
                <i data-lucide="check-circle-2" class="w-4 h-4"></i>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 reveal-right">
          <h2 class="text-2xl md:text-4xl font-extrabold mb-5 text-slate-900">
            Cada pago con su respaldo
          </h2>
          <p class="text-slate-600 text-lg font-medium leading-relaxed mb-10">
            Tu contador no debería reconstruir la historia de un pago meses después. El respaldo se arma cuando la operación nace.
          </p>

          <div class="divide-y divide-slate-100">
            <div class="flex gap-4 py-5 first:pt-0">
              <div class="w-10 h-10 rounded-xl bg-guira-teal/10 flex items-center justify-center shrink-0">
                <i data-lucide="file-check" class="w-5 h-5 text-guira-teal"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1 text-lg">Comprobante de la operación</h3>
                <p class="text-slate-600 font-medium">Registro del pago ejecutado con sus datos completos.</p>
              </div>
            </div>
            <div class="flex gap-4 py-5">
              <div class="w-10 h-10 rounded-xl bg-guira-teal/10 flex items-center justify-center shrink-0">
                <i data-lucide="link-2" class="w-5 h-5 text-guira-teal"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1 text-lg">Referencia conectada a tu factura</h3>
                <p class="text-slate-600 font-medium">El pago queda relacionado con el documento que lo origina.</p>
              </div>
            </div>
            <div class="flex gap-4 py-5">
              <div class="w-10 h-10 rounded-xl bg-guira-teal/10 flex items-center justify-center shrink-0">
                <i data-lucide="eye" class="w-5 h-5 text-guira-teal"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1 text-lg">Estado visible en todo momento</h3>
                <p class="text-slate-600 font-medium">Sabes si la operación está en preparación, en curso o completada.</p>
              </div>
            </div>
            <div class="flex gap-4 py-5 last:pb-0">
              <div class="w-10 h-10 rounded-xl bg-guira-teal/10 flex items-center justify-center shrink-0">
                <i data-lucide="history" class="w-5 h-5 text-guira-teal"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1 text-lg">Historial disponible</h3>
                <p class="text-slate-600 font-medium">Consultas cualquier operación anterior cuando la necesites.</p>
              </div>
            </div>
          </div>

          <p class="text-slate-900 text-xl font-extrabold mt-8 mb-6">
            Y si te preguntan, lo puedes mostrar.
          </p>

          <a href="https://wa.me/59175245845?text=Hola,%20quiero%20conocer%20el%20respaldo%20documental%20de%20los%20pagos%20con%20Guira"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 bg-slate-900 text-white rounded-xl font-bold text-lg hover:bg-slate-800 transition-all">
            Quiero ver el respaldo por operación
            <i data-lucide="arrow-right" class="w-5 h-5"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCION 6: TRES PREGUNTAS -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12 reveal">
        <h2 class="text-2xl md:text-4xl font-extrabold mb-6 text-slate-900">
          Antes de empezar
        </h2>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-6">
      <div class="rounded-2xl border border-slate-200 bg-white shadow-sm divide-y divide-slate-200 overflow-hidden reveal">
        <details class="group" open>
          <summary class="flex justify-between items-center gap-6 font-bold cursor-pointer list-none py-6 px-6 text-slate-900 hover:bg-slate-50 transition-colors">
            <span>¿Quién opera la plataforma?</span>
            <div class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center shrink-0 group-open:bg-guira-teal group-open:border-guira-teal transition-colors">
              <i data-lucide="plus" class="w-4 h-4 text-guira-teal group-open:text-white transition-transform duration-300 group-open:rotate-45"></i>
            </div>
          </summary>
          <div class="px-6 text-slate-600 font-medium leading-relaxed pb-8">
            Guira es una plataforma tecnológica creada y operada por Guira System LLC, constituida en Delaware, Estados Unidos. En Bolivia, Guiraglobal SRL es el equipo de asesoría comercial que acompaña a las empresas en su uso.
          </div>
        </details>

        <details class="group" open>
          <summary class="flex justify-between items-center gap-6 font-bold cursor-pointer list-none py-6 px-6 text-slate-900 hover:bg-slate-50 transition-colors">
            <span>¿Sirve para lo que mi contador necesita?</span>
            <div class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center shrink-0 group-open:bg-guira-teal group-open:border-guira-teal transition-colors">
              <i data-lucide="plus" class="w-4 h-4 text-guira-teal group-open:text-white transition-transform duration-300 group-open:rotate-45"></i>
            </div>
          </summary>
          <div class="px-6 text-slate-600 font-medium leading-relaxed pb-8">
            Cada operación se entrega con comprobante, referencia asociada a la factura y registro del estado. Es la información que se solicita habitualmente en una conciliación o en una revisión interna.
          </div>
        </details>

        <details class="group" open>
          <summary class="flex justify-between items-center gap-6 font-bold cursor-pointer list-none py-6 px-6 text-slate-900 hover:bg-slate-50 transition-colors">
            <span>¿Cuánto demora empezar?</span>
            <div class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center shrink-0 group-open:bg-guira-teal group-open:border-guira-teal transition-colors">
              <i data-lucide="plus" class="w-4 h-4 text-guira-teal group-open:text-white transition-transform duration-300 group-open:rotate-45"></i>
            </div>
          </summary>
          <div class="px-6 text-slate-600 font-medium leading-relaxed pb-8">
            Empieza con una conversación. Escríbenos, revisamos tu operación y te decimos con claridad si Guira encaja con lo que tu empresa necesita.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- SECCION 7: FORMULARIO Y CIERRE -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12 reveal">
        <h2 class="text-2xl md:text-4xl font-extrabold mb-5 text-slate-900">
          Cuéntanos qué necesitas pagar
        </h2>
        <p class="text-slate-600 text-lg font-medium max-w-2xl mx-auto">
          Déjanos tus datos y un especialista te contacta para revisar tu operación, los corredores que necesitas y los siguientes pasos.
        </p>
      </div>

      <DemoForm defaultUseCase="pagos" submitLabel="Quiero que me contacten" />

      <p class="text-center text-slate-500 font-medium mt-8">
        Si prefieres escribir, también puedes hacerlo por WhatsApp.
        <a href="https://wa.me/59175245845?text=Hola,%20quiero%20hablar%20sobre%20pagos%20a%20proveedores%20del%20exterior%20con%20Guira"
          target="_blank" rel="noopener noreferrer"
          class="text-guira-teal font-bold hover:underline">Escribir por WhatsApp</a>
      </p>
    </div>
  </section>

  <!-- PIE DE PAGINA -->
  <footer class="bg-slate-900 text-white py-14 border-t border-slate-800">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-10 mb-10">
        <div>
