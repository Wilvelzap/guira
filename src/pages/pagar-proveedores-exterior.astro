---
import Layout from '../layouts/Layout.astro';
import DemoForm from '../components/DemoForm.astro';
---

<!--
REDESIGN: Workbench macrostructure · N1b SaaS nav · Ft5 Statement footer
THESIS: Product-led tour showing the operational control panel for paying international suppliers.
OWN-WORLD: Institutional Control Panel following DESIGN.md — Inter font, guira-teal (#0051ff) as sole accent, slate neutrals, ambient shadows with blue tint on hover.
STORY: Visitor sees the platform in action — loading payment data, validating operations, tracking status — then understands the problem it solves and acts.
-->

<Layout
  title="Paga a tus proveedores en el exterior desde una sola cuenta operativa | Guira"
  description="Paga a proveedores en Estados Unidos, Brasil, México, Colombia y Europa desde una sola cuenta operativa. En la moneda que tu proveedor necesita recibir, con respaldo documental en cada operación."
  canonicalUrl="https://www.guiracorp.com/pagar-proveedores-exterior"
  robots="noindex, nofollow"
  hideNav={true}
  hideFooter={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="/assets/images/plataforma-dashboard-monitor.webp" type="image/webp" fetchpriority="high" />
    <style is:inline>
      /* Hallmark · redesign · macrostructure: Workbench · nav: N1b SaaS three-section · footer: Ft5 Statement
       * Design system: DESIGN.md locked (Inter font, guira-teal #0051ff, slate neutrals)
       * Diversification from last: Workbench ≠ Split Studio · N1b ≠ N5 · Ft5 ≠ Ft2
       */
      :root {
        /* DESIGN.md locked tokens */
        --color-guira-teal: #0051ff;
        --color-guira-cyan: #00d8ff;
        --color-guira-neon: #00f6ff;
        --color-guira-navy: #0B1120;
        --color-guira-petrol: #0F172A;
        --color-guira-dark: #020617;

        --color-surface-white: #ffffff;
        --color-slate-50: #f8fafc;
        --color-slate-100: #f1f5f9;
        --color-slate-200: #e2e8f0;
        --color-slate-400: #94a3b8;
        --color-slate-500: #64748b;
        --color-slate-600: #475569;
        --color-slate-700: #334155;
        --color-slate-800: #1e293b;
        --color-slate-900: #0f172a;

        /* Semantic mapping */
        --color-paper: var(--color-surface-white);
        --color-paper-dark: var(--color-slate-50);
        --color-ink: var(--color-slate-900);
        --color-ink-muted: var(--color-slate-500);
        --color-accent: var(--color-guira-teal);
        --color-accent-hover: var(--color-slate-800);
        --color-accent-muted: var(--color-slate-400);
        --color-accent-light: rgba(0, 81, 255, 0.08);
        --color-rule: var(--color-slate-200);
        --color-rule-strong: #cbd5e1;
        --color-focus: rgba(0, 81, 255, 0.25);

        /* Typography — Inter only */
        --font-display: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'SF Mono', 'Menlo', 'Monaco', 'Courier New', monospace;
        --font-label: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

        /* Spacing — 4pt scale */
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 1.5rem;
        --space-xl: 2rem;
        --space-2xl: 3rem;
        --space-3xl: 4rem;
        --space-4xl: 5rem;
        --space-5xl: 6rem;

        /* Easing */
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);

        /* Radii */
        --radius-pill: 9999px;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 24px;
        --radius-2xl: 32px;

        /* Shadows — ambient with blue tint */
        --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.06), 0 8px 32px -8px rgba(15, 23, 42, 0.10);
        --shadow-card-hover: 0 1px 3px rgba(15, 23, 42, 0.06), 0 16px 48px -12px rgba(0, 81, 255, 0.14);
        --shadow-btn-primary: 0 4px 16px rgba(15, 23, 42, 0.20);
        --shadow-btn-primary-hover: 0 8px 24px rgba(15, 23, 42, 0.24);
        --shadow-badge: 0 2px 16px rgba(0, 81, 255, 0.08);

        /* Layout */
        --page-max: 86rem;
        --page-gutter: 1.5rem;
      }

      html, body {
        overflow-x: clip;
      }

      body {
        font-family: var(--font-body);
        background: var(--color-paper);
        color: var(--color-ink);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Hide global WhatsApp widget */
      body > a.bg-emerald-500[href*="wa.me"]:not(.p-6) {
        display: none !important;
      }

      /* ========================================
         N1b · CANONICAL SAAS THREE-SECTION NAV
         ======================================== */

      .nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 500;
        background: transparent;
        border-bottom: 1px solid transparent;
        transition: background 240ms, border-color 240ms, box-shadow 240ms;
      }

      .nav.is-scrolled {
        background: color-mix(in srgb, var(--color-surface-white) 90%, transparent);
        backdrop-filter: blur(18px) saturate(160%);
        -webkit-backdrop-filter: blur(18px) saturate(160%);
        border-bottom-color: var(--color-rule);
        box-shadow: 0 8px 28px -18px rgba(15, 23, 42, 0.15);
      }

      .nav__inner {
        max-width: var(--page-max);
        margin: 0 auto;
        padding: 0 var(--page-gutter);
        height: 64px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
      }

      .nav__brand {
        justify-self: start;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1rem;
        color: var(--color-ink);
        text-decoration: none;
        letter-spacing: -0.02em;
      }

      .nav__center {
        justify-self: center;
        display: flex;
        gap: 0.5rem;
      }

      .nav__link {
        color: var(--color-slate-600);
        text-decoration: none;
        font-weight: 500;
        font-size: 1rem;
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius-sm);
        transition: color 150ms var(--ease-out), background 150ms var(--ease-out);
      }

      .nav__link:hover {
        color: var(--color-accent);
        background: var(--color-accent-light);
      }

      .nav__right {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .nav__sign-in {
        color: var(--color-slate-700);
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius-sm);
        transition: color 150ms var(--ease-out), background 150ms var(--ease-out);
      }

      .nav__sign-in:hover {
        color: var(--color-ink);
        background: var(--color-slate-100);
      }

      .nav__cta {
        display: inline-flex;
        align-items: center;
        padding: 0.625rem 1.25rem;
        background: var(--color-ink);
        color: var(--color-paper);
        border-radius: var(--radius-md);
        text-decoration: none;
        font-weight: 700;
        font-size: 1rem;
        box-shadow: var(--shadow-btn-primary);
        transition: all 200ms var(--ease-out);
      }

      .nav__cta:hover {
        background: var(--color-accent-hover);
        transform: translateY(-2px);
        box-shadow: var(--shadow-btn-primary-hover);
      }

      .nav__cta:active {
        transform: translateY(0) scale(0.97);
      }

      @media (max-width: 56rem) {
        .nav__center {
          display: none;
        }
      }

      /* ========================================
         WORKBENCH LITE HERO
         ======================================== */

      .hero-lite {
        padding: 9rem var(--page-gutter) 5rem;
        max-width: var(--page-max);
        margin: 0 auto;
      }

      .hero-lite__kicker {
        font-family: var(--font-label);
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin: 0 0 1rem 0;
      }

      .hero-lite__title {
        font-family: var(--font-display);
        font-size: clamp(1.875rem, 5vw, 3rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--color-ink);
        margin: 0 0 1.25rem 0;
        max-width: 18ch;
      }

      .hero-lite__lede {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-ink-muted);
        max-width: 52ch;
        margin: 0 0 2rem 0;
      }

      .hero-lite__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        background: var(--color-accent);
        color: var(--color-paper);
        border-radius: var(--radius-lg);
        text-decoration: none;
        font-weight: 700;
        font-size: 1rem;
        box-shadow: 0 4px 16px rgba(0, 81, 255, 0.25);
        transition: all 200ms var(--ease-out);
      }

      .hero-lite__cta:hover {
        background: var(--color-accent-hover);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 81, 255, 0.35);
      }

      .hero-lite__cta:active {
        transform: translateY(0) scale(0.97);
      }

      .hero-lite__cta svg {
        transition: transform 200ms var(--ease-out);
      }

      .hero-lite__cta:hover svg {
        transform: translateX(3px);
      }

      @media (max-width: 48rem) {
        .hero-lite {
          padding: 7rem var(--page-gutter) 4rem;
        }

        .hero-lite__title {
          font-size: clamp(1.5rem, 8vw, 2.25rem);
        }
      }

      /* ========================================
         SCREENSHOT FRAME SEQUENCE
         ======================================== */

      .screenshot-section {
        padding: 4rem var(--page-gutter);
        background: var(--color-slate-50);
        border-top: 1px solid var(--color-rule);
        border-bottom: 1px solid var(--color-rule);
      }

      .screenshot-frame {
        max-width: var(--page-max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2rem;
        align-items: start;
      }

      .screenshot-frame__caption {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: -0.01em;
        color: var(--color-ink);
        margin: 0 0 0.75rem 0;
        padding-top: 0.5rem;
      }

      .screenshot-frame__step {
        font-family: var(--font-label);
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin: 0 0 0.5rem 0;
      }

      .screenshot-frame__body {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-ink-muted);
        max-width: 42ch;
        margin: 0;
      }

      .screenshot-frame__visual {
        position: relative;
        width: min(100%, 42rem);
      }

      .browser-frame {
        background: var(--color-slate-900);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: 0 32px 64px -24px rgba(15, 23, 42, 0.4);
        border: 1px solid var(--color-slate-700);
      }

      .browser-frame__toolbar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: var(--color-accent-hover);
        border-bottom: 1px solid var(--color-slate-700);
      }

      .browser-frame__dot {
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 50%;
        background: var(--color-slate-600);
      }

      .browser-frame__dot:first-child { background: #ef4444; }
      .browser-frame__dot:nth-child(2) { background: #f59e0b; }
      .browser-frame__dot:nth-child(3) { background: #22c55e; }

      .browser-frame__url {
        flex: 1;
        font-size: 0.6875rem;
        color: var(--color-slate-400);
        text-align: center;
        font-family: var(--font-mono);
      }

      .browser-frame__img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
      }

      .screenshot-frame--reverse {
        grid-template-columns: auto 1fr;
      }

      .screenshot-frame--reverse .screenshot-frame__content {
        order: 2;
      }

      .screenshot-frame--reverse .screenshot-frame__visual {
        order: 1;
      }

      @media (max-width: 64rem) {
        .screenshot-frame,
        .screenshot-frame--reverse {
          grid-template-columns: 1fr;
        }

        .screenshot-frame__content {
          order: 1;
        }

        .screenshot-frame__visual {
          order: 2;
        }
      }

      /* ========================================
         PROBLEM SECTION (text-led)
         ======================================== */

      .section-problem {
        padding: 6rem var(--page-gutter);
        max-width: var(--page-max);
        margin: 0 auto;
      }

      .section-problem__header {
        margin-bottom: 3rem;
      }

      .section-problem__kicker {
        font-family: var(--font-label);
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin: 0 0 1rem 0;
      }

      .section-problem__title {
        font-family: var(--font-display);
        font-size: clamp(1.875rem, 4vw, 3rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--color-ink);
        margin: 0 0 1.25rem 0;
      }

      .section-problem__body {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-ink-muted);
        max-width: 58ch;
      }

      .problem-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        margin-top: 3rem;
      }

      .problem-item {
        padding: 1.5rem;
        background: var(--color-slate-50);
        border: 1px solid var(--color-rule);
        border-radius: var(--radius-lg);
      }

      .problem-item__title {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-ink);
        margin: 0 0 0.5rem 0;
      }

      .problem-item__body {
        font-size: 1rem;
        line-height: 1.5;
        color: var(--color-ink-muted);
        margin: 0;
      }

      @media (max-width: 48rem) {
        .problem-list {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
      }

      /* ========================================
         CORRIDORS SECTION
         ======================================== */

      .section-corridors {
        padding: 6rem var(--page-gutter);
        background: var(--color-slate-50);
        border-top: 1px solid var(--color-rule);
        border-bottom: 1px solid var(--color-rule);
      }

      .section-corridors__header {
        max-width: var(--page-max);
        margin: 0 auto 3rem;
      }

      .section-corridors__title {
        font-family: var(--font-display);
        font-size: clamp(1.875rem, 4vw, 3rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--color-ink);
        margin: 0 0 0.75rem 0;
      }

      .section-corridors__subtitle {
        font-size: 1rem;
        color: var(--color-ink-muted);
        margin: 0;
      }

      .corridors-grid {
        max-width: var(--page-max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
      }

      .corridor-card {
        padding: 1.5rem;
        background: var(--color-paper);
        border: 1px solid var(--color-rule);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        transition: all 200ms var(--ease-out);
      }

      .corridor-card:hover {
        box-shadow: var(--shadow-card-hover);
        border-color: rgba(0, 81, 255, 0.2);
        transform: translateY(-2px);
      }

      .corridor-card--featured {
        grid-column: span 2;
        background: var(--color-slate-900);
        color: var(--color-paper);
      }

      .corridor-card__flag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        background: var(--color-accent-light);
        color: var(--color-accent);
        font-weight: 800;
        font-size: 0.6875rem;
        border-radius: var(--radius-sm);
      }

      .corridor-card--featured .corridor-card__flag {
        background: rgba(96, 165, 250, 0.2);
        color: #60a5fa;
      }

      .corridor-card__title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        color: inherit;
        margin: 0.75rem 0 0.5rem 0;
      }

      .corridor-card__body {
        font-size: 1rem;
        line-height: 1.5;
        color: var(--color-ink-muted);
        margin: 0;
      }

      .corridor-card--featured .corridor-card__body {
        color: var(--color-slate-300);
      }

      @media (max-width: 64rem) {
        .corridors-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .corridor-card--featured {
          grid-column: span 2;
        }
      }

      @media (max-width: 40rem) {
        .corridors-grid {
          grid-template-columns: 1fr;
        }

        .corridor-card--featured {
          grid-column: span 1;
        }
      }

      /* ========================================
         FAQ SECTION
         ======================================== */

      .section-faq {
        padding: 6rem var(--page-gutter);
        max-width: var(--page-max);
        margin: 0 auto;
      }

      .section-faq__header {
        margin-bottom: 3rem;
      }

      .section-faq__title {
        font-family: var(--font-display);
        font-size: 1.875rem;
        font-weight: 800;
        color: var(--color-ink);
        margin: 0 0 0.5rem 0;
      }

      .section-faq__subtitle {
        font-size: 1rem;
        color: var(--color-ink-muted);
        margin: 0;
      }

      .faq-list {
        max-width: 56ch;
      }

      .faq-item {
        border-bottom: 1px solid var(--color-rule);
      }

      .faq-item:last-child {
        border-bottom: none;
      }

      .faq-question {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem 0;
        font-family: var(--font-display);
        font-size: 1.0625rem;
        font-weight: 700;
        color: var(--color-ink);
        cursor: pointer;
        list-style: none;
        transition: color 150ms var(--ease-out);
      }

      .faq-question::-webkit-details-marker {
        display: none;
      }

      .faq-question:hover {
        color: var(--color-accent);
      }

      .faq-question svg {
        flex-shrink: 0;
        width: 1.25rem;
        height: 1.25rem;
        color: var(--color-slate-400);
        transition: transform 300ms var(--ease-out);
      }

      details[open] .faq-question svg {
        transform: rotate(45deg);
      }

      .faq-answer {
        padding: 0 0 1.5rem 0;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-ink-muted);
      }

      .faq-answer p {
        margin: 0;
      }

      /* ========================================
         CONTACT SECTION
         ======================================== */

      .section-contact {
        padding: 6rem var(--page-gutter);
        background: var(--color-slate-900);
        color: var(--color-paper);
      }

      .contact-layout {
        max-width: var(--page-max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
      }

      .contact-header__kicker {
        font-family: var(--font-label);
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #60a5fa;
        margin: 0 0 1rem 0;
      }

      .contact-header__title {
        font-family: var(--font-display);
        font-size: 1.875rem;
        font-weight: 800;
        color: var(--color-paper);
        margin: 0 0 0.75rem 0;
      }

      .contact-header__body {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-slate-300);
        margin: 0 0 2rem 0;
      }

      .contact-whatsapp {
        font-size: 1rem;
        color: var(--color-slate-400);
        margin-top: 1.5rem;
      }

      .contact-whatsapp a {
        color: #60a5fa;
        font-weight: 600;
        text-decoration: none;
      }

      .contact-whatsapp a:hover {
        text-decoration: underline;
      }

      .contact-form-shell > div {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-xl);
        padding: 2rem;
      }

      @media (max-width: 64rem) {
        .contact-layout {
          grid-template-columns: 1fr;
          gap: 3rem;
        }
      }

      /* ========================================
         FT5 · STATEMENT FOOTER
         ======================================== */

      .foot-stmt {
        padding: var(--space-3xl) var(--page-gutter) var(--space-2xl);
        background: var(--color-slate-900);
        border-top: 1px solid var(--color-slate-700);
        display: grid;
        gap: var(--space-xl);
      }

      .foot-stmt__line {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 5vw, 3rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--color-paper);
        margin: 0;
        max-width: 38ch;
      }

      .foot-stmt__meta {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding-top: var(--space-md);
        border-top: 1px solid var(--color-slate-700);
      }

      .foot-stmt__wordmark {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1rem;
        color: var(--color-slate-300);
      }

