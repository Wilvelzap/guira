  <script is:inline>
    // Nav scroll behavior
    const nav = document.getElementById('nav');
    let ticking = false;

    function updateNav() {
      if (window.scrollY > 24) {
        nav.classList.add('is-scrolled');
      } else {
        nav.classList.remove('is-scrolled');
      }
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateNav);
        ticking = true;
      }
    }, { passive: true });

    // Sticky CTA reveal
    const stickyCta = document.getElementById('sticky-cta');
    const trigger = document.getElementById('trigger-sticky-cta');

    if (stickyCta && trigger) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) {
            stickyCta.classList.add('is-visible');
          } else {
            stickyCta.classList.remove('is-visible');
          }
        });
      }, { threshold: 0, rootMargin: '-100px 0px 0px 0px' });

      observer.observe(trigger);
    }

    // WhatsApp floating button hide on contact/footer
    const waFloatingBtn = document.getElementById('wa-floating-btn');
    const waFloatingObstacles = document.querySelectorAll('#contacto, .foot-stmt');

    if (waFloatingBtn && waFloatingObstacles.length) {
      const waFloatingObserver = new IntersectionObserver((entries) => {
        const shouldHide = entries.some((entry) => entry.isIntersecting);
        waFloatingBtn.classList.toggle('wa-floating--hidden', shouldHide);
      }, { threshold: 0.2 });

      waFloatingObstacles.forEach((el) => waFloatingObserver.observe(el));
    }

    // UTM tracking
    const params = new URLSearchParams(window.location.search);
    const utmContent = params.get('utm_content');

    if (utmContent) {
      const suffix = ` [ref: ${utmContent}]`;
      document.querySelectorAll('a[href*="wa.me"]').forEach((link) => {
        const url = new URL(link.href);
        const text = url.searchParams.get('text');
        if (text === null) return;
        url.searchParams.set('text', text + suffix);
        link.setAttribute('href', url.toString());
      });
    }

    // WhatsApp click tracking
    document.querySelectorAll('a[href*="wa.me"]').forEach((link) => {
      link.addEventListener('click', () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'click-whatsapp' });
      });
    });
  </script>
