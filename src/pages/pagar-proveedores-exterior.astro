            </div>
          </div>
          <DemoForm
            defaultUseCase="pagos"
            submitLabel="Quiero que me contacten"
          />
        </div>
      </section>
    </main>

    <footer
      class="landing-footer bg-slate-900 text-white py-12 border-t border-slate-800"
    >
      <div class="page-wrap">
        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <div>
            <p class="text-slate-300 font-medium leading-relaxed mb-4">
