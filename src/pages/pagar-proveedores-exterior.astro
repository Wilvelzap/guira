---
import Layout from "../layouts/Layout.astro";
import DemoForm from "../components/DemoForm.astro";
import GuiraButton from "../components/GuiraButton.astro";
import FaqSection from "../components/FaqSection.astro";

const pagarExteriorFaq = [
  {
    question: "¿Quién opera la plataforma?",
    answer: "Guira es una plataforma tecnológica creada y operada por Guira System LLC, constituida en Delaware, Estados Unidos. En Bolivia, Guiraglobal SRL es el equipo de asesoría comercial que acompaña a las empresas en su uso."
  },
  {
    question: "¿Sirve para lo que mi contador necesita?",
    answer: "Cada operación se entrega con comprobante, referencia asociada a la factura y registro del estado. Es la información que se solicita habitualmente en una conciliación o en una revisión interna."
  },
  {
    question: "¿Cuánto demora empezar?",
    answer: "Empieza con una conversación. Escríbenos, revisamos tu operación y te decimos con claridad si Guira encaja con lo que tu empresa necesita."
  }
];
---

<!--
THESIS: Convertir un pago internacional en una operación visible y ordenada. Evita el catálogo de tarjetas fintech.
OWN-WORLD: Blanco institucional, slate profundo y azul Guira. Superficies amplias, radios de 16px y líneas operativas precisas.
STORY: La empresa entiende qué puede pagar, ve cómo avanza una operación y solicita una revisión con un especialista.
FIRST VIEWPORT: Promesa y CTA a la izquierda. A la derecha, una operación realista que conecta proveedor, corredor y respaldo.
FORM: Recorrido operativo asimétrico, séptima estructura del concepto d4a56fbd, con la operación como hilo conductor.
-->
<Layout
  title="Paga a tus proveedores en el exterior desde una sola cuenta operativa | Guira"
  description="Desde una sola cuenta operativa, en la moneda que tu proveedor necesita recibir. Con respaldo documental en cada operación."
  canonicalUrl="https://www.guiracorp.com/pagar-proveedores-exterior"
  robots="noindex, nofollow"
  hideNav={true}
  hideFooter={true}
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href="/assets/images/logo-horizontal-color-oscuro.png"
      type="image/png"
    />
    <link
      rel="preload"
      as="image"
      href="/assets/images/logo-isotipo-color.png"
      type="image/png"
    />
    <style is:inline>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </Fragment>

  <div class="landing-shell">
    <nav class="landing-nav" aria-label="Encabezado">
      <div class="page-wrap nav-inner">
        <img
          src="/assets/images/logo-horizontal-color-oscuro.png"
          alt="Guira"
          class="h-8 md:h-9 w-auto"
        />
      </div>
    </nav>

    <main>
      <header class="hero">
        <div class="hero-wash" aria-hidden="true"></div>
        <div class="page-wrap hero-grid">
          <div class="hero-copy">
            <div class="audience-tag">
              <span></span> Para empresas importadoras de Bolivia
            </div>
            <h1>Paga a tus proveedores en el exterior</h1>
            <p class="hero-lead">
              Desde una sola cuenta operativa, en la moneda que tu proveedor
              necesita recibir. Con respaldo documental en cada operación.
            </p>
            <div class="hero-actions">
              <GuiraButton
                href="https://wa.me/59167015106?text=Hola,%20quiero%20pagar%20a%20mis%20proveedores%20del%20exterior%20con%20Guira"
                target="_blank"
                rel="noopener noreferrer"
                label="Quiero pagar a mi proveedor"
              />
            </div>
            <p class="hero-support">
              Escríbenos y revisamos tu operación. Sin compromiso.
            </p>
            <div class="trust-line" aria-label="Características principales">
              <span><i data-lucide="building-2"></i> Solo empresas</span>
              <span
                ><i data-lucide="file-check-2"></i> Respaldo por operación</span
              >
              <span><i data-lucide="headphones"></i> Acompañamiento local</span>
            </div>
          </div>

          <div
            class="hero-device hero-network"
            role="img"
            aria-label="Guira conecta una operación con proveedores internacionales en dólares, euros, reales, pesos mexicanos y pesos colombianos"
          >
            <div class="device-halo" aria-hidden="true"></div>
            <svg
              class="network-routes"
              viewBox="0 0 760 500"
              fill="none"
              aria-hidden="true"
              preserveAspectRatio="xMidYMid meet"
            >
              <defs>
