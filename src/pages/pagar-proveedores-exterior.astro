---
import Layout from '../layouts/Layout.astro';
import DemoForm from '../components/DemoForm.astro';
---

<!--
  /* Hallmark · pre-emit critique: P5 H4 E5 S4 R5 V5
   * genre: modern-minimal
   * macrostructure: Split Studio (diptych alternating)
   * theme: Guira Brand (white paper · blue accent · Inter throughout)
   * enrichment: E1 clipped-edge demo video, Tier-A CSS-art mockup
   * nav: N5 Floating pill
   * footer: Ft2 Inline single line
   * contrast: pass (4.8:1 - 14:1)
   */
-->

<Layout
  title="Paga a tus proveedores en el exterior desde una sola cuenta operativa | Guira"
  description="Paga a proveedores en Estados Unidos, Brasil, México, Colombia y Europa desde una sola cuenta operativa. En la moneda que tu proveedor necesita recibir, con respaldo documental en cada operación."
  canonicalUrl="https://www.guiracorp.com/pagar-proveedores-exterior"
  robots="noindex, nofollow"
  hideNav={true}
  hideFooter={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="/assets/images/plataforma-dashboard-monitor.webp" type="image/webp" fetchpriority="high" />
    <style is:inline>
      :root {
        /* Guira Brand Colors — matching the home page */
        --color-paper: #ffffff;
        --color-paper-dark: #f8fafc;
        --color-ink: #0f172a;
        --color-ink-muted: #64748b;
        --color-accent: #0051ff;
        --color-accent-muted: #3b82f6;
        --color-accent-light: #eff6ff;
        --color-rule: #e2e8f0;
        --color-rule-strong: #cbd5e1;

        /* Typography — Inter (matching Guira brand) */
        --font-display: 'Inter', system-ui, -apple-system, sans-serif;
        --font-body: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'Courier New', ui-monospace, monospace;

        /* Spacing — 4pt scale */
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 1.5rem;
        --space-xl: 2rem;
        --space-2xl: 3rem;
        --space-3xl: 4.5rem;
        --space-4xl: 6rem;

        /* Easing */
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
        --ease-in: cubic-bezier(0.64, 0, 0.78, 0);
        --ease-in-out: cubic-bezier(0.22, 0.61, 0.36, 1);

        /* Radii */
        --radius-pill: 9999px;
        --radius-sm: 6px;
        --radius-md: 8px;
        --radius-lg: 12px;
        --radius-xl: 16px;

        /* Text sizes — major third scale */
        --text-xs: 0.64rem;
        --text-sm: 0.8rem;
        --text-base: 1rem;
        --text-md: 1.25rem;
        --text-lg: 1.5625rem;
        --text-xl: 1.9531rem;
        --text-2xl: 2.4414rem;
        --text-3xl: 3.0518rem;
        --text-4xl: 3.8147rem;
        --text-display: clamp(2.75rem, 5vw + 1rem, 5.25rem);
        --text-display-s: clamp(2.2rem, 4vw + 0.8rem, 4rem);
      }

      html, body {
        overflow-x: clip;
      }

      body {
        font-family: var(--font-body);
        background: var(--color-paper);
        color: var(--color-ink);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Hide global WhatsApp widget */
      body > a.bg-emerald-500[href*="wa.me"]:not(.p-6) {
        display: none !important;
      }
    </style>
  </Fragment>

  <!-- NAV: N5 Floating Pill -->
  <nav class="nav-pill" aria-label="Navegación principal">
    <a href="/" class="wordmark">Guira</a>
    <ul class="nav-pill__links">
      <li><a href="/pagos-cobros-internacionales/">Soluciones</a></li>
      <li><a href="/como-funciona/">Cómo funciona</a></li>
    </ul>
    <a href="https://wa.me/59175245845?text=Hola,%20quiero%20pagar%20a%20mis%20proveedores%20del%20exterior%20con%20Guira"
       target="_blank" rel="noopener noreferrer"
       class="cta-fill">Contactar →</a>
  </nav>

  <!-- HERO: H2 Split Diptych -->
  <header class="hero-split">
    <div class="hero-split__text">
      <span class="hero-kicker">Para empresas importadoras de Bolivia</span>
      <h1 class="hero-title">
        Paga a tus proveedores en el exterior
      </h1>
      <p class="hero-lede">
        Desde una sola cuenta operativa, en la moneda que tu proveedor necesita recibir. Con respaldo documental en cada operación.
      </p>
      <div class="hero-destinations">
        <span class="destination-chip">Estados Unidos</span>
        <span class="destination-chip">Brasil</span>
        <span class="destination-chip">México</span>
        <span class="destination-chip">Colombia</span>
        <span class="destination-chip">Europa</span>
      </div>
      <a href="https://wa.me/59175245845?text=Hola,%20quiero%20pagar%20a%20un%20proveedor%20del%20exterior%20con%20Guira"
         target="_blank" rel="noopener noreferrer"
         class="hero-cta">
        <span>Quiero pagar a mi proveedor</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 2L11 13M22 2l-8 9-8-9 11 11M22 2L15 22l-7-7"/>
        </svg>
      </a>
      <p class="hero-note">Escríbenos y revisamos tu operación. Sin compromiso.</p>
    </div>
    <figure class="hero-split__visual">
      <div class="mockup-frame">
        <img src="/assets/images/plataforma-dashboard-monitor.webp"
             alt="Plataforma Guira, panel de operaciones y trazabilidad"
             class="mockup-img"
             fetchpriority="high"
             width="1200"
             height="800">
      </div>
    </figure>
  </header>

  <!-- SECTION: Problem → Solution (Split Studio alternating) -->
  <section class="section-split">
    <div class="section-split__visual">
      <div class="problem-grid">
        <div class="problem-card">
          <div class="problem-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
          </div>
          <h3>El proveedor no libera el pedido</h3>
          <p>Hasta confirmar que el pago salió, y esa confirmación depende de un proceso que tu empresa necesita controlar.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
            </svg>
          </div>
          <h3>Requisitos cambiantes</h3>
          <p>Cada operación solicita datos distintos y las observaciones surgen cuando la carga ya está esperando.</p>
        </div>
      </div>
    </div>
    <div class="section-split__text">
      <span class="section-kicker">El problema</span>
      <h2 class="section-title">Pagar afuera no debería frenar tu operación</h2>
      <p class="section-body">
        Cuando el pago se demora, no se demora un trámite. Se demora tu mercadería, tu producción y tu compromiso con el cliente.
      </p>
      <div class="solution-cta">
        <a href="https://wa.me/59175245845?text=Hola,%20necesito%20pagar%20a%20un%20proveedor%20del%20exterior%20y%20quiero%20orientaci%C3%B3n"
           target="_blank" rel="noopener noreferrer"
           class="link-cta">
          Quiero resolver esto
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION: How it works (Step sequence) -->
  <section class="section-steps">
    <div class="steps-header">
      <h2 class="steps-title">Cómo se ordena un pago con Guira</h2>
      <p class="steps-subtitle">Tres pasos claros con acompañamiento operativo antes de ejecutar la transferencia.</p>
    </div>
    <div class="steps-grid">
      <article class="step-card">
        <div class="step-number">01</div>
        <h3 class="step-title">Preparamos la operación</h3>
        <p class="step-body">Revisamos la factura, datos bancarios del proveedor y destino para asegurar que el pago salga completo desde el primer intento.</p>
      </article>
      <article class="step-card">
        <div class="step-number">02</div>
        <h3 class="step-title">Ejecutamos el corredor</h3>
        <p class="step-body">Definimos la ruta según el país del proveedor, el monto y la moneda que necesita recibir en su cuenta.</p>
      </article>
      <article class="step-card">
        <div class="step-number">03</div>
        <h3 class="step-title">Entregamos el respaldo</h3>
        <p class="step-body">Comprobante, referencia y soporte de conciliación disponibles para tu equipo administrativo y contable.</p>
      </article>
    </div>
    <div class="steps-cta">
      <a href="https://wa.me/59175245845?text=Hola,%20quiero%20empezar%20a%20pagar%20a%20mis%20proveedores%20del%20exterior%20con%20Guira"
         target="_blank" rel="noopener noreferrer"
         class="cta-primary">
        <span>Empezar mi primera operación</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- SECTION: Proof Panel (Split Studio reverse) -->
  <section class="section-split section-split--reverse">
    <div class="section-split__text">
      <span class="section-kicker">Respaldo por operación</span>
      <h2 class="section-title">Cada pago con su respaldo</h2>
      <p class="section-body">
        Tu contador no debería reconstruir la historia de un pago meses después. El respaldo documental se organiza cuando la operación se genera.
      </p>
      <ul class="feature-list">
        <li class="feature-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <div>
            <strong>Comprobante oficial de la operación</strong>
            <span>Registro del pago ejecutado con detalles bancarios completos.</span>
          </div>
        </li>
        <li class="feature-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <div>
            <strong>Referencia conectada a tu factura</strong>
            <span>Relación directa entre la salida del pago y el documento comercial de origen.</span>
          </div>
        </li>
        <li class="feature-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <div>
            <strong>Estado visible en todo momento</strong>
            <span>Control claro para saber si la operación está en preparación, en curso o finalizada.</span>
          </div>
        </li>
      </ul>
      <p class="section-highlight">Y si te preguntan, lo puedes mostrar.</p>
      <a href="https://wa.me/59175245845?text=Hola,%20quiero%20conocer%20el%20respaldo%20documental%20de%20los%20pagos%20con%20Guira"
         target="_blank" rel="noopener noreferrer"
         class="link-cta">
        Quiero ver el respaldo por operación
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
    <div class="section-split__visual">
      <div class="proof-panel">
        <div class="proof-header">
          <div>
            <span class="proof-tag">Operación B2B</span>
            <p class="proof-title">Pago a proveedor internacional</p>
          </div>
          <span class="proof-status">Completada</span>
        </div>
        <div class="proof-list">
          <div class="proof-row">
            <span>Comprobante de operación</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <div class="proof-row">
            <span>Referencia vinculada a factura</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <div class="proof-row">
            <span>Trazabilidad de estado</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <div class="proof-row">
            <span>Historial descargable</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION: Corridors (Bento-style grid) -->
  <section class="section-corridors">
    <div class="corridors-header">
      <h2 class="corridors-title">Un solo lugar para pagar a tus proveedores</h2>
      <p class="corridors-subtitle">Elige el destino y la moneda según lo que tu proveedor necesite recibir.</p>
    </div>
    <div class="corridors-grid">
      <article class="corridor-card corridor-card--featured">
        <div class="corridor-badge">Corredor principal</div>
        <h3 class="corridor-title">Estados Unidos</h3>
        <p class="corridor-body">Pagos en dólares estadounidenses a proveedores, fabricantes y socios comerciales en EE.UU. con trazabilidad completa.</p>
        <div class="corridor-footer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Transferencias en USD directamente a cuentas corporativas</span>
        </div>
      </article>
      <article class="corridor-card">
        <span class="corridor-flag">BR</span>
        <h3 class="corridor-title">Brasil</h3>
        <p class="corridor-body">Pagos en reales a proveedores brasileños de insumos y maquinaria.</p>
        <span class="corridor-meta">Moneda local o USD</span>
      </article>
      <article class="corridor-card">
        <span class="corridor-flag">MX</span>
        <h3 class="corridor-title">México</h3>
        <p class="corridor-body">Pagos en pesos mexicanos directamente a cuentas bancarias en México.</p>
        <span class="corridor-meta">Moneda local o USD</span>
      </article>
      <article class="corridor-card">
        <span class="corridor-flag">CO</span>
        <h3 class="corridor-title">Colombia</h3>
        <p class="corridor-body">Pagos en pesos colombianos para abastecimiento y servicios en Colombia.</p>
        <span class="corridor-meta">Moneda local o USD</span>
      </article>
      <article class="corridor-card corridor-card--euro">
        <span class="corridor-flag">EU</span>
        <span class="corridor-zone">Zona Euro</span>
        <h3 class="corridor-title">Europa</h3>
        <p class="corridor-body">Pagos en euros a proveedores de la zona europea con respaldo documental.</p>
        <span class="corridor-meta">Operaciones recurrentes sin empezar desde cero</span>
      </article>
    </div>
    <div class="corridors-summary">
      <p>Fondeas tu cuenta operativa y el pago sale en la moneda que tu proveedor necesita.</p>
    </div>
  </section>

  <!-- SECTION: FAQ -->
  <section class="section-faq">
    <div class="faq-header">
      <h2 class="faq-title">Antes de empezar</h2>
      <p class="faq-subtitle">Respuestas claras sobre la operativa y el alcance.</p>
    </div>
    <div class="faq-list">
      <details class="faq-item" open>
        <summary class="faq-question">
          ¿Quién opera la plataforma?
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v8M8 12h8"/>
          </svg>
        </summary>
        <div class="faq-answer">
          Guira es una plataforma tecnológica creada y operada por Guira System LLC, constituida en Delaware, Estados Unidos. En Bolivia, Guiraglobal SRL brinda asesoría comercial y acompañamiento operativo a las empresas.
        </div>
      </details>
      <details class="faq-item" open>
        <summary class="faq-question">
          ¿Sirve para lo que mi equipo contable necesita?
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v8M8 12h8"/>
          </svg>
        </summary>
        <div class="faq-answer">
          Cada operación se entrega con comprobante, referencia vinculada a la factura de origen y registro de estado. Es el respaldo solicitado en revisiones contables o auditorías internas.
        </div>
      </details>
      <details class="faq-item" open>
        <summary class="faq-question">
          ¿Cuánto demora iniciar una operación?
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v8M8 12h8"/>
          </svg>
        </summary>
        <div class="faq-answer">
          Comienza con una breve conversación. Revisamos los datos de tu proveedor y te indicamos el flujo conveniente para tu empresa.
        </div>
      </details>
    </div>
  </section>

  <!-- SECTION: Contact Form -->
  <section class="section-contact">
    <div class="contact-header">
      <h2 class="contact-title">Cuéntanos qué necesitas pagar</h2>
      <p class="contact-subtitle">Déjanos tus datos y un especialista te contacta para revisar tu operación, los corredores que necesitas y los siguientes pasos.</p>
    </div>
    <DemoForm defaultUseCase="pagos" submitLabel="Quiero que me contacten" />
    <p class="contact-whatsapp">
      Si prefieres escribir, también puedes hacerlo por WhatsApp.
      <a href="https://wa.me/59175245845?text=Hola,%20quiero%20hablar%20sobre%20pagos%20a%20proveedores%20del%20exterior%20con%20Guira"
         target="_blank" rel="noopener noreferrer">Escribir por WhatsApp →</a>
    </p>
  </section>

  <!-- FOOTER: Ft2 Inline single line -->
  <footer class="footer-line">
    <p>© 2026 Guira System LLC · Representado en Bolivia por Guiraglobal SRL · <a href="/terminos/">Términos</a> · <a href="/privacidad/">Privacidad</a></p>
  </footer>

  <!-- WhatsApp Floating Button -->
  <a id="wa-floating-btn"
     href="https://wa.me/59175245845?text=Hola,%20quiero%20pagar%20a%20un%20proveedor%20del%20exterior%20con%20Guira"
     target="_blank"
     rel="noopener noreferrer"
     class="wa-floating">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <style is:inline>
    /* Nav Pill */
    .nav-pill {
      position: fixed;
      inset-inline: var(--space-md) auto auto 50%;
      transform: translateX(-50%);
      display: inline-flex;
      align-items: center;
      gap: var(--space-md);
      padding: 0.625rem 1rem;
      background: rgba(255, 255, 255, 0.78);
      backdrop-filter: blur(14px) saturate(120%);
      -webkit-backdrop-filter: blur(14px) saturate(120%);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-pill);
      box-shadow: 0 8px 24px -12px rgba(15, 23, 42, 0.18);
      z-index: 20;
      font-size: var(--text-sm);
      font-weight: 500;
    }

    .nav-pill .wordmark {
      font-weight: 700;
      color: var(--color-ink);
      text-decoration: none;
    }

    .nav-pill__links {
      display: flex;
      gap: var(--space-md);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-pill__links a {
      color: var(--color-ink-muted);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.15s ease;
    }

    .nav-pill__links a:hover {
      color: var(--color-ink);
    }

    .nav-pill .cta-fill {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.5rem 1rem;
      background: var(--color-ink);
      color: var(--color-paper);
      border-radius: var(--radius-pill);
      text-decoration: none;
      font-weight: 600;
      font-size: var(--text-sm);
      transition: background 0.15s ease, transform 0.1s ease;
    }

    .nav-pill .cta-fill:hover {
      background: var(--color-ink-muted);
      transform: translateY(-1px);
    }

    .nav-pill .cta-fill:active {
      transform: translateY(0);
    }

    /* Hero Split Diptych — Premium layout */
    .hero-split {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-3xl);
      align-items: center;
      padding: 8rem var(--space-xl) var(--space-4xl);
      min-height: 100dvh;
      min-h-[100dvh];
    }

    @media (max-width: 56rem) {
      .hero-split {
        grid-template-columns: 1fr;
        padding: 6rem var(--space-lg) var(--space-3xl);
        gap: var(--space-2xl);
      }
    }

    .hero-split__text {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }

    .hero-kicker {
      display: inline-flex;
      align-items: center;
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-accent);
      padding: 0.375rem 0.75rem;
      background: var(--color-accent-light);
      border-radius: var(--radius-pill);
      width-fit-content;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: var(--text-display);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.025em;
      color: var(--color-ink);
      margin: 0;
    }

    @media (max-width: 40rem) {
      .hero-title {
        font-size: var(--text-display-s);
      }
    }

    .hero-lede {
      font-size: var(--text-md);
      line-height: 1.6;
      color: var(--color-ink-muted);
      max-width: 32ch;
      margin: 0;
    }

    .hero-destinations {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .destination-chip {
      display: inline-flex;
      align-items: center;
      padding: 0.375rem 0.75rem;
      background: var(--color-paper-dark);
      border: 1px solid var(--color-rule-strong);
      border-radius: var(--radius-pill);
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--color-ink);
    }

    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.875rem 1.75rem;
      background: var(--color-accent);
      color: white;
      border: none;
      border-radius: var(--radius-pill);
      font-size: var(--text-base);
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease, transform 0.1s ease;
      box-shadow: 0 4px 14px rgba(0, 81, 255, 0.3);
      width-fit-content;
    }

    .hero-cta:hover {
      background: #0041cc;
      transform: translateY(-1px);
    }

    .hero-cta:active {
      transform: translateY(0);
    }

    .hero-cta:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    .hero-note {
      font-size: var(--text-sm);
      color: var(--color-ink-muted);
      margin: 0;
    }

    .hero-split__visual {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .mockup-frame {
      position: relative;
      border-radius: var(--radius-xl);
      overflow: hidden;
      border: 1px solid var(--color-rule);
      box-shadow: 0 20px 50px -12px rgba(15, 23, 42, 0.15);
      background: var(--color-paper);
      max-width: 100%;
      max-height: 500px;
    }

    .mockup-img {
      display: block;
      width: 100%;
      height: 100%;
      max-width: 600px;
      max-height: 500px;
      object-fit: contain;
    }

    /* Section Split (Problem/Solution & Proof) */
    .section-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3xl);
      padding: var(--space-4xl) var(--space-xl);
      align-items: center;
    }

    .section-split--reverse {
      direction: rtl;
    }

    .section-split--reverse > * {
      direction: ltr;
    }

    @media (max-width: 56rem) {
      .section-split {
        grid-template-columns: 1fr;
        gap: var(--space-2xl);
      }

      .section-split--reverse {
        direction: ltr;
      }
    }

    .section-split__text {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }

    .section-kicker {
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-accent);
    }

    .section-title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--color-ink);
      margin: 0;
    }

    @media (max-width: 40rem) {
      .section-title {
        font-size: var(--text-2xl);
      }
    }

    .section-body {
      font-size: var(--text-base);
      line-height: 1.6;
      color: var(--color-ink-muted);
      max-width: 40ch;
    }

    .link-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-ink);
      font-weight: 600;
      text-decoration: none;
      font-size: var(--text-base);
      transition: color 0.15s ease;
      width-fit-content;
    }

    .link-cta:hover {
      color: var(--color-accent);
    }

    .link-cta:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
      border-radius: 2px;
    }

    .section-highlight {
      font-size: var(--text-lg);
      font-weight: 700;
      color: var(--color-ink);
      margin: 0;
    }

    /* Problem Grid */
    .problem-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }

    @media (max-width: 40rem) {
      .problem-grid {
        grid-template-columns: 1fr;
      }
    }

    .problem-card {
      padding: var(--space-lg);
      background: var(--color-paper);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .problem-icon {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-accent);
      background: var(--color-accent-light);
      border-radius: var(--radius-md);
    }

    .problem-card h3 {
      font-family: var(--font-display);
      font-size: var(--text-base);
      font-weight: 700;
      color: var(--color-ink);
      margin: 0;
    }

    .problem-card p {
      font-size: var(--text-sm);
      line-height: 1.5;
      color: var(--color-ink-muted);
      margin: 0;
    }

    /* Feature List */
    .feature-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .feature-item {
      display: flex;
      gap: var(--space-md);
      align-items: flex-start;
    }

    .feature-item svg {
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      color: var(--color-accent);
      background: var(--color-accent-light);
      border-radius: 50%;
      padding: 2px;
      margin-top: 2px;
    }

    .feature-item div {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .feature-item strong {
      font-size: var(--text-base);
      font-weight: 600;
      color: var(--color-ink);
    }

    .feature-item span {
      font-size: var(--text-sm);
      line-height: 1.5;
      color: var(--color-ink-muted);
    }

    /* Proof Panel */
    .proof-panel {
      background: var(--color-ink);
      color: var(--color-paper);
      padding: var(--space-xl);
      border-radius: var(--radius-xl);
    }

    .proof-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: var(--space-lg);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      margin-bottom: var(--space-lg);
    }

    .proof-tag {
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #60a5fa;
    }

    .proof-title {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: 700;
      color: white;
      margin: 0.25rem 0 0 0;
    }

    .proof-status {
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #60a5fa;
      padding: 0.25rem 0.625rem;
      background: rgba(30, 64, 175, 0.4);
      border: 1px solid rgba(96, 165, 250, 0.3);
      border-radius: var(--radius-pill);
    }

    .proof-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .proof-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-md) 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font-size: var(--text-sm);
      color: #f1f5f9;
    }

    .proof-row:last-child {
      border-bottom: none;
    }

    .proof-row svg {
      color: #60a5fa;
    }

    /* Steps Section */
    .section-steps {
      padding: var(--space-4xl) var(--space-xl);
      background: var(--color-paper-dark);
    }

    .steps-header {
      text-align: center;
      max-width: 42ch;
      margin: 0 auto var(--space-3xl);
    }

    .steps-title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--color-ink);
      margin: 0 0 var(--space-md) 0;
    }

    @media (max-width: 40rem) {
      .steps-title {
        font-size: var(--text-2xl);
      }
    }

    .steps-subtitle {
      font-size: var(--text-base);
      line-height: 1.5;
      color: var(--color-ink-muted);
      margin: 0;
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
      margin-bottom: var(--space-3xl);
    }

    @media (max-width: 56rem) {
      .steps-grid {
        grid-template-columns: 1fr;
      }
    }

    .step-card {
      padding: var(--space-xl);
      background: var(--color-paper);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }

    .step-number {
      font-family: var(--font-display);
      font-size: var(--text-4xl);
      font-weight: 800;
      color: var(--color-rule-strong);
      line-height: 1;
      margin: 0;
    }

    .step-title {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: 700;
      color: var(--color-ink);
      margin: 0;
    }

    .step-body {
      font-size: var(--text-sm);
      line-height: 1.5;
      color: var(--color-ink-muted);
      margin: 0;
    }

    .steps-cta {
      text-align: center;
    }

    .cta-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.875rem 1.75rem;
      background: var(--color-accent);
      color: white;
      border: none;
      border-radius: var(--radius-pill);
      font-size: var(--text-base);
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease, transform 0.1s ease;
      box-shadow: 0 4px 14px rgba(0, 81, 255, 0.3);
    }

    .cta-primary:hover {
      background: #0041cc;
      transform: translateY(-1px);
    }

    .cta-primary:active {
      transform: translateY(0);
    }

    .cta-primary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    /* Corridors Section */
    .section-corridors {
      padding: var(--space-4xl) var(--space-xl);
    }

    .corridors-header {
      text-align: center;
      max-width: 42ch;
      margin: 0 auto var(--space-3xl);
    }

    .corridors-title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--color-ink);
      margin: 0 0 var(--space-md) 0;
    }

    @media (max-width: 40rem) {
      .corridors-title {
        font-size: var(--text-2xl);
      }
    }

    .corridors-subtitle {
      font-size: var(--text-base);
      line-height: 1.5;
      color: var(--color-ink-muted);
      margin: 0;
    }

    .corridors-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: var(--space-lg);
      margin-bottom: var(--space-3xl);
    }

    @media (max-width: 56rem) {
      .corridors-grid {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
      }
    }

    .corridor-card {
      grid-column: span 2;
      padding: var(--space-xl);
      background: var(--color-paper);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      position: relative;
    }

    .corridor-card--featured {
      grid-column: span 2;
      grid-row: span 2;
      background: var(--color-ink);
      color: var(--color-paper);
    }

    @media (max-width: 56rem) {
      .corridor-card,
      .corridor-card--featured {
        grid-column: span 1;
        grid-row: span 1;
      }
    }

    .corridor-badge {
      position: absolute;
      top: var(--space-lg);
      right: var(--space-lg);
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #60a5fa;
      padding: 0.25rem 0.625rem;
      background: rgba(30, 64, 175, 0.4);
      border: 1px solid rgba(96, 165, 250, 0.3);
      border-radius: var(--radius-pill);
    }

    .corridor-flag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: var(--color-accent-light);
      color: var(--color-accent);
      font-weight: 700;
      font-size: var(--text-xs);
      border-radius: var(--radius-md);
    }

    .corridor-zone {
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-accent);
    }

    .corridor-card--euro {
      background: var(--color-ink);
      color: var(--color-paper);
    }

    .corridor-card--euro .corridor-flag {
      background: rgba(30, 64, 175, 0.4);
      color: var(--color-accent-muted);
    }

    .corridor-card--euro .corridor-zone {
      color: var(--color-accent-muted);
    }

    .corridor-title {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: 700;
      color: inherit;
      margin: 0;
    }

    .corridor-body {
      font-size: var(--text-sm);
      line-height: 1.5;
      color: var(--color-ink-muted);
      margin: 0;
    }

    .corridor-card--featured .corridor-body,
    .corridor-card--euro .corridor-body {
      color: #f1f5f9;
    }

    .corridor-footer {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      margin-top: auto;
      padding-top: var(--space-lg);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .corridor-footer svg {
      flex-shrink: 0;
      color: var(--color-accent);
    }

    .corridor-footer span {
      font-size: var(--text-sm);
      color: #f1f5f9;
    }

    .corridor-meta {
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--color-ink-muted);
      margin-top: auto;
    }

    .corridor-card--featured .corridor-meta,
    .corridor-card--euro .corridor-meta {
      color: #94a3b8;
    }

    .corridors-summary {
      text-align: center;
      max-width: 42ch;
      margin: 0 auto;
      padding: var(--space-xl);
      background: var(--color-paper);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-lg);
    }

    .corridors-summary p {
      font-family: var(--font-display);
      font-size: var(--text-base);
      font-weight: 700;
      color: var(--color-ink);
      margin: 0;
    }

    /* FAQ Section */
    .section-faq {
      padding: var(--space-4xl) var(--space-xl);
      background: var(--color-paper-dark);
    }

    .faq-header {
      text-align: center;
      max-width: 42ch;
      margin: 0 auto var(--space-3xl);
    }

    .faq-title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--color-ink);
      margin: 0 0 var(--space-md) 0;
    }

    @media (max-width: 40rem) {
      .faq-title {
        font-size: var(--text-2xl);
      }
    }

    .faq-subtitle {
      font-size: var(--text-base);
      color: var(--color-ink-muted);
      margin: 0;
    }

    .faq-list {
      max-width: 48ch;
      margin: 0 auto;
    }

    .faq-item {
      background: var(--color-paper);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-lg);
      margin-bottom: var(--space-md);
    }

    .faq-item:last-child {
      margin-bottom: 0;
    }

    .faq-question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-md);
      padding: var(--space-lg);
      font-family: var(--font-display);
      font-size: var(--text-base);
      font-weight: 600;
      color: var(--color-ink);
      cursor: pointer;
      user-select: none;
      list-style: none;
    }

    .faq-question::-webkit-details-marker {
      display: none;
    }

    .faq-question svg {
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      color: var(--color-ink-muted);
      transition: transform 0.2s ease;
    }

    details[open] .faq-question svg {
      transform: rotate(45deg);
    }

    .faq-answer {
      padding: 0 var(--space-lg) var(--space-lg);
      font-size: var(--text-sm);
      line-height: 1.6;
      color: var(--color-ink-muted);
    }

    .faq-answer p {
      margin: 0;
    }

    /* Contact Section */
    .section-contact {
      padding: var(--space-4xl) var(--space-xl);
    }

    .contact-header {
      text-align: center;
      max-width: 42ch;
      margin: 0 auto var(--space-3xl);
    }

    .contact-title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--color-ink);
      margin: 0 0 var(--space-md) 0;
    }

    @media (max-width: 40rem) {
      .contact-title {
        font-size: var(--text-2xl);
      }
    }

    .contact-subtitle {
      font-size: var(--text-base);
      line-height: 1.5;
      color: var(--color-ink-muted);
      margin: 0;
    }

    .contact-whatsapp {
      text-align: center;
      font-size: var(--text-sm);
      color: var(--color-ink-muted);
      margin-top: var(--space-xl);
    }

    .contact-whatsapp a {
      color: var(--color-accent);
      font-weight: 600;
      text-decoration: none;
    }

    .contact-whatsapp a:hover {
      text-decoration: underline;
    }

    /* Footer Line */
    .footer-line {
      padding: var(--space-xl) var(--space-xl);
      border-top: 1px solid var(--color-rule);
      text-align: center;
    }

    .footer-line p {
      font-size: var(--text-sm);
      color: var(--color-ink-muted);
      margin: 0;
    }

    .footer-line a {
      color: var(--color-ink-muted);
      text-decoration: none;
    }

    .footer-line a:hover {
      color: var(--color-ink);
    }

    @media (max-width: 40rem) {
      .footer-line p {
        font-size: var(--text-xs);
      }
    }

    /* WhatsApp Floating Button */
    .wa-floating {
      position: fixed;
      bottom: var(--space-lg);
      right: var(--space-lg);
      z-index: 50;
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-accent);
      color: white;
      border-radius: 50%;
      box-shadow: 0 8px 24px -8px rgba(0, 81, 255, 0.5);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .wa-floating:hover {
      transform: translateY(-2px);
    }

    .wa-floating:active {
      transform: translateY(0);
    }

    .wa-floating.wa-floating--hidden {
      opacity: 0;
      pointer-events: none;
    }

    @media (max-width: 40rem) {
      .wa-floating {
        width: 48px;
        height: 48px;
        bottom: var(--space-md);
        right: var(--space-md);
      }
    }
  </style>

  <script is:inline>
    const waFloatingBtn = document.getElementById('wa-floating-btn');
    const waFloatingObstacles = document.querySelectorAll('#demo-form, .footer-line');

    if (waFloatingBtn && waFloatingObstacles.length) {
      const waFloatingObserver = new IntersectionObserver((entries) => {
        const shouldHide = entries.some((entry) => entry.isIntersecting);
        waFloatingBtn.classList.toggle('wa-floating--hidden', shouldHide);
      }, { threshold: 0.2 });

      waFloatingObstacles.forEach((el) => waFloatingObserver.observe(el));
    }

    const params = new URLSearchParams(window.location.search);
    const utmContent = params.get('utm_content');

    if (utmContent) {
      const suffix = ` [ref: ${utmContent}]`;
      document.querySelectorAll('a[href*="wa.me"]').forEach((link) => {
        const url = new URL(link.href);
        const text = url.searchParams.get('text');
        if (text === null) return;
        url.searchParams.set('text', text + suffix);
        link.setAttribute('href', url.toString());
      });
    }

    document.querySelectorAll('a[href*="wa.me"]').forEach((link) => {
      link.addEventListener('click', () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'click-whatsapp' });
      });
    });
  </script>
</Layout>
