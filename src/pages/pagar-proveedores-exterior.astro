                  <path d="M 0 0 L 10 5 L 0 10 z" fill="#0051ff"></path>
                </marker>
                <marker
                  id="arrow-cyan"
                  viewBox="0 0 10 10"
                  refX="9"
                  refY="5"
                  markerWidth="7"
                  markerHeight="7"
