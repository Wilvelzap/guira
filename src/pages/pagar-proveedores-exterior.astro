---
import Layout from '../layouts/Layout.astro';
import DemoForm from '../components/DemoForm.astro';
---

<!-- 
  /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5
   * macrostructure: Marquee Hero
   * theme: Cobalt (modern-minimal cluster)
   * nav: N6 Masthead minimal
   * footer: Ft5 Statement
   * contrast: pass (4.8:1 - 14:1)
   */
-->

<Layout
  title="Paga a tus proveedores en el exterior desde una sola cuenta operativa | Guira"
  description="Paga a proveedores en Estados Unidos, Brasil, México, Colombia y Europa desde una sola cuenta operativa. En la moneda que tu proveedor necesita recibir, con respaldo documental en cada operación."
  canonicalUrl="https://www.guiracorp.com/pagar-proveedores-exterior"
  robots="noindex, nofollow"
  hideNav={true}
  hideFooter={true}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/images/plataforma-dashboard-macbook.webp" type="image/webp" fetchpriority="high" />
    <link rel="preload" as="image" href="/assets/images/logo-horizontal-color-blanco.png" type="image/png" />
    <style is:inline>
      html { 
        scroll-behavior: smooth; 
        overflow-x: clip;
      }
      body {
        overflow-x: clip;
      }
      /* Ocultar el widget global de WhatsApp inyectado por main.js */
      body > a.bg-emerald-500[href*="wa.me"]:not(.p-6) {
        display: none !important;
      }
    </style>
  </Fragment>

  <!-- HERO (Marquee Hero - Modern Minimal) -->
  <header class="relative pt-8 pb-20 md:pb-28 overflow-hidden bg-[#090d16] text-white">
    <!-- Subtle grid overlay -->
    <div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 64px 64px;"></div>
    
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <!-- ENCABEZADO: Logo oficial de Guira + badge -->
      <div class="flex items-center justify-between mb-12 md:mb-16">
        <img src="/assets/images/logo-horizontal-color-blanco.png" alt="Guira" class="h-8 md:h-9 object-contain" />
        <span class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold text-cyan-300 tracking-wide">
          <i data-lucide="building-2" class="w-3.5 h-3.5 text-cyan-400"></i>
          Para empresas importadoras de Bolivia
        </span>
      </div>

      <!-- HERO HEADLINE & INTRO -->
      <div class="max-w-3xl mb-10">
        <p class="sm:hidden inline-flex items-center gap-2 text-xs font-semibold text-cyan-300 mb-4">
          <i data-lucide="building-2" class="w-3.5 h-3.5 text-cyan-400"></i>
          Para empresas importadoras de Bolivia
        </p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.06] text-white mb-6">
          Paga a tus proveedores en el exterior
        </h1>
        <p class="text-lg md:text-xl text-slate-300 max-w-2xl font-normal leading-relaxed">
          Desde una sola cuenta operativa, en la moneda que tu proveedor necesita recibir. Con respaldo documental en cada operación.
        </p>
      </div>

      <!-- CORREDORES PILL & CTA -->
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex flex-wrap items-center gap-2.5 px-4 py-2.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-200 text-sm font-semibold mb-8">
            <i data-lucide="globe-2" class="w-4 h-4 text-cyan-400 shrink-0"></i>
            <span>Estados Unidos · Brasil · México · Colombia · Europa</span>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-3">
            <a href="https://wa.me/59175245845?text=Hola,%20quiero%20pagar%20a%20mis%20proveedores%20del%20exterior%20con%20Guira"
              target="_blank" rel="noopener noreferrer"
              class="inline-flex px-8 py-4 bg-teal-600 text-white rounded-xl font-bold text-base md:text-lg hover:bg-teal-500 transition-[background-color,transform] duration-200 shadow-lg shadow-teal-900/30 active:translate-y-0.5 items-center justify-center gap-2.5 text-center">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
              <span>Quiero pagar a mi proveedor</span>
            </a>
          </div>
          <p class="text-slate-400 text-xs md:text-sm font-medium">Escríbenos y revisamos tu operación. Sin compromiso.</p>
        </div>

        <div class="lg:col-span-5">
          <figure class="relative rounded-2xl border border-slate-700/80 bg-slate-900/60 shadow-2xl overflow-hidden">
            <img src="/assets/images/plataforma-dashboard-macbook.webp"
              alt="Plataforma Guira, panel de operaciones y trazabilidad"
              class="w-full h-auto object-cover block"
              fetchpriority="high">
          </figure>
        </div>
      </div>
    </div>
  </header>

  <!-- SECCION 2: CORREDORES (Bento Grid Asimétrico) -->
  <section class="py-20 md:py-24 bg-slate-50 border-y border-slate-200/80">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-14">
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
          Un solo lugar para pagar a tus proveedores
        </h2>
        <p class="text-slate-600 text-base md:text-lg font-normal leading-relaxed">
          Elige el destino y la moneda según lo que tu proveedor necesite recibir.
        </p>
      </div>

      <!-- Bento Grid Asimétrico -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <!-- EE.UU. (Featured Tile - Span 2) -->
        <article class="md:col-span-2 bg-slate-900 text-white border border-slate-800 rounded-2xl p-8 shadow-sm flex flex-col justify-between relative overflow-hidden group">
          <div class="absolute top-0 right-0 p-8 opacity-10 text-cyan-400 pointer-events-none">
            <i data-lucide="dollar-sign" class="w-32 h-32"></i>
          </div>
          <div>
            <span class="inline-block px-3 py-1 rounded-md bg-teal-500/20 text-teal-300 text-xs font-bold uppercase tracking-wider mb-4">Corredor Principal</span>
            <h3 class="font-extrabold text-2xl md:text-3xl mb-3 text-white">Estados Unidos</h3>
            <p class="text-slate-300 text-base md:text-lg max-w-lg font-normal leading-relaxed">
              Pagos en dólares estadounidenses a proveedores, fabricantes y socios comerciales en EE.UU. con trazabilidad completa.
            </p>
          </div>
          <div class="mt-8 pt-6 border-t border-slate-800 flex items-center gap-2 text-sm text-slate-400 font-semibold">
            <i data-lucide="check" class="w-4 h-4 text-teal-400"></i>
            <span>Transferencias en USD directamente a cuentas corporativas</span>
          </div>
        </article>

        <!-- Brasil -->
        <article class="bg-white border border-slate-200/90 rounded-2xl p-7 shadow-sm flex flex-col justify-between">
          <div>
            <span class="inline-block w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-xs mb-4">BR</span>
            <h3 class="font-bold text-slate-900 text-xl mb-2">Brasil</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Pagos en reales a proveedores brasileños de insumos y maquinaria.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500">
            Moneda local o USD
          </div>
        </article>

        <!-- México -->
        <article class="bg-white border border-slate-200/90 rounded-2xl p-7 shadow-sm flex flex-col justify-between">
          <div>
            <span class="inline-block w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-xs mb-4">MX</span>
            <h3 class="font-bold text-slate-900 text-xl mb-2">México</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Pagos en pesos mexicanos directamente a cuentas bancarias en México.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500">
            Moneda local o USD
          </div>
        </article>

        <!-- Colombia -->
        <article class="bg-white border border-slate-200/90 rounded-2xl p-7 shadow-sm flex flex-col justify-between">
          <div>
            <span class="inline-block w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-xs mb-4">CO</span>
            <h3 class="font-bold text-slate-900 text-xl mb-2">Colombia</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Pagos en pesos colombianos para abastecimiento y servicios en Colombia.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500">
            Moneda local o USD
          </div>
        </article>

        <!-- Europa & Operaciones Recurrentes (Span 2 / Integrated) -->
        <article class="bg-gradient-to-br from-slate-900 to-slate-800 text-white border border-slate-800 rounded-2xl p-7 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-block w-8 h-8 rounded-lg bg-white/10 text-cyan-300 flex items-center justify-center font-bold text-xs">EU</span>
              <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Zona Euro</span>
            </div>
            <h3 class="font-bold text-xl mb-2">Europa</h3>
            <p class="text-slate-300 text-sm leading-relaxed">Pagos en euros a proveedores de la zona europea con respaldo documental.</p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-700/60 text-xs font-semibold text-teal-300">
            Operaciones recurrentes sin empezar desde cero
          </div>
        </article>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200/80 text-center max-w-3xl mx-auto shadow-sm">
        <p class="text-slate-900 text-base md:text-lg font-bold">
          Fondeas tu cuenta operativa y el pago sale en la moneda que tu proveedor necesita.
        </p>
      </div>
    </div>
  </section>

  <!-- SECCION 3: EL PROBLEMA & SOLUCION -->
  <section class="py-20 md:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
          Pagar afuera no debería frenar tu operación
        </h2>
        <p class="text-slate-600 text-base md:text-lg font-normal leading-relaxed">
          Cuando el pago se demora, no se demora un trámite. Se demora tu mercadería, tu producción y tu compromiso con el cliente.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <div class="bg-slate-50 border border-slate-200/90 p-7 rounded-2xl flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-slate-900 text-teal-400 flex items-center justify-center shrink-0">
            <i data-lucide="lock" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-base mb-1.5">El proveedor no libera el pedido</h3>
            <p class="text-slate-600 text-sm leading-relaxed font-normal">
              Hasta confirmar que el pago salió, y esa confirmación depende de un proceso que tu empresa necesita controlar.
            </p>
          </div>
        </div>

        <div class="bg-slate-50 border border-slate-200/90 p-7 rounded-2xl flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-slate-900 text-teal-400 flex items-center justify-center shrink-0">
            <i data-lucide="file-question" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-base mb-1.5">Requisitos cambiantes por operación</h3>
            <p class="text-slate-600 text-sm leading-relaxed font-normal">
              Cada operación solicita datos distintos y las observaciones surgen cuando la carga ya está esperando.
            </p>
          </div>
        </div>

        <div class="bg-slate-50 border border-slate-200/90 p-7 rounded-2xl flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-slate-900 text-teal-400 flex items-center justify-center shrink-0">
            <i data-lucide="eye-off" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-base mb-1.5">Falta de visibilidad del estado</h3>
            <p class="text-slate-600 text-sm leading-relaxed font-normal">
              No sabes en qué etapa exacta está la transferencia hasta que alguien responde un correo o un mensaje.
            </p>
          </div>
        </div>

        <div class="bg-slate-50 border border-slate-200/90 p-7 rounded-2xl flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-slate-900 text-teal-400 flex items-center justify-center shrink-0">
            <i data-lucide="file-x" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-base mb-1.5">Dificultad en la conciliación</h3>
            <p class="text-slate-600 text-sm leading-relaxed font-normal">
              El comprobante tradicional no conecta directamente el pago ejecutado con la factura del proveedor.
            </p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="https://wa.me/59175245845?text=Hola,%20necesito%20pagar%20a%20un%20proveedor%20del%20exterior%20y%20quiero%20orientaci%C3%B3n"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-8 py-4 bg-slate-900 text-white rounded-xl font-bold text-base hover:bg-slate-800 transition-[background-color] duration-200">
          <span>Quiero resolver esto</span>
          <i data-lucide="arrow-right" class="w-4 h-4 text-cyan-400"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- SECCION 4: COMO FUNCIONA (Proceso Ordinal 3 Pasos) -->
  <section class="py-20 md:py-24 bg-slate-50 border-t border-slate-200/80">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-2xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
          Cómo se ordena un pago con Guira
        </h2>
        <p class="text-slate-600 text-base md:text-lg font-normal">
          Tres pasos claros con acompañamiento operativo antes de ejecutar la transferencia.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-14">
        <!-- Paso 1 -->
        <div class="bg-white border border-slate-200/90 rounded-2xl p-8 shadow-sm relative">
          <div class="text-4xl font-black text-slate-200 mb-4">01</div>
          <h3 class="font-bold text-slate-900 text-xl mb-3">Preparamos la operación</h3>
          <p class="text-slate-600 text-sm leading-relaxed font-normal">
            Revisamos la factura, datos bancarios del proveedor y destino para asegurar que el pago salga completo desde el primer intento.
          </p>
        </div>

        <!-- Paso 2 -->
        <div class="bg-white border border-slate-200/90 rounded-2xl p-8 shadow-sm relative">
          <div class="text-4xl font-black text-slate-200 mb-4">02</div>
          <h3 class="font-bold text-slate-900 text-xl mb-3">Ejecutamos el corredor</h3>
          <p class="text-slate-600 text-sm leading-relaxed font-normal">
            Definimos la ruta según el país del proveedor, el monto y la moneda que necesita recibir en su cuenta.
          </p>
        </div>

        <!-- Paso 3 -->
        <div class="bg-white border border-slate-200/90 rounded-2xl p-8 shadow-sm relative">
          <div class="text-4xl font-black text-slate-200 mb-4">03</div>
          <h3 class="font-bold text-slate-900 text-xl mb-3">Entregamos el respaldo</h3>
          <p class="text-slate-600 text-sm leading-relaxed font-normal">
            Comprobante, referencia y soporte de conciliación disponibles para tu equipo administrativo y contable.
          </p>
        </div>
      </div>

      <div class="text-center">
        <a href="https://wa.me/59175245845?text=Hola,%20quiero%20empezar%20a%20pagar%20a%20mis%20proveedores%20del%20exterior%20con%20Guira"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 px-9 py-4 bg-teal-600 text-white rounded-xl font-bold text-base hover:bg-teal-500 transition-[background-color] duration-200 shadow-md">
          <span>Empezar mi primera operación</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- SECCION 5: RESPALDO POR OPERACION -->
  <section class="py-20 md:py-24 bg-white border-t border-slate-200/80">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <!-- Panel de demostración de respaldo -->
        <div class="lg:col-span-5">
          <div class="bg-slate-900 text-white rounded-2xl border border-slate-800 p-6 md:p-8 shadow-xl">
            <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-800">
              <div>
                <p class="text-cyan-400 text-xs font-bold uppercase tracking-wider">Operación B2B</p>
                <p class="text-white font-bold text-lg mt-0.5">Pago a proveedor internacional</p>
              </div>
              <span class="text-xs font-bold text-emerald-300 bg-emerald-950/80 border border-emerald-500/30 px-3 py-1 rounded-full">
                Completada
              </span>
            </div>

            <div class="space-y-4">
              <div class="flex items-center justify-between text-sm py-2 border-b border-slate-800/60">
                <span class="text-slate-300 font-medium">Comprobante de operación</span>
                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
              </div>
              <div class="flex items-center justify-between text-sm py-2 border-b border-slate-800/60">
                <span class="text-slate-300 font-medium">Referencia vinculada a factura</span>
                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
              </div>
              <div class="flex items-center justify-between text-sm py-2 border-b border-slate-800/60">
                <span class="text-slate-300 font-medium">Trazabilidad de estado</span>
                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
              </div>
              <div class="flex items-center justify-between text-sm py-2">
                <span class="text-slate-300 font-medium">Historial descargable</span>
                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Descripción -->
        <div class="lg:col-span-7">
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-5">
            Cada pago con su respaldo
          </h2>
          <p class="text-slate-600 text-base md:text-lg font-normal leading-relaxed mb-8">
            Tu contador no debería reconstruir la historia de un pago meses después. El respaldo documental se organiza cuando la operación se genera.
          </p>

          <div class="space-y-5 mb-8">
            <div class="flex gap-3.5 items-start">
              <div class="w-6 h-6 rounded-md bg-teal-100 text-teal-700 flex items-center justify-center shrink-0 mt-0.5">
                <i data-lucide="check" class="w-4 h-4"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-base">Comprobante oficial de la operación</h3>
                <p class="text-slate-600 text-sm font-normal">Registro del pago ejecutado con detalles bancarios completos.</p>
              </div>
            </div>

            <div class="flex gap-3.5 items-start">
              <div class="w-6 h-6 rounded-md bg-teal-100 text-teal-700 flex items-center justify-center shrink-0 mt-0.5">
                <i data-lucide="check" class="w-4 h-4"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-base">Referencia conectada a tu factura</h3>
                <p class="text-slate-600 text-sm font-normal">Relación directa entre la salida del pago y el documento comercial de origen.</p>
              </div>
            </div>

            <div class="flex gap-3.5 items-start">
              <div class="w-6 h-6 rounded-md bg-teal-100 text-teal-700 flex items-center justify-center shrink-0 mt-0.5">
                <i data-lucide="check" class="w-4 h-4"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-base">Estado visible en todo momento</h3>
                <p class="text-slate-600 text-sm font-normal">Control claro para saber si la operación está en preparación, en curso o finalizada.</p>
              </div>
            </div>
          </div>

          <p class="text-slate-900 text-lg font-bold mb-6">
            Y si te preguntan, lo puedes mostrar.
          </p>

          <a href="https://wa.me/59175245845?text=Hola,%20quiero%20conocer%20el%20respaldo%20documental%20de%20los%20pagos%20con%20Guira"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-8 py-4 bg-slate-900 text-white rounded-xl font-bold text-base hover:bg-slate-800 transition-[background-color] duration-200">
            <span>Quiero ver el respaldo por operación</span>
            <i data-lucide="arrow-right" class="w-4 h-4 text-cyan-400"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCION 6: PREGUNTAS FRECUENTES -->
  <section class="py-20 md:py-24 bg-slate-50 border-t border-slate-200/80">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
          Antes de empezar
        </h2>
        <p class="text-slate-600 text-base font-normal">Respuestas claras sobre la operativa y el alcance.</p>
      </div>

      <div class="bg-white border border-slate-200/90 rounded-2xl shadow-sm divide-y divide-slate-200/80 overflow-hidden">
        <details class="group" open>
          <summary class="flex justify-between items-center gap-4 font-bold cursor-pointer list-none p-6 text-slate-900 hover:bg-slate-50/80 transition-colors">
            <span class="text-base md:text-lg">¿Quién opera la plataforma?</span>
            <div class="w-8 h-8 rounded-full border border-slate-200 flex items-center justify-center shrink-0 group-open:bg-slate-900 group-open:text-white transition-colors">
              <i data-lucide="plus" class="w-4 h-4 group-open:rotate-45 transition-transform duration-200"></i>
            </div>
          </summary>
