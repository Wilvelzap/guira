  <script>
    const prepareWhatsAppLinks = () => {
      const links = document.querySelectorAll('a[href*="wa.me"]');
      const floatingLink = Array.from(links).find(
        (link) => link.getAttribute("aria-label") === "Chat en WhatsApp",
      );

      if (floatingLink) {
        const floatingUrl = new URL(floatingLink.href);
        if (floatingUrl.searchParams.get("text") === null) {
          floatingUrl.searchParams.set(
            "text",
            "Hola, quiero pagar a mis proveedores del exterior con Guira",
          );
          floatingLink.setAttribute("href", floatingUrl.toString());
        }
      }

      const reference = new URLSearchParams(window.location.search).get(
        "utm_content",
      );
      if (!reference) return;
      const suffix = ` [ref: ${reference}]`;

      links.forEach((link) => {
        const url = new URL(link.href);
        const originalText = url.searchParams.get("text");
        if (originalText === null || originalText.endsWith(suffix)) return;
        url.searchParams.set("text", originalText + suffix);
        link.setAttribute("href", url.toString());
      });
    };

    window.addEventListener("load", prepareWhatsAppLinks);
    document.addEventListener("click", (event) => {
      const link = event.target.closest('a[href*="wa.me"]');
      if (!link) return;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "click-whatsapp" });
    });
  </script>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!reducedMotion) {
      // Entrada del hero al cargar
      const heroTimeline = gsap.timeline({
        defaults: { ease: "power3.out" },
      });
      heroTimeline
        .from(".audience-tag", { opacity: 0, y: 16, duration: 0.6 })
        .from(".hero h1", { opacity: 0, y: 22, duration: 0.75 }, "-=0.4")
        .from(".hero-lead", { opacity: 0, y: 20, duration: 0.7 }, "-=0.55")
        .from(".hero-actions", { opacity: 0, y: 16, duration: 0.6 }, "-=0.5")
        .from(".hero-support", { opacity: 0, y: 12, duration: 0.5 }, "-=0.4")
        .from(".trust-line", { opacity: 0, y: 16, duration: 0.6 }, "-=0.4")
        .from(
          ".hero-device",
          { opacity: 0, x: 40, scale: 0.96, duration: 0.9 },
          "-=0.7",
        )
        .from(
          ".network-route",
          { opacity: 0, duration: 0.45, stagger: 0.07 },
          "-=0.48",
        )
        .from(
          ".network-center",
          { autoAlpha: 0, scale: 0.78, duration: 0.55 },
          "-=0.42",
        )
        .from(
          ".network-node",
          { autoAlpha: 0, scale: 0.72, duration: 0.45, stagger: 0.08 },
          "-=0.36",
        );

      // Parallax sutil del halo del hero al hacer scroll
      gsap.to(".hero-wash", {
        y: 130,
        ease: "none",
        scrollTrigger: {
          trigger: ".hero",
          start: "top top",
          end: "bottom top",
          scrub: 1,
        },
      });

      // Tarjetas de "Cómo funciona": entran y se reactivan al subir/bajar
      const processCards = gsap.utils.toArray("#como-funciona .group");
      if (processCards.length) {
        gsap.set(processCards, { opacity: 0, y: 30, scale: 0.94 });
        gsap.to(processCards, {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.7,
          ease: "power3.out",
          stagger: 0.12,
          scrollTrigger: {
            trigger: "#como-funciona .grid",
            start: "top 78%",
            toggleActions: "play none none reverse",
          },
          onComplete: () => gsap.set(processCards, { clearProps: "all" }),
          onReverseComplete: () =>
            gsap.set(processCards, { opacity: 0, y: 30, scale: 0.94 }),
        });
      }

      // Preguntas de "Antes de empezar": suben desde abajo y se reactivan al subir/bajar
      const faqItems = gsap.utils.toArray(".faq-list details");
      if (faqItems.length) {
        gsap.set(faqItems, { opacity: 0, y: 44 });
        gsap.to(faqItems, {
          opacity: 1,
          y: 0,
          duration: 0.65,
          ease: "power3.out",
          stagger: 0.14,
          scrollTrigger: {
            trigger: ".faq-list",
            start: "top 82%",
            toggleActions: "play none none reverse",
          },
          onComplete: () =>
            gsap.set(faqItems, { clearProps: "opacity,transform" }),
          onReverseComplete: () => gsap.set(faqItems, { opacity: 0, y: 44 }),
        });
      }
    }
  </script>
</Layout>

