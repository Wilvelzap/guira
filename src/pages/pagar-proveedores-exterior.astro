  <script>
    const waFloatingBtn = document.getElementById('wa-floating-btn');
    const waFloatingObstacles = document.querySelectorAll('#demo-form, footer');

    if (waFloatingBtn && waFloatingObstacles.length) {
      const waFloatingObserver = new IntersectionObserver((entries) => {
        const shouldHide = entries.some((entry) => entry.isIntersecting);
        waFloatingBtn.classList.toggle('wa-floating-btn--hidden', shouldHide);
      }, { threshold: 0.2 });

      waFloatingObstacles.forEach((el) => waFloatingObserver.observe(el));
    }

    const params = new URLSearchParams(window.location.search);
    const utmContent = params.get('utm_content');

    if (utmContent) {
      const suffix = ` [ref: ${utmContent}]`;
      document.querySelectorAll('a[href*="wa.me"]').forEach((link) => {
        const url = new URL(link.href);
        const text = url.searchParams.get('text');
        if (text === null) return;
        url.searchParams.set('text', text + suffix);
        link.setAttribute('href', url.toString());
      });
    }

    document.querySelectorAll('a[href*="wa.me"]').forEach((link) => {
      link.addEventListener('click', () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'click-whatsapp' });
      });
    });
  </script>
