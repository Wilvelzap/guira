                marker-end="url(#arrow-blue)"></path>

              <circle class="network-signal network-signal-blue" r="5">
                <animateMotion
                  dur="3.8s"
                  repeatCount="indefinite"
                  path="M380 260 C380 195 394 152 390 102"></animateMotion>
                <animate
                  attributeName="opacity"
                  values="0;1;1;0"
                  keyTimes="0;0.12;0.8;1"
                  dur="3.8s"
                  repeatCount="indefinite"></animate>
              </circle>
              <circle
                class="network-signal network-signal-cyan"
                r="5"
                opacity="0"
              >
                <animateMotion
                  dur="4.6s"
                  begin="-1.3s"
                  repeatCount="indefinite"
                  path="M335 265 C270 248 222 214 161 204"></animateMotion>
                <animate
                  attributeName="opacity"
                  values="0;1;1;0"
                  keyTimes="0;0.12;0.8;1"
