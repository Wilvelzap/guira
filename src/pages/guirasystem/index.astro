---
/**
 * /guirasystem/ — página corporativa de Guira System LLC (versión inglesa,
 * canónica). Presenta el producto y sirve como expediente público de
 * verificación corporativa (v2.0 del brief).
 */
import CorporateLayout from '../../layouts/CorporateLayout.astro';
import CorporateProfile from '../../components/guirasystem/CorporateProfile.astro';
import data from '../../data/guirasystem/en.json';

// Solo campos verificables. Sin telephone, sin address de calle, sin
// sameAs hasta que exista el perfil corporativo de LinkedIn (§9.7).
// Sin subOrganization: GUIRAGLOBAL S.R.L. no es una filial de Guira
// System LLC (§3.5) — aparece solo como Related party en el JSON de datos,
// nunca en este schema.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Guira System LLC',
  legalName: 'Guira System LLC',
  url: data.meta.canonical,
  description: data.whatWeDo.paragraphs[0],
  naics: '541511',
  foundingLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'DE',
      addressCountry: 'US',
    },
  },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'DE',
    addressCountry: 'US',
  },
};

// Nuevo en v2.0 (§7.4): refuerza la clasificación como software ante
// buscadores y revisores. Sin aggregateRating, sin offers, sin campos que
// no estén confirmados.
const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Guira System LLC',
  applicationCategory: 'BusinessApplication',
  url: data.meta.canonical,
  description: data.platform.intro,
};
---

<CorporateLayout
  lang="en"
  title={data.meta.title}
  description={data.meta.description}
  canonical={data.meta.canonical}
  alternateEn={data.meta.canonical}
  alternateEs={data.meta.alternate}
  ogLocale={data.meta.ogLocale}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(softwareApplicationSchema)}
    />
  </Fragment>

  <CorporateProfile data={data} />
</CorporateLayout>
