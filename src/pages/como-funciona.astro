---
import Layout from "../layouts/Layout.astro";
import RadioCard from "../components/RadioCard.astro";
import GuiraButton from "../components/GuiraButton.astro";
import EditorialHeader from "../components/EditorialHeader.astro";
---

<Layout
    title="Cómo funciona el ecosistema de pagos internacionales | Guira"
    description="Conoce cómo una empresa puede organizar recepción en USD, validación KYB, documentación, compliance y seguimiento de operaciones internacionales con Guira."
    keywords="cómo funciona cuenta virtual USD empresas, KYB para empresas, compliance pagos internacionales, ecosistema pagos internacionales, recepción de pagos internacionales, gestión de operaciones internacionales"
    canonicalUrl="https://www.guiracorp.com/como-funciona"
    activeLink="como-funciona"
    footerTheme="rich-dark"
>
    <Fragment slot="head">
        <!-- Schema: BreadcrumbList -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Inicio",
                        "item": "https://www.guiracorp.com/"
                    },
                    {
                        "@type": "ListItem",
                        "position": 2,
                        "name": "Cómo Funciona",
                        "item": "https://www.guiracorp.com/como-funciona"
                    }
                ]
            }
        </script>

        <!-- Schema: HowTo -->
        <script type="application/ld+json" is:inline>
            {
                "@context": "https://schema.org",
                "@type": "HowTo",
                "name": "Cómo funciona el ecosistema de pagos internacionales de Guira",
                "description": "Proceso para que empresas organicen validación corporativa, recepción en USD, documentación, seguimiento y gestión de operaciones internacionales.",
                "step": [
                    {
                        "@type": "HowToStep",
                        "position": "1",
                        "name": "Validación Corporativa (KYB)",
                        "text": "Completa el proceso de Know Your Business. Se valida la identidad corporativa de tu empresa y se habilitan las herramientas y rieles según la estructura aplicable."
                    },
                    {
                        "@type": "HowToStep",
                        "position": "2",
                        "name": "Recepción Estructurada en USD",
                        "text": "Centraliza la recepción de pagos en USD de tus clientes en EE.UU. de forma trazable. La visibilidad de cada remesa depende del soporte documental validado por la plataforma."
                    },
                    {
                        "@type": "HowToStep",
                        "position": "3",
                        "name": "Ejecución y Cierre Operativo",
                        "text": "Instruye hacia dónde dirigir el saldo operativo: hacia cuentas locales o pago a proveedores en USA mediante ACH o Wire, según la estructura aprobada por los partners financieros."
                    }
                ]
            }
        </script>
    </Fragment>

    <!-- Header Section -->
    <!-- Header Section (Estilo Editorial Minimalista con Paleta Azul y Tipografía de Index) -->
    <header
        class="relative pt-36 sm:pt-40 md:pt-44 pb-20 sm:pb-24 md:pb-28 overflow-hidden bg-[#080f21] border-b border-white/10"
    >
        <!-- Superficie de azules y cianes de Guira (idéntica a index.astro) -->
        <div class="hero-operation-surface"></div>
        <div class="hero-operation-network" aria-hidden="true">
            <div class="hero-operation-network__halo"></div>
        </div>

        <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
            <div class="border-l border-white/15 pl-6 sm:pl-10 lg:pl-12">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 lg:gap-16 items-start">
                    <!-- Columna Izquierda: Label / Categoría alineado al tope -->
                    <div class="md:col-span-3 lg:col-span-2">
                        <span class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold tracking-wider text-guira-cyan uppercase select-none">
                            <span class="w-1.5 h-1.5 rounded-full bg-guira-cyan"></span>
                            Cómo funciona
                        </span>
                    </div>

                    <!-- Columna Derecha: Titular Monumental en Mayúsculas con Tipografía de Index -->
                    <div class="md:col-span-9 lg:col-span-10">
                        <h1
                            class="text-3xl sm:text-4xl md:text-5xl lg:text-[46px] xl:text-[54px] font-extrabold tracking-tight text-white uppercase leading-[1.1] max-w-5xl"
                        >
                            Cómo funciona el ecosistema de pagos internacionales y control por operación
                        </h1>

                        <p
                            class="mt-6 sm:mt-8 text-base md:text-lg text-slate-300 font-normal leading-relaxed max-w-2xl"
                        >
                            Desde la validación KYB hasta la recepción de pagos en USD, la
                            organización documental y el seguimiento de cada operación,
                            Guira ayuda a que tu empresa trabaje con mayor visibilidad.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Ecosistema -->
    <section class="py-20 bg-white border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-6 relative z-10" data-cross-fade="from">
            <EditorialHeader
                kicker="Ecosistema operativo"
                line1="Las piezas que conectan"
                line2="una operación internacional."
                description="Una operación internacional no es solo recibir o enviar fondos. También implica identificación, documentos, validaciones, seguimiento y conciliación."
            />

            <div class="grid md:grid-cols-3 gap-6" data-folder-stack>
                <RadioCard
                    icon="badge-dollar-sign"
                    title="Cuenta virtual USD"
                    padding="p-6"
                    data-folder-card
                >
                    <p class="text-slate-500 text-sm font-medium leading-relaxed mb-5">
                        Facilita la recepción, identificación y gestión
                        operativa de cobros internacionales en dólares.
                    </p>
                    <a
                        href="/blog/como-funciona-cuenta-virtual-usd-empresas/"
                        class="text-guira-teal font-bold inline-flex items-center gap-2 text-sm"
                        >Leer guía <i data-lucide="arrow-right" class="w-4 h-4"
                        ></i></a
                    >
                </RadioCard>

                <RadioCard
                    icon="shield-check"
                    title="KYB"
                    padding="p-6"
                    data-folder-card
                >
                    <p class="text-slate-500 text-sm font-medium leading-relaxed mb-5">
                        Permite verificar información corporativa antes de
                        habilitar determinados servicios empresariales.
                    </p>
                    <a
                        href="/blog/que-es-kyb-por-que-empresas-deben-completarlo/"
                        class="text-guira-teal font-bold inline-flex items-center gap-2 text-sm"
                        >Ver requisitos <i
                            data-lucide="arrow-right"
                            class="w-4 h-4"></i></a
                    >
                </RadioCard>

                <RadioCard
                    icon="folder-check"
                    title="Compliance y documentos"
                    padding="p-6"
                    data-folder-card
                >
                    <p class="text-slate-500 text-sm font-medium leading-relaxed mb-5">
                        Organiza respaldos y procesos para responder a
                        solicitudes, revisiones y auditorías con menos fricción.
                    </p>
                    <a
                        href="/blog/compliance-pagos-internacionales-empresas/"
                        class="text-guira-teal font-bold inline-flex items-center gap-2 text-sm"
                        >Entender compliance <i
                            data-lucide="arrow-right"
                            class="w-4 h-4"></i></a
                    >
                </RadioCard>
            </div>
        </div>

        <style>
            [data-folder-stack] {
                perspective: 1200px;
            }
            [data-folder-card] {
                transform-origin: 50% 100%;
                will-change: transform;
            }
        </style>

        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";

            gsap.registerPlugin(ScrollTrigger);

            const folderStack = document.querySelector("[data-folder-stack]");

            if (folderStack) {
                const cards = Array.from(
                    folderStack.querySelectorAll("[data-folder-card]"),
                );
                const reducedMotion = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                ).matches;

                if (!reducedMotion && cards.length) {
                    gsap.set(cards, {
                        x: (i) => (cards.length - 1 - i) * 10,
                        y: (i) => (cards.length - 1 - i) * 22,
                        rotate: (i) => (i - (cards.length - 1) / 2) * -5,
                        scale: 0.94,
                        zIndex: (i) => i,
                    });

                    gsap.to(cards, {
                        x: 0,
                        y: 0,
                        rotate: 0,
                        scale: 1,
                        duration: 0.9,
                        ease: "power3.out",
                        stagger: 0.12,
                        scrollTrigger: {
                            trigger: folderStack,
                            start: "top 78%",
                            toggleActions: "play none none reverse",
                        },
                    });
                }
            }
        </script>
    </section>
    <!-- Simulador Visual B2B (Inspirado en Mesa de Pagos) -->
    <section
        class="bg-guira-navy border-t border-white/5 relative z-10 overflow-hidden"
    >
        <div
            class="w-full h-screen overflow-hidden reveal-up"
            data-cross-fade="to"
        >
            <video
                src="https://res.cloudinary.com/dbrkedvyp/video/upload/v1784908930/Flujo_de_funcionamiento_ecqoco.webm"
                autoplay
                loop
                muted
                playsinline
                class="w-full h-full object-cover block"></video>
        </div>

        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";

            gsap.registerPlugin(ScrollTrigger);

            const videoContent = document.querySelector(
                '[data-cross-fade="to"]',
            );
            const ecoContent = document.querySelector(
                '[data-cross-fade="from"]',
            );
            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            if (videoContent && ecoContent) {
                if (!reducedMotion) {
                    gsap.set(videoContent, {
                        opacity: 0,
                        scale: 0.96,
                        transformOrigin: "50% 50%",
                    });
                    gsap.set(ecoContent, {
                        transformOrigin: "50% 50%",
                    });

                    gsap.timeline({
                        scrollTrigger: {
                            trigger: videoContent.closest("section"),
                            start: "top bottom",
                            end: "top top",
                            scrub: true,
                        },
                    })
                        .to(
                            videoContent,
                            { opacity: 1, scale: 1, ease: "none" },
                            0,
                        )
                        .to(
                            ecoContent,
                            {
                                opacity: 0.4,
                                scale: 0.96,
                                ease: "none",
                            },
                            0,
                        );

                    // Recalcula el rango de scroll cuando terminan de
                    // cargar imágenes/fuentes que puedan mover el layout.
                    window.addEventListener("load", () =>
                        ScrollTrigger.refresh(),
                    );
                } else {
                    gsap.set([videoContent, ecoContent], {
                        opacity: 1,
                        clearProps: "transform",
                    });
                }
            }
        </script>
    </section>

    <!-- Pasos de Operación -->
    <section class="py-24 md:py-32 bg-white relative overflow-hidden">
        <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(0,81,255,0.06),transparent_60%)] pointer-events-none"
        >
        </div>
        <div class="max-w-7xl mx-auto px-6 relative z-10">
            <EditorialHeader
                kicker="Cómo empezar"
                line1="El proceso,"
                line2="paso a paso."
                description="Elige el tipo de cuenta según tu perfil y sigue los video tutoriales para completar tu habilitación operativa."
            />

            <div class="w-full border-t border-slate-300" data-editorial-steps>
                <div class="grid">
                    <!-- Opción: Cuenta personal (KYC) -->
                    <div
                        class="step editorial-step group grid gap-8 py-10 md:py-14 border-b border-slate-300 md:grid-cols-12 md:items-center md:gap-12"
                        data-step
                    >
                        <div class="md:col-span-7 flex flex-col justify-between h-full py-1">
                            <div>
                                <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold uppercase tracking-tight text-slate-900 leading-tight">
                                    Conoce cómo crear tu cuenta personal en Guira
                                </h3>
                                <p class="mt-3 text-sm font-semibold uppercase tracking-wider text-slate-500">
                                    KYC
                                </p>
                            </div>
                            <div class="mt-8 md:mt-10">
                                <GuiraButton
                                    href="https://app.guiracorp.com"
                                    variant="dark"
                                    size="md"
                                    label="Crear cuenta"
                                />
                            </div>
                        </div>
                        <div class="md:col-span-5">
                            <div class="relative w-full aspect-video bg-black overflow-hidden shadow-sm">
                                <video
                                    controls
                                    controlslist="nodownload"
                                    oncontextmenu="return false;"
                                    preload="metadata"
                                    playsinline
                                    poster="https://res.cloudinary.com/dbrkedvyp/video/upload/so_1/v1788533356/KYC_Tutorial_uglyzm.jpg"
                                    class="w-full h-full object-cover"
                                    data-tutorial-video
                                >
                                    <source
                                        src="https://res.cloudinary.com/dbrkedvyp/video/upload/v1788533356/KYC_Tutorial_uglyzm.mp4"
                                        type="video/mp4"
                                    />
                                    Tu navegador no soporta la reproducción de video.
                                </video>
                            </div>
                        </div>
                    </div>

                    <!-- Opción: Cuenta para empresa (KYB) -->
                    <div
                        class="step editorial-step group grid gap-8 py-10 md:py-14 border-b border-slate-300 md:grid-cols-12 md:items-center md:gap-12"
                        data-step
                    >
                        <div class="md:col-span-7 flex flex-col justify-between h-full py-1">
                            <div>
                                <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold uppercase tracking-tight text-slate-900 leading-tight">
                                    Conoce cómo crear tu cuenta para empresa
                                </h3>
                                <p class="mt-3 text-sm font-semibold uppercase tracking-wider text-slate-500">
                                    KYB
                                </p>
                            </div>
                            <div class="mt-8 md:mt-10">
                                <GuiraButton
                                    href="https://app.guiracorp.com"
                                    variant="dark"
                                    size="md"
                                    label="Crear cuenta"
                                />
                            </div>
                        </div>
                        <div class="md:col-span-5">
                            <div class="relative w-full aspect-video bg-black overflow-hidden shadow-sm">
                                <video
                                    controls
                                    controlslist="nodownload"
                                    oncontextmenu="return false;"
                                    preload="metadata"
                                    playsinline
                                    poster="https://res.cloudinary.com/dbrkedvyp/video/upload/so_1/v1788533578/KYB_Tutorial_uvl9ml.jpg"
                                    class="w-full h-full object-cover"
                                    data-tutorial-video
                                >
                                    <source
                                        src="https://res.cloudinary.com/dbrkedvyp/video/upload/v1788533578/KYB_Tutorial_uvl9ml.mp4"
                                        type="video/mp4"
                                    />
                                    Tu navegador no soporta la reproducción de video.
                                </video>
                            </div>
                        </div>
                    </div>

                    <!-- Habilita tu cuenta virtual en otros países -->
                    <div
                        class="step editorial-step group grid gap-8 py-10 md:py-14 border-b border-slate-300 md:grid-cols-12 md:items-center md:gap-12"
                        data-step
                    >
                        <div class="md:col-span-7 flex flex-col justify-between h-full py-1">
                            <div>
                                <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold uppercase tracking-tight text-slate-900 leading-tight">
                                    Habilita tu cuenta virtual en otros países
                                </h3>
                                <p class="mt-3 text-sm font-semibold uppercase tracking-wider text-slate-500">
                                    Cuenta operativa en dólares
                                </p>
                            </div>
                            <div class="mt-8 md:mt-10">
                                <GuiraButton
                                    href="/blog/como-funciona-cuenta-virtual-usd-empresas/"
                                    variant="dark"
                                    size="md"
                                    label="Leer guía"
                                />
                            </div>
                        </div>
                        <div class="md:col-span-5">
                            <div class="relative w-full aspect-video bg-black overflow-hidden shadow-sm">
                                <img
                                    src="/assets/images/blog/seguimiento-operaciones-plataforma-digital.webp"
                                    alt="Cuenta operativa en dólares disponible en la plataforma"
                                    class="w-full h-full object-cover"
                                    loading="lazy"
                                />
                            </div>
                        </div>
                    </div>

                    <!-- Centraliza la visibilidad e instruye pagos -->
                    <div
                        class="step editorial-step group grid gap-8 py-10 md:py-14 border-b border-slate-300 md:grid-cols-12 md:items-center md:gap-12"
                        data-step
                    >
                        <div class="md:col-span-7 flex flex-col justify-between h-full py-1">
                            <div>
                                <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold uppercase tracking-tight text-slate-900 leading-tight">
                                    Centraliza la visibilidad e instruye pagos
                                </h3>
                                <p class="mt-3 text-sm font-semibold uppercase tracking-wider text-slate-500">
                                    ACH & Wire internacional
                                </p>
                            </div>
                            <div class="mt-8 md:mt-10">
                                <GuiraButton
                                    href="/pagos-proveedores-bolivia/"
                                    variant="dark"
                                    size="md"
                                    label="Ver detalles"
                                />
                            </div>
                        </div>
                        <div class="md:col-span-5">
                            <div class="relative w-full aspect-video bg-black overflow-hidden shadow-sm">
                                <img
                                    src="/assets/images/blog/wire-vs-ach-empresas-bolivianas.webp"
                                    alt="Empresa instruyendo un pago internacional"
                                    class="w-full h-full object-cover"
                                    loading="lazy"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <style>
        .editorial-step {
            opacity: 0;
            transform: translateY(28px);
        }

        @media (prefers-reduced-motion: reduce) {
            .editorial-step {
                opacity: 1;
                transform: none;
            }
        }
    </style>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        const editorialSteps = gsap.utils.toArray(".editorial-step");
        const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        if (prefersReducedMotion) {
            gsap.set(editorialSteps, { autoAlpha: 1, y: 0 });
        } else {
            ScrollTrigger.batch(editorialSteps, {
                start: "top 85%",
                onEnter: (batch) =>
                    gsap.to(batch, {
                        autoAlpha: 1,
                        y: 0,
                        duration: 0.7,
                        stagger: 0.12,
                        ease: "power3.out",
                        overwrite: true,
                    }),
            });
        }

        // Evitar que ambos videos tutoriales suenen al mismo tiempo
        const tutorialVideos = document.querySelectorAll<HTMLVideoElement>("[data-tutorial-video]");
        tutorialVideos.forEach((video) => {
            video.addEventListener("play", () => {
                tutorialVideos.forEach((other) => {
                    if (other !== video && !other.paused) {
                        other.pause();
                    }
                });
            });
        });
    </script>

    <!-- Qué necesita normalmente una empresa para empezar -->
    <section class="py-24 bg-slate-900 text-white relative overflow-hidden">
        <div
            class="absolute top-0 right-0 w-96 h-96 bg-guira-teal opacity-10 blur-[100px] rounded-full pointer-events-none"
        >
        </div>
        <div
            class="max-w-7xl mx-auto px-6 relative z-10 grid md:grid-cols-2 gap-16 items-center"
        >
            <div class="reveal">
                <h2 class="h2-section text-white mb-6">
                    Qué necesita normalmente una empresa para empezar
                </h2>
                <p class="text-slate-400 text-lg font-medium leading-relaxed mb-8">
                    Para agilizar la validación empresarial y el acceso a la
                    plataforma, tu negocio debe contar con requisitos operativos
                    claros.
                </p>
            </div>
            <div class="reveal reveal-delay-1">
                <ul class="divide-y divide-slate-800 border-y border-slate-800">
                    <li class="flex items-center gap-4 py-4 sm:py-5">
                        <i
                            data-lucide="check-circle-2"
                            class="w-6 h-6 text-guira-teal shrink-0"></i>
                        <span class="font-medium text-slate-100"
                            >Empresa legalmente constituida</span
                        >
                    </li>
                    <li class="flex items-center gap-4 py-4 sm:py-5">
                        <i
                            data-lucide="users"
                            class="w-6 h-6 text-guira-teal shrink-0"></i>
                        <span class="font-medium text-slate-100"
                            >Representantes identificables</span
                        >
                    </li>
                    <li class="flex items-center gap-4 py-4 sm:py-5">
                        <i
                            data-lucide="activity"
                            class="w-6 h-6 text-guira-teal shrink-0"></i>
                        <span class="font-medium text-slate-100"
                            >Actividad comercial verificable</span
                        >
                    </li>
                    <li class="flex items-center gap-4 py-4 sm:py-5">
                        <i
                            data-lucide="folder-check"
                            class="w-6 h-6 text-guira-teal shrink-0"></i>
                        <span class="font-medium text-slate-100"
                            >Documentación básica de soporte</span
                        >
                    </li>
                    <li class="flex items-center gap-4 py-4 sm:py-5">
                        <i
                            data-lucide="target"
                            class="w-6 h-6 text-guira-teal shrink-0"></i>
                        <span class="font-medium text-slate-100"
                            >Caso de uso alineado con el servicio</span
                        >
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Qué puede hacer tu empresa una vez activada -->
    <section class="py-24 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-6 relative z-10">
            <div class="text-center mb-16 reveal">
                <h2
                    class="h2-section mb-6 text-slate-900"
                >
                    Qué puede hacer tu empresa una vez activada
                </h2>
                <p
                    class="text-lg md:text-xl text-slate-600 font-medium leading-relaxed max-w-2xl mx-auto"
                >
                    Conecta onboarding operativo con beneficios reales para tu
                    negocio en LATAM.
                </p>
            </div>

            <div
                class="grid md:grid-cols-2 lg:grid-cols-4 divide-y divide-slate-200 md:divide-y-0 md:divide-x"
            >
                <!-- Beneficio 1 -->
                <div class="group px-6 py-8 md:py-0 text-center reveal">
                    <div class="relative inline-flex mb-6">
                        <div
                            class="w-14 h-14 rounded-xl bg-white border border-slate-200 flex items-center justify-center transition-colors group-hover:bg-blue-600 group-hover:border-blue-600"
                        >
                            <i
                                data-lucide="arrow-down-to-line"
                                class="w-6 h-6 text-slate-700 transition-colors group-hover:text-white"
                            ></i>
                        </div>
                        <span
                            class="absolute -top-2 -right-2 w-5 h-5 rounded-full bg-slate-900 text-white text-[11px] font-bold flex items-center justify-center"
                            >1</span
                        >
                    </div>
                    <h3 class="h3-card text-slate-900 mb-3">
                        Habilitar la recepción en USD
                    </h3>
                    <p
                        class="text-slate-600 text-sm font-medium leading-relaxed max-w-xs mx-auto"
                    >
                        Centraliza la recepción de cobros desde clientes o
                        plataformas en Estados Unidos de forma estructurada.
                    </p>
                </div>
                <!-- Beneficio 2 -->
                <div
                    class="group px-6 py-8 md:py-0 text-center reveal reveal-delay-1"
                >
                    <div class="relative inline-flex mb-6">
